# How recipes/linux-omarchy differs from upstream; bin/rebase-recipe re-applies it to each
# new upstream release (see its --help for the format, NOTES.md for the why).
# prepare() applies every *.patch in source=() order at fuzz 0, so placing the patch
# in source=() is the whole edit.
upstream omarchy-pkgs pkgbuilds/linux-omarchy
mode overlay
keep NOTES.md g16-test/deploy g16-test/test g16-test/lib.sh
patch 0481-drm-amd-display-power-backports.patch after 0480-*
patch 0482-drm-amd-display-replay-dmub-hpd-skipped-in-suspend.patch after 0481-*
patch 0568-hid-asus-pass-through-rog-nkey-win-lock-reports.patch after 0567-*
patch 0569-i2c-designware-size-rx-fifo-threshold.patch after 0568-*
patch 0773-gpiolib-acpi-ignore-wake-on-gpio16-asus-ga605km.patch after 0772-*
patch 0807-platform-x86-asus-armoury-ga605km-power-limits.patch after 0806-*
patch 0808-platform-x86-asus-wmi-restore-thermal-policy-after-hibernation.patch after 0807-*
patch 0810-drm-amd-display-panel-power-savings-apply-now.patch after 0808-*
patch 9900-EXPERIMENTAL-zen5c-first-soft-park-default-off.patch end -- EXPERIMENTAL, default-off scheduler series for GA605KM battery testing; see NOTES.md
