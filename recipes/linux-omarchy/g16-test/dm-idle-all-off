#!/usr/bin/env python3
"""dm-idle-all-off: screen-off display idle and the idlemask through suspend on the G16 (#353).

Patch 9902 (EXPERIMENTAL, default off) adds amdgpu.dm_idle_all_off: with every CRTC off,
the display manager re-allows idle optimizations even though the internal panel is still
connected. Patch 9901 adds amdgpu.dcn35_s0i2 (the S0i2-ready display idle message). Patch
9903 logs the SMU idlemask at each stage of an s2idle while pm_debug_messages is 1.

  dm-idle-all-off               run it: on battery, one root prompt, about 5 minutes
  dm-idle-all-off --post        and post the report to #353 (bin/issue)
  dm-idle-all-off --measure S   seconds measured per screen-off phase (30)
  dm-idle-all-off --dry-run     simulated readings, no root, nothing changed

Phases:
  a  baseline, screen on (15 s)
  b  dcn35_s0i2=1 and dm_idle_all_off=1, screen off (DPMS, Hyprland) for --measure s
  c  screen on (the panel must read back on); both 0, screen off for --measure s (control)
  d  pm_debug_messages=1, one 15 s s2idle (rtcwake), then the "SMU idlemask <stage>" lines
Each measured phase reads amd_pmc's idlemask at 10 Hz, amdgpu_dm_ips_status before and
after, gpu_metrics' average_socket_power (v3.0, offset 112) every 0.5 s and battery watts
every second. The parameters, the screen and pm_debug_messages go back to their values at
the start on exit, Ctrl-C included. A watchdog in its own session turns the screen back
on and both parameters to 0 if the kit dies, or if it runs past its deadline.

Pass: in (b), bits 5 (display idle) and 20 (IPS2) read idle in most reads; if bit 16 does
too and socket power is below (c)'s, the screen-off root cause is confirmed. (d) names the
first suspend stage where bit 16 reads idle. The panel comes back every time; no amdgpu or
DMUB errors. The report (no host or user names) goes to
~/omarchy-asus-g16-dm-idle-all-off-<kernel>-<date>.md.

Root: pkexec through the desktop's polkit agent (G16_POLKIT_REASON=<wrapper> runs
`<wrapper> run REASON -- pkexec ...`; G16_ROOT=sudo uses sudo).
Exit status: 0 the run finished (whatever the verdict), 1 a problem, 2 bad usage.
"""
import argparse
import glob
import json
import os
import pwd
import random
import re
import signal
import struct
import subprocess
import sys
import tempfile
import time

ISSUE = 353
SELF = os.path.realpath(__file__)
KIT = os.path.dirname(SELF)
P_S0I2 = "/sys/module/amdgpu/parameters/dcn35_s0i2"
P_IDLE = "/sys/module/amdgpu/parameters/dm_idle_all_off"
PARAMS = (P_S0I2, P_IDLE)
PM_DEBUG = "/sys/power/pm_debug_messages"
IDLEMASK = "/sys/kernel/debug/amd_pmc/amd_pmc_idlemask"
BITS = (5, 16, 20)      # display idle, the runtime blocker, IPS2
SOCKET_OFF = 112        # gpu_metrics_v3_0.average_socket_power (u32, mW)
SLEEP_S = 15
BASELINE_S = 15
STAGES = ("amdgpu-display", "amdgpu-ip", "prepare", "os-hint", "s0i3")
STAGE_RE = re.compile(r"SMU idlemask ([a-z0-9-]+): (0x[0-9a-fA-F]+)")
ERR_RE = re.compile(r"\*ERROR\*|dmub.*(timeout|timed out|error|fail)|REG_WAIT timeout|"
                    r"amdgpu.*(timeout|timed out|failed|hang|reset|error)", re.I)


def rd(p, d=None):
    try:
        with open(p, errors="replace") as f:
            return f.read(8192).strip()
    except OSError:
        return d


def wr(p, v):
    try:
        with open(p, "w") as f:
            f.write(f"{v}\n")
        return True
    except OSError:
        return False


def battery():
    for s in sorted(glob.glob("/sys/class/power_supply/*")):
        if rd(s + "/type") == "Battery" and rd(s + "/scope") != "Device":
            return s
    return None


def bat_w(bat):
    c, v = rd(bat + "/current_now", ""), rd(bat + "/voltage_now", "")
    if c.lstrip("-").isdigit() and v.isdigit() and int(c):
        return abs(int(c)) * int(v) / 1e12
    p = rd(bat + "/power_now", "")
    return abs(int(p)) / 1e6 if p.lstrip("-").isdigit() else None


def amdgpu_dev():
    for c in sorted(glob.glob("/sys/class/drm/card*")):
        d = os.path.realpath(c + "/device")
        if os.path.basename(os.path.realpath(d + "/driver")) == "amdgpu" and os.path.exists(d + "/gpu_metrics"):
            return d
    return None


def ips_status_path(dev):
    """amdgpu_dm_ips_status of the amdgpu (iGPU) DRM device in debugfs."""
    pci = os.path.basename(dev) if dev else ""
    found = sorted(glob.glob("/sys/kernel/debug/dri/*/amdgpu_dm_ips_status"))
    for p in found:
        if pci and pci in (rd(os.path.dirname(p) + "/name", "") or ""):
            return p
    return found[0] if found else None


def socket_w(dev):
    try:
        with open(dev + "/gpu_metrics", "rb") as f:
            b = f.read()
    except OSError:
        return None
    if len(b) < SOCKET_OFF + 4 or b[2] != 3 or b[3] != 0:
        return None
    v = struct.unpack_from("<I", b, SOCKET_OFF)[0]
    return None if v == 0xFFFFFFFF else v / 1000


def parse_mask(t):
    m = re.search(r"0x[0-9a-fA-F]+", t or "")
    return int(m.group(0), 16) if m else None


def idle_opt(ips):
    """'Idle optimization: N' from amdgpu_dm_ips_status, or None."""
    m = re.search(r"Idle optimization:\s*(\d+)", ips or "")
    return int(m.group(1)) if m else None


def not_idle(mask):
    return [b for b in range(32) if not (mask >> b) & 1]


def hypr_instance():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if re.match(r"^[A-Za-z0-9_]+$", sig):
        return sig
    run = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    socks = [x for x in glob.glob(run + "/hypr/*/.socket.sock")
             if re.match(r"^[A-Za-z0-9_]+$", os.path.basename(os.path.dirname(x)))]
    return os.path.basename(os.path.dirname(max(socks, key=os.path.getmtime))) if socks else ""


class Display:
    """DPMS of every output through the user's Hyprland (Lua dispatch first, then the old one)."""

    def __init__(self, user, uid, sig):
        self.base = ["runuser", "-u", user, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                     f"HYPRLAND_INSTANCE_SIGNATURE={sig}", "hyprctl"]

    def _ctl(self, *a):
        try:
            return subprocess.run(self.base + list(a), capture_output=True, text=True, timeout=10).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return ""

    def reads(self, on):
        try:
            mons = json.loads(self._ctl("monitors", "-j") or "x")
        except ValueError:
            return None
        return all(bool(m.get("dpmsStatus")) == on for m in mons if not m.get("disabled"))

    def set(self, on):
        said = self._ctl("dispatch", 'hl.dsp.dpms({ action = "%s" })' % ("enable" if on else "disable")) == "ok"
        time.sleep(1)
        got = self.reads(on)
        if got is False or (got is None and not said):
            said = self._ctl("dispatch", "dpms", "on" if on else "off") == "ok"
            time.sleep(1)
            got = self.reads(on)
        return said if got is None else got

    def back_on(self, tries=5):
        for _ in range(tries):
            if self.set(True):
                return True
            time.sleep(2)
        return False


class SimHw:
    """--dry-run: with both parameters at 1 and the screen off, bits 5, 16 and 20 read idle
    and the socket loses 0.6 W; the suspend trace turns bit 16 idle at the OS hint."""

    def __init__(self):
        self.p, self.on, self.rng = {P_S0I2: 0, P_IDLE: 0}, True, random.Random(353)

    def set_params(self, v):
        self.p = {P_S0I2: v, P_IDLE: v}
        return True

    def screen(self, on):
        self.on = on
        return True

    def ips(self):
        return f"Idle optimization: {0 if self.on or not self.p[P_IDLE] else 1}\nIPS2 entry count: 0\n"

    def sample(self, secs):
        n = int(secs * 10)
        base = 0xffce9add
        if not self.on and self.p[P_IDLE]:
            base |= (1 << 5) | (1 << 16) | (1 << 20)
        masks = [base if self.rng.random() > 0.05 else base & ~(1 << 7) for _ in range(n)]
        drop = 0.6 if base & (1 << 16) else 0
        sock = [(4.4 - drop + (0.8 if self.on else 0)) + self.rng.uniform(-0.05, 0.05) for _ in range(n // 5)]
        bat = [(5.9 - drop + (1.5 if self.on else 0)) + self.rng.uniform(-0.2, 0.2) for _ in range(n // 10)]
        return {"masks": masks, "sock": sock, "bat": bat, "status": ["Discharging"]}

    def suspend(self, secs):
        lines = ["amd_pmc: SMU idlemask amdgpu-display: 0xffce9afd",
                 "amd_pmc: SMU idlemask amdgpu-ip: 0xffde9afd",
                 "amd_pmc: SMU idlemask prepare: 0xffde9efd",
                 "amd_pmc: SMU idlemask os-hint: 0xffff9efd",
                 "amd_pmc: SMU idlemask s0i3: 0xffff9efd"]
        return {"ok": True, "lines": lines, "hw_sleep_us": 13800000, "panel_back": True}


class Hw:
    def __init__(self, display):
        self.display, self.dev, self.bat = display, amdgpu_dev(), battery()
        self.ips_path = ips_status_path(self.dev)

    def set_params(self, v):
        ok = all(wr(p, 1 if v else 0) for p in PARAMS)
        return ok and all(rd(p) == ("Y" if v else "N") for p in PARAMS)

    def screen(self, on):
        return self.display.set(on)

    def ips(self):
        return rd(self.ips_path, "") if self.ips_path else ""

    def sample(self, secs):
        out = {"masks": [], "sock": [], "bat": [], "status": set()}
        t0, k = time.monotonic(), 0
        while time.monotonic() - t0 < secs:
            out["masks"].append(parse_mask(rd(IDLEMASK, "")))
            if k % 5 == 0 and self.dev:
                out["sock"].append(socket_w(self.dev))
            if k % 10 == 0 and self.bat:
                out["bat"].append(bat_w(self.bat))
                out["status"].add(rd(self.bat + "/status"))
            k += 1
            time.sleep(max(0.0, t0 + k * 0.1 - time.monotonic()))
        out["status"] = sorted(x for x in out["status"] if x)
        return out

    def suspend(self, secs):
        t0 = time.time()
        try:
            r = subprocess.run(["rtcwake", "-m", "freeze", "-s", str(secs)],
                               capture_output=True, text=True, timeout=secs + 120)
            ok = r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            ok = False
        time.sleep(3)
        panel = self.display.back_on()
        hw = rd("/sys/power/suspend_stats/last_hw_sleep", "")
        return {"ok": ok, "lines": kernel_lines(t0 - 1, "SMU idlemask"),
                "hw_sleep_us": int(hw) if hw.isdigit() else None, "panel_back": panel}


def kernel_lines(since, needle):
    try:
        r = subprocess.run(["journalctl", "-k", "-q", "-o", "cat", "--since", f"@{int(since)}"],
                           capture_output=True, text=True, timeout=30)
        text = r.stdout
    except (OSError, subprocess.SubprocessError):
        text = ""
    return [ln for ln in text.splitlines() if needle in ln][:200]


def journal_errors(since):
    try:
        r = subprocess.run(["journalctl", "-k", "-q", "-o", "cat", "--since", f"@{int(since)}"],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return ["(journalctl failed)"]
    return [ln for ln in r.stdout.splitlines() if ERR_RE.search(ln)][:20]


def mean(xs):
    xs = [x for x in xs if x is not None]
    return sum(xs) / len(xs) if xs else None


def summarize(s):
    good = [m for m in s["masks"] if m is not None]
    idle = {b: (sum(1 for m in good if (m >> b) & 1) / len(good) if good else None) for b in BITS}
    top = {}
    for m in good:
        top[f"0x{m:08x}"] = top.get(f"0x{m:08x}", 0) + 1
    masks = sorted(top.items(), key=lambda x: -x[1])[:3]
    # Bits never idle in any read of the phase.
    never = [b for b in range(32) if good and all(not (m >> b) & 1 for m in good)]
    return {"idle": idle, "reads": len(good), "masks": masks, "never_idle": never,
            "sock": mean(s["sock"]), "bat": mean(s["bat"])}


def parse_stages(lines):
    """'SMU idlemask <stage>: 0x...' lines -> [(stage, mask)], in the order logged."""
    out = []
    for ln in lines:
        m = STAGE_RE.search(ln)
        if m:
            out.append((m.group(1), int(m.group(2), 16)))
    return out


def first_idle(stages, bit):
    for st, m in stages:
        if (m >> bit) & 1:
            return st
    return None


def measure(hw, name, label, params, screen_on, secs, log, dry):
    """One measured phase: parameters, screen, IPS status before, sample, IPS status after."""
    if not hw.set_params(params):
        raise RuntimeError(f"could not set the parameters to {params}")
    ips0 = hw.ips()
    off = True if screen_on else hw.screen(False)
    if not dry:
        time.sleep(3)
    s = hw.sample(secs if not dry else 3)
    ips1 = hw.ips()
    back = True if screen_on else hw.screen(True)
    if not dry and not screen_on:
        time.sleep(4)
    p = {"phase": name, "label": label, "params": params, "screen_on": screen_on,
         "screen_off_ok": off, "panel_back": back, "status": s["status"],
         "ips_before": idle_opt(ips0), "ips_after": idle_opt(ips1),
         "ips_raw_after": (ips1 or "")[:600], **summarize(s)}
    log(f"phase {name} ({label}): " + " ".join(f"bit{b} idle {fmt_share(p['idle'][b])}" for b in BITS)
        + f" ips {p['ips_before']}->{p['ips_after']} socket {fmt_w(p['sock'])} battery {fmt_w(p['bat'])}"
        + ("" if back else " PANEL DID NOT READ BACK ON"))
    return p


def run(hw, a, log, pm_debug):
    """Phases a-d; -> (phases, suspend). The caller puts everything back.
    pm_debug(v) writes pm_debug_messages (a no-op in a dry run)."""
    dry = a.dry_run
    phases = [measure(hw, "a", "baseline, screen on", 0, True, BASELINE_S, log, dry)]

    def charger(p):
        return not dry and any(x != "Discharging" for x in p["status"])

    if charger(phases[-1]):
        log("on the charger: stopping (the run counts as incomplete)")
        return phases, None
    for name, label, v in (("b", "dcn35_s0i2=1 dm_idle_all_off=1, screen off", 1),
                           ("c", "both 0, screen off (control)", 0)):
        phases.append(measure(hw, name, label, v, False, a.measure, log, dry))
        if charger(phases[-1]):
            log("the charger came back: stopping (the run counts as incomplete)")
            return phases, None
        if not phases[-1]["panel_back"]:
            log("the panel did not come back: stopping")
            return phases, None
    if not hw.set_params(0):
        raise RuntimeError("could not set the parameters to 0 before the suspend")
    if not pm_debug(1):
        raise RuntimeError(f"could not write {PM_DEBUG}")
    log(f"phase d: one {SLEEP_S} s s2idle (rtcwake) with pm_debug_messages on")
    sus = hw.suspend(SLEEP_S)
    pm_debug(None)
    sus["stages"] = [[st, f"0x{m:08x}"] for st, m in parse_stages(sus["lines"])]
    log(f"phase d: suspend {'ok' if sus['ok'] else 'FAILED'}, {len(sus['stages'])} idlemask lines, "
        f"panel {'back' if sus['panel_back'] else 'DID NOT READ BACK ON'}")
    return phases, sus


def fmt_share(x):
    return "-" if x is None else f"{x * 100:.0f}%"


def fmt_w(x):
    return "-" if x is None else f"{x:.2f} W"


def watchdog(a):
    """Root, own session: if the kit's root stage dies (or passes its deadline), turn the
    screen back on, both parameters to 0 and pm_debug_messages to its start value."""
    deadline = time.monotonic() + a.deadline
    disp = Display(a.user, a.uid, a.hypr)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    while time.monotonic() < deadline:
        try:
            os.kill(a.parent, 0)
        except ProcessLookupError:
            break
        except PermissionError:
            pass
        time.sleep(0.5)
    else:
        print("dm-idle-all-off watchdog: past the deadline, restoring", file=sys.stderr)
    if os.path.exists(a.done):
        return 0
    for p in PARAMS:
        wr(p, 0)
    if a.pm_debug in ("0", "1"):
        wr(PM_DEBUG, a.pm_debug)
    disp.back_on()
    return 0


def start_watchdog(pw, uid, a, pm0, done, deadline):
    args = [sys.executable, "-I", SELF, "--stage", "watchdog", "--parent", str(os.getpid()),
            "--user", pw.pw_name, "--uid", str(uid), "--hypr", a.hypr, "--pm-debug", pm0,
            "--done", done, "--deadline", str(deadline)]
    try:
        return subprocess.Popen(args, start_new_session=True, stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return None


def stage_root(a):
    """Root: measure, put everything back, write results.json into the user's directory."""
    if os.geteuid() != 0:
        print("dm-idle-all-off: the root stage needs root", file=sys.stderr)
        return 1
    uid = int(os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID") or -1)
    try:
        pw = pwd.getpwuid(uid)
    except (KeyError, OverflowError):
        print("dm-idle-all-off: can't tell who asked (no PKEXEC_UID/SUDO_UID)", file=sys.stderr)
        return 1
    out = os.path.realpath(a.out)
    if not out.startswith(pw.pw_dir.rstrip("/") + "/") or os.stat(out).st_uid != uid:
        print("dm-idle-all-off: the output directory must be the user's own, in their home", file=sys.stderr)
        return 1
    for p in PARAMS:
        if rd(p) not in ("Y", "N"):
            print(f"dm-idle-all-off: no {p} (not a kernel with patches 9901 and 9902)", file=sys.stderr)
            return 1
    if parse_mask(rd(IDLEMASK, "")) is None:
        print(f"dm-idle-all-off: can't read {IDLEMASK}", file=sys.stderr)
        return 1
    hw = Hw(Display(pw.pw_name, uid, a.hypr))
    start = {p: rd(p) == "Y" for p in PARAMS}
    pm0 = rd(PM_DEBUG, "")
    t0 = time.time()
    res = {"params_at_start": {os.path.basename(p): int(v) for p, v in start.items()},
           "phases": [], "suspend": None, "errors": [], "problems": [],
           "trace_symbol": False, "ips_status": bool(hw.ips_path)}
    try:
        with open("/proc/kallsyms") as f:
            res["trace_symbol"] = any(re.search(r" amd_pmc_trace_idlemask(\s|$)", ln) for ln in f)
    except OSError:
        pass
    done_dir = tempfile.mkdtemp(prefix="dm-idle-all-off-")
    done = os.path.join(done_dir, "done")
    deadline = BASELINE_S + 2 * (a.measure + 15) + SLEEP_S + 180
    wd = start_watchdog(pw, uid, a, pm0, done, deadline)
    if wd is None:
        res["problems"].append("the watchdog did not start")

    def pm_debug(v):
        return wr(PM_DEBUG, v if v is not None else (pm0 if pm0 in ("0", "1") else 0))

    def back():
        for p, v in start.items():
            if not (wr(p, int(v)) and rd(p) == ("Y" if v else "N")):
                res["problems"].append(f"could not put {p} back to {int(v)}")
        if pm0 in ("0", "1") and not (wr(PM_DEBUG, pm0) and rd(PM_DEBUG) == pm0):
            res["problems"].append(f"could not put {PM_DEBUG} back to {pm0}")
        if not hw.display.back_on():
            res["panel_restore"] = False
            res["problems"].append("the screen did not read back on (hyprctl): press a key")

    def on_term(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGHUP, on_term)
    try:
        res["phases"], res["suspend"] = run(hw, a, lambda m: print(m, flush=True), pm_debug)
    except KeyboardInterrupt:
        res["problems"].append("interrupted")
    except RuntimeError as e:
        res["problems"].append(str(e))
    finally:
        back()
        try:
            open(done, "w").close()
        except OSError:
            pass
        if wd is not None:
            wd.terminate()
    if res["suspend"]:
        res["suspend"].pop("lines", None)
    time.sleep(2)
    res["errors"] = journal_errors(t0 - 1)
    try:
        os.unlink(done)
        os.rmdir(done_dir)
    except OSError:
        pass
    # Written as the user, never following a link: the directory is theirs.
    os.setegid(pw.pw_gid)
    os.seteuid(uid)
    try:
        fd = os.open(os.path.join(out, "results.json"), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(res, f, indent=1)
    finally:
        os.seteuid(0)
        os.setegid(0)
    return 0


def phase(res, name):
    return next((p for p in res["phases"] if p["phase"] == name), None)


def verdict(res):
    """-> (verdict, facts). PASS needs bits 5 and 20 idle in (b); CONFIRMED adds bit 16 and
    a socket drop against the control (c)."""
    b, c, sus = phase(res, "b"), phase(res, "c"), res.get("suspend")
    panel = all(p["panel_back"] for p in res["phases"]) and res.get("panel_restore", True) \
        and (sus is None or sus.get("panel_back", True))
    charger = any(st != "Discharging" for p in res["phases"] for st in p["status"])
    stages = [(st, int(m, 16)) for st, m in (sus or {}).get("stages", [])]
    f = {"panel": panel, "stage16": first_idle(stages, 16), "stages": stages,
         "d_sock": None if not b or not c or b["sock"] is None or c["sock"] is None else b["sock"] - c["sock"],
         "d_bat": None if not b or not c or b["bat"] is None or c["bat"] is None else b["bat"] - c["bat"]}
    if not panel or res["errors"]:
        v = "FAIL"
    elif res["problems"] or charger or not b or not c or not sus or not sus.get("ok"):
        v = "INCOMPLETE"
    elif (b["idle"][5] or 0) >= 0.8 and (b["idle"][20] or 0) >= 0.8:
        v = "CONFIRMED" if (b["idle"][16] or 0) >= 0.8 and f["d_sock"] is not None and f["d_sock"] < 0 else "PASS"
    else:
        v = "NO EFFECT"
    return v, f


WHAT = {"FAIL": "FAIL", "INCOMPLETE": "INCOMPLETE", "NO EFFECT": "NO EFFECT",
        "PASS": "PASS (bits 5 and 20 idle with the screen off; bit 16 still not)",
        "CONFIRMED": "PASS, root cause confirmed (bit 16 idle and socket power down with the screen off)"}


def bits_list(xs):
    return ", ".join(str(x) for x in xs) if xs else "none"


def report(res, kernel, a):
    v, f = verdict(res)

    def sign(x):
        return "-" if x is None else f"{x:+.2f} W"

    b = phase(res, "b") or {"idle": {}}
    o = [f"## dm_idle_all_off on the G16: {WHAT[v]} (#353)", "",
         f"Kernel {kernel}, on battery. Screen off (DPMS) for {a.measure} s per screen-off phase; "
         f"idlemask at 10 Hz, socket power from gpu_metrics, battery watts; one {SLEEP_S} s s2idle with "
         "pm_debug_messages on." + (" **Dry run: simulated readings.**" if a.dry_run else ""), "",
         f"- (b) both parameters 1, screen off: bit 5 idle {fmt_share(b['idle'].get(5))}, bit 20 "
         f"{fmt_share(b['idle'].get(20))}, bit 16 {fmt_share(b['idle'].get(16))} of reads",
         f"- socket power, (b) minus the control (c): {sign(f['d_sock'])}; battery: {sign(f['d_bat'])}",
         f"- first suspend stage with bit 16 idle: {f['stage16'] or 'none logged'}",
         f"- panel back every time: {'yes' if f['panel'] else 'NO'}",
         f"- amdgpu / DMUB errors in the kernel log: {len(res['errors']) or 'none'}", "",
         "| phase | what | bit 5 | bit 16 | bit 20 | never idle | Idle optimization before -> after "
         "| socket W | battery W | idlemask (most read) | panel back |",
         "|---|---|---|---|---|---|---|---|---|---|---|"]
    for p in res["phases"]:
        masks = ", ".join(f"{m} x{n}" for m, n in p["masks"][:2])
        sock = "-" if p["sock"] is None else f"{p['sock']:.2f}"
        bat = "-" if p["bat"] is None else f"{p['bat']:.2f}"
        o.append(f"| {p['phase']} | {p['label']} | {fmt_share(p['idle'][5])} | {fmt_share(p['idle'][16])} | "
                 f"{fmt_share(p['idle'][20])} | {bits_list(p['never_idle'])} | {p['ips_before']} -> {p['ips_after']} | "
                 f"{sock} | {bat} | {masks} | {'yes' if p['panel_back'] else 'NO'} |")
    sus = res.get("suspend")
    if sus:
        hw_s = "-" if sus.get("hw_sleep_us") is None else f"{sus['hw_sleep_us'] / 1e6:.1f} s"
        o += ["", f"Suspend (d): rtcwake {'ok' if sus.get('ok') else 'FAILED'}, hardware sleep {hw_s}, "
              f"panel back {'yes' if sus.get('panel_back') else 'NO'}"]
    else:
        o += ["", "Suspend (d): not run"]
    if f["stages"]:
        o += ["", "| stage | idlemask | bit 5 | bit 16 | bit 20 | not idle |", "|---|---|---|---|---|---|"]
        for st, m in f["stages"]:
            o.append(f"| {st} | 0x{m:08x} | " + " | ".join("idle" if (m >> x) & 1 else "-" for x in BITS)
                     + f" | {bits_list(not_idle(m))} |")
    elif sus:
        o += ["", "No `SMU idlemask <stage>` lines in the kernel log"
              + ("." if res.get("trace_symbol", True) else " (this kernel lacks patch 9903).")]
    if res["errors"]:
        o += ["", "<details><summary>Kernel log</summary>", "", "```", *res["errors"], "```", "", "</details>"]
    if res["problems"]:
        o += ["", "Problems: " + "; ".join(res["problems"])]
    o += ["", "<sub>recipes/linux-omarchy/g16-test/dm-idle-all-off</sub>"]
    return "\n".join(o) + "\n", v


def normalize(res):
    """JSON turns the int bit keys into strings; put them back."""
    for p in res["phases"]:
        p["idle"] = {int(k): x for k, x in p["idle"].items()}
    return res


def front(a):
    kernel = os.uname().release
    if a.dry_run:
        hw = SimHw()
        phases, sus = run(hw, a, print, lambda v: True)
        sus["stages"] = [[st, f"0x{m:08x}"] for st, m in parse_stages(sus.pop("lines"))]
        res = {"params_at_start": {"dcn35_s0i2": 0, "dm_idle_all_off": 0}, "phases": phases,
               "suspend": sus, "errors": [], "problems": [], "trace_symbol": True}
        kernel += " (dry run)"
    else:
        bat = battery()
        bad = []
        if "GA605" not in (rd("/sys/class/dmi/id/product_name", "") + rd("/sys/class/dmi/id/board_name", "")):
            bad.append("not a GA605 (the G16)")
        for p in PARAMS:
            if rd(p) not in ("Y", "N"):
                bad.append(f"no {p}: boot a kernel with patches 9901-9903 (7.2.8-9.107 or later)")
        if not os.path.exists(PM_DEBUG):
            bad.append(f"no {PM_DEBUG} (CONFIG_PM_SLEEP_DEBUG)")
        if not bat or rd(bat + "/status") != "Discharging":
            bad.append("not on battery: unplug the charger")
        sig = hypr_instance()
        if not sig:
            bad.append("no running Hyprland found (HYPRLAND_INSTANCE_SIGNATURE)")
        if bad:
            print("dm-idle-all-off: not starting, nothing was changed:\n  - " + "\n  - ".join(bad), file=sys.stderr)
            return 1
        state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                             "omarchy-asus-g16-test")
        os.makedirs(state, exist_ok=True)
        out = tempfile.mkdtemp(prefix="dm-idle-all-off-", dir=state)
        args = [sys.executable, "-I", SELF, "--stage", "root", "--out", out, "--hypr", sig,
                "--measure", str(a.measure)]
        mins = (BASELINE_S + 2 * (a.measure + 10) + SLEEP_S + 30) // 60 + 1
        why = (f"G16 screen-off idle test (#353): amdgpu.dcn35_s0i2 and amdgpu.dm_idle_all_off on and off with "
               f"the screen off, then one {SLEEP_S} s suspend with pm_debug_messages on, about {mins} minutes; "
               "everything goes back to its value now")
        if os.environ.get("G16_POLKIT_REASON"):
            cmd = [os.environ["G16_POLKIT_REASON"], "run", why, "--", "pkexec", *args]
        elif os.environ.get("G16_ROOT") == "sudo":
            cmd = ["sudo", *args]
        else:
            cmd = ["pkexec", "--disable-internal-agent", *args]
        print(f"==> {why}\n    hands off the keyboard and the lid until it says done", flush=True)
        if subprocess.run(cmd).returncode != 0:
            print("dm-idle-all-off: the root stage failed", file=sys.stderr)
            return 1
        try:
            with open(os.path.join(out, "results.json")) as f:
                res = normalize(json.load(f))
        except (OSError, ValueError):
            print("dm-idle-all-off: no results from the root stage", file=sys.stderr)
            return 1
    text, v = report(res, kernel, a)
    path = os.path.expanduser(f"~/omarchy-asus-g16-dm-idle-all-off-{os.uname().release}-{time.strftime('%Y%m%d-%H%M')}.md")
    if a.dry_run:
        path = os.path.join(tempfile.gettempdir(), os.path.basename(path))
    with open(path, "w") as f:
        f.write(text)
    print(f"\n{text}\n==> {v}; report: {path}")
    if a.post and not a.dry_run:
        helper = os.path.realpath(os.path.join(KIT, "..", "..", "..", "bin", "issue"))
        if os.access(helper, os.X_OK):
            r = subprocess.run([helper, "comment", str(ISSUE), "--agent", "laptop-claude", "--body-file", path])
            print(f"posted to #{ISSUE}" if r.returncode == 0 else f"not posted (bin/issue refused it); the text is in {path}")
        else:
            print(f"not posted: no bin/issue in this checkout; the text is in {path}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="dm-idle-all-off", description=__doc__.split("\n\n")[0])
    ap.add_argument("--measure", type=int, default=30)
    ap.add_argument("--post", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--stage", choices=["front", "root", "watchdog"], default="front", help=argparse.SUPPRESS)
    ap.add_argument("--out", default="", help=argparse.SUPPRESS)
    ap.add_argument("--hypr", default="", help=argparse.SUPPRESS)
    ap.add_argument("--parent", type=int, default=0, help=argparse.SUPPRESS)
    ap.add_argument("--user", default="", help=argparse.SUPPRESS)
    ap.add_argument("--uid", type=int, default=-1, help=argparse.SUPPRESS)
    ap.add_argument("--pm-debug", default="", help=argparse.SUPPRESS)
    ap.add_argument("--done", default="", help=argparse.SUPPRESS)
    ap.add_argument("--deadline", type=int, default=600, help=argparse.SUPPRESS)
    a = ap.parse_args()
    if not 10 <= a.measure <= 300:
        ap.error("--measure 10-300")
    if a.hypr and not re.match(r"^[A-Za-z0-9_]+$", a.hypr):
        ap.error("bad --hypr")
    if a.stage == "watchdog":
        if os.geteuid() != 0 or a.parent <= 1 or not a.user or a.uid < 0 or not a.done:
            ap.error("the watchdog is started by the root stage")
        return watchdog(a)
    return stage_root(a) if a.stage == "root" else front(a)


if __name__ == "__main__":
    sys.exit(main())
