check_nvidia() {
  local d rs0 drv nv smi rs st=PASS det=()
  d=$(dgpu_dir) || { result FAIL nvidia "no NVIDIA GPU on the PCI bus"; return; }
  rs0=$(cat "$d/power/runtime_status" 2>/dev/null)
  drv=$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)
  det+=("dGPU ${d##*/}: driver ${drv:-none}, runtime_status at start: $rs0, control: $(cat "$d/power/control" 2>/dev/null)")
  [[ $drv == nvidia ]] || st=FAIL
  nv=$(dkms status -k "$KREL" 2>/dev/null | grep -i nvidia)
  det+=("dkms: ${nv:-nothing for $KREL}" "module: $(cat /sys/module/nvidia/version 2>/dev/null || echo not loaded)")
  [[ $nv == *installed* ]] || st=FAIL
  if have nvidia-smi && smi=$(timeout 30 nvidia-smi --query-gpu=name,driver_version,pstate,temperature.gpu,power.draw --format=csv,noheader 2>&1); then
    det+=("nvidia-smi: $smi")
  else
    st=FAIL; det+=("nvidia-smi failed: ${smi:-not installed}")
  fi
  local i
  for ((i = 0; i < 30; i++)); do
    rs=$(cat "$d/power/runtime_status" 2>/dev/null)
    [[ $rs == suspended ]] && break
    sleep 1
  done
  det+=("runtime_status ${i}s after nvidia-smi: $rs")
  if [[ $rs != suspended && $st == PASS ]]; then
    st=WARN; det+=("the dGPU did not runtime-suspend within 30 s (something holds it, e.g. an external monitor or a GPU app)")
  fi
  result "$st" nvidia "driver $drv, dkms ${nv:+installed}, nvidia-smi $([[ -n ${smi:-} && $st != FAIL ]] && echo works || echo failed), runtime PM: $rs0 -> $rs" "${det[@]}"
}

check_suspend() {
  ((SUSPEND)) || { result SKIP suspend "--no-suspend"; return; }
  local ms s0 f0 t0 s1 f1 l1 t1 pmc0 pmc1 since irq
  ms=$(cat /sys/power/mem_sleep 2>/dev/null)
  [[ $ms == *"[s2idle]"* ]] || { result FAIL suspend "mem_sleep is '$ms', expected [s2idle]"; return; }
  ask "Suspend now for about 30 s? The RTC wakes it; if it is still asleep after a minute, press the power button (then unlock the screen)." ||
    { result SKIP suspend "declined"; return; }
  s0=$(cat /sys/power/suspend_stats/success) f0=$(cat /sys/power/suspend_stats/fail) t0=$(cat /sys/power/suspend_stats/total_hw_sleep 2>/dev/null || echo 0)
  pmc0=$(root_read cat /sys/kernel/debug/amd_pmc/s0ix_stats || true)
  since=$(date '+%Y-%m-%d %H:%M:%S')
  as_root "set an RTC alarm 30 s ahead so the laptop wakes by itself" rtcwake -m no -s 30 >/dev/null || true
  systemctl suspend || { result FAIL suspend "systemctl suspend refused"; return; }
  local i
  for ((i = 0; i < 180; i++)); do
    s1=$(cat /sys/power/suspend_stats/success) f1=$(cat /sys/power/suspend_stats/fail)
    ((s1 > s0 || f1 > f0)) && break
    sleep 1
  done
  sleep 5
  l1=$(cat /sys/power/suspend_stats/last_hw_sleep 2>/dev/null || echo 0) t1=$(cat /sys/power/suspend_stats/total_hw_sleep 2>/dev/null || echo 0)
  pmc1=$(root_read cat /sys/kernel/debug/amd_pmc/s0ix_stats || true)
  irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo none)
  local det=("suspend_stats success $s0 -> $s1, fail $f0 -> $f1" "last_hw_sleep ${l1} us, total_hw_sleep $t0 -> $t1 us, wake irq $irq"
    "amd_pmc s0ix_stats before:" "${pmc0:-unreadable}" "after:" "${pmc1:-unreadable}"
    "kernel errors since the suspend:" "$(journalctl -k -p err --since "$since" -o cat --no-pager 2>/dev/null | head -n 20)")
  if ((f1 > f0)); then
    result FAIL suspend "the suspend failed (suspend_stats fail $f0 -> $f1)" "${det[@]}"
  elif ((s1 == s0)); then
    result FAIL suspend "no completed suspend within 3 minutes" "${det[@]}"
  elif ((l1 > 0 && t1 > t0 && l1 < 10000000)); then
    # success counts a suspend that resumes at once too (#133): the RTC alarm is 30 s out
    result FAIL suspend "woke after $((l1 / 1000)) ms of hardware sleep (wake irq $irq), not the 30 s RTC alarm: see #132" "${det[@]}"
  elif ((l1 > 0 && t1 > t0)); then
    result PASS suspend "s2idle cycle reached s0i3: $((l1 / 1000)) ms of hardware sleep" "${det[@]}"
  else
    result FAIL suspend "resumed, but no hardware sleep (s0i3 not reached: last_hw_sleep $l1)" "${det[@]}"
  fi
}

check_hibernate() {
  ((HIBERNATE)) || { result SKIP hibernate "opt-in: run with --hibernate (needs a power-button press)"; return; }
  local can since t0 ok=''
  can=$(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager CanHibernate 2>/dev/null | awk '{print $2}' | tr -d '"')
  [[ $can == yes ]] || { result SKIP hibernate "logind CanHibernate: ${can:-unknown} (no swap/resume set up?)"; return; }
  printf '\n%sHibernate: the laptop saves memory to disk and powers off. Wait until it is fully\n' "$B"
  printf 'off (all lights out), press the power button, keep the default Limine entry, unlock.%s\n' "$N"
  ask "Hibernate now?" || { result SKIP hibernate "declined"; return; }
  since=$(date '+%Y-%m-%d %H:%M:%S') t0=$(date +%s)
  systemctl hibernate || { result FAIL hibernate "systemctl hibernate refused"; return; }
  local i
  for ((i = 0; i < 900; i++)); do
    journalctl -k --since "$since" -o cat --no-pager 2>/dev/null | grep -q 'PM: hibernation: hibernation exit' && break
    sleep 1
  done
  sleep 3
  local lines
  lines=$(journalctl -k --since "$since" -o cat --no-pager 2>/dev/null | grep -E 'PM: (hibernation|Image|resume)|NVRM|Freezing|Restarting' | head -n 30)
  if ((INTERACTIVE)); then read -r -p "Did it power off completely within about 30 s (no hang with lights on)? [y/n] " ok || ok=''; fi
  if [[ $lines != *"hibernation exit"* ]]; then
    result FAIL hibernate "no resume from hibernation seen in the kernel log" "$lines"
  elif [[ $ok == [nN]* ]]; then
    result FAIL hibernate "resumed after $(($(date +%s) - t0)) s, but it did not power off cleanly" "$lines"
  else
    result PASS hibernate "hibernated, powered off$([[ -z $ok ]] && echo ' (not confirmed)'), resumed after $(($(date +%s) - t0)) s" "$lines"
  fi
}

run_checks() {
  say "G16 test: $EXPECT_KREL (PR #$PR), running $KREL"
  [[ -f $BASE ]] || note "no baseline from deploy: comparisons are skipped"
  sudo_up_front "dmesg fallback, amd_pmc counters, reading the touchpad device, the asus-armoury write check, the CACP kprobe, the RTC alarm"
  echo
  local booted=1
  check_kernel || booted=0
  if ((booted)); then
    check_klog
    check_winlock
    check_touchpad
    check_armoury
    check_panel
    check_cacp_apply
    check_gpio16
    check_sdreader
    check_dock
    check_dcn35_s0i2
    check_dm_idle_all_off
    check_pmf_hwmon
    check_nvidia
    check_suspend
    check_hibernate
  fi
  local f=$HOME/omarchy-asus-g16-test-$KREL-$STAMP.md verdict
  if ((!booted)); then verdict="**Did not boot $EXPECT_KREL** (running $KREL)."
  elif ((NF)); then verdict="**$NF check(s) failed.** HOLD stays."
  else verdict="**No failures.** The boot test passed; the HOLD can be lifted by the maintainer."; fi
  write_report "$f" "G16 test: linux-omarchy $EXPECT_VER" "$(header_info)"$'\n\n'"$verdict"
  echo
  say "$NP pass, $NF fail, $NW warn, $NS skip. Report: ${f/#$HOME/\~}"
  offer_post "$f" pr "$PR"
}

# ==================================================================== temps
temps_preflight() {
  local cap need qa qm helper=/usr/bin/omarchy-powerprofiles-asus-quiet-fans
  on_ac && die "the charger is connected: #42 is about battery. Unplug it and run --temps again."
  cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1)
  # About 1 %/min under load (33-41 W measured on the G16), idle and recovery included, plus
  # the 15 % the run stops at.
  need=$((20 + (TEMPS_MIN + 1 + RECOVERY) * (AB + 1)))
  ((need <= 100)) || die "--temps $TEMPS_MIN$( ((AB)) && echo ' --ab') needs more than a full battery; shorten it"
  ((${cap:-0} >= need)) ||
    die "battery at ${cap:-?}%: charge to at least $need% for this run (or shorten it: --temps 5)"
  qa=$(profile_of asus-wmi) qm=$(profile_of amd-pmf)
  if [[ $qa != quiet || $qm != balanced ]]; then
    note "the quiet fan table is not active (asus-wmi $qa, amd-pmf $qm; want quiet + balanced)"
    if [[ $qa == balanced && $qm == balanced && -x $helper ]] && ask "Turn it on now with omarchy's helper (sudo $helper on)?"; then
      as_root "set the asus-wmi platform profile to quiet (amd-pmf stays balanced)" "$helper" on || die "the helper failed"
    else
      die "pick the Balanced power profile on battery (Omarchy menu > Setup > Power profile), which turns the quiet fan table on with omarchy-asus 4.0.5-1.1, then run again"
    fi
    qa=$(profile_of asus-wmi) qm=$(profile_of amd-pmf)
    [[ $qa == quiet && $qm == balanced ]] || die "still asus-wmi $qa, amd-pmf $qm"
  fi
}

fan_table() { # the factory curve asus-wmi reports for the active profile
  local fc p i t v
  fc=$(hwmon_by_name asus_custom_fan_curve) || { echo "no asus_custom_fan_curve hwmon"; return; }
  for p in 1 2 3; do
    [[ -e $fc/pwm${p}_auto_point1_temp ]] || continue
    printf 'pwm%s (enable=%s):' "$p" "$(cat "$fc/pwm${p}_enable" 2>/dev/null)"
    for i in 1 2 3 4 5 6 7 8; do
      t=$(cat "$fc/pwm${p}_auto_point${i}_temp" 2>/dev/null) v=$(cat "$fc/pwm${p}_auto_point${i}_pwm" 2>/dev/null)
      [[ -n $t ]] && printf ' %sC=%s%%' "$t" "$(((v * 100 + 127) / 255))"
    done
    printf '\n'
  done
}

# One CSV row: t,phase,tctl,apu_edge,dgpu,fan1,fan2,fan3,apu_w,batt_w,mhz_avg,mhz_max,profile,asus,amd
sample_header='t_s,phase,tctl_c,apu_edge_c,dgpu,fan1_rpm,fan2_rpm,fan3_rpm,apu_w,batt_w,mhz_avg,mhz_max,platform_profile,asus_wmi,amd_pmf'
sample() {
  local t=$1 phase=$2 k a fans=() f g rs dg pw bw mhz
  k=$(cat "$HW_K10/temp1_input" 2>/dev/null || echo)
  a=$(cat "$HW_AMDGPU/temp1_input" 2>/dev/null || echo)
  for f in 1 2 3; do fans+=("$(cat "$HW_ASUS/fan${f}_input" 2>/dev/null || echo)"); done
  rs=$(cat "$DGPU/power/runtime_status" 2>/dev/null || echo absent)
  dg=$rs
  if [[ $rs == active ]] && have nvidia-smi; then
    g=$(timeout 5 nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1)
    [[ -n $g ]] && dg="${g}C"
  fi
  pw=$(cat "$HW_AMDGPU/power1_average" 2>/dev/null || cat "$HW_AMDGPU/power1_input" 2>/dev/null || echo)
  bw=$(cat /sys/class/power_supply/BAT*/power_now 2>/dev/null | head -n1)
  mhz=$(awk '{s+=$1; if ($1>m) m=$1; n++} END {if (n) printf "%d,%d", s/n/1000, m/1000; else printf ","}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null)
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$t" "$phase" \
    "$([[ -n $k ]] && awk -v x="$k" 'BEGIN{printf "%.1f", x/1000}')" \
    "$([[ -n $a ]] && awk -v x="$a" 'BEGIN{printf "%.1f", x/1000}')" "$dg" \
    "${fans[0]}" "${fans[1]}" "${fans[2]}" \
    "$([[ -n $pw ]] && awk -v x="$pw" 'BEGIN{printf "%.1f", x/1e6}')" \
    "$([[ -n $bw ]] && awk -v x="$bw" 'BEGIN{printf "%.1f", x/1e6}')" "$mhz" \
    "$(cat /sys/firmware/acpi/platform_profile 2>/dev/null)" "$(profile_of asus-wmi)" "$(profile_of amd-pmf)"
}

LOAD_PIDS=()
stop_load() { local p; for p in "${LOAD_PIDS[@]}"; do kill "$p" 2>/dev/null; done; LOAD_PIDS=(); }
start_load() { # seconds
  local n i
  n=$(nproc)
  if have stress-ng; then
    stress-ng --cpu "$n" --timeout "${1}s" --quiet >/dev/null 2>&1 &
    LOAD_PIDS+=($!)
    LOAD_KIND="stress-ng --cpu $n"
  else
    for ((i = 0; i < n; i++)); do
      timeout "$1" bash -c 'while :; do :; done' &
      LOAD_PIDS+=($!)
    done
    LOAD_KIND="bash busy loops x$n (stress-ng not installed)"
  fi
}

run_phase_set() { # label csv -> runs idle/load/recovery
  local label=$1 csv=$2 t=0 end phase
  printf '%s\n' "$sample_header" >"$csv"
  local idle=60 load=$((TEMPS_MIN * 60)) rec=$((RECOVERY * 60))
  say "[$label] idle ${idle}s, load ${load}s, recovery ${rec}s, sample every ${INTERVAL}s"
  end=$((idle + load + rec))
  local start=$SECONDS loaded=0 tc
  while ((t <= end)); do
    if ((t < idle)); then phase=idle
    elif ((t < idle + load)); then phase=load
      ((loaded)) || { start_load "$load"; loaded=1; note "load: $LOAD_KIND"; }
    else phase=recovery; stop_load
    fi
    sample "$t" "$phase" >>"$csv"
    tc=$(tail -n1 "$csv" | cut -d, -f3)
    printf '\r    %4ds %-8s Tctl %5sC  fans %s  apu %sW   ' "$t" "$phase" "$tc" "$(tail -n1 "$csv" | cut -d, -f6-8)" "$(tail -n1 "$csv" | cut -d, -f9)"
    if [[ -n $tc ]] && awk -v x="$tc" 'BEGIN {exit !(x >= 100)}'; then
      stop_load; echo; note "Tctl reached ${tc}C: load stopped early (safety)"; break
    fi
    if [[ $(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1) -lt 15 ]]; then
      stop_load; echo; note "battery below 15%: stopped"; break
    fi
    on_ac && { stop_load; echo; note "charger connected during the run: stopped (the run is no longer on battery)"; break; }
    t=$((t + INTERVAL))
    local next=$((start + t))
    ((SECONDS < next)) && sleep $((next - SECONDS))
  done
  echo
  stop_load
}

summarize() { # csv table_text -> markdown summary
  python3 -I - "$1" "$2" "$INTERVAL" <<'PY'
import csv, statistics as st, sys, re
rows = list(csv.DictReader(open(sys.argv[1])))
table, interval = sys.argv[2], int(sys.argv[3])
f = lambda r, k: float(r[k]) if r.get(k) not in (None, "") else None
load = [r for r in rows if r["phase"] == "load"]
idle = [r for r in rows if r["phase"] == "idle"]
rec = [r for r in rows if r["phase"] == "recovery"]
def col(rs, k): return [v for v in (f(r, k) for r in rs) if v is not None]
def med(xs): return st.median(xs) if xs else float("nan")
out = []
if not load:
    print("No load samples recorded."); sys.exit()
tc = col(load, "tctl_c"); tail_n = max(1, int(120 / interval))
steady = med(tc[-tail_n:]); peak = max(tc) if tc else float("nan")
t_steady = next((float(r["t_s"]) - float(load[0]["t_s"]) for r in load if f(r, "tctl_c") is not None and f(r, "tctl_c") >= steady - 2), None)
fans = ["fan1_rpm", "fan2_rpm", "fan3_rpm"]
def fanmax(rs): return max([v for k in fans for v in col(rs, k)] or [0])
first_spin = next((r for r in load if any((f(r, k) or 0) > 0 for k in fans)), None)
mhz_first = med(col(load[: max(1, int(60 / interval))], "mhz_avg")); mhz_last = med(col(load[-tail_n:], "mhz_avg"))
w_first = med(col(load[: max(1, int(60 / interval))], "apu_w")); w_last = med(col(load[-tail_n:], "apu_w"))
drop = (1 - mhz_last / mhz_first) * 100 if mhz_first and mhz_first == mhz_first else 0
throttled = []
if peak >= 95: throttled.append(f"Tctl peaked at {peak:.1f} C (at or near the 95-100 C limit)")
if drop > 15: throttled.append(f"average clock fell {drop:.0f}% from the first minute ({mhz_first:.0f} -> {mhz_last:.0f} MHz) while APU power went {w_first:.1f} -> {w_last:.1f} W")
profiles = sorted({(r["asus_wmi"], r["amd_pmf"]) for r in rows})
out.append(f"- Idle before load: Tctl {med(col(idle, 'tctl_c')):.1f} C, fans max {fanmax(idle):.0f} rpm, battery draw {med(col(idle, 'batt_w')):.1f} W")
out.append(f"- Load: peak Tctl **{peak:.1f} C**, steady state (median of the last 2 min) **{steady:.1f} C**" + (f", within 2 C of it after {t_steady:.0f} s" if t_steady is not None else ""))
out.append(f"- APU power first minute {w_first:.1f} W, last 2 min {w_last:.1f} W; battery draw under load {med(col(load, 'batt_w')):.1f} W; clocks {mhz_first:.0f} -> {mhz_last:.0f} MHz")
out.append(f"- Throttled: **{'yes' if throttled else 'no'}**" + ("" if not throttled else " (" + "; ".join(throttled) + ")"))
if first_spin:
    out.append(f"- Fans: first spun up {float(first_spin['t_s']) - float(load[0]['t_s']):.0f} s into the load at Tctl {first_spin['tctl_c']} C; max {fanmax(load):.0f} rpm under load")
else:
    out.append(f"- Fans: stayed at 0 rpm for the whole load")
m = re.search(r"pwm1 \(enable=[^)]*\):((?: \d+C=\d+%)+)", table)
if m:
    pts = [(int(a), int(b)) for a, b in re.findall(r"(\d+)C=(\d+)%", m.group(1))]
    on = next((t for t, p in pts if p > 0), None)
    if on is not None and first_spin:
        spin_t = f(first_spin, "tctl_c")
        verdict = "consistent with" if spin_t is not None and spin_t >= on - 5 else "earlier than"
        out.append(f"- Against the quiet table: the CPU fan's first non-zero point is {on} C; the fans started at {spin_t} C ({verdict} the table)")
    elif on is not None:
        out.append(f"- Against the quiet table: the CPU fan's first non-zero point is {on} C; Tctl peaked at {peak:.1f} C" + (" without the fans starting (EC overrides the table?)" if peak >= on else ", below it"))
rt = col(rec, "tctl_c")
if rt:
    out.append(f"- Recovery: Tctl {rt[0]:.1f} -> {rt[-1]:.1f} C over {len(rt) * interval} s; fans at the end {', '.join(rec[-1][k] or '-' for k in fans)} rpm")
out.append(f"- Profiles seen (asus-wmi, amd-pmf): {', '.join('/'.join(p) for p in profiles)}; samples: {len(rows)} every {interval} s")
print("\n".join(out))
PY
}

downsample() { awk -F, -v step="$((30 / INTERVAL > 0 ? 30 / INTERVAL : 1))" 'NR==1 {print; next} (NR-2) % step == 0' "$1"; }

run_temps() {
  say "Temps (#42): $TEMPS_MIN min load on battery with the quiet fan table, $KREL"
  temps_preflight
  HW_K10=$(hwmon_by_name k10temp || true) HW_AMDGPU=$(hwmon_by_name amdgpu || true) HW_ASUS=$(hwmon_by_name asus || true)
  DGPU=$(dgpu_dir || true)
  [[ -n $HW_K10 ]] || die "no k10temp hwmon"
  [[ -n $HW_ASUS ]] || note "no asus hwmon: fan rpm will be empty"
  trap 'stop_load' EXIT
