#!/bin/bash
# Test the PR #8 kernel on the G16 after `deploy` and a reboot, then report.
#
#   recipes/linux-omarchy/g16-test/test [--hibernate] [--no-suspend] [--dock] [--yes]
#   recipes/linux-omarchy/g16-test/test --temps [MIN] [--interval S] [--recovery MIN] [--ab]
#   recipes/linux-omarchy/g16-test/test --resume-profile [--hibernates N]
#   recipes/linux-omarchy/g16-test/test --ec-table
#
# Default mode: one PASS/FAIL/WARN/SKIP line per check, with evidence:
#   kernel     uname and package versions
#   klog       oops/warnings, amdgpu, i2c, nvidia errors against deploy's baseline
#   0568       hid-asus Win-lock pass-through (asks you to press Fn+Super once)
#   0569       i2c-designware: touchpad IRQs per report (asks you to swipe for 10 s)
#   0807       asus-armoury GA605KM limits present and correct; PPT writes refused
#              without a custom fan curve (writes the current value back, no change)
#   0481       panel_power_savings exists, reads 0, nothing enables CACP
#   0810       a panel_power_savings write reaches the display firmware at once
#              (kprobe on dmub_cacp_set_level; level 1 for 3 s, then back to 0)
#   0773       gpiolib-acpi ignores GPIO 16 wakeups (the quirk, not a command-line option)
#   0570       GL9767 SD reader runtime PM (#226): with the slot empty it suspends and
#              stays suspended (under 10% active over 10 s); then a card cycle: seen
#              when inserted while suspended, suspended and settled again after
#              removal (the resume loop the first version had). Without the cycle
#              (declined, or no terminal) it is a WARN: removal untested
#   0482       amdgpu replays DMUB HPDs skipped during resume (#205): the module has it,
#              and no USB4 DP tunnel was torn down as "not active" this boot. With --dock
#              it walks you through #205's dock scenario (unplug the dock with the lid
#              closed, replug it while suspended, resume) and checks the monitors return
#   0809       amd_pmf hwmon: APU/dGPU/socket power read as numbers; reading leaves a
#              runtime-suspended RTX asleep; awake (nvidia-smi), dGPU within 25%
#              of NVML. Anything it can't establish is a FAIL, so the HOLD stays
#   suspend    one s2idle cycle (RTC wakes it after 30 s): at least 10 s of s0i3
#   hibernate  only with --hibernate: hibernate, power-off, resume (needs a button press)
#   9901       amdgpu.dcn35_s0i2 exists and is off; nothing sets it (the A/B is
#              g16-test/dcn35-s0i2-ab, #353)
#   9902       amdgpu.dm_idle_all_off exists and is off; nothing sets it (the test is
#              g16-test/dm-idle-all-off, with 9903's suspend idlemask trace, #353)
#   nvidia     module, dkms, nvidia-smi, runtime PM back to suspended
# --no-suspend skips the suspend cycle; --yes answers the yes/no prompts with yes
# (the Fn+Super and touchpad steps still wait for you). --dock adds the 0482 dock
# scenario (needs the USB4 dock with its DP monitors).
#
# --temps (#42): on battery with the quiet fan table (asus-wmi quiet, amd-pmf
# balanced), 1 min idle, MIN minutes (default 10) of all-core load (stress-ng, or
# busy loops), then --recovery minutes (default 3) of idle, sampling temperatures,
# fans, power, clocks and the platform profile every --interval seconds (default
# 5). --ab repeats the run with the balanced fan table for comparison.
#
# --resume-profile (#185): on battery with the quiet fan table, does the EC keep
# it across hibernate and s2idle, and does writing the profile again restore it?
# Each step settles 2 min at idle (fans, Tctl: median of the last 30 s), then
# runs 60 s of all-core load (peak Tctl, APU power), sampling every second:
# baseline; hibernate (up to N times, default 3, until the table is lost); write
# `quiet` again; if still lost, write `balanced` then `quiet`; one s2idle suspend,
# and the same writes if it lost the table too. Hibernate needs a power-button press.
# Each step also reads the fan table the EC really runs (FTBL, EC RAM 0x06:
# 0 balanced, 1 turbo, 2 silent) through ec_sys's read-only debugfs file. With
# 7.2.8-9.6 (0808) asus-wmi writes its profile back on every hibernate resume,
# so the EC must read silent after each one.
#
# --ec-table (#185): read only, no writes, no load, about 10 s. Prints the
# asus-wmi profile next to the EC's FTBL byte and the fan speeds, and says
# whether they agree. Run it whenever the fans seem to spin on a cool idle.
#
# All modes write a report without host or user names to
# ~/omarchy-asus-g16-test-<kernel>-<date>[-temps|-resume].md, show it, and offer to
# post it on PR #8 (default mode), issue #42 (--temps) or issue #185 (--resume-profile).
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "$0")")/lib.sh"

MODE=checks HIBERNATE=0 SUSPEND=1 DOCK=0 YES=0 TEMPS_MIN=10 INTERVAL=5 RECOVERY=3 AB=0 HIBERNATES=3
while (($#)); do
  case $1 in
    --temps) MODE=temps; if [[ ${2:-} =~ ^[0-9]+$ ]]; then TEMPS_MIN=$2; shift; fi ;;
    --temps=*) MODE=temps TEMPS_MIN=${1#--temps=} ;;
    --interval) INTERVAL=${2:?}; shift ;;
    --recovery) RECOVERY=${2:?}; shift ;;
    --ab) AB=1 ;;
    --resume-profile) MODE=resume ;;
    --ec-table) MODE=ectable ;;
    --hibernates) HIBERNATES=${2:?}; shift ;;
    --hibernate) HIBERNATE=1 ;;
    --no-suspend) SUSPEND=0 ;;
    --dock) DOCK=1 ;;
    --yes | -y) YES=1 ;;
    -h | --help) sed -n '2,52s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) die "unknown option $1 (see --help)" ;;
  esac
  shift
done
[[ ${G16_ROOT:-} != pkexec || $MODE == resume || $MODE == ectable ]] ||
  die "G16_ROOT=pkexec covers --resume-profile and --ec-table only; the other modes read root-only files with sudo"
for v in TEMPS_MIN INTERVAL RECOVERY HIBERNATES; do [[ ${!v} =~ ^[0-9]+$ && ${!v} -gt 0 ]] || die "$v must be a positive number"; done
((EUID != 0)) || die "run it as your normal user; it uses sudo where it must"
is_g16 || die "this is not a GA605; the kit is for the ROG Zephyrus G16 GA605 only"
have python3 || die "python3 is missing"

KREL=$(uname -r)
STAMP=$(date +%Y%m%d-%H%M)
BASE=$STATE_DIR/baseline.env
mkdir -p "$STATE_DIR"
KIT_REV=$(git -C "$KIT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)
INTERACTIVE=0; [[ -t 0 ]] && INTERACTIVE=1

ask() { # question -> 0 for yes
  local a
  ((YES)) && return 0
  ((INTERACTIVE)) || return 1
  read -r -p "$1 [Y/n] " a || return 1
  [[ -z $a || $a == [yY]* ]]
}

# ------------------------------------------------------------------ results
ROWS=() DETAILS=() NP=0 NF=0 NW=0 NS=0
result() { # status check summary [details...]
  local st=$1 name=$2 sum=$3 col
  shift 3
  case $st in
    PASS) col=$G NP=$((NP + 1)) ;;
    FAIL) col=$R NF=$((NF + 1)) ;;
    WARN) col=$Y NW=$((NW + 1)) ;;
    *) col=$D NS=$((NS + 1)) ;;
  esac
  printf '  %s%-4s%s  %-10s %s\n' "$col" "$st" "$N" "$name" "$sum"
  ROWS+=("| $name | **$st** | ${sum//|/\\|} |")
  if (($#)); then
    local body
    body=$(printf '%s\n' "$@")
    printf '%s\n' "$body" | sed 's/^/              /' | head -n 12
    DETAILS+=("#### $name ($st)"$'\n\n```\n'"$body"$'\n```\n')
  fi
}

sudo_up_front() {
  [[ ${G16_ROOT:-} == pkexec ]] && { note "root steps go through polkit (G16_ROOT=pkexec): one prompt each"; return; }
  say "Some checks need root: $*."
  note "Asking for the sudo password once; nothing is changed except where a check says so."
  sudo -v || note "no sudo: the checks that need root will report SKIP or FAIL with the reason"
}

write_report() { # file title intro
  local f=$1 title=$2 intro=$3 raw
  raw=$(mktemp)
  {
    printf '## %s\n\n' "$title"
    printf '%s\n\n' "$intro"
    if ((${#ROWS[@]})); then
      printf '**%d pass, %d fail, %d warn, %d skip**\n\n' "$NP" "$NF" "$NW" "$NS"
      printf '| Check | Result | Evidence |\n|---|---|---|\n'
      printf '%s\n' "${ROWS[@]}"
      printf '\n'
    fi
    if ((${#DETAILS[@]})); then
      printf '<details><summary>Details</summary>\n\n'
      printf '%s\n' "${DETAILS[@]}"
      printf '</details>\n\n'
    fi
    printf -- '---\nGenerated on the G16 by `recipes/linux-omarchy/g16-test/test` (kit %s). Host and user names are stripped.\n' "$KIT_REV"
  } >"$raw"
  redact <"$raw" >"$f"
  rm -f "$raw"
}

header_info() {
  printf -- '- Kernel: `%s` (expected `%s`)\n' "$KREL" "$EXPECT_KREL"
  printf -- '- Machine: %s / %s, BIOS %s\n' "$(dmi product_name)" "$(dmi board_name)" "$(dmi bios_version)"
  printf -- '- Date (UTC): %s\n' "$(date -u +%Y-%m-%dT%H:%MZ)"
  printf -- '- Power: %s, battery %s%%\n' "$(on_ac && echo AC || echo battery)" "$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1)"
  printf -- '- Profiles: asus-wmi %s, amd-pmf %s\n' "$(profile_of asus-wmi)" "$(profile_of amd-pmf)"
  if [[ -f $BASE ]]; then
    printf -- '- Baseline: `%s` (recorded by deploy %s)\n' "$(state_get "$BASE" krel)" "$(state_get "$BASE" date)"
  else
    printf -- '- Baseline: none (deploy did not record one)\n'
  fi
}

# =================================================================== checks
check_kernel() {
  local pk ph
  pk=$(pacman -Q linux-omarchy 2>/dev/null | cut -d' ' -f2)
  ph=$(pacman -Q linux-omarchy-headers 2>/dev/null | cut -d' ' -f2)
  if [[ $KREL == "$EXPECT_KREL" && $pk == "$EXPECT_VER" && $ph == "$EXPECT_VER" ]]; then
    result PASS kernel "running $KREL; linux-omarchy and headers $pk"
    return 0
  fi
  local prev
  prev=$(journalctl -k -b -1 -o cat --no-pager 2>/dev/null | head -n1)
  result FAIL kernel "running $KREL, not $EXPECT_KREL (installed: linux-omarchy ${pk:-none}, headers ${ph:-none})" \
    "previous boot: ${prev:-no journal}" \
    "$(journalctl -k -b -1 -p err -o short-monotonic --no-pager 2>/dev/null | tail -n 40)"
  return 1
}

check_klog() {
  local k now base new lines st=PASS sum=() det=()
  for k in oops amdgpu i2c nvidia hidasus armoury; do
    now=$(klog_lines "$k" | wc -l)
    base=$(state_get "$BASE" "klog_$k")
    sum+=("$k $now${base:+ (was $base)}")
    ((now == 0)) && continue
    lines=$(klog_lines "$k" | sed -E 's/^\[ *[0-9.]+\] //; s/^[^ ]+ +[^ ]+ kernel: //')
    if [[ -f $STATE_DIR/baseline-klog-$k.txt ]]; then
      new=$(grep -vxFf <(sed -E 's/^\[ *[0-9.]+\] //; s/^[^ ]+ +[^ ]+ kernel: //' "$STATE_DIR/baseline-klog-$k.txt") <<<"$lines" | sort | uniq -c | sort -rn | head -n 15)
    else
      new=$(sort <<<"$lines" | uniq -c | sort -rn | head -n 15)
    fi
    [[ -n $new ]] || continue
    det+=("[$k] lines not in the baseline:" "$new")
    if [[ $k == oops ]]; then st=FAIL; elif [[ $st == PASS ]]; then st=WARN; fi
  done
  result "$st" klog "$(IFS=,; echo "${sum[*]}"); err-level total $(state_get <(klog_counts) klog_err)" "${det[@]}"
}

check_winlock() {
  local mp node out before
  mp=$(modinfo -n hid_asus 2>/dev/null)
  if [[ $mp != /usr/lib/modules/$KREL/kernel/* && $mp != /lib/modules/$KREL/kernel/* ]]; then
    result FAIL 0568 "hid_asus is not the in-tree module of $KREL: ${mp:-not found}"
    return
  fi
  node=$(winlock_hidraw)
  [[ -n $node ]] || { result FAIL 0568 "no hidraw node of the N-Key keyboard (0b05:19b6) declares report 0x5D"; return; }
  ((INTERACTIVE)) || { result SKIP 0568 "in-tree hid_asus, $node present; key press needs a terminal"; return; }
  before=$(state_get "$BASE" winlock_state)
  local reader=(python3 -I -c '
import os, select, sys, time
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK)
end, seen = time.time() + 15, []
while time.time() < end:
    r, _, _ = select.select([fd], [], [], max(0, end - time.time()))
    if not r: break
    try: d = os.read(fd, 64)
    except BlockingIOError: continue
    if len(d) >= 4 and d[:3] == bytes([0x5D, 0xBF, 0x01]):
        seen.append(d[3]); print("report 5d bf 01 %02x -> Win-lock %s" % (d[3], "on" if d[3] else "off"), flush=True)
        if len(seen) >= 1: end = min(end, time.time() + 1.5)
print("seen=%d last=%s" % (len(seen), seen[-1] if seen else "-"))
' "$node")
  local try
  for try in 1 2; do
    printf '\n%s>>> Press Fn+Super ONCE now (15 s).%s\n' "$B" "$N"
    if [[ -r $node ]]; then out=$("${reader[@]}" 2>&1); else out=$(sudo -n "${reader[@]}" 2>&1); fi
    [[ $out == *"seen=0"* && $try == 1 ]] && { ask "No Win-lock report seen. Try once more?" && continue; }
    break
  done
  if [[ $out == *"seen=0"* ]]; then
    result FAIL 0568 "no 5D BF 01 report reached $node within 15 s of the prompt" "$out"
    return
  fi
  local last=${out##*last=}
  result PASS 0568 "Fn+Super report reached hidraw ($node): Win-lock $([[ $last == 0 ]] && echo off || echo on)" "$out" "baseline state: ${before:-unknown}"
  if [[ $last != 0 ]]; then
    if have g16-winlock && g16-winlock unlock >/dev/null 2>&1; then
      note "Win-lock was left on by the test: cleared it (g16-winlock unlock)"
    else
      printf '%sWin-lock is now ON (Super does nothing): press Fn+Super once more to clear it.%s\n' "$Y" "$N"
    fi
  fi
}

check_touchpad() {
  local ev a b rate irqs reports ratio base out
  ev=$(touchpad_event)
  [[ -n $ev ]] || { result FAIL 0569 "no touchpad input device in /proc/bus/input/devices"; return; }
  ((INTERACTIVE)) || { result SKIP 0569 "touchpad $ev present; the swipe needs a terminal"; return; }
  read -r -p $'\n'"${B}>>> Press Enter, then keep moving one finger on the touchpad for 10 s.${N} " _ || true
  a=$(dw_irq_counts)
  out=$(sudo -n python3 -I -c '
import os, select, struct, sys, time
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK)
end, n, buf = time.time() + 10, 0, b""
while time.time() < end:
    r, _, _ = select.select([fd], [], [], max(0, end - time.time()))
    if not r: continue
    try: buf += os.read(fd, 24 * 64)
    except BlockingIOError: continue
    while len(buf) >= 24:
        _, _, t, c, _ = struct.unpack("qqHHi", buf[:24]); buf = buf[24:]
        if t == 0 and c == 0: n += 1
print(n)
' "$ev" 2>&1)
  b=$(dw_irq_counts)
  rate=$(join <(sort <<<"$a") <(sort <<<"$b") | awk '{d=($3-$2); if (d>m) {m=d; irq=$1}} END {printf "%d %s", m, irq}')
  irqs=${rate% *}
  reports=${out//[!0-9]/}
  base=$(state_get "$BASE" touch_irq_rate)
  if [[ -z $reports ]]; then
    result SKIP 0569 "could not read $ev ($out)"
    return
  fi
  if ((reports == 0)); then
    result FAIL 0569 "touchpad sent no reports in 10 s (dead touchpad, or no finger on it); DesignWare IRQs $((irqs / 10))/s"
    return
  fi
  ratio=$(awk -v i="$irqs" -v r="$reports" 'BEGIN {printf "%.1f", i / r}')
  local tsum="$((reports / 10)) reports/s, $((irqs / 10)) IRQ/s on IRQ ${rate#* }, $ratio IRQs per report (stock about 52)${base:+; baseline $base IRQ/s}"
  if awk -v x="$ratio" 'BEGIN {exit !(x < 26)}'; then result PASS 0569 "$tsum"; else result WARN 0569 "$tsum: not clearly fewer IRQs than stock"; fi
}

check_armoury() {
  local exp a v mn mx cur st=PASS det=() ac
  if on_ac; then
    ac=AC exp=(ppt_pl1_spl=15-80 ppt_pl2_sppt=35-80 ppt_pl3_fppt=35-80 nv_dynamic_boost=5-15 nv_temp_target=75-87)
  else
    ac=DC exp=(ppt_pl1_spl=25-35 ppt_pl2_sppt=31-44 ppt_pl3_fppt=45-65 nv_temp_target=75-87)
  fi
  [[ -d $ARMOURY ]] || { result FAIL 0807 "$ARMOURY is missing (asus-armoury not loaded?)"; return; }
  local nomatch
  nomatch=$(klog | grep -c 'No matching power limits' || true)
  ((nomatch == 0)) || { st=FAIL; det+=("kernel log: No matching power limits found ($nomatch)"); }
  for e in "${exp[@]}"; do
    a=${e%%=*}
    v=$(armoury_read "$a")
    det+=("$a: $v (expected ${e#*=} on $ac)")
    mn=${v%%-*} mx=${v#*-} mx=${mx%% *}
    [[ "$mn-$mx" == "${e#*=}" ]] || st=FAIL
  done
  [[ $ac == DC ]] && det+=("nv_dynamic_boost: $(armoury_read nv_dynamic_boost) (no DC range in the entry)")
  if [[ -d $ARMOURY/nv_tgp ]]; then st=FAIL; det+=("nv_tgp is present (should be hidden)"); else det+=("nv_tgp: absent, as intended"); fi
  # The fan-curve gate: write the current value back (no change if accepted).
  local fc pe out
  fc=$(hwmon_by_name asus_custom_fan_curve || true)
  pe=$(cat "$fc/pwm1_enable" 2>/dev/null || echo '?')
  cur=$(cat "$ARMOURY/ppt_pl1_spl/current_value" 2>/dev/null || true)
  if [[ $pe == 1 ]]; then
    det+=("PPT gate: skipped, the CPU custom fan curve is on (pwm1_enable=1)")
  elif [[ $cur =~ ^[0-9]+$ ]]; then
    printf '%s[sudo]%s write the current SPL (%s W) back to ppt_pl1_spl: expect EBUSY, no change either way\n' "$Y" "$N" "$cur"
    out=$(printf '%s\n' "$cur" | sudo -n tee "$ARMOURY/ppt_pl1_spl/current_value" 2>&1 >/dev/null)
    if [[ $out == *"busy"* ]]; then
      det+=("PPT gate: writing the current SPL ($cur) back with pwm1_enable=$pe -> EBUSY, as intended")
    else
      st=FAIL; det+=("PPT gate: write of the current SPL ($cur) with pwm1_enable=$pe was not refused: ${out:-accepted}")
    fi
  else
    det+=("PPT gate: skipped, ppt_pl1_spl current_value unreadable: ${cur:-empty}")
  fi
  local base
  base=$(state_get "$BASE" armoury_ppt_pl1_spl)
  [[ -n $base ]] && det+=("baseline ppt_pl1_spl: $base")
  result "$st" 0807 "GA605KM limits on $ac $([[ $st == PASS ]] && echo 'present and correct' || echo 'wrong or missing'); nv_tgp hidden; PPT writes gated by the fan curve" "${det[@]}"
}

check_panel() {
  local p v st=PASS det=() hits
  p=$(panel_power_path)
  [[ -n $p ]] || { result FAIL 0481 "no card*-eDP-*/amdgpu/panel_power_savings (CACP backport not active on the OLED)"; return; }
  v=$(cat "$p" 2>&1)
  det+=("$p = $v (baseline: $(state_get "$BASE" panel_power_savings || true))")
  [[ $v == 0 ]] || { st=FAIL; det+=("expected 0 at boot"); }
  grep -q 'amdgpu.abmlevel' /proc/cmdline && { st=FAIL; det+=("kernel command line sets amdgpu.abmlevel"); }
  hits=$(grep -rls 'panel_power_savings' /etc/udev/rules.d /usr/lib/udev/rules.d /etc/tmpfiles.d /usr/lib/tmpfiles.d /etc/systemd/system 2>/dev/null)
  [[ -z $hits ]] || { st=FAIL; det+=("files that write it: $hits"); }
  if have powerprofilesctl && powerprofilesctl list-actions 2>/dev/null | grep -q amdgpu_panel_power; then
    det+=("power-profiles-daemon lists its amdgpu_panel_power action; on the G16 it left the value at 0 on battery and in power-saver (#46). Rerun this on battery to see the value there")
  fi
  result "$st" 0481 "panel_power_savings exists and reads $v; nothing in the config enables CACP" "${det[@]}"
}

# 0810: the level must reach DMUB when it is written, not at the next modeset.
# A kprobe on dmub_cacp_set_level (0481) records the level sent; level 1 is held
# for 3 s (a slight contrast change), then 0 is written back. A check that cannot
# run is a FAIL, not a SKIP: the PR's gate is this check passing.
check_cacp_apply() {
  local p out st det=()
  p=$(panel_power_path)
  [[ -n $p ]] || { result FAIL 0810 "could not run: no panel_power_savings (see 0481)"; return; }
  [[ $(cat "$p" 2>/dev/null) == 0 ]] || { result FAIL 0810 "could not run: panel_power_savings is not 0; write 0 to it and run the test again"; return; }
  printf '%s[sudo]%s panel_power_savings 1 for 3 s, then 0, watching dmub_cacp_set_level\n' "$Y" "$N"
  out=$(sudo -n bash -s "$p" 2>&1 <<'ROOT'
p=$1 T=/sys/kernel/tracing
[[ -d $T/instances ]] || T=/sys/kernel/debug/tracing
I=$T/instances/g16cacp
cleanup() { echo 0 >"$p" 2>/dev/null; [[ -d $I ]] && { echo 0 >"$I/events/g16cacp/enable" 2>/dev/null; rmdir "$I" 2>/dev/null; }; echo '-:g16cacp/set' >>"$T/kprobe_events" 2>/dev/null; }
trap cleanup EXIT
echo 'p:g16cacp/set dmub_cacp_set_level level=%si:u32' >>"$T/kprobe_events" 2>/dev/null || { echo "kprobe: dmub_cacp_set_level not probeable"; exit 3; }
mkdir "$I" 2>/dev/null || { echo "kprobe: no trace instance"; exit 3; }
echo 1 >"$I/events/g16cacp/set/enable"
echo 1 >"$p"; sleep 3
echo "after write 1: $(grep -c 'level=1' "$I/trace")"
echo 0 >"$p"; sleep 1
echo "after write 0: $(grep -o 'level=[0-9]*' "$I/trace" | sort | uniq -c | tr -s ' ' | paste -sd, -)"
ROOT
)
  case $? in
    0) ;;
    3) result FAIL 0810 "could not run: ${out:-kprobe unavailable}" "the 0810 gate needs this check to PASS"; return ;;
    *) result FAIL 0810 "could not run (no sudo, or the probe failed): ${out:-?}" "the 0810 gate needs this check to PASS"; return ;;
  esac
  det+=("$out" "panel_power_savings now: $(cat "$p" 2>&1)")
  if [[ $out =~ after\ write\ 1:\ ([0-9]+) ]] && ((BASH_REMATCH[1] > 0)); then st=PASS
  else st=FAIL; det+=("level 1 never reached dmub_cacp_set_level: the write waits for the next modeset (the bug 0810 fixes)"); fi
  result "$st" 0810 "panel_power_savings write $([[ $st == PASS ]] && echo 'reached the firmware at once' || echo 'did not reach the firmware')" "${det[@]}"
}

# 0773: the DMI quirk logs this at boot. The G16 carried the same as a kernel
# command-line option before (#151); with that still set the check proves nothing.
check_gpio16() {
  local st=PASS det=() msg
  if grep -q 'gpiolib_acpi.ignore_wake' /proc/cmdline; then
    st=WARN
    det+=("the kernel command line still sets gpiolib_acpi.ignore_wake: remove that drop-in and reboot, so the quirk is what is tested")
  fi
  msg=$(journalctl -k -b -o cat --no-pager 2>/dev/null | grep -m1 'Ignoring wakeup on pin 16')
  [[ -n $msg ]] || { result FAIL 0773 "no 'Ignoring wakeup on pin 16' in this boot's kernel log" "${det[@]}"; return; }
  det+=("$msg")
  result "$st" 0773 "GPIO 16 wakeups ignored (AMDI0030:00@16); suspend with HDMI connected should now sleep" "${det[@]}"
}

# 0570 (#226): the GL9767 reader (Genesys 17a0:9767) runtime-suspends with the slot empty.
sd_dir() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ $(<"$d/vendor") == 0x17a0 && $(<"$d/device") == 0x9767 ]] 2>/dev/null && { echo "$d"; return; }
  done
}
sd_card() { compgen -G '/sys/class/mmc_host/mmc*/mmc*:*' >/dev/null; }
sd_state() { echo "$(<"$1/power/runtime_status") $(<"$1/power_state" 2>/dev/null) control=$(<"$1/power/control")"; }
sd_settled() { # dir label -> 0 when suspended within 10 s and under 10% active for the next 10 s
  local d=$1 i a0 a1
  for ((i = 0; i < 20; i++)); do [[ $(<"$d/power/runtime_status") == suspended ]] && break; sleep 0.5; done
  a0=$(<"$d/power/runtime_active_time")
  sleep 10
  a1=$(<"$d/power/runtime_active_time")
  det+=("$2: $(sd_state "$d"), active $((a1 - a0)) ms of 10000")
  [[ $(<"$d/power/runtime_status") == suspended ]] && ((a1 - a0 < 1000))
}
check_sdreader() {
  local st=PASS det=() d i msg cycled=0
  d=$(sd_dir)
  [[ -n $d ]] || { result SKIP 0570 "no GL9767 SD reader on the PCI bus"; return; }
  if sd_card; then
    result SKIP 0570 "a card is in the SD reader: take it out and run the test again"
    return
  fi
  det+=("reader ${d##*/}: $(sd_state "$d")")
  [[ $(<"$d/power/control") == auto ]] || { result FAIL 0570 "runtime PM not allowed (power/control is not auto)" "${det[@]}"; return; }
  sd_settled "$d" "slot empty" || st=FAIL
  if [[ $st == PASS ]] && ((INTERACTIVE)) && ask "Cycle an SD card through the reader (insert, then remove)?"; then
    cycled=1
    read -r -p "    Insert an SD card, then press Enter... " _
    for ((i = 0; i < 10; i++)); do [[ -e /dev/mmcblk0 ]] && break; sleep 0.5; done
    if [[ -e /dev/mmcblk0 ]]; then det+=("card seen: $(lsblk -dno NAME,SIZE /dev/mmcblk0)")
    else st=FAIL; det+=("no /dev/mmcblk0 within 5 s of inserting a card while suspended"); fi
    read -r -p "    Remove the card, then press Enter... " _
    sleep 2
    sd_settled "$d" "after removal" || { st=FAIL; det+=("the reader does not settle in runtime suspend after the card is removed"); }
  fi
  msg=$(journalctl -k -b -o cat --no-pager 2>/dev/null | grep -m1 'times in a row with no card')
  [[ -z $msg ]] || { st=FAIL; det+=("$msg"); }
  # The empty slot passed with the first version too; only the card cycle tests the fix.
  if [[ $st == PASS ]] && ((!cycled)); then
    st=WARN
    det+=("card removal untested (no card cycle): run the test again at the G16 with an SD card")
  fi
  case $st in
    PASS) msg='runtime-suspends with the slot empty and settles again after a card is removed' ;;
    WARN) msg='runtime-suspends with the slot empty; card removal untested' ;;
    *) msg='does not stay runtime-suspended' ;;
  esac
  result "$st" 0570 "SD reader $msg" "${det[@]}"
}

# 0482 (#205): DP connectors of the amdgpu card, one "name status [link_settings]"
# line each. link_settings (debugfs, root) shows Current vs Verified link rates.
dp_links() {
  local c dev pci ls
  for c in /sys/class/drm/card*-DP-*; do
    [[ -e $c/status ]] || continue
    dev=$(readlink -f "${c%-DP-*}/device")
    [[ $(basename "$(readlink "$dev/driver" 2>/dev/null)") == amdgpu ]] || continue
    pci=${dev##*/}
    ls=$(root_read cat "/sys/kernel/debug/dri/$pci/DP-${c##*-DP-}/link_settings" | tr -s ' \n' ' ')
    printf '%s %s%s\n' "${c##*/}" "$(cat "$c/status")" "${ls:+ [$ls]}"
  done
}

# A connected link trained below its verified rate is #205's second failure
# (RBR after resume); 0482 does not address it, so it is a WARN with the evidence.
dp_low_rate() {
  local l cur ver
  while read -r l; do
    [[ $l == *" connected "* ]] || continue
    cur=$(sed -n 's/.*Current: *[0-9]* *\(0x[0-9a-fA-F]*\).*/\1/p' <<<"$l")
    ver=$(sed -n 's/.*Verified: *[0-9]* *\(0x[0-9a-fA-F]*\).*/\1/p' <<<"$l")
    [[ -n $cur && -n $ver ]] && ((cur > 0 && cur < ver)) && printf '%s\n' "${l%% *}"
  done
}

check_dock() {
  local f n st=PASS det=() since s0 s1 teardown skipped replayed links before n0 n1 low
  f=$(modinfo -F filename amdgpu 2>/dev/null)
  # grep -c reads the whole stream: with -q the decompressor dies on the closed
  # pipe and pipefail turns a match into a failure
  case $f in
    *.zst) have zstdcat && n=$(zstdcat "$f" 2>/dev/null | grep -ac 'Replay DMUB HPD skipped') ;;
    *.xz) n=$(xzcat "$f" 2>/dev/null | grep -ac 'Replay DMUB HPD skipped') ;;
    ?*) n=$(grep -ac 'Replay DMUB HPD skipped' "$f") ;;
  esac
  ((${n:-0} > 0)) || { result FAIL 0482 "the amdgpu module (${f:-not found}) has no HPD replay: not this kernel's build?"; return; }
  det+=("amdgpu module: ${f##*/} has the HPD replay")
  teardown=$(journalctl -k -b -o cat --no-pager 2>/dev/null | grep -E '\(DP\): not active, tearing down')
  [[ -z $teardown ]] || { st=FAIL; det+=("DP tunnels torn down as not active earlier in this boot:" "$teardown"); }
  if ((!DOCK)); then
    det+=("dock scenario not run (--dock)" "DP connectors now:" "$(dp_links)")
    result "$st" 0482 "module has the HPD replay; $([[ $st == PASS ]] && echo 'no DP tunnel torn down this boot' || echo 'a DP tunnel was torn down this boot'); dock scenario: --dock" "${det[@]}"
    return
  fi
  ((INTERACTIVE)) || { result SKIP 0482 "--dock needs a terminal to wait for you" "${det[@]}"; return; }
  printf '\n%s0482 dock scenario (#205).%s Have the G16 on the USB4 dock with its DP monitors on\n' "$B" "$N"
  printf 'and lit. Then: close the lid, unplug the dock, wait until the laptop has suspended,\n'
  printf 'plug the dock back in, open the lid and unlock. Come back here and press Enter.\n'
  ask "Ready (dock connected, monitors lit)?" || { result SKIP 0482 "declined" "${det[@]}"; return; }
  # Connector names can change across a dock replug, so compare how many are connected.
  before=$(dp_links) n0=$(grep -c ' connected' <<<"$before")
  ((n0 > 0)) || { result SKIP 0482 "no DP connector is connected: dock the G16 with its monitors on first" "${det[@]}"; return; }
  since=$(date '+%Y-%m-%d %H:%M:%S') s0=$(cat /sys/power/suspend_stats/success)
  read -r -p "Press Enter after the resume, with the lid open and the session unlocked... " _ || true
  note "waiting 20 s: a failed DP tunnel is torn down 12 s after it is set up"
  sleep 20
  s1=$(cat /sys/power/suspend_stats/success)
  skipped=$(journalctl -k --since "$since" -o cat --no-pager 2>/dev/null | grep -c 'Skip DMUB HPD IRQ callback')
  replayed=$(journalctl -k --since "$since" -o cat --no-pager 2>/dev/null | grep 'Replay DMUB HPD skipped')
  teardown=$(journalctl -k --since "$since" -o cat --no-pager 2>/dev/null | grep -E '\(DP\): not active, tearing down')
  links=$(dp_links) n1=$(grep -c ' connected' <<<"$links")
  low=$(dp_low_rate <<<"$links")
  det+=("suspend_stats success $s0 -> $s1" "HPDs skipped during the resume: $skipped" "replayed:" "${replayed:-none}"
    "DP connectors before ($n0 connected):" "$before" "DP connectors after the resume ($n1 connected):" "$links")
  if ((s1 == s0)); then
    result FAIL 0482 "no suspend happened between the prompts (did logind suspend after the unplug?)" "${det[@]}"
  elif [[ -n $teardown ]]; then
    result FAIL 0482 "DP tunnels torn down as not active after the resume (#205 not fixed)" "${det[@]}" "$teardown"
  elif ((n1 < n0)); then
    result FAIL 0482 "only $n1 of $n0 DP monitors came back connected after the resume" "${det[@]}"
  elif [[ -n $low ]]; then
    result WARN 0482 "monitors back; link below its verified rate on: ${low//$'\n'/ } (#205 failure 2, not covered by 0482)" "${det[@]}"
  else
    result "$st" 0482 "all $n0 DP monitors back after the dock was replugged in suspend; $skipped HPD(s) skipped, $(grep -c . <<<"$replayed") replayed" "${det[@]}"
  fi
}

# 0809 (#238): amd_pmf's hwmon. Read only power*_input under it, never `sensors`
# (which reads the RTX's own hwmon too, and that wakes it).
pmf_hwmon_dir() {
  local h
  for h in /sys/class/hwmon/hwmon*; do
    [[ $(cat "$h/name" 2>/dev/null) == amd_pmf ]] && { printf '%s\n' "$h"; return 0; }
  done
  return 1
}
pmf_watts() { # hwmon dir -> "APU x W, dGPU y W, socket z W"
  local i out=''
  for i in 1 2 3; do
    out+="$(cat "$1/power${i}_label" 2>/dev/null) $(awk '{printf "%.2f", $1 / 1e6}' "$1/power${i}_input" 2>/dev/null) W, "
  done
  printf '%s\n' "${out%, }"
}

check_pmf_hwmon() {
  local h d rs0 rs1 st=PASS det=() i v w smi pm nm sp at0 at1
  pmf_fail() { st=FAIL; det+=("$1"); }
  h=$(pmf_hwmon_dir) || { result FAIL 0809 "no amd_pmf hwmon device (is amd_pmf loaded? amd_pmf.hwmon_support=0 on the command line?)"; return; }
  d=$(dgpu_dir) || { result FAIL 0809 "no NVIDIA GPU on the PCI bus"; return; }
  # Asleep: all three channels read as numbers, and reading leaves the RTX in D3cold.
  for ((i = 0; i < 60; i++)); do
    rs0=$(cat "$d/power/runtime_status" 2>/dev/null)
    [[ $rs0 == suspended ]] && break
    sleep 1
  done
  det+=("hwmon: ${h##*/}" "RTX runtime_status before reading: $rs0 (waited ${i}s)")
  # runtime_active_time only grows while the RTX is awake, so a wake that is
  # already over by the second status read still shows here.
  at0=$(cat "$d/power/runtime_active_time" 2>/dev/null)
  for i in 1 2 3; do
    v=$(cat "$h/power${i}_input" 2>/dev/null)
    [[ $v =~ ^[0-9]+$ ]] || pmf_fail "power${i}_input ($(cat "$h/power${i}_label" 2>/dev/null)) did not read as a number: '${v}'"
  done
  w=$(pmf_watts "$h")
  v=$(cat "$h/power2_input" 2>/dev/null)
  sleep 2
  rs1=$(cat "$d/power/runtime_status" 2>/dev/null)
  at1=$(cat "$d/power/runtime_active_time" 2>/dev/null)
  det+=("asleep read: $w" "RTX runtime_status 2 s after reading: $rs1, runtime_active_time ${at0:-?} -> ${at1:-?} ms")
  if [[ $rs0 == suspended ]]; then
    [[ $rs1 == suspended ]] || pmf_fail "reading amd_pmf's hwmon woke the RTX"
    [[ $at0 =~ ^[0-9]+$ && $at1 =~ ^[0-9]+$ ]] || pmf_fail "runtime_active_time unreadable, so a short wake can't be ruled out"
    [[ $at0 =~ ^[0-9]+$ && $at1 =~ ^[0-9]+$ ]] && ((at1 > at0)) && pmf_fail "the RTX was awake for $((at1 - at0)) ms during the reads"
    [[ $v =~ ^[0-9]+$ ]] && ((v > 500000)) && pmf_fail "dGPU reads over 0.5 W while the RTX is in D3cold"
  else
    pmf_fail "the RTX never runtime-suspended in 60 s, so the asleep reading is untested"
  fi
  # Awake: nvidia-smi wakes the RTX on purpose; amd_pmf's dGPU figure must track NVML.
  if have nvidia-smi; then
    smi=$(mktemp)
    timeout 15 nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits -lms 1000 >"$smi" 2>/dev/null &
    sp=$!
    sleep 4
    pm=0
    for ((i = 0; i < 8; i++)); do
      v=$(cat "$h/power2_input" 2>/dev/null)
      if [[ $v =~ ^[0-9]+$ ]]; then pm=$((pm + v)); else pmf_fail "awake read $((i + 1)) of power2_input failed: '${v}'"; fi
      sleep 1
    done
    wait "$sp"
    pm=$(awk -v s="$pm" 'BEGIN {printf "%.2f", s / 8 / 1e6}')
    nm=$(awk '$1 + 0 > 0 {s += $1; c++} END {if (c) printf "%.2f", s / c}' "$smi")
    rm -f "$smi"
    det+=("awake: amd_pmf dGPU mean $pm W, NVML power.draw mean ${nm:-?} W")
    if [[ -z $nm ]]; then
      pmf_fail "nvidia-smi gave no power.draw, so the awake reading is unchecked"
    elif awk -v p="$pm" 'BEGIN {exit !(p < 0.5)}'; then
      pmf_fail "dgpu_power is not populated: about 0 W with the RTX awake (NVML $nm W)"
    elif ! awk -v p="$pm" -v n="$nm" 'BEGIN {d = p - n; if (d < 0) d = -d; exit !(d / n <= 0.25)}'; then
      pmf_fail "dGPU reading is more than 25% from NVML"
    fi
  else
    pmf_fail "no nvidia-smi: the awake reading is unchecked"
  fi
  result "$st" 0809 "amd_pmf hwmon: $w; RTX $rs0 -> $rs1; awake dGPU ${pm:-?} W vs NVML ${nm:-?} W" "${det[@]}"
}

check_dcn35_s0i2() {
  local p=/sys/module/amdgpu/parameters/dcn35_s0i2 v st=PASS det=() hits
  grep -q 'dcn35_s0i2' /proc/cmdline && { st=FAIL; det+=("kernel command line sets amdgpu.dcn35_s0i2"); }
  hits=$(grep -rls 'dcn35_s0i2' /etc/modprobe.d /usr/lib/modprobe.d /etc/udev/rules.d /usr/lib/udev/rules.d /etc/tmpfiles.d /usr/lib/tmpfiles.d 2>/dev/null)
  [[ -z $hits ]] || { st=FAIL; det+=("files that set it: $hits"); }
  if ! v=$(cat "$p" 2>/dev/null); then
    result FAIL 9901 "no $p: this kernel lacks patch 9901" "${det[@]}"
    return
  fi
  [[ $v == N ]] || st=FAIL
  result "$st" 9901 "amdgpu.dcn35_s0i2 reads $v (default N)" "${det[@]}"
}

check_dm_idle_all_off() {
  local p=/sys/module/amdgpu/parameters/dm_idle_all_off v st=PASS det=() hits
  grep -q 'dm_idle_all_off' /proc/cmdline && { st=FAIL; det+=("kernel command line sets amdgpu.dm_idle_all_off"); }
  hits=$(grep -rls 'dm_idle_all_off' /etc/modprobe.d /usr/lib/modprobe.d /etc/udev/rules.d /usr/lib/udev/rules.d /etc/tmpfiles.d /usr/lib/tmpfiles.d 2>/dev/null)
  [[ -z $hits ]] || { st=FAIL; det+=("files that set it: $hits"); }
