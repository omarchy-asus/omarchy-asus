From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: omarchy-asus <noreply@github.com>
Date: Sun, 25 Oct 2026 00:00:00 -0400
Subject: [PATCH] EXPERIMENTAL: drm/amd/display: dcn35: tell the SMU the
 display is S0i2-ready (default off)

EXPERIMENTAL, DEFAULT-OFF (local carry for ROG Zephyrus G16 GA605KM idle
power testing; not submitted upstream).

When the active display count drops to 0, DCN 3.1/3.14/3.15/3.16 send
SetDisplayIdleOptimizations with df_request_disabled, phy_ref_clk_off and
s0i2_rdy set before moving the clock manager to DCN_PWR_STATE_LOW_POWER,
and DCN 4.2 does the same in its set_low_power_state. DCN 3.5/3.5.1 move
to DCN_PWR_STATE_LOW_POWER without sending anything: the only
SetDisplayIdleOptimizations they send is the 0 on the way back to mission
mode, and dcn35_smu_enable_phy_refclk_pwrdwn() has no caller. The SMU
then never learns that the display is idle, so the SoC cannot use its
display-idle and IPS2 states even with every display off.

Add amdgpu.dcn35_s0i2 (bool, 0644, default 0). When it is set,
dcn35_update_clocks() (safe_to_lower) and dcn35_set_low_power_state()
send the same three flags DCN 3.1 sends on the transition to low power.
The existing path back to mission mode already clears them with 0. The
parameter is read on every transition, so it can be toggled at runtime;
it takes effect from the next time the displays go off.

With the parameter at 0 the driver takes the stock path.

Tracked in omarchy-asus #353 (refs #249).
---
--- a/drivers/gpu/drm/amd/display/dc/clk_mgr/dcn35/dcn35_clk_mgr.c
+++ b/drivers/gpu/drm/amd/display/dc/clk_mgr/dcn35/dcn35_clk_mgr.c
@@ -47,6 +47,31 @@
 #include "link_service.h"
 #include "logger_types.h"
 
+#include <linux/moduleparam.h>
+
+/*
+ * EXPERIMENTAL: when no display is active, tell the SMU the display is idle
+ * and ready for S0i2, as DCN 3.1 does. Read on every transition to low power,
+ * so it can be changed at runtime. Default off.
+ */
+static bool dcn35_s0i2;
+module_param(dcn35_s0i2, bool, 0644);
+MODULE_PARM_DESC(dcn35_s0i2,
+	"EXPERIMENTAL: send S0i2-ready display idle optimizations to the SMU with no active display (0 = off (default), 1 = on)");
+
+static void dcn35_notify_display_idle(struct clk_mgr_internal *clk_mgr)
+{
+	union display_idle_optimization_u idle_info = { 0 };
+
+	if (!READ_ONCE(dcn35_s0i2))
+		return;
+
+	idle_info.idle_info.df_request_disabled = 1;
+	idle_info.idle_info.phy_ref_clk_off = 1;
+	idle_info.idle_info.s0i2_rdy = 1;
+	dcn35_smu_set_display_idle_optimization(clk_mgr, idle_info.data);
+}
+
 #undef DC_LOGGER
 #define DC_LOGGER \
 	clk_mgr->base.base.ctx->logger
@@ -432,8 +457,10 @@
 		/* check that we're not already in lower */
 		if (clk_mgr_base->clks.pwr_state != DCN_PWR_STATE_LOW_POWER) {
 			/* if we can go lower, go lower */
-			if (display_count == 0)
+			if (display_count == 0) {
+				dcn35_notify_display_idle(clk_mgr);
 				clk_mgr_base->clks.pwr_state = DCN_PWR_STATE_LOW_POWER;
+			}
 		}
 	} else {
 		if (new_clocks->zstate_support == DCN_ZSTATE_SUPPORT_DISALLOW &&
@@ -1219,8 +1246,10 @@
 	if (clk_mgr_base->clks.pwr_state != DCN_PWR_STATE_LOW_POWER) {
 		display_count = dcn35_get_active_display_cnt_wa(dc, context, NULL);
 		/* if we can go lower, go lower */
-		if (display_count == 0)
+		if (display_count == 0) {
+			dcn35_notify_display_idle(TO_CLK_MGR_INTERNAL(clk_mgr_base));
 			clk_mgr_base->clks.pwr_state = DCN_PWR_STATE_LOW_POWER;
+		}
 	}
 }
 
