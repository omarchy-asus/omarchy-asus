@@ -146,6 +149,7 @@ static struct cmn2asic_msg_mapping smu_v14_0_0_message_map[SMU_MSG_MAX_COUNT] =
 	MSG_MAP(SetSoftMinVpe,                  PPSMC_MSG_SetSoftMinVpe,			1),
 	MSG_MAP(MALLPowerController,            PPSMC_MSG_MALLPowerController,		1),
 	MSG_MAP(MALLPowerState,                 PPSMC_MSG_MALLPowerState,			1),
+	MSG_MAP(AllowZstates,                   PPSMC_MSG_AllowZstates,			1),
 };
 
 static struct cmn2asic_mapping smu_v14_0_0_feature_mask_map[SMU_FEATURE_COUNT] = {
@@ -1796,6 +1800,66 @@ static void smu_v14_0_0_init_msg_ctl(struct smu_context *smu)
 	ctl->message_map = smu_v14_0_0_message_map;
 }
 
+/*
+ * EXPERIMENTAL: amdgpu_smu_allow_zstates (debugfs, root, write-only).
+ *
+ * Writing 0, 8 or 9 sends the driver-mailbox message AllowZstates
+ * (PPSMC_MSG_AllowZstates, 0x25) with that argument: 0 disallows
+ * Z-states, 8 allows Z8, 9 allows Z9 and Z8 (ZStates_e). Nothing is sent
+ * unless the file is written; the driver never sends this message on its
+ * own. Each write is logged with the result and the argument register the
+ * SMU leaves behind.
+ */
+#if defined(CONFIG_DEBUG_FS)
+static ssize_t smu_v14_0_0_allow_zstates_write(struct file *filp,
+					       const char __user *ubuf,
+					       size_t size, loff_t *pos)
+{
+	struct smu_context *smu = file_inode(filp)->i_private;
+	struct amdgpu_device *adev = smu->adev;
+	u32 arg, read_arg = 0;
+	int ret;
+
+	ret = kstrtou32_from_user(ubuf, size, 0, &arg);
+	if (ret)
+		return ret;
+	if (arg != DISALLOW_ZSTATES && arg != ALLOW_ZSTATES_Z8 &&
+	    arg != ALLOW_ZSTATES_Z9)
+		return -EINVAL;
+	if (!smu->pm_enabled || amdgpu_in_reset(adev) || adev->in_suspend)
+		return -EBUSY;
+
+	ret = pm_runtime_resume_and_get(adev->dev);
+	if (ret < 0)
+		return ret;
+	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_AllowZstates, arg,
+					      &read_arg);
+	pm_runtime_put_autosuspend(adev->dev);
+
+	dev_info(adev->dev,
+		 "EXPERIMENTAL: SMU AllowZstates(%u) sent: %d, arg register 0x%08x\n",
+		 arg, ret, read_arg);
+
+	return ret ? ret : size;
+}
+
+static const struct file_operations smu_v14_0_0_allow_zstates_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = smu_v14_0_0_allow_zstates_write,
+	.llseek = default_llseek,
+};
+#endif
+
+void smu_v14_0_0_allow_zstates_debugfs_init(struct smu_context *smu)
+{
+#if defined(CONFIG_DEBUG_FS)
+	debugfs_create_file("amdgpu_smu_allow_zstates", 0200,
+			    adev_to_drm(smu->adev)->primary->debugfs_root,
+			    smu, &smu_v14_0_0_allow_zstates_fops);
+#endif
+}
+
 void smu_v14_0_0_set_ppt_funcs(struct smu_context *smu)
 {
 	struct amdgpu_device *adev = smu->adev;
diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_0_ppt.h b/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_0_ppt.h
index 93e645ee3..c023b4e87 100644
--- a/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_0_ppt.h
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_0_ppt.h
@@ -24,5 +24,6 @@
 #define __SMU_V14_0_0_PPT_H__
 
 extern void smu_v14_0_0_set_ppt_funcs(struct smu_context *smu);
+void smu_v14_0_0_allow_zstates_debugfs_init(struct smu_context *smu);
 
