+/* EXPERIMENTAL: see smu_v14_0_0_allow_zstates_debugfs_init() */
+void amdgpu_smu_allow_zstates_debug_fs_init(struct amdgpu_device *adev)
+{
+	struct smu_context *smu = adev->powerplay.pp_handle;
+
+	if (!smu)
+		return;
+
+	switch (amdgpu_ip_version(adev, MP1_HWIP, 0)) {
+	case IP_VERSION(14, 0, 0):
+	case IP_VERSION(14, 0, 1):
+	case IP_VERSION(14, 0, 4):
+	case IP_VERSION(14, 0, 5):
+		smu_v14_0_0_allow_zstates_debugfs_init(smu);
+		break;
+	default:
+		break;
+	}
+}
