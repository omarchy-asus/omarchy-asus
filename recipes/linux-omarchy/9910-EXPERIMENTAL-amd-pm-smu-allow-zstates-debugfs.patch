 drivers/gpu/drm/amd/pm/swsmu/inc/amdgpu_smu.h |  1 +
 .../drm/amd/pm/swsmu/smu14/smu_v14_0_0_ppt.c  | 64 +++++++++++++++++++
 .../drm/amd/pm/swsmu/smu14/smu_v14_0_0_ppt.h  |  1 +
 5 files changed, 87 insertions(+)

