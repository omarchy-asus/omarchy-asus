+DEFINE_STATIC_KEY_FALSE(amd_wlc_track);
+DEFINE_STATIC_KEY_FALSE(amd_wlc_steer);
+
+/*
+ * Debounce: a new class becomes the task's class only after two
+ * consecutive switch-outs report it.
+ */
+static __always_inline void amd_wlc_consume(struct task_struct *prev)
+{
+	u64 val;
+	u8 cls;
+
+	rdmsrq(MSR_AMD_WORKLOAD_CLASS_ID, val);
+	if (!(val & AMD_WLC_VALID))
+		return;
+
+	cls = val & AMD_WLC_CLASS_MASK;
+	if (cls == prev->thread.amd_wlc_last)
+		WRITE_ONCE(prev->thread.amd_wlc, cls);
+	prev->thread.amd_wlc_last = cls;
+}
+
+/* Overrides the __weak default in kernel/sched/fair.c. */
+bool arch_task_wake_pref(struct task_struct *p)
+{
+	if (!static_branch_unlikely(&amd_wlc_steer))
+		return true;
+
+	/* Only non-scalable (1) and memory/I/O-bound (2) tasks are steered. */
+	return READ_ONCE(p->thread.amd_wlc) != 0;
+}
