+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_X86_AMD_WLC_H
+#define _ASM_X86_AMD_WLC_H
+
+#include <linux/bits.h>
+#include <linux/jump_label.h>
+
+/*
+ * AMD hardware workload classification (Zen 5 hybrid parts).
+ *
+ * The core classifies the running thread into class 0 (default), 1
+ * (non-scalable) or 2 (I/O / memory bound); see
+ * Documentation/arch/x86/amd-hfi.rst. The OS reads MSR_AMD_WORKLOAD_CLASS_ID
+ * when switching a thread out and then writes MSR_AMD_WORKLOAD_HRST.
+ *
+ * UNVERIFIED: the field layout below is a placeholder. Confirm it against
+ * the AMD PPR for Family 1Ah (MSRC000_0501) or by sampling the MSR as root
+ * before enabling the tracking key on real hardware.
+ */
+#define AMD_WLC_CLASS_MASK	GENMASK_ULL(7, 0)
+#define AMD_WLC_VALID		BIT_ULL(63)
+
+/* Read the class on every switch-out (costs one RDMSR per switch). */
+DECLARE_STATIC_KEY_FALSE(amd_wlc_track);
+/* Use the class for the soft wakeup preference (classes 1 and 2 only). */
+DECLARE_STATIC_KEY_FALSE(amd_wlc_steer);
+
+#endif /* _ASM_X86_AMD_WLC_H */
