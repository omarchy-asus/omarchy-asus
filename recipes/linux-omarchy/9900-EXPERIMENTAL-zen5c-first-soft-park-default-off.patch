 /*
+ * Soft wakeup preference ("soft park").
+ *
+ * A platform power policy may name a set of CPUs that wakeups should use
+ * while any of them is idle, e.g. the efficient cores of a hybrid part on
+ * battery (see the amd_hfi "wake_preferred" attribute). Wakeup placement
+ * otherwise ignores ITMT/asym-packing priorities and wakes whichever idle
+ * CPU the LLC scan meets first; asym packing then corrects it only for
+ * tasks that run long enough to be seen by load balancing.
+ *
+ * The preference is soft: when no preferred CPU is idle, the stock
+ * selection runs unchanged, so a busy preferred set spills to the other
+ * CPUs immediately (no queueing behind a busy CPU).
+ */
+static DEFINE_STATIC_KEY_FALSE(sched_wake_pref);
+static struct cpumask sched_wake_pref_cpus;
+static unsigned int sched_wake_pref_flags;
+static DEFINE_MUTEX(sched_wake_pref_lock);
+
+/**
+ * sched_set_wake_preferred_cpus - set or clear the soft wakeup preference
+ * @mask: CPUs to prefer for wakeups, or NULL / empty / all to clear it.
+ * @flags: SCHED_WAKE_PREF_PACK: within @mask, wake an idle SMT sibling of
+ *	an already busy core before a fully idle core. This keeps fewer cores
+ *	out of deep idle (fewer core C6 exits) at the cost of SMT sharing.
+ *
+ * May sleep.
+ */
+void sched_set_wake_preferred_cpus(const struct cpumask *mask,
+				   unsigned int flags)
+{
+	guard(mutex)(&sched_wake_pref_lock);
+
+	if (static_branch_unlikely(&sched_wake_pref)) {
+		static_branch_disable(&sched_wake_pref);
+		/* Wakeups run with IRQs off: wait for readers of the old mask. */
+		synchronize_rcu();
+	}
+
+	if (!mask || cpumask_empty(mask) ||
+	    cpumask_subset(cpu_possible_mask, mask))
+		return;
+
+	cpumask_copy(&sched_wake_pref_cpus, mask);
+	WRITE_ONCE(sched_wake_pref_flags, flags);
+	static_branch_enable(&sched_wake_pref);
+}
+
+bool __weak arch_task_wake_pref(struct task_struct *p)
+{
+	return true;
+}
+
+static inline const struct cpumask *sis_pref_mask(struct task_struct *p)
+{
+	if (!static_branch_unlikely(&sched_wake_pref))
+		return NULL;
