-	if (cpu_feature_enabled(X86_FEATURE_AMD_WORKLOAD_CLASS))
+	/* Consume prev's workload class, then reset hw history on AMD CPUs */
+	if (cpu_feature_enabled(X86_FEATURE_AMD_WORKLOAD_CLASS)) {
+		if (static_branch_unlikely(&amd_wlc_track))
+			amd_wlc_consume(prev_p);
 		wrmsrq(MSR_AMD_WORKLOAD_HRST, 0x1);
+	}
 
