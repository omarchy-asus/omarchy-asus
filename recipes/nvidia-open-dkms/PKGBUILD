# nvidia-open-dkms with two NVIDIA/open-gpu-kernel-modules PRs applied:
#   Both rebased onto 615.78.08 on 2026-10-16: same changes, regenerated without offsets.
#   0001 PR #1412: no hang at power-off after a hibernation image is written.
#   0002 PR #1299: defer the NVPCF notification while the GPU is runtime-suspended,
#        so the RTX no longer wakes from D3cold on every 1% battery change
#        (lars76's PR, tested on a ROG Zephyrus G16).
# Trimmed from Arch's nvidia-utils 615.78.08-1 PKGBUILD (pkgbase nvidia-utils):
# only the nvidia-open-dkms split, only the kernel-module-source tarball.
#
# Why: after a hibernation image is written, kernel_power_off()/kernel_restart()
# -> device_shutdown() -> nv_pci_shutdown() tears the driver down against a GPU
# that is still NV_FLAG_SUSPENDED (thaw is a no-op) and never returns: the G16
# sits black with the image safely on disk until a long power press.
# pkgrel 1.1 sorts above the repo's 615.78.08-1 and below any later driver or Arch rebuild (-2), so a future
# nvidia-open-dkms upgrade replaces this build (re-check the PR is merged first).

pkgname=nvidia-open-dkms
pkgver=615.78.08
pkgrel=1.1
pkgdesc="NVIDIA open kernel modules - module sources (PR #1412 hibernate power-off hang, PR #1299 NVPCF wake defer)"
arch=('x86_64')
url="https://github.com/NVIDIA/open-gpu-kernel-modules/pull/1412"
license=('MIT AND GPL-2.0-only')
depends=('dkms' "nvidia-utils=$pkgver")
conflicts=('nvidia-open' 'NVIDIA-MODULE')
provides=('nvidia-open' 'NVIDIA-MODULE' 'nvidia-dkms')
replaces=('nvidia-dkms')
options=('!strip')
_pkg_open="NVIDIA-kernel-module-source-${pkgver}"
source=("https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/${_pkg_open}.tar.xz"
        '0001-nvidia-skip-teardown-in-nv_pci_shutdown-while-hibernate-suspended.patch'
        '0002-nvidia-defer-NVPCF-notify-while-runtime-suspended.patch')
sha512sums=('5ced2c7e3e9df21f8494ea439ac2103307fcbcb295a3f11e5fdf4f1dbeda3f0b13800a06f8147ebd064f98897c24e92f5de82023a8ca43a582694d951c9620c9'
            'SKIP'
            'SKIP')

prepare() {
    cd "${_pkg_open}"
    patch -Np1 -i "${srcdir}/0001-nvidia-skip-teardown-in-nv_pci_shutdown-while-hibernate-suspended.patch"
    patch -Np1 -i "${srcdir}/0002-nvidia-defer-NVPCF-notify-while-runtime-suspended.patch"

    # Attempt to make builds reproducible (as Arch does)
    sed -i "s/^  HOSTNAME.*/  HOSTNAME = echo archlinux/" utils.mk
    sed -i "s/^WHOAMI.*/WHOAMI = echo archlinux-builder/" utils.mk
    sed -i "s/^DATE.*/DATE = date -r version.mk/" utils.mk

    local conf=kernel-open/dkms.conf
    sed -i "s/__VERSION_STRING/${pkgver}/" "$conf"
    sed -i 's/__JOBS/`nproc`/' "$conf"
    sed -i 's/__EXCLUDE_MODULES//' "$conf"
    sed -i 's/__DKMS_MODULES//' "$conf"
    sed -i 's/NV_EXCLUDE_BUILD_MODULES/IGNORE_PREEMPT_RT_PRESENCE=1 NV_EXCLUDE_BUILD_MODULES/' "$conf"
    sed -i '$i\
BUILT_MODULE_NAME[0]="nvidia"\
DEST_MODULE_LOCATION[0]="/kernel/drivers/video"\
BUILT_MODULE_NAME[1]="nvidia-uvm"\
DEST_MODULE_LOCATION[1]="/kernel/drivers/video"\
BUILT_MODULE_NAME[2]="nvidia-modeset"\
DEST_MODULE_LOCATION[2]="/kernel/drivers/video"\
BUILT_MODULE_NAME[3]="nvidia-drm"\
DEST_MODULE_LOCATION[3]="/kernel/drivers/video"\
BUILT_MODULE_NAME[4]="nvidia-peermem"\
DEST_MODULE_LOCATION[4]="/kernel/drivers/video"' "$conf"
    cat <<EOT >>"$conf"
BUILT_MODULE_LOCATION[0]="kernel-open"
BUILT_MODULE_LOCATION[1]="kernel-open"
BUILT_MODULE_LOCATION[2]="kernel-open"
BUILT_MODULE_LOCATION[3]="kernel-open"
BUILT_MODULE_LOCATION[4]="kernel-open"
EOT
}

package() {
    install -dm 755 "${pkgdir}/usr/src"
    cp -dr --no-preserve='ownership' "${srcdir}/${_pkg_open}" "${pkgdir}/usr/src/nvidia-$pkgver"
    mv "${pkgdir}/usr/src/nvidia-$pkgver/kernel-open/dkms.conf" "${pkgdir}/usr/src/nvidia-$pkgver/dkms.conf"
    # patch(1) backups must not ship (they showed up as an "altered file" in pacman -Qkk)
    find "${pkgdir}/usr/src/nvidia-$pkgver" -name '*.orig' -delete
    install -Dm644 "${srcdir}/${_pkg_open}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
