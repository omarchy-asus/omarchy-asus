From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rdoupe <1207041+rdoupe@users.noreply.github.com>
Date: Sat, 24 Oct 2026 02:46:32 -0400
Subject: [PATCH] Swap the G16 Control widget's dead link for the omarchy-asus
 plugin

The asus-zephyrus-g16-control package linked its bar widget into
~/.config/omarchy/plugins from /usr/share under the id omarchy-asus.g16.
The widget is the omarchy-asus plugin now
(https://github.com/omarchy-asus/omarchy-asus-plugin), and the package
is replaced by asus-rog-nkey-winlock on the next update, which leaves
the link pointing nowhere. A migration removes that link and adds and
enables the plugin, so an update alone finishes the move. A failed add
(no network) does not fail the update; it says how to add the plugin
later. Machines without that exact link are left alone.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 migrations/1792824363.sh                      | 19 +++++
 .../g16-widget-plugin-migration-test.sh       | 75 +++++++++++++++++++
 2 files changed, 94 insertions(+)
 create mode 100644 migrations/1792824363.sh
 create mode 100755 test/shell.d/g16-widget-plugin-migration-test.sh

diff --git a/migrations/1792824363.sh b/migrations/1792824363.sh
new file mode 100644
index 000000000..991bcb8d3
--- /dev/null
+++ b/migrations/1792824363.sh
@@ -0,0 +1,19 @@
+echo "Move the G16 Control widget to the omarchy-asus plugin"
+
+# The asus-zephyrus-g16-control package linked its bar widget into the plugins
+# directory from /usr/share under the id omarchy-asus.g16. The widget is the
+# omarchy-asus plugin now, and asus-rog-nkey-winlock replaces that package, so
+# the link points nowhere. Swap it for the plugin. Machines that never had the
+# link are left alone.
+plugins=$HOME/.config/omarchy/plugins
+old=$plugins/omarchy-asus.g16
+url=https://github.com/omarchy-asus/omarchy-asus-plugin
+
+if [[ -L $old && $(readlink "$old") == /usr/share/omarchy/plugins/omarchy-asus.g16 ]]; then
+  rm "$old"
+  if [[ ! -e $plugins/io.github.omarchy-asus.panel ]] &&
+    ! omarchy-plugin-add "$url" --enable --yes; then
+    echo "Could not add the omarchy-asus plugin. Add it later with:"
+    echo "  omarchy-plugin-add $url --enable"
+  fi
+fi
diff --git a/test/shell.d/g16-widget-plugin-migration-test.sh b/test/shell.d/g16-widget-plugin-migration-test.sh
new file mode 100755
index 000000000..dfe11d18c
--- /dev/null
+++ b/test/shell.d/g16-widget-plugin-migration-test.sh
@@ -0,0 +1,75 @@
+#!/bin/bash
+
+set -euo pipefail
+
+source "$(dirname "$0")/base-test.sh"
+
+migration="$ROOT/migrations/1792824363.sh"
+test_dir=$(mktemp -d)
+trap 'rm -rf "$test_dir"' EXIT
+
+mkdir -p "$test_dir/bin"
+
+cat >"$test_dir/bin/omarchy-plugin-add" <<'STUB'
+#!/bin/bash
+
+echo "$*" >>"$PLUGIN_ADDS"
+[[ -z ${PLUGIN_ADD_FAILS:-} ]] || exit 1
+mkdir -p "$HOME/.config/omarchy/plugins/io.github.omarchy-asus.panel/.git"
+STUB
+
+chmod +x "$test_dir/bin/"*
+
+export PLUGIN_ADDS="$test_dir/plugin-adds"
+
+home="$test_dir/home"
+plugins="$home/.config/omarchy/plugins"
+
+reset_home() {
+  rm -rf "$home"
+  mkdir -p "$plugins"
+  : >"$PLUGIN_ADDS"
+}
+
+run_migration() {
+  HOME="$home" PATH="$test_dir/bin:$PATH" bash -euo pipefail "$migration" >"$test_dir/out"
+}
+
+reset_home
+ln -s /usr/share/omarchy/plugins/omarchy-asus.g16 "$plugins/omarchy-asus.g16"
+run_migration
+[[ ! -e $plugins/omarchy-asus.g16 && ! -L $plugins/omarchy-asus.g16 ]] ||
+  fail "migration removes the packaged widget's link"
+pass "migration removes the packaged widget's link"
+[[ $(<"$PLUGIN_ADDS") == "https://github.com/omarchy-asus/omarchy-asus-plugin --enable --yes" ]] ||
+  fail "migration adds and enables the omarchy-asus plugin" "$(cat "$PLUGIN_ADDS")"
+pass "migration adds and enables the omarchy-asus plugin"
+
+reset_home
+ln -s /usr/share/omarchy/plugins/omarchy-asus.g16 "$plugins/omarchy-asus.g16"
+mkdir -p "$plugins/io.github.omarchy-asus.panel/.git"
+run_migration
+[[ ! -L $plugins/omarchy-asus.g16 && ! -s $PLUGIN_ADDS ]] ||
+  fail "migration only removes the link when the plugin is already there" "$(cat "$PLUGIN_ADDS")"
+pass "migration only removes the link when the plugin is already there"
+
+reset_home
+ln -s /usr/share/omarchy/plugins/omarchy-asus.g16 "$plugins/omarchy-asus.g16"
+PLUGIN_ADD_FAILS=1 run_migration ||
+  fail "migration does not fail the update when the plugin cannot be added"
+grep -q "omarchy-plugin-add https://github.com/omarchy-asus/omarchy-asus-plugin --enable" "$test_dir/out" ||
+  fail "migration says how to add the plugin later" "$(cat "$test_dir/out")"
+pass "migration says how to add the plugin later when the add fails"
+
+reset_home
+run_migration
+[[ ! -s $PLUGIN_ADDS ]] || fail "migration leaves a machine without the link alone"
+pass "migration leaves a machine without the link alone"
+
+reset_home
+mkdir -p "$test_dir/mine"
+ln -s "$test_dir/mine" "$plugins/omarchy-asus.g16"
+run_migration
+[[ -L $plugins/omarchy-asus.g16 && ! -s $PLUGIN_ADDS ]] ||
+  fail "migration leaves a link of the user's own under that id alone"
+pass "migration leaves a link of the user's own under that id alone"
-- 
