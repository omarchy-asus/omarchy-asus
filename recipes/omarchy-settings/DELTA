# How recipes/omarchy-settings differs from upstream; bin/rebase-recipe re-applies it to each new
# upstream release (see its --help for the format, NOTES.md for the why).
# The patches are the omarchy-asus fork's fixes backported onto the pinned release
# (fork branch asus/v4-5-0-rc1). recipes/omarchy and recipes/omarchy-settings carry the
# SAME patch list: both packages build from the same source tree, and omarchy pins
# omarchy-settings=$pkgver-$pkgrel, and the pair is one release cohort (build/cohorts.conf):
# built, published and withdrawn together. Keep the two DELTA files in lockstep.
# prepare() doesn't cd into the source, hence the "omarchy" directory argument.
upstream omarchy-pkgs pkgbuilds/omarchy-settings
mode overlay
keep NOTES.md
# Ship the fork's charger-swap monitor user unit (0002) in /usr/lib/systemd/user; omarchy-settings
# installs user units from an explicit list. Fork pkgs branch omarchy-settings-source-monitor.
pkgbuild-patch pkgbuild-source-monitor-unit.diff
pkgbuild-patch pkgbuild-pkgdesc-label.diff
patch 0001-Stop-asusd-from-switching-the-power-profile-and-EPP-.patch prepare omarchy
