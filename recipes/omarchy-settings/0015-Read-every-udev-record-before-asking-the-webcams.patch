From ce4422b3eca2b534f5643f5001ca61821b200df7 Mon Sep 17 00:00:00 2001
From: rdoupe
Date: Sun, 18 Oct 2026 03:29:12 -0400
Subject: [PATCH 15/18] Read every udev record before asking the webcams

A node udev had no record for sent the guard straight to
omarchy-capture-webcam-list, which opens every camera, even when a
later node's record already answered. Check all recorded nodes first
and ask the devices only when none of them is a capture node and some
had no record.

Co-Authored-By: Claude Opus 5.5
Backport-of: 6c7d70014d5f4d9f1f26bf7094224f02857dda29

(cherry picked from commit 6c7d70014d5f4d9f1f26bf7094224f02857dda29)
---
 bin/omarchy-hw-webcam                | 13 ++++++++-----
 test/shell.d/screenrecording-test.sh | 15 +++++++++++++++
 2 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/bin/omarchy-hw-webcam b/bin/omarchy-hw-webcam
index 0a48b8a8..d1fbb0c9 100755
--- a/bin/omarchy-hw-webcam
+++ b/bin/omarchy-hw-webcam
@@ -26,6 +26,9 @@ udev_capabilities() {
   done <"$1"
 }
 
+# Every recorded answer comes first, so one node udev knows nothing about does not
+# make the guard open the cameras udev already describes.
+unknown=0
 for node in "${nodes[@]}"; do
   [[ -r $node/dev ]] || continue
   capabilities=""
@@ -33,11 +36,11 @@ for node in "${nodes[@]}"; do
   [[ -r $data ]] && capabilities=$(udev_capabilities "$data")
 
   if [[ -z $capabilities ]]; then
-    [[ -n $(omarchy-capture-webcam-list) ]]
-    exit
+    unknown=1
+  elif [[ $capabilities == *:capture:* ]]; then
+    exit 0
   fi
-
-  [[ $capabilities == *:capture:* ]] && exit 0
 done
 
-exit 1
+# No recorded capture node: ask the devices, but only if some had no record.
+((unknown)) && [[ -n $(omarchy-capture-webcam-list) ]]
diff --git a/test/shell.d/screenrecording-test.sh b/test/shell.d/screenrecording-test.sh
index 1a528f00..a2de9f82 100644
--- a/test/shell.d/screenrecording-test.sh
+++ b/test/shell.d/screenrecording-test.sh
@@ -150,6 +150,21 @@ OMARCHY_TEST_V4L2_LOG="$v4l2_log" OMARCHY_V4L_CLASS_PATH="$udev_v4l" OMARCHY_UDE
   fail "webcam hardware detection opens no video device when udev answers" "$(cat "$v4l2_log")"
 pass "webcam hardware detection reads udev's record without opening a device"
 
+# A node udev has no record for, sorted before a recorded capture node, must not
+# send the guard to the devices: the recorded answer is enough.
+mixed_v4l="$tmp_dir/v4l-mixed"
+mixed_data="$tmp_dir/udev-mixed"
+mkdir -p "$mixed_v4l/video0" "$mixed_v4l/video1" "$mixed_data"
+echo 81:0 >"$mixed_v4l/video0/dev"
+echo 81:1 >"$mixed_v4l/video1/dev"
+printf '%s\n' 'E:ID_V4L_CAPABILITIES=:capture:' >"$mixed_data/c81:1"
+OMARCHY_TEST_V4L2_LOG="$v4l2_log" OMARCHY_V4L_CLASS_PATH="$mixed_v4l" OMARCHY_UDEV_DATA_PATH="$mixed_data" \
+  "$ROOT/bin/omarchy-hw-webcam" ||
+  fail "webcam hardware detection finds a recorded capture node after an unrecorded one"
+[[ ! -s $v4l2_log ]] ||
+  fail "webcam hardware detection opens no device when a later node's record answers" "$(cat "$v4l2_log")"
+pass "webcam hardware detection answers from a later node's record before asking any device"
+
 printf '%s\n' 'E:ID_V4L_CAPABILITIES=:video_output:' >"$udev_data/c81:1"
 if OMARCHY_TEST_V4L2_LOG="$v4l2_log" OMARCHY_V4L_CLASS_PATH="$udev_v4l" OMARCHY_UDEV_DATA_PATH="$udev_data" \
   "$ROOT/bin/omarchy-hw-webcam"; then
