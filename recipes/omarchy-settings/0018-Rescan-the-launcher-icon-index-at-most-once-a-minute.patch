From fe152448b4ec1510f44f5efc6dc0b1b801278659 Mon Sep 17 00:00:00 2001
From: rdoupe
Date: Sun, 18 Oct 2026 03:30:17 -0400
Subject: [PATCH 18/18] Rescan the launcher icon index at most once a minute on
 open

Opening the menu walked every icon theme with find (about 9,000 paths, 75 ms)
and indexed each path in its own JS callback on the GUI thread, while the menu
was animating in. Desktop entry changes still rescan at once; an open now only
rescans when the last scan is over a minute old, and a scan is indexed in a
single pass over the collected output.

Co-Authored-By: Claude Opus 5.5
Backport-of: 0f5fc1a9a37b76e5e4ddafa670b5c8cad9013831
Backport-of: 2dcec7e710564634614629485ff6c6f68e851b41 (fixup)

(cherry picked from commit 0f5fc1a9a37b76e5e4ddafa670b5c8cad9013831)
---
 shell/services/AppLibrary.qml   | 45 ++++++++++++++++++++++++++++-----
 test/shell.d/app-search-test.sh | 23 +++++++++++++++++
 2 files changed, 61 insertions(+), 7 deletions(-)

diff --git a/shell/services/AppLibrary.qml b/shell/services/AppLibrary.qml
index 738529de..ba6a67dd 100644
--- a/shell/services/AppLibrary.qml
+++ b/shell/services/AppLibrary.qml
@@ -22,6 +22,13 @@ Item {
   // whenever the app list changes, so newly installed apps get their icon live.
   property var iconIndex: ({})
   property var pendingIconIndex: ({})
+  // When the last scan finished, so an open of a consumer can skip a scan that
+  // could not have found anything new yet.
+  property real iconIndexScannedAt: 0
+  // An app-list change that lands while a scan runs; it may have missed the
+  // change, so one more scan runs as soon as this one exits.
+  property bool iconRescanPending: false
+  readonly property int iconRefreshMinIntervalMs: 60000
 
   property int launchSerial: 0
   property int launchToplevelCount: 0
@@ -70,8 +77,14 @@ Item {
 
   // The shell may start before first-install packages have finished placing
   // their icons; consumers call this when they open so icons appear live.
+  // A scan walks every icon theme (thousands of files) and indexes each one on
+  // the GUI thread, and the menu opens far more often than icons change. Desktop
+  // entry changes still rescan straight away; an open only rescans once the
+  // last scan is a minute old.
   function refreshIcons() {
-    if (!iconIndexScan.running) iconIndexScan.running = true
+    if (iconIndexScan.running) return
+    if (Date.now() - root.iconIndexScannedAt < root.iconRefreshMinIntervalMs) return
+    iconIndexScan.running = true
   }
 
   function launch(desktopId, name) {
@@ -147,6 +160,17 @@ Item {
       root.pendingIconIndex[name] = value
   }
 
+  // The whole scan in one pass, rather than one JS callback per path.
+  function indexIconText(text) {
+    root.pendingIconIndex = ({})
+    var lines = String(text || "").split("\n")
+    for (var i = 0; i < lines.length; i++) root.indexIconLine(lines[i])
+    // Swapping the property re-evaluates every iconSource() binding, so
+    // newly found icons appear without rebuilding the list.
+    root.iconIndex = root.pendingIconIndex
+    root.iconIndexScannedAt = Date.now()
+  }
+
   function hiddenEntryScanCommand() {
     var desktop = [Quickshell.env("XDG_CURRENT_DESKTOP"), Quickshell.env("XDG_SESSION_DESKTOP"), Quickshell.env("DESKTOP_SESSION")].filter(function(v) { return String(v || "").length > 0 }).join(":")
     var script = root.omarchyPath + "/shell/services/hidden-entries.sh"
@@ -202,11 +226,15 @@ Item {
   Process {
     id: iconIndexScan
     command: ["bash", "-c", root.iconIndexScanCommand()]
-    stdout: SplitParser { onRead: function(line) { root.indexIconLine(line) } }
-    onStarted: root.pendingIconIndex = ({})
-    // Swapping the property re-evaluates every iconSource() binding, so
-    // newly found icons appear without rebuilding the list.
-    onExited: root.iconIndex = root.pendingIconIndex
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: root.indexIconText(text)
+    }
+    onExited: {
+      if (!root.iconRescanPending) return
+      root.iconRescanPending = false
+      iconIndexScan.running = true
+    }
   }
 
   // Coalesces bursts of app-list changes (a package install touches many
@@ -214,7 +242,10 @@ Item {
   Timer {
     id: iconIndexDebounce
     interval: 750
-    onTriggered: if (!iconIndexScan.running) iconIndexScan.running = true
+    onTriggered: {
+      if (iconIndexScan.running) root.iconRescanPending = true
+      else iconIndexScan.running = true
+    }
   }
 
   FileView {
diff --git a/test/shell.d/app-search-test.sh b/test/shell.d/app-search-test.sh
index 5ebd1cfe..fed8c20e 100644
--- a/test/shell.d/app-search-test.sh
+++ b/test/shell.d/app-search-test.sh
@@ -148,6 +148,29 @@ assert(
   'app library keeps owning an OSD a previous launch left on screen'
 )
 
+const refreshMatch = appLibraryQml.match(/function refreshIcons\(\) \{([\s\S]*?)\n  \}/)
+assert(
+  refreshMatch && refreshMatch[1].includes('root.iconIndexScannedAt') &&
+    refreshMatch[1].includes('root.iconRefreshMinIntervalMs'),
+  'opening a consumer rescans icons only once the last scan has aged'
+)
+const iconScanMatch = appLibraryQml.match(/id: iconIndexScan\n([\s\S]*?)\n  \}/)
+assert(
+  iconScanMatch && iconScanMatch[1].includes('StdioCollector') &&
+    iconScanMatch[1].includes('root.indexIconText(text)') && !iconScanMatch[1].includes('SplitParser'),
+  'the icon scan is indexed in one pass rather than one callback per path'
+)
+assert(
+  /function indexIconText\(text\) \{[\s\S]*?root\.iconIndexScannedAt = Date\.now\(\)/.test(appLibraryQml),
+  'a finished icon scan records when it ran'
+)
+const debounceMatch = appLibraryQml.match(/id: iconIndexDebounce\n([\s\S]*?)\n  \}/)
+assert(
+  debounceMatch && debounceMatch[1].includes('root.iconRescanPending = true') &&
+    iconScanMatch && /onExited:[\s\S]*root\.iconRescanPending = false[\s\S]*iconIndexScan\.running = true/.test(iconScanMatch[1]),
+  'an app-list change during a scan runs one more scan when it exits, past the open throttle'
+)
+
 const openMatch = menuQml.match(/function openExistingMenu\(initialMenu\) \{([\s\S]*?)\n  \}/)
 assert(openMatch, 'menu openExistingMenu function exists')
 assert(
