From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rdoupe
Date: Sun, 18 Oct 2026 04:02:19 -0400
Subject: [PATCH 19/24] Give a connector name both GPUs expose to the card that
 has it connected

On a hybrid laptop both cards can expose a connector with the same name (DP-1
on the iGPU and on the NVIDIA card). The lookup returned the lowest-numbered
card even when its connector was disconnected, so a monitor on the NVIDIA
DP-1 kept the hardware cursor. Prefer the card whose cached status reads
connected, and fall back to the first match.

Found by Codex review of the omarchy-asus 4.0.5 backport.
---
 default/hypr/hybrid-cursor.lua              | 12 ++++++++++--
 test/shell.d/hyprland-hybrid-cursor-test.sh |  9 +++++++++
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/default/hypr/hybrid-cursor.lua b/default/hypr/hybrid-cursor.lua
index da81bdf2..7177c0d1 100644
--- a/default/hypr/hybrid-cursor.lua
+++ b/default/hypr/hybrid-cursor.lua
@@ -31,15 +31,23 @@ local function card_vendor(card)
   return vendor
 end
 
+-- Two cards can expose a connector with the same name (DP-1 on both), so the
+-- one that reports "connected" owns the monitor; the status file is the cached
+-- state and reading it doesn't probe the GPU.
 local function connector_card(connector)
+  local first = nil
   for index = 0, 15 do
     local file = io.open(drm_path .. "/card" .. index .. "-" .. connector .. "/status", "r")
     if file then
+      local status = file:read("*l")
       file:close()
-      return "card" .. index
+      if status == "connected" then
+        return "card" .. index
+      end
+      first = first or ("card" .. index)
     end
   end
-  return nil
+  return first
 end
 
 -- Hybrid: an NVIDIA card next to a display card from another vendor.
diff --git a/test/shell.d/hyprland-hybrid-cursor-test.sh b/test/shell.d/hyprland-hybrid-cursor-test.sh
index c9e73e6f..e8cdf4ae 100644
--- a/test/shell.d/hyprland-hybrid-cursor-test.sh
+++ b/test/shell.d/hyprland-hybrid-cursor-test.sh
@@ -78,6 +78,15 @@ expect "hybrid: unplugging it goes back to auto" "1 2 2" add:HDMI-A-1 remove:HDM
 expect "hybrid: a reload with the monitor plugged in re-applies" "1 1" add:HDMI-A-1 reload
 expect "hybrid: a value the user set is left alone" "0 0 0" user:0 add:HDMI-A-1 remove:HDMI-A-1
 
+rm -rf "$OMARCHY_DRM_PATH"
+card 0 0x1002 eDP-1 DP-1
+card 1 0x10de DP-1
+printf 'disconnected\n' >"$OMARCHY_DRM_PATH/card0-DP-1/status"
+expect "hybrid: a connector name on both cards belongs to the connected one" "1" add:DP-1
+printf 'connected\n' >"$OMARCHY_DRM_PATH/card0-DP-1/status"
+printf 'disconnected\n' >"$OMARCHY_DRM_PATH/card1-DP-1/status"
+expect "hybrid: and stays on the iGPU when that one is connected" "2" add:DP-1
+
 rm -rf "$OMARCHY_DRM_PATH"
 card 0 0x10de HDMI-A-1 eDP-1
 expect "NVIDIA only: nothing registered" "events=0"
