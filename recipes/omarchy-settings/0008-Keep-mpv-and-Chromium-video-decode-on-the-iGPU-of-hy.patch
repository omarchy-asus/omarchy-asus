+if render_node=$(omarchy-hw-igpu-render-node); then
+  echo "Detected a hybrid GPU with the display on the iGPU. Decoding video on $render_node."
+  hybrid_video_pin_mpv
+  hybrid_video_pin_chromium
+fi
