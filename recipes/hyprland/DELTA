# How recipes/hyprland differs from upstream; bin/rebase-recipe re-applies it to each
# new upstream release (see its --help for the format, NOTES.md for the why).
upstream arch hyprland
mode overlay
take PKGBUILD LICENSE
keep NOTES.md
pkgbuild-patch pkgbuild-pkgdesc-label.diff
patch reconnect-render-offset.patch prepare
# not on Hyprland main yet (checked 2026-10-24); drop it once a release sends leave on capability loss
patch seat-leave-on-capability-loss.patch prepare
# backport of main's c7932c6ef + 5b6b75ac5 (late binds to removed outputs are inert); drop on the release that has them
patch output-late-bind-inert.patch prepare
fixed-upstream hyprwm/Hyprland 5b6b75ac5 v{pkgver}
# ours: removed wl_output globals are destroyed 5 s later, not at once; not on main (checked 2026-11-10)
patch output-global-destroy-delay.patch prepare
# not on Hyprland main (checked 2026-11-10); wlroots, KWin and Weston carry the same change
patch xwayland-no-focus-window.patch prepare
# backport of hyprwm/Hyprland#16784: a lock surface asked for on a removed output is inert, not a
# protocol error; main has it as 8b6f4329, the 0.57.1 release branch as 518be87e; drop on the release that has it
patch session-lock-removed-output.patch prepare
fixed-upstream hyprwm/Hyprland 518be87e v{pkgver}
fixed-upstream hyprwm/Hyprland 8b6f4329 v{pkgver}
# main has the same fix (e9e2f64c, #16140); flag the first release that contains it
fixed-upstream hyprwm/Hyprland e9e2f64c v{pkgver}
