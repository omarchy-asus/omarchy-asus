-        setActiveWindow(XCB_WINDOW_NONE);
+    // When focus leaves X11 for a Wayland window, or for no window at all, name the
+    // no-focus window as the active window and give it the X input focus, instead of None.
+    // X clients such as Wine read None as a transient state (other X window managers use it
+    // mid-switch), so they keep the deactivated window in the foreground. This follows
+    // wlroots, KWin and Weston, which all made the same change.
+    const auto FOCUSED = Desktop::focusState()->window();
+    if (!surf || (!activate && (!FOCUSED || !FOCUSED->m_isX11))) {
+        setActiveWindow(m_noFocusWindow);
         focusWindow(nullptr);
     } else {
         setActiveWindow(surf ? surf->m_xID : sc<uint32_t>(XCB_WINDOW_NONE));
@@ -1263,7 +1281,7 @@ void CXWM::updateWorkArea(int x, int y, int w, int h) {
