+// A mapped, 1x1, off-screen, override-redirect window that holds the X input focus and is the
+// _NET_ACTIVE_WINDOW while no X11 window is focused (as wlroots' no_focus_window).
+// isWMWindow() keeps it from becoming a managed surface.
+void CXWM::createNoFocusWindow() {
+    m_noFocusWindow    = xcb_generate_id(getConnection());
+    uint32_t values[2] = {1, XCB_EVENT_MASK_KEY_PRESS | XCB_EVENT_MASK_KEY_RELEASE | XCB_EVENT_MASK_FOCUS_CHANGE};
+    xcb_create_window(getConnection(), XCB_COPY_FROM_PARENT, m_noFocusWindow, m_screen->root, -100, -100, 1, 1, 0, XCB_WINDOW_CLASS_COPY_FROM_PARENT, XCB_COPY_FROM_PARENT,
+                      XCB_CW_OVERRIDE_REDIRECT | XCB_CW_EVENT_MASK, values);
+    xcb_map_window(getConnection(), m_noFocusWindow);
+}
