+// how long a removed wl_output global stays bindable before it is destroyed (wlroots: 5 s)
+static constexpr auto OUTPUT_GLOBAL_DESTROY_DELAY = std::chrono::seconds(5);
 
 CWLOutputResource::CWLOutputResource(SP<CWlOutput> resource_, PHLMONITOR pMonitor, WP<CWLOutputProtocol> owner) : m_monitor(pMonitor), m_owner(owner), m_resource(resource_) {
     if UNLIKELY (!good())
@@ -115,10 +120,16 @@ void CWLOutputProtocol::bindManager(wl_client* client, void* data, uint32_t ver,
     m_events.outputBound.emit(RESOURCE);
 }
 
+CWLOutputProtocol::~CWLOutputProtocol() {
+    if (m_destroyTimer && g_pEventLoopManager)
+        g_pEventLoopManager->removeTimer(m_destroyTimer);
+}
+
 void CWLOutputProtocol::destroyResource(CWLOutputResource* resource) {
     std::erase_if(m_outputs, [&](const auto& other) { return other.get() == resource; });
 
-    if (m_outputs.empty() && m_defunct) {
+    // still within the delay after the global was removed: the destroy timer drops us.
+    if (m_outputs.empty() && canDestroy()) {
         // only erase the map entry if it is actually us: a new global with the same name may
         // have replaced us (monitor replug), in which case we live in defunctOutputs.
         // NOTE: either erase drops the last ref to `this` — nothing may run after it.
@@ -133,6 +144,30 @@ bool CWLOutputProtocol::hasBoundResources() {
     return !m_outputs.empty();
 }
 
+bool CWLOutputProtocol::canDestroy() {
+    return m_defunct && m_outputs.empty() && Time::steadyNow() - m_removedAt >= OUTPUT_GLOBAL_DESTROY_DELAY;
+}
+
+void PROTO::sweepDefunctOutputs() {
+    // move them out first: destroying one may not re-enter the containers mid-erase.
+    std::vector<SP<CWLOutputProtocol>> dead;
+    for (auto it = PROTO::defunctOutputs.begin(); it != PROTO::defunctOutputs.end();) {
+        if ((*it)->canDestroy()) {
+            dead.emplace_back(*it);
+            it = PROTO::defunctOutputs.erase(it);
+        } else
+            ++it;
+    }
+    for (auto it = PROTO::outputs.begin(); it != PROTO::outputs.end();) {
+        if (it->second->canDestroy()) {
+            dead.emplace_back(it->second);
+            it = PROTO::outputs.erase(it);
+        } else
+            ++it;
+    }
+    // `dead` going out of scope runs wl_global_destroy for each.
+}
+
 std::vector<SP<CWLOutputResource>> CWLOutputProtocol::outputResourcesFrom(wl_client* client) {
     std::vector<SP<CWLOutputResource>> ret;
 
@@ -150,8 +185,16 @@ void CWLOutputProtocol::remove() {
     if UNLIKELY (m_defunct)
         return;
 
-    m_defunct = true;
+    m_defunct   = true;
+    m_removedAt = Time::steadyNow();
     removeGlobal();
+
+    // destroy the global only once clients have had time to see the removal (canDestroy())
+    if (g_pEventLoopManager) {
+        m_destroyTimer = makeShared<CEventLoopTimer>(
+            OUTPUT_GLOBAL_DESTROY_DELAY + std::chrono::milliseconds(100), [](SP<CEventLoopTimer> self, void* data) { PROTO::sweepDefunctOutputs(); }, nullptr);
+        g_pEventLoopManager->addTimer(m_destroyTimer);
+    }
 }
 
 bool CWLOutputProtocol::isDefunct() {
