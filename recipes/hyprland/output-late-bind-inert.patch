@@ -26,6 +23,9 @@ CWLOutputResource::CWLOutputResource(SP<CWlOutput> resource_, PHLMONITOR pMonito
             m_owner->destroyResource(this);
     });
 
+    if (!m_monitor || !m_monitor->m_output || !m_owner || m_owner->m_defunct)
+        return;
+
     if (m_resource->version() >= 4) {
