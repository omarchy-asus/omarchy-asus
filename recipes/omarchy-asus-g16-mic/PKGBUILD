build() {
  arch-meson . build -Daec_tests=enabled
  meson compile -C build
}

check() {
  # Synthetic signals only: the real-time core, calibration, source matching,
  # beam, tracking, the engine's fallbacks and crossfades, the status file, and
  # the WebRTC echo canceller PipeWire's module uses (delay, drift, double talk;
  # the echo-cancel-only default and the opt-in noise-suppression-high settings).
  # test_handoff drives the capture-to-outputs hand-off on a simulated schedule:
  # exactly one quantum per output buffer, all buffering in g16-mic's own
  # bounded queue (8 cycles per output), oldest-first counted overflow, the stop
  # drain delivering the last accepted cycle, the source-loss tail counted
  # exactly, and no stale audio after a reconnect.
  # test_pw_live adds the isolated live PipeWire test: a private daemon with
  # only null/dummy drivers and a private WirePlumber under a temporary
  # directory, nothing audible and no real devices (checkdepends: wireplumber),
  # steps 1-14, the last a consumer-only stall past the queue bound.
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
