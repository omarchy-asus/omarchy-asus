# EXPERIMENTAL: ASUS ROG Zephyrus G16 GA605KM only.
#
# omarchy-asus-g16-mic (#401, part of #400): `g16-mic`, an opt-in processor for
# the G16's internal microphones. `g16-mic run --source <node.name>` captures
# exactly that PipeWire source and offers two virtual sources, g16_mic_processed
# (raw, omni, fixed beam or direction tracking, mono) and g16_mic_raw (every
# channel, untouched). Echo cancellation is PipeWire's own module-echo-cancel,
# through config fragments installed under
# /usr/share/omarchy-asus-g16-mic/pipewire/ that a user links in to opt in:
# g16-mic-aec.conf (the default) is echo cancellation only, noise suppression
# and gain control off, so every word is kept; g16-mic-aec-ns-high.conf adds
# noise suppression at PipeWire's fixed high level, a word-loss risk to check
# on the G16 before relying on it. Nothing is started or enabled at install time, nothing goes into /etc or
# pipewire.conf.d, and the default source is unchanged. See README.md.
#
# A local package with no upstream build to track, so pkgrel does not use the
# repo's "<upstream>.1" scheme.

pkgname=omarchy-asus-g16-mic
pkgver=0.1.0
pkgrel=104
pkgdesc='Opt-in G16 microphone processing host: raw, omni, fixed beam and direction tracking as PipeWire sources (EXPERIMENTAL)'
arch=('x86_64')
url='https://github.com/omarchy-asus/omarchy-asus'
license=('MIT')
depends=('pipewire' 'fftw' 'glibc')
makedepends=('meson' 'webrtc-audio-processing-1')
checkdepends=('wireplumber' 'util-linux')  # util-linux: prlimit for test_pw_live step 12
optdepends=('wireplumber: links the capture stream to the named source')
options=('!debug')
