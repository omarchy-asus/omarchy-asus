# The Zen 5c-first knobs of kernel patch 9900 (#10): amd_hfi's attributes on its
# platform device. ranking reads "[performance] efficiency inverted"; the others
# read their value alone.
def _hfi(name):
    def path(h):
        d = glob_dirs(os.path.join(h.sys, "bus/platform/devices"),
                      lambda p: os.path.basename(p).startswith("AMDI0104:") and os.path.exists(f"{p}/ranking"))
        if not d:
            fail("no amd_hfi Zen 5c-first knobs (AMDI0104 ranking: a kernel without patch 9900)")
        return _need(f"{d[0]}/{name}", f"amd_hfi {name}")
    return path


def _bracketed(v):
    m = re.search(r"\[([a-z]+)\]", v)
    return m.group(1) if m else v


# cpufreq, for the boost and clock tweaks (#328): every policy alike, each put back
# to its own value.
def _policies(h):
    base = os.path.join(h.sys, "devices/system/cpu/cpufreq")
    d = glob_dirs(base, lambda p: re.fullmatch(r"policy[0-9]+", os.path.basename(p)) is not None)
    if not d:
        fail("no cpufreq policies")
    return sorted(d, key=lambda p: int(os.path.basename(p)[6:]))


def _per_policy(name):
    def get(h):
        v = [rd(f"{p}/{name}") for p in _policies(h)]
        return v[0] if len(set(v)) == 1 else ",".join(v)

    def set_(h, v):
        for p in _policies(h):
            wr(f"{p}/{name}", v)

    def save(h):
        return {"policies": {p: rd(f"{p}/{name}") for p in _policies(h)}}

    def load(h, orig):
        for p, v in orig["policies"].items():
            if os.path.exists(p):
                wr(f"{p}/{name}", v)
    return get, set_, save, load


def _epp_choices(h):
    sets = [set(rd(f"{p}/energy_performance_available_preferences").split()) for p in _policies(h)]
    return set.intersection(*sets)


def _max_freq_range(h):
    # a value every policy accepts: from the highest cpuinfo_min_freq to the highest
    # cpuinfo_max_freq (a policy whose own maximum is lower stays at its maximum)
    ps = _policies(h)
    lo = max(int(rd(f"{p}/cpuinfo_min_freq") or 0) for p in ps)
    hi = max(int(rd(f"{p}/cpuinfo_max_freq") or 0) for p in ps)
    return range(lo, hi + 1)


def _pmf_profile(h):
