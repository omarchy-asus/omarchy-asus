def fail(msg):
    raise Refused(msg)


class Refused(Exception):
    pass


# --------------------------------------------------------------- the machine
class Host:
    """Paths and commands, under a fake root for the offline tests (--fake)."""

    def __init__(self, fake=None):
        self.fake = fake
        r = fake or "/"
        j = lambda *p: os.path.join(r, *p)  # noqa: E731
        self.sys, self.proc = j("sys"), j("proc")
        self.state = j("var/lib", UNIT)
        self.run_dir = j("run", UNIT)
        self.etc_dropins = j("etc/limine-entry-tool.d")
        self.default_limine = j("etc/default/limine")
        self.root = r
        self.canned = {}
        if fake and os.path.exists(j("fake-commands.json")):
            with open(j("fake-commands.json")) as f:
                self.canned = json.load(f)

    def tracefs(self):
        t = os.path.join(self.sys, "kernel/tracing")
        return t if os.path.isdir(os.path.join(t, "instances")) else os.path.join(self.sys, "kernel/debug/tracing")

    def run(self, argv, check=True):
        """A fixed command; in fake mode logged (and answered from fake-commands.json)."""
        if self.fake:
            with open(os.path.join(self.fake, "commands.log"), "a") as f:
                f.write(" ".join(argv) + "\n")
            out = self.canned.get(" ".join(argv), "")
            return 0, out
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
        if check and p.returncode != 0:
            fail(f"{argv[0]} failed: {(p.stderr or p.stdout).strip()[:300]}")
        return p.returncode, p.stdout

    def mkinstance(self, path):
        os.mkdir(path)
        # tracefs fills a new instance itself; the fake copies a template
        if self.fake and os.path.isdir(os.path.join(self.fake, "fake-instance")):
            shutil.copytree(os.path.join(self.fake, "fake-instance"), path, dirs_exist_ok=True)

    def rmdir(self, path):
        if self.fake:
            shutil.rmtree(path, ignore_errors=True)
        else:
            os.rmdir(path)

    def boot_id(self):
        return rd(os.path.join(self.proc, "sys/kernel/random/boot_id"))


def rd(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def wr(path, value):
    try:
        with open(path, "w") as f:
            f.write(f"{value}\n")
    except OSError as e:
        fail(f"write {value!r} to {path} refused: {e.strerror}")


def glob_dirs(base, test):
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return []
    return [os.path.join(base, n) for n in names if test(os.path.join(base, n))]


def pci_by_id(h, vendor, device):
    d = glob_dirs(os.path.join(h.sys, "bus/pci/devices"),
                  lambda p: rd(f"{p}/vendor") == vendor and rd(f"{p}/device") == device)
    return d[0] if d else None


def usb_by_id(h, vendor, product):
    d = glob_dirs(os.path.join(h.sys, "bus/usb/devices"),
                  lambda p: rd(f"{p}/idVendor") == vendor and rd(f"{p}/idProduct") == product)
    return d[0] if d else None


# --------------------------------------------------------------- knobs
# Each knob: check(value) raises on a value outside its range; get() reads the current
# value as a string; set(value) writes it. The original is what get() said before the
# first set in a session, and restore is set(original).
class Knob:
    def __init__(self, what, values, get, set_):
        self.what, self.values, self.get, self.set = what, values, get, set_

    def check(self, h, v):
        allowed = self.values(h) if callable(self.values) else self.values
        if isinstance(allowed, range):
            if not re.fullmatch(r"[0-9]{1,6}", v) or int(v) not in allowed:
                fail(f"value {v!r} out of range {allowed.start}..{allowed.stop - 1}")
        elif isinstance(allowed, re.Pattern):
            if not allowed.fullmatch(v):
                fail(f"value {v!r} not of the form {allowed.pattern}")
        elif v not in allowed:
            fail(f"value {v!r} not one of {', '.join(sorted(allowed))}")


def _need(path, what):
    if not path or not os.path.exists(path):
        fail(f"{what} absent")
    return path


def _nvme_params(h):
    return os.path.join(h.sys, "module/nvme_core/parameters")


def _nvme_get(h):
    p = _nvme_params(h)
    _need(os.path.join(p, "apst_primary_timeout_ms"), "nvme_core APST parameters")
    return f"{rd(p + '/apst_primary_timeout_ms')}/{rd(p + '/apst_secondary_timeout_ms')}"


def _nvme_set(h, v):
    p = _nvme_params(h)
    prim, sec = v.split("/")
    if int(prim) > 60000 or int(sec) > 60000:
        fail("APST timeouts are at most 60000 ms")
    wr(os.path.join(p, "apst_primary_timeout_ms"), prim)
    wr(os.path.join(p, "apst_secondary_timeout_ms"), sec)
    # APST is set up when the controller starts and when its latency tolerance changes:
    # step the tolerance by one and back, so the new timeouts take effect.
    for q in glob_dirs(os.path.join(h.sys, "class/nvme"), lambda d: os.path.exists(f"{d}/power/pm_qos_latency_tolerance_us")):
        q += "/power/pm_qos_latency_tolerance_us"
        cur = rd(q)
        if cur.isdigit():
            wr(q, int(cur) + 1)
            wr(q, cur)


SD_ID = ("0x17a0", "0x9767")  # Genesys GL9767 SD reader (#226)


def _sd_get(h):
    return "present" if pci_by_id(h, *SD_ID) else "removed"


def _sd_set(h, v, state=None):
    # state: the reader's PCI name and its port, recorded while it is present
    dev = pci_by_id(h, *SD_ID)
    if v == "removed":
        if dev:
            wr(os.path.join(dev, "remove"), 1)
        return
    if dev:
        return
    port = state.get("port") if state else None
    if not port or not os.path.isdir(port):
        fail("the SD reader's port is unknown; it returns at the next boot")
    ctl = rd(f"{port}/power/control")
    # Rescan below the reader's port only, with the port held awake so its bus can be read.
    wr(f"{port}/power/control", "on")
    wr(f"{port}/rescan" if os.path.exists(f"{port}/rescan") else os.path.join(h.sys, "bus/pci/rescan"), 1)
    for _ in range(10):
        if pci_by_id(h, *SD_ID):
            break
        time.sleep(0.5)
    if ctl:
        wr(f"{port}/power/control", ctl)
    if not pci_by_id(h, *SD_ID):
        fail("the SD reader did not come back (it returns at the next boot)")


def _sd_state(h):
    dev = pci_by_id(h, *SD_ID)
    return {"port": os.path.realpath(os.path.join(dev, ".."))} if dev else {}


def _power_control(find, what):
    def get(h):
        d = _need(find(h), what)
        return rd(f"{d}/power/control")

    def set_(h, v):
        wr(f"{_need(find(h), what)}/power/control", v)
    return get, set_


def _leds(h):
    return [f"{d}/brightness" for d in glob_dirs(os.path.join(h.sys, "class/leds"),
                                                  lambda p: p.endswith("::numlock") and os.path.exists(f"{p}/brightness"))]


def _numlock_get(h):
    leds = _leds(h)
    if not leds:
        fail("no Num Lock LED")
    return "1" if any(rd(f) not in ("", "0") for f in leds) else "0"


def _numlock_set(h, v):
    for f in _leds(h):
        wr(f, v)


def _wlan(h):
    d = glob_dirs(os.path.join(h.sys, "class/net"),
                  lambda p: os.path.isdir(f"{p}/wireless") or os.path.exists(f"{p}/phy80211"))
    if not d:
        fail("no Wi-Fi interface")
    return os.path.basename(d[0])


def _wifi_get(h):
    _, out = h.run(["iw", "dev", _wlan(h), "get", "power_save"])
    v = out.split()[-1] if out.split() else ""
    if v not in ("on", "off"):
        fail("Wi-Fi power save unreadable")
    return v


def _wifi_set(h, v):
    h.run(["iw", "dev", _wlan(h), "set", "power_save", v])


def _rfkill_bt(h):
    d = glob_dirs(os.path.join(h.sys, "class/rfkill"), lambda p: rd(f"{p}/type") == "bluetooth")
    if not d:
        fail("no Bluetooth rfkill switch")
    return f"{d[0]}/soft"


def _panel(h):
    d = glob_dirs(os.path.join(h.sys, "class/drm"),
                  lambda p: "-eDP-" in os.path.basename(p) and os.path.exists(f"{p}/amdgpu/panel_power_savings"))
    if not d:
        fail("no panel_power_savings on the eDP panel")
    return f"{d[0]}/amdgpu/panel_power_savings"


def _profile(h):
    return _need(os.path.join(h.sys, "firmware/acpi/platform_profile"), "platform_profile")


def _profile_choices(h):
    return set(rd(os.path.join(h.sys, "firmware/acpi/platform_profile_choices")).split())


def _file_knob(path_of):
    return (lambda h: rd(path_of(h))), (lambda h, v: wr(path_of(h), v))


_sd_dev = lambda h: pci_by_id(h, *SD_ID)  # noqa: E731
_kbd_dev = lambda h: usb_by_id(h, "0b05", "19b6")  # noqa: E731

