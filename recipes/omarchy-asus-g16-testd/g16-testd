# --------------------------------------------------------------- the daemon
class Daemon:
    def __init__(self, h, uid, expires, modules, stay_awake_before="unknown"):
        self.h, self.uid, self.expires, self.modules = h, uid, expires, modules
        self.stay_awake_before, self.idle_put_back = stay_awake_before, False
        self.rec = {"boot_id": h.boot_id(), "knobs": {}, "modules": {}, "dropins": [],
                    "ec_loaded": False, "traces": {}, "frozen": {}}
        self.records = os.path.join(h.state, "records.json")
        self.stopping = False

    # -- records: written before every change, so a crash still knows what to put back
    def save(self):
        os.makedirs(self.h.state, mode=0o700, exist_ok=True)
        tmp = self.records + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.rec, f, indent=1)
        os.replace(tmp, self.records)

    def recover(self):
        """Put back what a previous daemon left changed (it crashed or was killed)."""
        try:
            with open(self.records) as f:
                old = json.load(f)
        except (OSError, ValueError):
            return
        dropins = [d for d in old.get("dropins", []) if d in DROPINS]
        if old.get("boot_id") == self.rec["boot_id"]:
            self.rec.update({k: old.get(k, v) for k, v in self.rec.items() if k not in ("boot_id", "dropins")})
            log(f"recovering the previous session's changes: {self.summary()}")
            self.restore_runtime()
        else:
            log("previous session was in an earlier boot: its runtime changes reset with it")
        # Drop-ins survive the reboot they were made for; they stay recorded until stop.
        self.rec["dropins"] = dropins
        self.save()

    def summary(self):
        r = self.rec
        return ", ".join(f"{k}={len(r[k]) if not isinstance(r[k], bool) else r[k]}"
                         for k in ("knobs", "modules", "dropins", "traces", "frozen", "ec_loaded"))

    def restore_runtime(self):
        """Everything but the boot drop-ins; each failure logged, the rest still tried."""
        errs = []
        for scope in list(self.rec["frozen"]):
            self._try(errs, self.thaw, scope)
        for name in list(self.rec["traces"]):
            self._try(errs, self.trace_stop, name, False)
        for name in list(self.rec["modules"]):
            self._try(errs, self.module_restore, name)
        for name in list(self.rec["knobs"]):
            self._try(errs, self.knob_restore, name)
        if self.rec["ec_loaded"]:
            self._try(errs, self.ec_unload)
        self._try(errs, self.idle_restore)
        return errs

    def idle_restore(self):
        """Omarchy's stay-awake back off, as the user, only if it was off at start."""
        if self.stay_awake_before != "off" or self.idle_put_back:
            return
        self.idle_put_back = True
        try:
            pw = pwd.getpwuid(self.uid)
        except KeyError:
            fail(f"uid {self.uid} has no passwd entry; stay-awake left on")
        self.h.run(["setpriv", f"--reuid={self.uid}", f"--regid={pw.pw_gid}", "--init-groups",
                    "--reset-env", "omarchy-toggle-idle", "allow-idle"])

    def restore_all(self):
        errs = self.restore_runtime()
        for name in list(self.rec["dropins"]):
            self._try(errs, self.boot_dropin, name, "off")
        return errs

    @staticmethod
    def _try(errs, fn, *a):
        try:
            fn(*a)
        except Refused as e:
            errs.append(str(e))
            log(f"restore: {e}")

    # -- knobs
    def knob_set(self, name, value):
        k = KNOBS.get(name) or fail(f"unknown knob {name!r} (g16-testd list)")
        k.check(self.h, value)
        if name not in self.rec["knobs"]:
            orig = {"value": k.get(self.h)}
            if name == "sd-reader":
                orig.update(_sd_state(self.h))
            self.rec["knobs"][name] = orig
            self.save()
        if name == "sd-reader":
            _sd_set(self.h, value, self.rec["knobs"][name])
        else:
            k.set(self.h, value)
        return k.get(self.h)

    def knob_restore(self, name):
        k = KNOBS.get(name) or fail(f"unknown knob {name!r}")
        orig = self.rec["knobs"].get(name)
        if orig is None:
            return "not changed"
        if name == "sd-reader":
            _sd_set(self.h, orig["value"], orig)
        else:
            k.set(self.h, orig["value"])
        del self.rec["knobs"][name]
        self.save()
        return k.get(self.h)

    # -- EC RAM, read-only
    def ec_read(self, offset, length):
        o, n = _int(offset, 0, 255, "offset"), _int(length, 1, 256, "length")
        if o + n > 256:
            fail("offset + length is past the 256-byte EC RAM")
        mod = os.path.join(self.h.sys, "module/ec_sys")
        if os.path.isdir(mod):
            if rd(f"{mod}/parameters/write_support") not in ("N", "0"):
                fail("ec_sys is loaded with write_support on; unload it first (this helper never writes the EC)")
        else:
            self.rec["ec_loaded"] = True
            self.save()
            self.h.run(["modprobe", "ec_sys", "write_support=0"])
        io = os.path.join(self.h.sys, "kernel/debug/ec/ec0/io")
        try:
            with open(io, "rb") as f:
                f.seek(o)
                data = f.read(n)
        except OSError as e:
            fail(f"cannot read {io}: {e.strerror}")
        return data.hex()

    def ec_unload(self):
        self.h.run(["modprobe", "-r", "ec_sys"])
        self.rec["ec_loaded"] = False
        self.save()

    # -- tracing
    def trace_start(self, name, events, kprobes="-", buffer_kb="16384"):
        if not NAME_RE.fullmatch(name):
            fail("instance name: lowercase letters, digits and dashes, up to 32")
        if name in self.rec["traces"]:
            fail(f"trace {name} is already running")
        ev = [] if events == "-" else events.split(",")
        kp = [] if kprobes == "-" else kprobes.split(",")
        bad = [e for e in ev if e not in EVENTS] + [k for k in kp if k not in KPROBES]
        if bad:
            fail(f"not on the allowlist: {', '.join(bad)} (g16-testd list)")
        if not ev and not kp:
            fail("no events and no kprobes")
        kb = _int(buffer_kb, 64, 65536, "buffer_kb")
        base = self.h.tracefs()
        if not os.path.isdir(os.path.join(base, "instances")):
            fail(f"no tracefs at {base}")
        inst = os.path.join(base, "instances", f"g16-testd-{name}")
        self.rec["traces"][name] = {"started": time.time(), "kprobes": kp}
        self.save()
        try:
            self.h.mkinstance(inst)
        except OSError as e:
            del self.rec["traces"][name]
            self.save()
            fail(f"cannot create the tracefs instance: {e.strerror}")
        wr(f"{inst}/tracing_on", 0)
        wr(f"{inst}/buffer_size_kb", kb)
        for k in kp:
            self._kprobe_add(base, k)
        on, missing = [], []
        for e in ev + [f"g16testd/{_kp_event(k)}" for k in kp]:
            f = f"{inst}/events/{e}/enable"
            if os.path.exists(f):
                wr(f, 1)
                on.append(e)
            else:
                missing.append(e)
        if not on:
            self.trace_stop(name, False)
            fail("none of the events exist in this kernel")
        wr(f"{inst}/tracing_on", 1)
        return {"on": on, "missing": missing}

    def _kprobe_add(self, base, k):
        line = f"p:g16testd/{_kp_event(k)} {KPROBES[k]}\n"
        try:
            with open(os.path.join(base, "kprobe_events"), "a") as f:
                f.write(line)
        except OSError as e:
            fail(f"kprobe {k} ({KPROBES[k]}) refused: {e.strerror}")

    def trace_stop(self, name, keep=True):
        t = self.rec["traces"].get(name) or fail(f"no trace {name} running")
        base = self.h.tracefs()
        inst = os.path.join(base, "instances", f"g16-testd-{name}")
        out = None
        if os.path.isdir(inst):
            wr(f"{inst}/tracing_on", 0)
            if keep:
                outdir = os.path.join(self.h.run_dir, "out")
                os.makedirs(outdir, mode=0o755, exist_ok=True)
                out = os.path.join(outdir, f"{name}.trace")
                with open(f"{inst}/trace", "rb") as src, open(out, "wb") as dst:
                    shutil.copyfileobj(src, dst)
                if not self.h.fake:
                    os.chown(out, self.uid, -1)
                os.chmod(out, 0o600)
            self.h.rmdir(inst)
        in_use = {k for n, o in self.rec["traces"].items() if n != name for k in o["kprobes"]}
        for k in t["kprobes"]:
            if k not in in_use:
                try:
                    with open(os.path.join(base, "kprobe_events"), "a") as f:
                        f.write(f"-:g16testd/{_kp_event(k)}\n")
                except OSError as e:
                    log(f"kprobe {k} removal refused: {e.strerror}")
        del self.rec["traces"][name]
        self.save()
        return out or "discarded"

    # -- modules
    def module_swap(self, name, path):
        if not MODULE_RE.fullmatch(name):
            fail("bad module name")
        want = self.modules.get(name) or fail(f"module {name} is not on this session's list (session start --module)")
        if name in self.rec["modules"]:
            fail(f"{name} is already swapped; module-restore it first")
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError as e:
            fail(f"cannot open {path}: {e.strerror}")
        st = os.fstat(fd)
        # Read as root, so only a file the caller could read too: theirs, or anyone's.
        if not stat.S_ISREG(st.st_mode) or not (st.st_uid == self.uid or st.st_mode & 0o004):
            os.close(fd)
            fail(f"{path} is not a regular file you own or anyone can read")
        # Hash the copy that will be loaded, not the caller's file, which could change.
        store = os.path.join(self.h.state, "modules")
        os.makedirs(store, mode=0o700, exist_ok=True)
        copy = os.path.join(store, f"{name}-{want[:16]}.ko" + _ko_suffix(path))
        with os.fdopen(fd, "rb") as src, open(copy, "wb") as dst:
            shutil.copyfileobj(src, dst)
        got = sha256(copy)
        if got != want:
            os.unlink(copy)
            fail(f"{path} has sha256 {got}, not this session's {want}")
        _, inner = self.h.run(["modinfo", "-F", "name", copy])
        if inner.strip().replace("-", "_") != name.replace("-", "_"):
            os.unlink(copy)
            fail(f"{path} is module {inner.strip() or '?'}, not {name}")
        loaded = os.path.isdir(os.path.join(self.h.sys, "module", name.replace("-", "_")))
        self.rec["modules"][name] = {"stock_loaded": loaded, "copy": copy}
        self.save()
        if loaded:
            self.h.run(["rmmod", name])
        rc, _ = self.h.run(["insmod", copy], check=False)
        if rc != 0:
            self.module_restore(name)
            fail(f"insmod {name} failed; the stock module is back")
        return f"{name} {want[:12]} loaded"

    def module_restore(self, name):
        r = self.rec["modules"].get(name)
        if r is None:
            return "not swapped"
        if os.path.isdir(os.path.join(self.h.sys, "module", name.replace("-", "_"))):
            self.h.run(["rmmod", name])
        if r["stock_loaded"]:
            self.h.run(["modprobe", name])
        try:
            os.unlink(r["copy"])
        except OSError:
            pass
        del self.rec["modules"][name]
        self.save()
        return f"{name}: stock module {'loaded' if r['stock_loaded'] else 'left unloaded, as before'}"

    # -- boot drop-ins
    def boot_dropin(self, name, state):
        if name not in DROPINS:
            fail(f"unknown drop-in {name!r} (g16-testd list)")
        if state not in ("on", "off"):
            fail("state is on or off")
        f = os.path.join(self.h.etc_dropins, f"{UNIT}-{name}.conf")
        if state == "on":
            if name not in self.rec["dropins"]:
                self.rec["dropins"].append(name)
                self.save()
            os.makedirs(self.h.etc_dropins, mode=0o755, exist_ok=True)
            with open(f, "w") as fh:
                fh.write(f"# {UNIT}: test session drop-in {name} (#277); removed by g16-testd session stop.\n"
                         f'KERNEL_CMDLINE[default]+="{DROPINS[name]}"\n')
        else:
            try:
                os.unlink(f)
            except FileNotFoundError:
                pass
        self.h.run(["limine-update"])
        if state == "off" and name in self.rec["dropins"]:
            self.rec["dropins"].remove(name)
            self.save()
        return {"cmdlines": self.cmdlines()}

    def cmdlines(self):
        esp = "/boot"
        for line in rd(self.h.default_limine).splitlines():
            m = re.match(r'^ESP_PATH="?([^"]*)"?$', line.strip())
            if m:
                esp = m.group(1)
        root = self.h.root
        for c in ("limine.conf", "EFI/limine/limine.conf", "limine/limine.conf", "EFI/BOOT/limine.conf"):
            p = os.path.join(root, esp.lstrip("/"), c)
            if os.path.isfile(p):
                seen = []
                for line in rd(p).splitlines():
                    m = re.match(r"^\s*(?:kernel_)?cmdline:\s*(.*)$", line)
                    if m and m.group(1) not in seen:
                        seen.append(m.group(1))
                return seen
        return ["(no limine.conf found: check the boot menu by hand before rebooting)"]

    # -- freezing user app scopes
    def _scope(self, scope):
        if not re.fullmatch(r"app-[A-Za-z0-9_.@:\\-]{1,200}\.scope", scope):
            fail("only user app scopes (app-*.scope), never services")
        top = os.path.join(self.h.sys, f"fs/cgroup/user.slice/user-{self.uid}.slice/user@{self.uid}.service/app.slice")
        for d, subdirs, _ in os.walk(top):
            if scope in subdirs:
                return os.path.join(d, scope)
            subdirs[:] = [s for s in subdirs if s.startswith("app") and s.endswith(".slice")]
        fail(f"no scope {scope} in your app.slice")

    def freeze(self, scope, seconds=str(FREEZE_DEFAULT)):
        s = _int(seconds, 1, FREEZE_MAX, "seconds")
        cg = self._scope(scope)
        self.rec["frozen"][scope] = {"path": cg, "until": time.time() + s}
        self.save()
        wr(f"{cg}/cgroup.freeze", 1)
        return f"frozen for at most {s} s"

    def thaw(self, scope):
        r = self.rec["frozen"].get(scope) or fail(f"{scope} is not frozen by this session")
        if os.path.isdir(r["path"]):
            wr(f"{r['path']}/cgroup.freeze", 0)
        del self.rec["frozen"][scope]
        self.save()
        return "thawed"

    def watchdogs(self):
        now = time.time()
        for scope, r in list(self.rec["frozen"].items()):
            if now >= r["until"]:
                log(f"watchdog: thawing {scope}")
                self._try([], self.thaw, scope)
        for name, t in list(self.rec["traces"].items()):
            if now - t["started"] > TRACE_MAX_SECONDS:
                log(f"watchdog: trace {name} ran {TRACE_MAX_SECONDS} s; stopping it, kept for trace-stop")
                self._try([], self.trace_stop, name, True)

    def status(self):
        return {"uid": self.uid, "expires": int(self.expires), "left_s": int(self.expires - time.time()),
                "knobs": {k: v["value"] for k, v in self.rec["knobs"].items()},
                "modules": sorted(self.rec["modules"]), "dropins": self.rec["dropins"],
                "traces": sorted(self.rec["traces"]), "frozen": sorted(self.rec["frozen"]),
                "ec_loaded": self.rec["ec_loaded"], "session_modules": self.modules,
                "stay_awake_before": self.stay_awake_before}

    METHODS = {
        "ec-read": "ec_read", "trace-start": "trace_start", "trace-stop": "trace_stop",
        "knob-set": "knob_set", "knob-restore": "knob_restore", "module-swap": "module_swap",
        "module-restore": "module_restore", "boot-dropin": "boot_dropin", "freeze": "freeze",
        "thaw": "thaw", "status": "status",
    }

    def handle(self, req, peer):
        method, args, reason = req.get("method"), req.get("args", []), clean(req.get("reason", ""))
        if not isinstance(args, list) or not all(isinstance(a, str) and len(a) < 4096 for a in args):
            fail("bad arguments")
        log(f"call {method} {' '.join(args)!r} by uid {peer[1]} pid {peer[0]}: {reason or '-'}")
        if method == "stop":
            errs = self.restore_all()
            self.stopping = True
            return {"restored": not errs, "errors": errs}
        if method != "status" and not reason:
            fail("--reason is required")
        fn = self.METHODS.get(method) or fail(f"unknown method {method!r}")
        if method == "trace-stop":
            args = args[:1]
        f = getattr(self, fn)
        try:
            inspect.signature(f).bind(*args)
        except TypeError:
            fail(f"wrong number of arguments for {method}")
        return f(*args)

    def serve(self):
        os.makedirs(self.h.run_dir, mode=0o755, exist_ok=True)
        sock_path = os.path.join(self.h.run_dir, "socket") if not self.h.fake else SOCKET
        try:
            os.unlink(sock_path)
        except FileNotFoundError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        srv.bind(sock_path)
        os.umask(old)
        if not self.h.fake:
            os.chown(sock_path, self.uid, -1)
        os.chmod(sock_path, 0o600)
        srv.listen(8)
        srv.settimeout(1.0)
        log(f"session open for uid {self.uid} until {time.strftime('%F %T', time.localtime(self.expires))}")
        try:
            while not self.stopping:
                if time.time() >= self.expires:
                    log("session expired: putting everything back")
                    self.restore_all()
                    break
                self.watchdogs()
                try:
                    conn, _ = srv.accept()
                except socket.timeout:
                    continue
                with conn:
                    self.answer(conn)
        finally:
            srv.close()
            try:
                os.unlink(sock_path)
            except FileNotFoundError:
                pass
        if not self.restore_runtime() and not self.rec["dropins"]:
            try:
                os.unlink(self.records)
            except FileNotFoundError:
                pass
        log("session closed")

    def answer(self, conn):
        conn.settimeout(10)
        pid, uid, _ = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
        try:
            if uid not in (self.uid, 0):
                fail(f"uid {uid} is not this session's user")
            buf = b""
            while not buf.endswith(b"\n") and len(buf) < 65536:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                buf += chunk
            req = json.loads(buf or b"{}")
            if not isinstance(req, dict):
                fail("bad request")
            reply = {"ok": True, "result": self.handle(req, (pid, uid))}
        except Refused as e:
            log(f"refused (uid {uid} pid {pid}): {e}")
            reply = {"ok": False, "error": str(e)}
        except (ValueError, OSError) as e:
            reply = {"ok": False, "error": f"{type(e).__name__}: {e}"}
        try:
            conn.sendall((json.dumps(reply) + "\n").encode())
        except OSError:
            pass


def _kp_event(k):
    return k.replace("-", "_")


def _ko_suffix(path):
    for s in (".zst", ".xz", ".gz"):
        if path.endswith(".ko" + s):
            return s
    return ""


def _int(v, lo, hi, what):
    if not re.fullmatch(r"(0x)?[0-9a-fA-F]{1,6}", v):
        fail(f"{what}: not a number")
    n = int(v, 16) if v.startswith("0x") else int(v)
    if not lo <= n <= hi:
        fail(f"{what} {n} out of range {lo}..{hi}")
    return n


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def clean(s):
    return re.sub(r"[^\x20-\x7e]", "?", str(s))[:200]


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def parse_modules(items):
    mods = {}
    for m in items or []:
        name, _, sha = m.partition("=")
        if not MODULE_RE.fullmatch(name) or not SHA_RE.fullmatch(sha):
            raise SystemExit(f"g16-testd: --module wants NAME=SHA256, got {m!r}")
        mods[name] = sha
    return mods


def is_ga605km(sys_root="/sys"):
    d = os.path.join(sys_root, "class/dmi/id")
    return (rd(f"{d}/sys_vendor") == "ASUSTeK COMPUTER INC." and "ROG" in rd(f"{d}/product_family")
            and ("GA605KM" in rd(f"{d}/product_name").upper() or "GA605KM" in rd(f"{d}/product_family").upper()))


# --------------------------------------------------------------- root entry points
def cmd_daemon(a):
    if not a.fake and os.geteuid() != 0:
        raise SystemExit("g16-testd daemon: runs as root, from session start")
    d = Daemon(Host(a.fake), a.uid, a.expires, parse_modules(a.module), a.stay_awake_before)
    stop = lambda *_: setattr(d, "stopping", True)  # noqa: E731
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGHUP, stop)
    d.recover()
    d.serve()
    return 0


def cmd_root_start(a):
    """Run by pkexec: start the daemon as a transient system unit for the calling user."""
    if os.geteuid() != 0:
        raise SystemExit("g16-testd root-start: run by session start through pkexec")
    uid = os.environ.get("PKEXEC_UID", "")
    if not uid.isdigit() or int(uid) == 0:
        raise SystemExit("g16-testd root-start: no calling user (PKEXEC_UID)")
    if not is_ga605km():
        raise SystemExit("g16-testd: this is not an ASUS ROG Zephyrus G16 GA605KM; no session opened")
    hours = a.hours
    if not 0 < hours <= MAX_HOURS:
        raise SystemExit(f"g16-testd: --hours is 0..{MAX_HOURS}")
    mods = parse_modules(a.module)
    if subprocess.run(["systemctl", "is-active", "-q", f"{UNIT}.service"]).returncode == 0:
        raise SystemExit("g16-testd: a session is already open (g16-testd session stop ends it)")
    subprocess.run(["systemctl", "reset-failed", f"{UNIT}.service"], capture_output=True)
    expires = int(time.time() + hours * 3600)
    argv = ["systemd-run", f"--unit={UNIT}", "--description=G16 test session root helper (#277)",
            "--collect", "-p", f"RuntimeMaxSec={int(hours * 3600) + 300}", "-p", "TimeoutStopSec=120",
            LIBEXEC, "daemon", "--uid", uid, "--expires", str(expires), "--stay-awake-before", a.stay_awake_before]
    for n, s in mods.items():
        argv += ["--module", f"{n}={s}"]
    subprocess.run(argv, check=True, capture_output=True)
    for _ in range(50):
        if os.path.exists(SOCKET):
            print(f"g16-testd: session open until {time.strftime('%F %T', time.localtime(expires))}")
            return 0
        time.sleep(0.2)
    raise SystemExit(f"g16-testd: the daemon did not come up; journalctl -u {UNIT}")


# --------------------------------------------------------------- client
IDLE_RECORD = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                           UNIT, "stay-awake-before")


def idle(action):
    """omarchy-toggle-idle as this user; status -> on/off, or unknown without it."""
    try:
        p = subprocess.run(["omarchy-toggle-idle", action], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    if action != "status":
        return "ok" if p.returncode == 0 else "unknown"
    try:
        return "on" if json.loads(p.stdout).get("enabled") else "off"
    except (ValueError, AttributeError):
        return "unknown"


def idle_put_back_leftover():
    """A session that ended without its daemon's restore left the record behind."""
    try:
        with open(IDLE_RECORD) as f:
            before = f.read().strip()
    except OSError:
        return
    if before == "off":
        idle("allow-idle")
        print("g16-testd: stay-awake from an earlier session put back off")
    os.unlink(IDLE_RECORD)


def call(method, args=(), reason=""):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCKET)
    except (FileNotFoundError, ConnectionRefusedError):
        return None
    except PermissionError:
        return {"ok": False, "error": "the open session belongs to another user"}
    with s:
        s.settimeout(300)
        s.sendall((json.dumps({"method": method, "args": list(args), "reason": reason}) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    try:
        return json.loads(buf)
    except ValueError:
        return {"ok": False, "error": "no answer from the daemon"}


def show(reply):
    if reply is None:
        print("g16-testd: no session open (g16-testd session start)", file=sys.stderr)
        return 3
    if not reply.get("ok"):
        print(f"g16-testd: {reply.get('error')}", file=sys.stderr)
        return 1
    r = reply.get("result")
    if isinstance(r, str):
        print(r)
    elif isinstance(r, dict) and "cmdlines" in r:
        print("kernel command lines after the next boot:")
        for c in r["cmdlines"]:
            print(f"  {c}")
    else:
        print(json.dumps(r, indent=1, sort_keys=True))
    return 0


def cmd_session(a):
    if a.action == "start":
        if os.geteuid() == 0:
            raise SystemExit("g16-testd: run session start as your normal user")
        if call("status") is not None:
            print("g16-testd: a session is already open", file=sys.stderr)
            return 1
        mods = parse_modules(a.module)
        idle_put_back_leftover()
        before = idle("status")
        argv = ["pkexec", LIBEXEC, "root-start", "--hours", str(a.hours), "--stay-awake-before", before]
        for n, s in mods.items():
            argv += ["--module", f"{n}={s}"]
        why = f"Open a {a.hours} h G16 test session: fixed, allowlisted root steps, all put back at the end"
        # Through the desktop's polkit agent, like the kits (systemd-run --user), so a
        # terminal or agent outside the graphical session still gets the dialog.
        wrap = os.environ.get("G16_POLKIT_REASON")
        if wrap:
            argv = ["systemd-run", "--user", "--wait", "-q", "-P", wrap, "run", why, "--"] + argv
        else:
            argv = ["systemd-run", "--user", "--wait", "-q", "-P", argv[0], "--disable-internal-agent"] + argv[1:]
        rc = subprocess.run(argv).returncode
        if rc == 0:
            os.makedirs(os.path.dirname(IDLE_RECORD), exist_ok=True)
            with open(IDLE_RECORD, "w") as f:
                f.write(before + "\n")
            idle("stay-awake")
            print(f"g16-testd: stay-awake on for the session (it was {before})")
        return rc
    if a.action == "stop":
        r = call("stop", reason="session stop")
        if r is None:
            print("g16-testd: no session open; nothing to put back")
            return 0
        if r.get("ok"):
            try:
                os.unlink(IDLE_RECORD)  # the daemon put stay-awake back
            except FileNotFoundError:
                pass
        if r.get("ok") and r["result"]["restored"]:
            print("g16-testd: everything put back; session closed")
            return 0
        print(f"g16-testd: closed, but these did not go back: {r.get('error') or r['result']['errors']}", file=sys.stderr)
        return 1
    return show(call("status"))


def cmd_list(_a):
    print("knobs (knob-set NAME VALUE):")
    for n, k in KNOBS.items():
        v = k.values
        vs = ("from platform_profile_choices" if callable(v) else f"{v.start}..{v.stop - 1}" if isinstance(v, range)
              else v.pattern if isinstance(v, re.Pattern) else "|".join(sorted(v)))
        print(f"  {n:20} {vs:22} {k.what}")
    print("trace events (trace-start):\n  " + "\n  ".join(sorted(EVENTS)))
    print("kprobes (trace-start):\n  " + "\n  ".join(f"{k:22} {s}" for k, s in KPROBES.items()))
    print("boot drop-ins (boot-dropin NAME on|off):\n  " + "\n  ".join(f"{k:22}{s}" for k, s in DROPINS.items()))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="g16-testd", description="One root helper per G16 test session (#277).")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("session")
    s.add_argument("action", choices=["start", "stop", "status"])
    s.add_argument("--hours", type=float, default=DEFAULT_HOURS)
    s.add_argument("--module", action="append")
    sub.add_parser("available")
    sub.add_parser("list")
    c = sub.add_parser("call")
    c.add_argument("method", choices=sorted(Daemon.METHODS))
    c.add_argument("args", nargs="*")
    c.add_argument("--reason", default="")
    d = sub.add_parser("daemon")
    d.add_argument("--uid", type=int, required=True)
    d.add_argument("--expires", type=float, required=True)
    d.add_argument("--module", action="append")
    d.add_argument("--stay-awake-before", choices=["on", "off", "unknown"], default="unknown")
    d.add_argument("--fake", help=argparse.SUPPRESS)
    r = sub.add_parser("root-start")
    r.add_argument("--hours", type=float, default=DEFAULT_HOURS)
    r.add_argument("--module", action="append")
    r.add_argument("--stay-awake-before", choices=["on", "off", "unknown"], default="unknown")
    a = p.parse_args(argv)
    # Through pkexec only root-start runs: the dialog's action is opening a session.
    if os.geteuid() == 0 and os.environ.get("PKEXEC_UID") and a.cmd != "root-start":
        raise SystemExit("g16-testd: through pkexec, only root-start")
    if a.cmd == "session":
        return cmd_session(a)
    if a.cmd == "available":
        r = call("status")
        return 0 if r and r.get("ok") else 3
    if a.cmd == "list":
        return cmd_list(a)
    if a.cmd == "call":
        return show(call(a.method, a.args, a.reason))
    if a.cmd == "daemon":
        return cmd_daemon(a)
    return cmd_root_start(a)


if __name__ == "__main__":
    sys.exit(main())
