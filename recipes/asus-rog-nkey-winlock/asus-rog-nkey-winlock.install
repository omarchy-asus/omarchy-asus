# Re-run the hidraw rules so the keyboard node gets its uaccess ACL now,
# without a reboot or a replug. The user unit is enabled by the package
# itself (default.target.wants) and starts at the next login.
_g16_winlock_trigger() {
  udevadm control --reload >/dev/null 2>&1 || true
  udevadm trigger --action=change --subsystem-match=hidraw >/dev/null 2>&1 || true
}

post_install() {
  _g16_winlock_trigger
  echo ':: g16-winlock starts at your next login. To start it now:'
  echo '   systemctl --user start g16-winlock.service'
}

post_upgrade() {
  _g16_winlock_trigger
}
