<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>omarchy-asus</vendor>
  <vendor_url>https://github.com/omarchy-asus/omarchy-asus</vendor_url>
  <action id="io.github.omarchy-asus.winlock.set-locked">
    <description>Lock or unlock the Windows key of the ROG N-Key keyboard</description>
    <message>Authentication is required to change the Windows key lock</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
