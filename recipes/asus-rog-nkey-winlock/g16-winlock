#!/usr/bin/env python3
"""G16 / ROG N-Key Win-lock helper (ASUS 0b05:19b6).

Modes for `watch`:
  toast   — bottom-center Omarchy OSD when Fn+Super toggles Win-lock
  unlock  — same OSD, then immediately clear the lock (Active Guard)

Also: lock | unlock | status | toggle  (one-shot control)
`status` prints locked=True/False, or locked=unknown and exits 3 while the
service doesn't know yet (nothing reports the lock until the first Fn+Super).

The keyboard belongs to the root service g16-winlockd: this helper opens no
device. It follows the service's LockChanged signal and calls its Status and
SetLocked methods over the system bus (gdbus, from glib2).

Depends on the patched hid-asus passing 5D BF Win-lock notifications through
to hidraw instead of dropping them with the AURA echo stream.
"""
from __future__ import annotations

import argparse
import glob
import os
import json
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

VID, PID = 0x0B05, 0x19B6
BUS_NAME = "io.github.omarchy_asus.WinLock1"
OBJECT_PATH = "/io/github/omarchy_asus/WinLock1"
SYSFS = os.environ.get("G16_WINLOCK_SYSFS", "/sys/class/hidraw")  # tests move it
CALL_TIMEOUT_S = 30  # SetLocked may wait on polkit
UNKNOWN_ERROR = f"{BUS_NAME}.Error.Unknown"

# OSD icons (bottom-center omarchy-osd). Locked uses the color-emoji lock
# because Omarchy OSD paints Nerd Font glyphs with popup text color only.
ICON_LOCKED = "🔒"       # red lock — stays locked (toast mode)
ICON_UNLOCKED = "󰌿"     # lock-open — Super cleared
ICON_AUTO_UNLOCK = "󰕥"  # shield-check — unlock mode blocked Fn+Super
ICON_FAIL = "󰀦"


def keyboard_present() -> bool:
    """Whether any hidraw node belongs to the 0b05:19b6 keyboard (sysfs only)."""
    for uevent in glob.glob(f"{SYSFS}/hidraw*/device/uevent"):
        try:
            if f"{VID:08X}:{PID:08X}" in Path(uevent).read_text(errors="replace").upper():
                return True
        except OSError:
            continue
    return False


def _call(method: str, *args: str) -> str:
    """Call a g16-winlockd method; its reply as gdbus prints it, e.g. "(true,)"."""
    cmd = ["gdbus", "call", "--system", "--dest", BUS_NAME, "--object-path", OBJECT_PATH,
           "--method", f"{BUS_NAME}.{method}", *args]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=CALL_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise SystemExit(f"g16-winlockd {method}: {e}") from e
    if r.returncode != 0:
        raise SystemExit(f"g16-winlockd {method}: {r.stderr.strip() or 'failed'}")
    return r.stdout.strip()


def set_lock(locked: bool) -> None:
    """SetLocked(b): the service writes SetFeature 5D BF 00 xx and the 01 01 commit."""
    _call("SetLocked", "true" if locked else "false")
    print(f"Win-lock {'on' if locked else 'off'}", flush=True)


def query_status() -> bool | None:
    """Status(): True/False, or None while the service doesn't know (no Fn+Super or
    SetLocked since it started). Other failures raise SystemExit."""
    try:
        reply = _call("Status")
    except SystemExit as e:
        if UNKNOWN_ERROR in str(e):
            return None
        raise
    return reply == "(true,)"


NOTIFY_TIMEOUT_S = 5  # a stuck notifier must not stall the report loop


def _run_notifier(cmd: list[str]) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=NOTIFY_TIMEOUT_S)
    except (subprocess.TimeoutExpired, OSError) as e:
        print(f"notifier {cmd[0]} failed: {e}", flush=True)
        return None


def toast(message: str, *, icon: str = ICON_LOCKED, duration_ms: int = 2000) -> None:
    """Bottom-center Omarchy OSD, not top-right notifications.

    Tries omarchy-osd, then omarchy-shell, then a desktop notification, moving
    on whenever one is missing, exits nonzero or times out.
    """
    payload = json.dumps({"icon": icon, "message": message, "duration": duration_ms})
    backends = [
        ("osd", "omarchy-osd", ["-i", icon, "-m", message, "-d", str(duration_ms)]),
        ("osd-shell", "omarchy-shell", ["osd", "show", payload]),
        # Last resort only — top-right notification, not the preferred toast.
        ("notify", "omarchy-notification-send", [message]),
        ("notify", "notify-send", [message]),
    ]
    for label, name, extra in backends:
        exe = shutil.which(name)
        if not exe:
            continue
        r = _run_notifier([exe, *extra])
        if r is None:
            continue
        print(f"{label} rc={r.returncode} msg={message!r} err={r.stderr.strip()!r}", flush=True)
        if r.returncode == 0:
            return
    print(f"toast FAILED: no OSD/notifier delivered {message!r}", flush=True)


# gdbus monitor prints each signal as "<path>: <interface>.<member> (<args>)",
# and "The name ... is owned by :1.N" (or "is now owned by") once it follows the service.
SIGNAL_RE = re.compile(re.escape(f"{OBJECT_PATH}: {BUS_NAME}.LockChanged (") + r"(true|false),\)")
OWNED_RE = re.compile(r"is (now )?owned by")


def watch(mode: str) -> None:
    """Follow g16-winlockd's LockChanged signal.

    No keyboard within ~10 s of startup: exit 0, since the unit is enabled for every user
    and most machines lack one. gdbus monitor keeps following the bus name across
    service restarts (unplug, resume), so nothing here polls.
    """
    for attempt in range(6):  # ~10 s grace in case the keyboard is still settling
        if keyboard_present():
            break
        if attempt == 5:
            print("No hidraw for ASUS 0b05:19b6 (ITE N-Key); nothing to watch", flush=True)
            return
        time.sleep(2)
    cmd = ["gdbus", "monitor", "--system", "--dest", BUS_NAME, "--object-path", OBJECT_PATH]
    print(f"watching {BUS_NAME} ({mode} mode)… Ctrl-C to stop", flush=True)
    # Ignore the next N "off" signals after we ourselves unlock (SetFeature echoes).
    suppress_off = 0
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1)
    try:
        for line in proc.stdout:
            m = SIGNAL_RE.search(line)
            if m:
                suppress_off = _handle(m.group(1) == "true", mode, suppress_off)
            elif line.strip():
                print(line.rstrip(), flush=True)  # gdbus: who owns the name now
                if mode == "unlock" and OWNED_RE.search(line):
                    suppress_off = _unlock_at_start(suppress_off)
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        proc.terminate()
    if proc.wait() not in (0, -15):
        raise SystemExit(f"gdbus monitor exited with {proc.returncode}")


def _unlock_at_start(suppress_off: int) -> int:
    """Unlock mode, when the service (re)starts: a lock kept over a reboot or set while
    nothing watched sends no report, so clear it unless the service knows it is off."""
    try:
        if query_status() is False:
            return suppress_off
        set_lock(False)
    except SystemExit as e:
        print(e, file=sys.stderr)
        return suppress_off
    return suppress_off + 1  # a possible echo of our own unlock


def _handle(locked: bool, mode: str, suppress_off: int) -> int:
    """Show the OSD for one LockChanged, and in unlock mode clear the lock."""
    state = "on" if locked else "off"
    ts = time.strftime("%H:%M:%S")
    print(f"[{ts}] Win-lock {state}", flush=True)
    if mode == "toast":
        if locked:
            toast("Super locked", icon=ICON_LOCKED)
        else:
            toast("Super unlocked", icon=ICON_UNLOCKED)
    elif mode == "unlock":
        if locked:
            # Unlock first: a slow notifier must not keep Super locked.
            try:
                suppress_off += 1
                set_lock(False)
            except SystemExit as e:
                suppress_off = max(0, suppress_off - 1)
                toast(f"Super unlock failed: {e}", icon=ICON_FAIL, duration_ms=4000)
                print(e, file=sys.stderr)
            else:
                toast("Super auto-unlocked", icon=ICON_AUTO_UNLOCK)
        else:
            if suppress_off > 0:
                print(f"[{ts}] suppressed echo unlock notify", flush=True)
                return suppress_off - 1
            toast("Super unlocked", icon=ICON_UNLOCKED)
    return suppress_off


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="Ask g16-winlockd for the lock state")
    sub.add_parser("lock", help="Lock the Win key")
    sub.add_parser("unlock", help="Unlock the Win key")
    sub.add_parser("toggle", help="Invert inferred lock state")

    w = sub.add_parser("watch", help="Follow g16-winlockd's LockChanged signal")
    w.add_argument(
        "--mode",
        choices=("toast", "unlock"),
        default=os.environ.get("G16_WINLOCK_MODE", "toast"),
        help="toast = OSD only; unlock = OSD + auto-unlock (default: toast or $G16_WINLOCK_MODE)",
    )

    args = p.parse_args()
    if args.cmd == "status":
        try:
            locked = query_status()
        except SystemExit as e:
            print(e, file=sys.stderr)
            raise SystemExit(1) from None
        if locked is None:
            print("locked=unknown (g16-winlockd learns it at the first Fn+Super, lock or unlock)")
            raise SystemExit(3)
        print(f"locked={locked}")
    elif args.cmd == "lock":
        set_lock(True)
    elif args.cmd == "unlock":
        set_lock(False)
    elif args.cmd == "toggle":
        cur = query_status()
        if cur is None:
            raise SystemExit("Cannot toggle: the lock state is not known until the first Fn+Super")
        set_lock(not cur)
    elif args.cmd == "watch":
        watch(args.mode)


if __name__ == "__main__":
    main()
