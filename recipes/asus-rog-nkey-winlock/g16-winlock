#!/usr/bin/env python3
"""G16 / ROG N-Key Win-lock helper (ASUS 0b05:19b6).

Modes for `watch`:
  toast   — bottom-center Omarchy OSD when Fn+Super toggles Win-lock
  unlock  — same OSD, then immediately SetFeature-unlock (Active Guard)

Also: lock | unlock | status | toggle  (one-shot HID control)

Depends on the patched hid-asus passing 5D BF Win-lock notifications through
to hidraw instead of dropping them with the AURA echo stream.
"""
from __future__ import annotations

import argparse
import fcntl
import glob
import os
import json
import select
import shutil
import struct
import subprocess
import sys
import time
from pathlib import Path

VID, PID = 0x0B05, 0x19B6
REPORT_LEN = 64
# linux/hidraw.h HIDIOC{S,G}FEATURE(64)
HIDIOCSFEATURE = 0xC0404806
HIDIOCGFEATURE = 0xC0404807

# OSD icons (bottom-center omarchy-osd). Locked uses the color-emoji lock
# because Omarchy OSD paints Nerd Font glyphs with popup text color only.
ICON_LOCKED = "🔒"       # red lock — stays locked (toast mode)
ICON_UNLOCKED = "󰌿"     # lock-open — Super cleared
ICON_AUTO_UNLOCK = "󰕥"  # shield-check — unlock mode blocked Fn+Super
ICON_FAIL = "󰀦"


WINLOCK_REPORT_ID = 0x5D


def _hidraw_sort_key(path: str) -> int:
    digits = "".join(ch for ch in Path(path).parts[-3] if ch.isdigit())
    return int(digits or 0)


def _matching_nodes() -> list[Path]:
    """sysfs dirs (/sys/class/hidraw/hidrawN) of every 0b05:19b6 hidraw node."""
    nodes = []
    for uevent in sorted(glob.glob("/sys/class/hidraw/hidraw*/device/uevent"), key=_hidraw_sort_key):
        try:
            text = Path(uevent).read_text(errors="replace").upper()
        except OSError:
            continue
        # HID_ID=0003:00000B05:000019B6
        if f"{VID:08X}:{PID:08X}" in text:
            nodes.append(Path(uevent).parents[1])
    return nodes


def report_ids(descriptor: bytes) -> set[int] | None:
    """Report IDs declared by a HID report descriptor, or None if it does not parse.

    Walks the items properly (short items: prefix + 0/1/2/4 data bytes; long
    items: 0xFE size tag data) so a 0x85 that is merely a data byte is not
    mistaken for a Report ID item.
    """
    ids: set[int] = set()
    i, n = 0, len(descriptor)
    while i < n:
        prefix = descriptor[i]
        if prefix == 0xFE:  # long item
            if i + 2 >= n:
                return None
            i += 3 + descriptor[i + 1]
            continue
        size = (0, 1, 2, 4)[prefix & 0x03]
        if i + 1 + size > n:
            return None
        if prefix & 0xFC == 0x84 and size >= 1:  # Global, Report ID
            ids.add(descriptor[i + 1])
        i += 1 + size
    return ids


def find_hidraw() -> Path:
    """The 0b05:19b6 hidraw node that carries the 5D (Win-lock / Aura) reports.

    The keyboard exposes several HID interfaces, each with its own hidraw node;
    only the one whose report descriptor declares report ID 0x5D sees the
    5D BF notifications and accepts the 5D BF SetFeature. If no descriptor can
    be read or parsed, fall back to the first matching node.
    """
    nodes = _matching_nodes()
    if not nodes:
        raise FileNotFoundError("No hidraw for ASUS 0b05:19b6 (ITE N-Key)")
    for node in nodes:
        try:
            desc = (node / "device" / "report_descriptor").read_bytes()
        except OSError:
            continue
        ids = report_ids(desc)
        if ids and WINLOCK_REPORT_ID in ids:
            return Path("/dev") / node.name
    return Path("/dev") / nodes[0].name


def open_hidraw(*, writable: bool = True) -> tuple[int, Path]:
    path = find_hidraw()
    try:
        access = os.O_RDWR if writable else os.O_RDONLY
        fd = os.open(path, access | os.O_NONBLOCK)
    except PermissionError as e:
        raise SystemExit(
            f"Cannot open {path} ({e}). Install the udev rule "
            f"(70-g16-winlock-hidraw.rules) and replug/reload, "
            f"or run via pkexec."
        ) from e
    return fd, path


def set_lock(locked: bool) -> None:
    """SetFeature 5D BF 00 xx + output write 01 01 (AsusWinKeyActiveGuard)."""
    fd, path = open_hidraw()
    try:
        buf = bytearray(REPORT_LEN)
        buf[0], buf[1], buf[2], buf[3] = 0x5D, 0xBF, 0x00, 0x01 if locked else 0x00
        fcntl.ioctl(fd, HIDIOCSFEATURE, buf, True)
        # Commit must be a WRITE of output report 01 01 — not another SetFeature
        os.write(fd, bytes([0x01, 0x01]))
    finally:
        os.close(fd)
    print(f"{path}: Win-lock {'on' if locked else 'off'}")


def get_status() -> bool | None:
    """Best-effort GetFeature; byte[3] is lock flag when report is BF-shaped."""
    fd, path = open_hidraw()
    try:
        buf = bytearray(REPORT_LEN)
        buf[0] = 0x5D
        try:
            fcntl.ioctl(fd, HIDIOCGFEATURE, buf, True)
        except OSError as e:
            print(f"{path}: GetFeature failed: {e}", file=sys.stderr)
            return None
        # Expect 5D BF ?? xx or at least byte3 meaningful after AWKAG pattern
        locked = bool(buf[3])
        print(
            f"{path}: feature={buf[:8].hex(' ')} "
            f"→ infer locked={locked} (byte3)"
        )
        return locked
    finally:
        os.close(fd)


NOTIFY_TIMEOUT_S = 5  # a stuck notifier must not stall the report loop


def _run_notifier(cmd: list[str]) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=NOTIFY_TIMEOUT_S)
    except (subprocess.TimeoutExpired, OSError) as e:
        print(f"notifier {cmd[0]} failed: {e}", flush=True)
        return None


def toast(message: str, *, icon: str = ICON_LOCKED, duration_ms: int = 2000) -> None:
    """Bottom-center Omarchy OSD (same channel as Pixel Buds volume), not top-right notifications."""
    osd = shutil.which("omarchy-osd")
    if osd:
        r = _run_notifier([osd, "-i", icon, "-m", message, "-d", str(duration_ms)])
        if r is None:
            return
        print(f"osd rc={r.returncode} msg={message!r} err={r.stderr.strip()!r}", flush=True)
        return
    shell = shutil.which("omarchy-shell")
    if shell:
        payload = json.dumps({"icon": icon, "message": message, "duration": duration_ms})
        r = _run_notifier([shell, "osd", "show", payload])
        if r is None:
            return
        print(f"osd-shell rc={r.returncode} msg={message!r} err={r.stderr.strip()!r}", flush=True)
        return
    # Last resort only — top-right notification, not the preferred toast.
    send = shutil.which("omarchy-notification-send") or shutil.which("notify-send")
    if send:
        _run_notifier([send, message])
        print(f"toast FALLBACK notify msg={message!r}", flush=True)
    else:
        print(f"toast FAILED: no OSD/notifier for {message!r}", flush=True)


class _DeviceLost(Exception):
    """The hidraw node went away (unplug, resume, driver rebind)."""


def _reopen_with_backoff() -> tuple[int, Path]:
    """Wait for the keyboard to come back, polling with backoff up to 30 s."""
    delay = 1.0
    while True:
        try:
            return open_hidraw(writable=False)
        except (FileNotFoundError, SystemExit, OSError) as e:
            # SystemExit: the node is back but its uaccess ACL is not yet.
            print(f"waiting for keyboard ({e}); retry in {delay:.0f}s", flush=True)
        time.sleep(delay)
        delay = min(delay * 2, 30.0)


def watch(mode: str) -> None:
    """Read Win-lock state notifications passed through to hidraw.

    No keyboard within ~10 s of startup: exit 0, since the unit is enabled for every user
    and most machines lack one. Losing the node later (unplug, resume): wait
    for it to come back instead of crashing into systemd's restart limit.
    """
    for attempt in range(6):  # ~10 s grace in case the node is still settling
        try:
            fd, path = open_hidraw(writable=False)
            break
        except FileNotFoundError as e:
            if attempt == 5:
                print(f"{e}; nothing to watch", flush=True)
                return
            time.sleep(2)
        except SystemExit as e:
            # The keyboard is there but not yet ours (uaccess ACL not applied):
            # keep retrying rather than exit into systemd's restart limit.
            print(f"{e}; waiting for keyboard access", flush=True)
            fd, path = _reopen_with_backoff()
            break
    # Ignore the next N "off" lines after we ourselves unlock (SetFeature echoes).
    suppress_off = 0
    try:
        while True:
            print(f"watching {path} ({mode} mode)… Ctrl-C to stop", flush=True)
            try:
                suppress_off = _watch_node(fd, path, mode, suppress_off)
            except _DeviceLost as e:
                print(f"{e}; waiting for it to return", flush=True)
                os.close(fd)
                fd = -1
                suppress_off = 0
                fd, path = _reopen_with_backoff()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        if fd >= 0:
            os.close(fd)


def _watch_node(fd: int, path: Path, mode: str, suppress_off: int) -> int:
    """Handle reports from one open node until it disappears (raises _DeviceLost)."""
    while True:
        try:
            select.select([fd], [], [])
            data = os.read(fd, REPORT_LEN)
        except BlockingIOError:
            continue
        except OSError as e:  # ENODEV/EIO once the node is removed
            raise _DeviceLost(f"{path}: {e.strerror or e}") from e
        if not data:
            raise _DeviceLost(f"{path} disconnected")
        if len(data) < 4 or data[:3] != bytes([0x5D, 0xBF, 0x01]):
            continue
        locked = bool(data[3])
        state = "on" if locked else "off"
        ts = time.strftime("%H:%M:%S")
        print(f"[{ts}] Win-lock {state}", flush=True)
        if mode == "toast":
            if locked:
                toast("Super locked", icon=ICON_LOCKED)
            else:
                toast("Super unlocked", icon=ICON_UNLOCKED)
        elif mode == "unlock":
            if locked:
                # Unlock first: a slow notifier must not keep Super locked.
                try:
                    suppress_off += 1
                    set_lock(False)
                except (SystemExit, OSError) as e:
                    suppress_off = max(0, suppress_off - 1)
                    toast(f"Super unlock failed: {e}", icon=ICON_FAIL, duration_ms=4000)
                    print(e, file=sys.stderr)
                else:
                    toast("Super auto-unlocked", icon=ICON_AUTO_UNLOCK)
            else:
                if suppress_off > 0:
                    suppress_off -= 1
                    print(f"[{ts}] suppressed echo unlock notify", flush=True)
                    continue
                toast("Super unlocked", icon=ICON_UNLOCKED)


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="GetFeature probe of lock byte")
    sub.add_parser("lock", help="SetFeature lock + commit write")
    sub.add_parser("unlock", help="SetFeature unlock + commit write")
    sub.add_parser("toggle", help="Invert inferred lock state")

    w = sub.add_parser("watch", help="Follow kernel Win-lock lines")
    w.add_argument(
        "--mode",
        choices=("toast", "unlock"),
        default=os.environ.get("G16_WINLOCK_MODE", "toast"),
        help="toast = OSD only; unlock = OSD + auto-unlock (default: toast or $G16_WINLOCK_MODE)",
    )

    args = p.parse_args()
    if args.cmd == "status":
        get_status()
    elif args.cmd == "lock":
        set_lock(True)
    elif args.cmd == "unlock":
        set_lock(False)
    elif args.cmd == "toggle":
        cur = get_status()
        if cur is None:
            raise SystemExit("Cannot toggle without a readable status")
        set_lock(not cur)
    elif args.cmd == "watch":
        watch(args.mode)


if __name__ == "__main__":
    main()
