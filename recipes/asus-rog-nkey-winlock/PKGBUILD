build() {
  # shellcheck disable=SC2086 # CFLAGS/LDFLAGS are word lists
  cc $CPPFLAGS $CFLAGS -Wall $LDFLAGS -o g16-winlockd g16-winlockd.c $(pkg-config --cflags --libs libsystemd)
}

check() {
  # A fake hidraw node (a pty) on a private D-Bus with a fake polkit: reports
  # become signals, SetLocked is polkit-gated and writes the feature and commit,
  # and g16-winlock opens no device.
  bash winlockd.test.sh "$srcdir/g16-winlockd"
}

package_asus-rog-nkey-winlock() {
  install=asus-rog-nkey-winlock.install
  pkgdesc='Win-key lock OSD and auto-unlock helper (g16-winlock) for the ASUS ROG N-Key keyboard of the Zephyrus G16 GA605'
  depends=('python' 'glib2' 'systemd-libs' 'polkit')
  optdepends=(
    'linux-omarchy: the omarchy-asus build (7.2.8-9.1 or later, patch 0568) or any kernel whose hid-asus passes Win-lock reports to hidraw, needed for "watch"'
    'omarchy: omarchy-osd / omarchy-shell for the on-screen toast'
    'libnotify: notify-send fallback when no Omarchy OSD is available'
  )

  install -Dm755 g16-winlockd "$pkgdir/usr/lib/g16-winlockd"
  install -Dm644 g16-winlockd@.service "$pkgdir/usr/lib/systemd/system/g16-winlockd@.service"
  install -Dm644 60-g16-winlockd.rules "$pkgdir/usr/lib/udev/rules.d/60-g16-winlockd.rules"
  install -Dm644 io.github.omarchy_asus.WinLock1.conf "$pkgdir/usr/share/dbus-1/system.d/io.github.omarchy_asus.WinLock1.conf"
  install -Dm644 io.github.omarchy-asus.winlock.policy "$pkgdir/usr/share/polkit-1/actions/io.github.omarchy-asus.winlock.policy"
  install -Dm755 g16-winlock "$pkgdir/usr/bin/g16-winlock"
  install -Dm644 g16-winlock.service "$pkgdir/usr/lib/systemd/user/g16-winlock.service"
  # Enabled for every user: it does nothing on machines without the 0b05:19b6
  # keyboard. Opt out per user with `systemctl --user mask g16-winlock.service`.
  install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../g16-winlock.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/g16-winlock.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/asus-rog-nkey-winlock/README.md"
}

package_asus-zephyrus-g16-control() {
  # Transitional: the widget is an Omarchy plugin now
  # (https://github.com/omarchy-asus/omarchy-asus-plugin, #183). This version removes
  # the packaged copy and its install message says how to switch. Drop this
  # package from the recipe once the G16 has switched.
  arch=('any')
  pkgdesc='(transitional) G16 Control is the omarchy-asus plugin now: omarchy-asus/omarchy-asus-plugin'
  depends=()
  install=asus-zephyrus-g16-control.install
  install -Dm644 README.md "$pkgdir/usr/share/doc/asus-zephyrus-g16-control/README.md"
}
