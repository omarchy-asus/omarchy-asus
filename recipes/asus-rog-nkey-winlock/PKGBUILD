# Win-key lock helper for the ROG N-Key keyboard (USB 0b05:19b6) of the ASUS ROG
# Zephyrus G16 GA605. Its switch is in the omarchy-asus plugin, an Omarchy bar
# widget (https://github.com/omarchy-asus/omarchy-asus-plugin).
#
# asus-rog-nkey-winlock: `g16-winlockd`, a small root service that owns the
#   keyboard's hidraw node and forwards its Win-lock reports as a D-Bus signal
#   (udev starts it; the node stays root-only), and `g16-winlock`, the user unit
#   that shows an Omarchy OSD when Fn+Super toggles the firmware Win-key lock and
#   can clear it again (auto-unlock), plus one-shot lock/unlock/status/toggle over
#   D-Bus. The user unit is enabled on install (toast mode).
# asus-zephyrus-g16-control: transitional. The widget it shipped is the
#   omarchy-asus plugin now (#183); this version removes the packaged
#   copy and says how to switch.
#
# `g16-winlockd` only sees the toggle with a kernel whose hid-asus passes
# the Win-lock reports through to hidraw: linux-omarchy from this repo (patch
# 0568, from 7.2.8-9.1). That requirement is an optdepend, not a versioned
# depend, so these packages survive the fix landing in a stock kernel.
#
# These are local packages with no upstream build to track, so pkgrel does not
# use the repo's "<upstream>.1" scheme, and the LOCAL_ONLY marker next to this
# file tells check-upstream there is nothing to compare against. See README.md.

pkgbase=asus-rog-nkey-winlock
pkgname=(asus-rog-nkey-winlock asus-zephyrus-g16-control)
pkgver=0.1.0
pkgrel=102
pkgdesc='Win-key lock helper for the ASUS ROG Zephyrus G16 (GA605)'
arch=('x86_64')
url='https://github.com/omarchy-asus/omarchy-asus'
license=('MIT')
options=('!debug')
makedepends=('systemd-libs')
checkdepends=('dbus' 'glib2' 'python')
source=(
  'g16-winlockd.c'
  'g16-winlockd@.service'
  '60-g16-winlockd.rules'
  'io.github.omarchy_asus.WinLock1.conf'
  'io.github.omarchy-asus.winlock.policy'
  'g16-winlock'
  'g16-winlock.service'
  'README.md'
  'winlockd.test.sh'
  'fake_hid.c'
  'fake_polkit.c'
  'fake_node.py'
)
sha256sums=('538959a30fab316978968989339e31a082f0973dea72f34135bc66250196b870'
            '92cbe6d3aac2ea0497653b6068d1432b3868ab3404a01672734cb356b13d00da'
            'c0c868d5f0c98ca9d5b35b4927f2ff0d06b45c40e64f683857e491b9558e5a6e'
            'c078a9ee5aaea137045c2bfb70b652c3d9e46ba63eda5f8dbcad7a6482560499'
            '9a8d280dc9bd465f1fa0894a10e0ec70401604922388fcc6de253978219991b1'
            '314657194394df95885f8328a71261e2008e670ba1cb71cb14dc74de985d02d0'
            '85955d0a7eb12911ead8c0cb68cd89d356aae02d67d4668f187136be3e767bfd'
            '2287c8bff28dc3de120652923dbf1b67a1bef8ff42341a3f32774a8cd651d5f0'
            '0fd61de1ee4fe201bc366c639688b57c3727c289b2637e044a3e4518f148e9f5'
            'd7225964ac70f92b4ab04ae2a339558982f84c23da195d2a0badcc8cb9100dd6'
            '03c0fc8c75f1c2175bc85275bbf90cbf9699a15ef26a2a155747a70eb4619bfe'
