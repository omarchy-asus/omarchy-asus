From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Heinemeier Hansson
Date: Sun, 1 Nov 2026 19:32:27 +0100
Subject: [PATCH] Keep the lock usable after an NVIDIA suspend's VT switch
 (#17277)

* Give the lock's password field its focus back after a VT switch

The NVIDIA driver forces a VT switch around every suspend, which takes the
keyboard away; Qt drops the field's focus with it and nothing restores it, so
typing after a lid-open resume went nowhere until the field was clicked.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

* Hold off blanking the lock for longer after a resume

The countdown restarts as the kernel thaws, seconds before the panel lights
on NVIDIA, so the lock went dark again just as it appeared.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

* Hold off the blank after a resume that found the lock already dark

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

---------

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 1843592f21166dd3abd689e2ae2a9f155a54039c)
---
 shell/plugins/lock/LockView.qml | 11 +++++++++++
 shell/plugins/lock/Service.qml  | 14 ++++++++++----
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/shell/plugins/lock/LockView.qml b/shell/plugins/lock/LockView.qml
index f5296c89..9f4aa693 100644
--- a/shell/plugins/lock/LockView.qml
+++ b/shell/plugins/lock/LockView.qml
@@ -72,10 +72,21 @@ Item {
     syncingPasswordText = false
   }
 
+  // The field loses focus while a password is checked (it is disabled then),
+  // and forcing focus onto it would not stick until the check ends.
+  function restorePasswordFocus() {
+    if (inputEnabled && passwordInput.enabled && !passwordInput.activeFocus) forcePasswordFocus()
+  }
+
   onPasswordTextChanged: syncPasswordText()
   onInputEnabledChanged: {
     if (inputEnabled) Qt.callLater(forcePasswordFocus)
   }
+
+  // A VT switch, which the NVIDIA driver forces around every suspend, takes the
+  // keyboard away and Qt drops the field's focus with it. Nothing gives it back
+  // when the keyboard returns, so typing went nowhere until the field was clicked.
+  Window.onActiveFocusItemChanged: Qt.callLater(restorePasswordFocus)
   Component.onCompleted: {
     syncPasswordText()
     if (inputEnabled) Qt.callLater(forcePasswordFocus)
diff --git a/shell/plugins/lock/Service.qml b/shell/plugins/lock/Service.qml
index b45d0145..a02708e0 100644
--- a/shell/plugins/lock/Service.qml
+++ b/shell/plugins/lock/Service.qml
@@ -248,7 +248,8 @@ Item {
     runWake()
   }
 
-  function armBlankTimer() {
+  function armBlankTimer(delayMs) {
+    idleBlankTimer.interval = delayMs || idleBlankTimer.idleMs
     idleBlankTimer.armedAt = Date.now()
     idleBlankTimer.restart()
   }
@@ -669,7 +670,7 @@ Item {
         stop()
         root.fingerprintSleptWhilePaused = true
         root.resumeFingerprint()
-        root.armBlankTimer()
+        root.armBlankTimer(idleBlankTimer.resumeMs)
       } else if (slept || !root.fingerprintPaused || --ticksLeft <= 0) {
         stop()
       }
@@ -765,7 +766,12 @@ Item {
 
   Timer {
     id: idleBlankTimer
-    interval: 5000
+    readonly property int idleMs: 5000
+    // A resume reaches this as soon as the kernel thaws, seconds before the
+    // panel lights (on NVIDIA it waits out a VT switch and a modeset), so the
+    // idle run-up blanked the lock just as it appeared.
+    readonly property int resumeMs: 15000
+    interval: idleMs
     repeat: false
     property double armedAt: 0
     onTriggered: {
@@ -773,7 +779,7 @@ Item {
       // blank the freshly woken unlock screen under the user. Wall-clock time
       // exposes the gap: take a fresh run-up instead of blanking.
       if (Date.now() - armedAt > interval + 2000) {
-        root.armBlankTimer()
+        root.armBlankTimer(resumeMs)
         return
       }
       // Only a password check in flight should hold the display up. The
