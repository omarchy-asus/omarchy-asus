From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Obuch
Date: Thu, 27 Aug 2026 11:12:55 +0100
Subject: [PATCH] Restore lock screen password focus lost on suspend

Suspending drops keyboard focus from the lock screen's password field
while the lock stays up, and nothing put it back: focus was only taken in
Component.onCompleted and when inputEnabled changed, and inputEnabled is
already true by then. The machine woke to a lock screen that ignored the
keyboard until it was clicked. The field now takes focus back whenever it
loses it while input is enabled.

While a password is checked the field is disabled, and Qt gives focus
back to a re-enabled item only if nothing else took it meanwhile, so the
field also takes focus back once the check ends (after a wrong password).

lock-focus-recovery-test.sh moves focus away from the field in a real
window, before, during and after a password check, and checks that it
comes back on its own and stays away while input is disabled.

Upstream: omacom/omarchy#8560 (head 39691c1e), for omacom/omarchy#9180.
Fork commits 28a967beb + b86b2f97e + 42cbfdf1c + c5887be86 on
asus/v4-5-0-rc1 (that pull request's four commits), squashed.

Co-Authored-By: Arve Lømsland <arve@lomsland.no>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 shell/plugins/lock/LockView.qml                    |  14 ++
 .../shell.d/fixtures/lock-focus-recovery/shell.qml | 172 +++++++++++++++++++++
 test/shell.d/lock-focus-recovery-test.sh           |  74 +++++++++
 3 files changed, 260 insertions(+)

diff --git a/shell/plugins/lock/LockView.qml b/shell/plugins/lock/LockView.qml
index f26f43a8d..700076e08 100644
--- a/shell/plugins/lock/LockView.qml
+++ b/shell/plugins/lock/LockView.qml
@@ -81,6 +81,11 @@ Item {
   onInputEnabledChanged: {
     if (inputEnabled) Qt.callLater(forcePasswordFocus)
   }
+  // Qt hands focus back to a re-enabled field only if nothing took it during
+  // the password check, so take it back once the check is over.
+  onAuthenticatingPasswordChanged: {
+    if (inputEnabled && !authenticatingPassword) Qt.callLater(forcePasswordFocus)
+  }
   Component.onCompleted: {
     syncPasswordText()
     if (inputEnabled) Qt.callLater(forcePasswordFocus)
@@ -193,6 +198,15 @@ Item {
           visible: passwordInput.cursorVisible
         }
 
+        // Suspending drops keyboard focus from this field while the lock is
+        // still up, and nothing puts it back: focus is only taken in
+        // Component.onCompleted and when inputEnabled changes, and inputEnabled
+        // is already true by then. Take it back so the machine wakes ready to
+        // type instead of needing a click first.
+        onActiveFocusChanged: {
+          if (!activeFocus && root.inputEnabled) Qt.callLater(root.forcePasswordFocus)
+        }
+
         onTextChanged: {
           if (!root.syncingPasswordText) root.passwordTextEdited(text)
           if (text.length > 0) {
diff --git a/test/shell.d/fixtures/lock-focus-recovery/shell.qml b/test/shell.d/fixtures/lock-focus-recovery/shell.qml
new file mode 100644
index 000000000..09dd57901
--- /dev/null
+++ b/test/shell.d/fixtures/lock-focus-recovery/shell.qml
@@ -0,0 +1,172 @@
+import QtQuick
+import Quickshell
+import qs.Commons
+
+ShellRoot {
+  id: root
+
+  readonly property string resultPath: Quickshell.env("OMARCHY_QML_TEST_RESULT")
+  readonly property string rootPath: Quickshell.env("OMARCHY_PATH")
+  property var failures: []
+  property var view: null
+  property var passwordInput: null
+  property int step: 0
+  property int waitedForWindow: 0
+
+  function fail(message) {
+    failures.push(String(message))
+  }
+
+  function assertTrue(condition, message) {
+    if (!condition) fail(message)
+  }
+
+  function shellQuote(value) {
+    return "'" + String(value).replace(/'/g, "'\\''") + "'"
+  }
+
+  function writeResult() {
+    var payload = JSON.stringify({
+      ok: failures.length === 0,
+      failures: failures
+    })
+
+    if (resultPath) {
+      Quickshell.execDetached(["bash", "-lc", "printf '%s' " + shellQuote(payload) + " > " + shellQuote(resultPath)])
+    }
+  }
+
+  function findPasswordInput(item) {
+    if (!item) return null
+    if (item.echoMode === TextInput.Password) return item
+    var children = item.children || []
+    for (var i = 0; i < children.length; i++) {
+      var found = findPasswordInput(children[i])
+      if (found) return found
+    }
+    return null
+  }
+
+  function finish() {
+    stepTimer.stop()
+    if (view) view.destroy()
+    writeResult()
+  }
+
+  // A real window, because an item outside one never gets active focus and so
+  // never loses it.
+  FloatingWindow {
+    id: win
+    implicitWidth: 800
+    implicitHeight: 600
+    color: "black"
+
+    Item {
+      id: host
+      anchors.fill: parent
+
+      readonly property bool windowActive: Window.active
+
+      // Stands in for anything else on the surface that takes focus.
+      TextInput { id: decoy }
+    }
+  }
+
+  // Each step takes focus from the password field, and the next checks that
+  // the field took it back without a click.
+  Timer {
+    id: stepTimer
+    interval: 200
+    repeat: true
+    onTriggered: {
+      try {
+        // Focus is only judged while the window holds the keyboard; the
+        // compositor may take it away mid-test, so wait for it to come back.
+        if (!host.windowActive) {
+          root.waitedForWindow += 1
+          if (root.waitedForWindow < 25) return
+          root.fail("test window never became active")
+          root.finish()
+          return
+        }
+
+        if (root.step === 0) {
+          root.assertTrue(root.passwordInput.activeFocus, "password field has focus once the window is active")
+          decoy.forceActiveFocus()
+        } else if (root.step === 1) {
+          root.assertTrue(root.passwordInput.activeFocus, "password field takes focus back from another item")
+          // What resume does: focus falls back to the surface's own item.
+          host.forceActiveFocus()
+        } else if (root.step === 2) {
+          root.assertTrue(root.passwordInput.activeFocus, "password field takes focus back when it is dropped")
+          root.view.authenticatingPassword = true
+        } else if (root.step === 3) {
+          root.view.authenticatingPassword = false
+        } else if (root.step === 4) {
+          root.assertTrue(root.passwordInput.activeFocus, "password field has focus after a password check")
+          root.view.authenticatingPassword = true
+        } else if (root.step === 5) {
+          // Focus moves once the check is under way, as when resume lands during it.
+          host.forceActiveFocus()
+        } else if (root.step === 6) {
+          root.view.authenticatingPassword = false
+        } else if (root.step === 7) {
+          root.assertTrue(root.passwordInput.activeFocus, "password field takes focus back after it was dropped during a password check")
+          root.view.authenticatingPassword = true
+        } else if (root.step === 8) {
+          decoy.forceActiveFocus()
+        } else if (root.step === 9) {
+          root.view.authenticatingPassword = false
+        } else if (root.step === 10) {
+          root.assertTrue(root.passwordInput.activeFocus, "password field takes focus back after another item took it during a password check")
+          // The preview surface builds the same view with input disabled.
+          root.view.inputEnabled = false
+          decoy.forceActiveFocus()
+        } else {
+          root.assertTrue(decoy.activeFocus, "password field leaves focus alone while input is disabled")
+          root.finish()
+          return
+        }
+        root.step += 1
+      } catch (error) {
+        root.fail("lock focus recovery fixture threw: " + error)
+        root.finish()
+      }
+    }
+  }
+
+  Timer {
+    interval: 1
+    running: true
+    repeat: false
+    onTriggered: {
+      try {
+        var component = Qt.createComponent("file://" + root.rootPath + "/shell/plugins/lock/LockView.qml", Component.PreferSynchronous)
+        if (component.status !== Component.Ready) {
+          root.fail("LockView failed to load: " + component.errorString())
+          root.writeResult()
+          return
+        }
+
+        root.view = component.createObject(host, { width: 800, height: 600, loadBackground: false, inputEnabled: true })
+        if (!root.view) {
+          root.fail("LockView failed to instantiate: " + component.errorString())
+          root.writeResult()
+          return
+        }
+
+        root.passwordInput = root.findPasswordInput(root.view)
+        if (!root.passwordInput) {
+          root.fail("LockView has no password field")
+          root.finish()
+          return
+        }
+
+        stepTimer.start()
+      } catch (error) {
+        root.fail("lock focus recovery fixture threw: " + error)
+        root.finish()
+      }
+    }
+  }
+}
diff --git a/test/shell.d/lock-focus-recovery-test.sh b/test/shell.d/lock-focus-recovery-test.sh
new file mode 100755
index 000000000..e964b31f2
--- /dev/null
+++ b/test/shell.d/lock-focus-recovery-test.sh
@@ -0,0 +1,74 @@
+#!/bin/bash
+
+set -euo pipefail
+
+source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
+
+TMPDIR=""
+QS_PID=""
+
+cleanup() {
+  if [[ -n $QS_PID ]] && kill -0 "$QS_PID" 2>/dev/null; then
+    kill "$QS_PID" 2>/dev/null || true
+    wait "$QS_PID" 2>/dev/null || true
+  fi
+  if [[ -n $TMPDIR && -d $TMPDIR ]]; then
+    rm -rf "$TMPDIR"
+  fi
+}
+trap cleanup EXIT
+
+require_compositor "lock focus recovery test"
+
+if ! command -v quickshell >/dev/null 2>&1; then
+  pass "quickshell not installed; skipping lock focus recovery test"
+  exit 0
+fi
+
+require_command jq
+
+TMPDIR=$(mktemp -d)
+result="$TMPDIR/result.json"
+log="$TMPDIR/quickshell.log"
+config_dir="$TMPDIR/lock-focus-recovery"
+mkdir -p "$config_dir" "$TMPDIR/home"
+cp "$SHELL_TEST_DIR/fixtures/lock-focus-recovery/shell.qml" "$config_dir/shell.qml"
+ln -s "$ROOT/shell/Ui" "$config_dir/Ui"
+ln -s "$ROOT/shell/Commons" "$config_dir/Commons"
+
+OMARCHY_PATH="$ROOT" \
+OMARCHY_QML_TEST_RESULT="$result" \
+HOME="$TMPDIR/home" \
+XDG_CONFIG_HOME="$TMPDIR/home/.config" \
+XDG_CACHE_HOME="$TMPDIR/home/.cache" \
+XDG_STATE_HOME="$TMPDIR/home/.local/state" \
+QML2_IMPORT_PATH="$ROOT/shell${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}" \
+QML_IMPORT_PATH="$ROOT/shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
+PATH="$ROOT/bin:$PATH" \
+  quickshell -p "$config_dir" --no-color >"$log" 2>&1 &
+QS_PID=$!
+
+# The fixture waits up to five seconds for its window to take the keyboard.
+for _ in {1..150}; do
+  [[ -s $result ]] && break
+  if ! kill -0 "$QS_PID" 2>/dev/null; then
+    sed -n '1,220p' "$log" >&2
+    fail "lock focus recovery quickshell exited before writing result"
+  fi
+  sleep 0.1
+done
+
+[[ -s $result ]] || {
+  sed -n '1,220p' "$log" >&2
+  fail "lock focus recovery test timed out"
+}
+
+if ! jq -e '.ok == true' "$result" >/dev/null; then
+  printf 'Lock focus recovery result:\n' >&2
+  jq . "$result" >&2
+  printf 'Lock focus recovery log:\n' >&2
+  sed -n '1,220p' "$log" >&2
+  fail "lock password field takes keyboard focus back on its own"
+fi
+
+pass "lock password field takes keyboard focus back on its own"
