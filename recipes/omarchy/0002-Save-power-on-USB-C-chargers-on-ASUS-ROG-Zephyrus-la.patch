 #!/bin/bash
 
 # omarchy:summary=Set and remember the power profile for AC or battery use
-# omarchy:args=[autodetect|ac|battery] [power-saver|balanced|performance]
+# omarchy:args=[autodetect|ac|battery|usb-c] [power-saver|balanced|performance]
 
 action="${1:-autodetect}"
 requested_profile="${2:-}"
 
 usage() {
-  echo "Usage: omarchy-powerprofiles-set [autodetect|ac|battery] [power-saver|balanced|performance]" >&2
+  echo "Usage: omarchy-powerprofiles-set [autodetect|ac|battery|usb-c] [power-saver|balanced|performance]" >&2
   exit 1
 }
 
 (( $# <= 2 )) || usage
 
+detected=0
 case "$action" in
   autodetect)
+    detected=1
     # Use the same signal as the shell (UPower.onBattery) so every entry point
     # saves and restores the profile under the same ac/battery key.
     if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]; then
@@ -23,10 +25,21 @@ case "$action" in
       action=ac
     fi
     ;;
-  ac | battery) ;;
+  ac | battery | usb-c) ;;
   *) usage ;;
 esac
 
+# An ASUS ROG laptop runs at full power only from its own barrel adapter. A
+# USB-C charger delivers far less (100 W, against 200-330 W from the
+# barrel), so there it saves power as on battery: balanced unless a profile was
+# picked while on USB-C, which is remembered apart from the barrel's. Only the
+# current source is resolved this way (autodetect, or a power-source change
+# naming ac without a profile); `ac <profile>` names the barrel explicitly, as
+# `battery <profile>` names battery, and `usb-c <profile>` names USB-C.
+if [[ $action == "ac" ]] && { (( detected )) || [[ -z $requested_profile ]]; } && omarchy-hw-asus-rog-usbc-power; then
+  action=usb-c
+fi
+
 mapfile -t profiles < <(omarchy-powerprofiles-list)
 
 profile_available() {
diff --git a/bin/omarchy-powerprofiles-source-monitor b/bin/omarchy-powerprofiles-source-monitor
new file mode 100755
index 00000000..abf8934a
--- /dev/null
+++ b/bin/omarchy-powerprofiles-source-monitor
@@ -0,0 +1,56 @@
+#!/bin/bash
+
+# omarchy:summary=Re-apply the power profile when an ASUS ROG laptop swaps between its barrel adapter and a USB-C charger
+# omarchy:hidden=true
+
+# The battery service applies the profile when UPower's OnBattery changes, which
+# covers plugging in and unplugging. Swapping one charger for another while the
+# laptop stays powered (USB-C in, then the barrel out) leaves OnBattery alone,
+# and UPower does not track the USB-C supply, so nothing else notices. The kernel
+# sends a power_supply uevent for each charger either way; follow those and act
+# only on a move between two chargers, so a plug or unplug is never applied
+# twice. Each platform-profile write can wake the NVIDIA GPU, so that matters.
+
+power_source() {
+  if ! omarchy-power-present; then
+    echo battery
+  elif omarchy-hw-asus-rog-usbc-power; then
+    echo usb-c
+  else
+    echo ac
+  fi
+}
+
+consume_power_events() {
+  local line last current
+  last=$(power_source)
+
+  while IFS= read -r line; do
+    [[ $line == *"(power_supply)"* ]] || continue
+    # The battery reports every percent; only a charger can change the source.
+    [[ $line == *"/power_supply/BAT"* ]] && continue
+
+    # One plug sends a burst of events; act once it has settled.
+    while IFS= read -r -t 1 line; do :; done
+
+    current=$(power_source)
+    if [[ $last != battery && $current != battery && $current != "$last" ]]; then
+      omarchy-powerprofiles-set ac || true
+    fi
+    last=$current
+  done
+}
+
+case ${1:-} in
+  --consume)
+    consume_power_events
+    exit 0
+    ;;
+esac
+
+udevadm monitor --udev --subsystem-match=power_supply | consume_power_events
+
+# udevadm monitor runs until it is stopped, so reaching here means it failed or
+# went away. Exit non-zero so systemd restarts the monitor.
+echo "udevadm monitor ended; exiting so systemd restarts the monitor" >&2
+exit 1
diff --git a/default/systemd/user/omarchy-powerprofiles-source-monitor.service b/default/systemd/user/omarchy-powerprofiles-source-monitor.service
new file mode 100644
index 00000000..4630839a
--- /dev/null
+++ b/default/systemd/user/omarchy-powerprofiles-source-monitor.service
@@ -0,0 +1,18 @@
+[Unit]
+Description=Re-apply the power profile when an ASUS ROG laptop swaps chargers
+# Only ASUS laptops whose firmware says which charger is in use, through
+# asus-armoury's charge_mode (or asus-nb-wmi's on older kernels), can tell a
+# USB-C charger from the barrel adapter. Everywhere else the unit stays inert.
+ConditionPathExists=|/sys/class/firmware-attributes/asus-armoury/attributes/charge_mode/current_value
+ConditionPathExists=|/sys/devices/platform/asus-nb-wmi/charge_mode
+After=graphical-session.target
+PartOf=graphical-session.target
+
+[Service]
+Type=simple
+ExecStart=/usr/bin/omarchy-powerprofiles-source-monitor
+Restart=on-failure
+RestartSec=5
+
+[Install]
+WantedBy=graphical-session.target
