From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rdoupe
Date: Thu, 22 Oct 2026 03:04:35 -0400
Subject: [PATCH 24/24] Recover a stranded lock while voxtype's dictation OSD is running

Backport to v4.5.0-rc2: the stranded-lock test is now part of hyprland-session-lock-test.sh (omacom/omarchy#16337); the voxtype cases are ported there, with the fake /proc in its scratch directory.
Backport-of: omacom/omarchy#15912 (ab447851), applies to v4.5.0-rc1 unchanged
but for the test's locker paths, which sit under /data instead of a home
directory. Fork commits f87801d1 and d528fca1 on asus/v4-5-0-rc1, squashed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bin/omarchy-hyprland-session-lock-stranded | 27 ++++++++++++++++---
 test/shell.d/hyprland-session-lock-test.sh | 31 +++++++++++++++++++++-
 2 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/bin/omarchy-hyprland-session-lock-stranded b/bin/omarchy-hyprland-session-lock-stranded
index 05b8a56cc..24ab5b809 100755
--- a/bin/omarchy-hyprland-session-lock-stranded
+++ b/bin/omarchy-hyprland-session-lock-stranded
@@ -12,8 +12,29 @@
 #
 # Exits 0 stranded, 1 unlocked, 2 undetermined. The caller passes its own pid,
 # as a crash re-execs the shell in place.
+#
+# Voxtype's dictation OSD is a Quickshell that runs for the whole session and
+# never locks, so it doesn't count; otherwise no orphan would ever be recovered
+# while dictation is installed.
 omarchy-hyprland-session-locked || exit
 
-if pgrep -u "$UID" -x 'quickshell|qs|hyprlock' | grep -qvxF "$1"; then
-  exit 2
-fi
+proc_root=${OMARCHY_PROC_ROOT:-/proc}
+
+# Read from cmdline rather than pgrep -a, which joins arguments with spaces and
+# so lets a path with a space in it pass for voxtype's.
+is_voxtype_osd() {
+  local args=() i
+
+  mapfile -d '' args 2>/dev/null <"$proc_root/$1/cmdline" || return 1
+  [[ ${args[0]-} == ?(*/)@(qs|quickshell) ]] || return 1
+
+  for ((i = 1; i < ${#args[@]} - 1; i++)); do
+    [[ ${args[i]} == "-p" && ${args[i + 1]%/} == */voxtype/quickshell ]] && return 0
+  done
+
+  return 1
+}
+
+while read -r pid; do
+  [[ $pid == "$1" ]] || is_voxtype_osd "$pid" || exit 2
+done < <(pgrep -u "$UID" -x 'quickshell|qs|hyprlock')
diff --git a/test/shell.d/hyprland-session-lock-test.sh b/test/shell.d/hyprland-session-lock-test.sh
index cf441019e..e47ffa7ef 100644
--- a/test/shell.d/hyprland-session-lock-test.sh
+++ b/test/shell.d/hyprland-session-lock-test.sh
@@ -10,6 +10,7 @@ test_tmp=$(mktemp -d)
 trap 'rm -rf "$test_tmp"' EXIT
 
 fake_bin="$test_tmp/bin"
+proc="$test_tmp/proc"
 mkdir -p "$fake_bin"
 
 cat >"$fake_bin/hyprctl" <<'SH'
@@ -30,6 +31,24 @@ printf '%s\n' $OMARCHY_TEST_LOCKERS
 SH
 chmod +x "$fake_bin"/*
 
+locker() {
+  local pid="$1"
+  shift
+
+  mkdir -p "$proc/$pid"
+  printf '%s\0' "$@" >"$proc/$pid/cmdline"
+}
+
+locker 100 quickshell -n -p /usr/share/omarchy/shell
+locker 200 quickshell -n -p /tmp/tmp.abc/omarchy/shell
+locker 201 quickshell -n -p "/data/voxtype/quickshell backup/omarchy/shell"
+locker 202 qs -p /usr/share/voxtype/quickshell-locker
+locker 300 qs -p /usr/share/voxtype/quickshell
+locker 301 qs -d -p /data/.local/share/voxtype/quickshell
+locker 302 /usr/bin/qs -p "/data/User Data/voxtype/quickshell/"
+locker 400 hyprlock
+locker 401 hyprlock -c /usr/share/voxtype/quickshell/lock.conf
+
 LOCKED=0
 UNLOCKED=1
 UNDETERMINED=2
@@ -46,6 +65,7 @@ exit_status() {
   OMARCHY_TEST_MONITORS="$monitors" \
   OMARCHY_TEST_HYPRCTL_FAILS="$hyprctl_fails" \
   OMARCHY_TEST_LOCKERS="$lockers" \
+  OMARCHY_PROC_ROOT="$proc" \
     "$ROOT/bin/$command" 100 || actual=$?
 
   printf '%s\n' "$actual"
@@ -116,4 +136,13 @@ assert_stranded 0 "$locked_monitors" "" "a lock with no locker alive is stranded
 assert_stranded 0 "$locked_monitors" "100" "the asking shell does not count as another locker"
 assert_stranded 1 "$unlocked_monitors" "" "an unlocked session is not stranded"
 assert_stranded 2 '[]' "" "a compositor that cannot say leaves it undetermined" 1
-assert_stranded 2 "$locked_monitors" "100 200" "a lock another locker may hold is left undetermined, so it is never taken"
+assert_stranded 2 "$locked_monitors" "100 200" "a lock another shell may hold is left undetermined, so it is never taken"
+assert_stranded 2 "$locked_monitors" "100 400" "a lock hyprlock may hold is left undetermined"
+assert_stranded 0 "$locked_monitors" "100 300" "voxtype's dictation OSD does not count as a locker"
+assert_stranded 2 "$locked_monitors" "300 200" "voxtype's OSD does not hide another shell"
+assert_stranded 0 "$locked_monitors" "100 301" "voxtype's OSD from the user's data directory does not count either"
+assert_stranded 0 "$locked_monitors" "100 302" "nor from a data directory with a space in it"
+assert_stranded 2 "$locked_monitors" "100 202" "a shell beside voxtype's config is still a locker"
+assert_stranded 2 "$locked_monitors" "100 201" "a shell whose path only contains voxtype's config, after a space, is still a locker"
+assert_stranded 2 "$locked_monitors" "100 401" "hyprlock is a locker whatever its arguments name"
+assert_stranded 2 "$locked_monitors" "100 500" "a locker gone before its arguments are read is still counted"
