prepare() {
  if [[ -n "${OMARCHY_SRC:-}" ]]; then
    rm -rf "$srcdir/omarchy"
    mkdir -p "$srcdir/omarchy"
    cp -a "${OMARCHY_SRC}/." "$srcdir/omarchy/"
  fi
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0001-Stop-asusd-from-switching-the-power-profile-and-EPP-.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0002-Save-power-on-USB-C-chargers-on-ASUS-ROG-Zephyrus-la.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0003-Let-another-power-manager-own-the-profile-on-plug-an.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0004-Stop-the-idle-fans-on-battery-on-the-ROG-Zephyrus-G1.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0005-Use-a-software-cursor-while-a-monitor-on-the-NVIDIA-.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0006-Add-omarchy-hw-igpu-render-node-for-hybrid-NVIDIA-la.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0007-Decode-video-on-the-iGPU-when-it-is-a-non-VGA-displa.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0008-Keep-mpv-and-Chromium-video-decode-on-the-iGPU-of-hy.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0009-Set-the-ASUS-ROG-ALC285-Master-to-full-scale-under-t.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0010-Install-rtkit-so-PipeWire-gets-realtime-priority.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0011-Install-rtkit-on-fresh-installs-and-restart-the-port.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0012-Stop-early-loading-the-NVIDIA-driver-on-hybrid-GPU-m.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0013-Restore-the-drop-in-when-the-initramfs-rebuild-fails.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0014-Answer-the-webcam-menu-guard-from-udev-instead-of-op.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0015-Read-every-udev-record-before-asking-the-webcams.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0016-Poll-only-Tailscale-status-while-its-panel-is-closed.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0017-Reconcile-clamshell-state-on-logind-events-instead-o.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0018-Rescan-the-launcher-icon-index-at-most-once-a-minute.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0019-Give-a-connector-name-both-GPUs-expose-to-the-card-t.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0020-Repin-only-the-video-decode-pins-Omarchy-wrote.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0021-Remove-the-NVIDIA-drop-in-only-when-it-is-the-one-Om.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0022-Restart-the-portal-and-PipeWire-only-for-a-session-t.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/0023-Leave-mpv-alone-when-the-user-sets-hwdec-or-vaapi-de.patch"
}

package() {
  cd "$srcdir/omarchy"

  # Runtime binaries — ship everything in bin/ except the debug helpers
  # that ship from omarchy-settings (needed before omarchy is installed,
  # e.g. on the ISO live env).
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/omarchy/bin"
  for bin in bin/*; do
    [[ -f $bin ]] || continue
    local base
    base=$(basename "$bin")
    case "$base" in
      omarchy-debug|omarchy-debug-idle|omarchy-upload-log)
        continue
        ;;
    esac
    install -Dm755 "$bin" "$pkgdir/usr/bin/$base"
    ln -s "/usr/bin/$base" "$pkgdir/usr/share/omarchy/bin/$base"
  done

  install -d "$pkgdir/usr/share/omarchy"

  # Guard direct pacman upgrades from bypassing the Omarchy update pipeline,
  # and pause Hyprland live config reloads while settings files are replaced.
  # Ship hooks with their Exec targets so package skew cannot leave a broken
  # hook pointing at a missing binary.
  install -Dm644 default/libalpm/hooks/00-omarchy-update-guard.hook "$pkgdir/usr/share/libalpm/hooks/00-omarchy-update-guard.hook"
  install -Dm644 default/libalpm/hooks/10-omarchy-hyprland-reload-pause.hook "$pkgdir/usr/share/libalpm/hooks/10-omarchy-hyprland-reload-pause.hook"
  install -Dm644 default/libalpm/hooks/90-omarchy-hyprland-reload-resume.hook "$pkgdir/usr/share/libalpm/hooks/90-omarchy-hyprland-reload-resume.hook"

  # Target-side setup scripts and package lists used by ISO finalization,
  # first login, future users, migrations, and reinstall/reset commands.
  cp -a install "$pkgdir/usr/share/omarchy/"

  # Theme bundles for theme switching.
  cp -a themes "$pkgdir/usr/share/omarchy/"
  # Their intro videos ship from omarchy-themes-intros, into these same
  # directories, so they are not downloaded again with every rebuild.
  rm -rf "$pkgdir"/usr/share/omarchy/themes/*/backgrounds/intros

  # Versioned migrations runner reads from this tree.
  cp -a migrations "$pkgdir/usr/share/omarchy/"

  # Fresh users created after install are already on the package layout in this
  # build, so seed migration markers through /etc/skel. Existing users keep
  # their own state and still run pending migrations on update.
  if compgen -G 'migrations/*.sh' >/dev/null; then
    install -d "$pkgdir/etc/skel/.local/state/omarchy/migrations"
    for migration in migrations/*.sh; do
      touch "$pkgdir/etc/skel/.local/state/omarchy/migrations/$(basename "$migration")"
    done
  fi
  # Quickshell desktop shell tree.
  cp -a shell "$pkgdir/usr/share/omarchy/"

  # Runtime version file.
  install -Dm644 version "$pkgdir/usr/share/omarchy/version"
}
