diff --git a/bin/omarchy-launch-all-gpus b/bin/omarchy-launch-all-gpus
new file mode 100755
index 000000000..69736bfc5
--- /dev/null
+++ b/bin/omarchy-launch-all-gpus
@@ -0,0 +1,20 @@
+#!/bin/bash
+
+# omarchy:summary=Run a command that can use the NVIDIA GPU of a hybrid laptop, for games and their launchers
+# omarchy:args=<command> [args...]
+
+# On a hybrid laptop whose iGPU drives the display, Hyprland keeps NVIDIA's
+# Vulkan driver and EGL vendor out of the desktop
+# (default/hypr/desktop-gpu-pins.lua): the open driver resumes the
+# runtime-suspended dGPU whenever an app merely lists GPUs. Games get them back however they start: from a shell, at login, or from
+# the app launcher as a game. This runs anything else with every GPU too: DXVK
+# and other Vulkan games then pick the dGPU themselves. A native OpenGL game
+# still needs PRIME render offload as well (__NV_PRIME_RENDER_OFFLOAD=1
+# __GLX_VENDOR_LIBRARY_NAME=nvidia).
+
+if (( $# == 0 )); then
+  echo "Usage: omarchy-launch-all-gpus <command> [args...]" >&2
+  exit 1
+fi
+
+exec env -u VK_LOADER_DRIVERS_DISABLE -u __EGL_VENDOR_LIBRARY_FILENAMES "$@"
diff --git a/bin/omarchy-launch-desktop-entry b/bin/omarchy-launch-desktop-entry
new file mode 100755
index 000000000..8ecce1bca
--- /dev/null
+++ b/bin/omarchy-launch-desktop-entry
@@ -0,0 +1,77 @@
+#!/bin/bash
+
+# omarchy:summary=Launch a desktop entry, with every GPU for a game or game launcher
+# omarchy:args=<desktop-id>
+
+# On a hybrid laptop Hyprland keeps NVIDIA's Vulkan driver and EGL vendor out of
+# the desktop (default/hypr/desktop-gpu-pins.lua). A game, or a launcher that
+# starts games, starts through omarchy-launch-all-gpus instead, so it and every
+# game it starts can reach the dGPU: an entry in the Game category (Steam, Heroic, Lutris and
+# most games), one that prefers the discrete GPU (PrefersNonDefaultGPU=true or
+# KDE's X-KDE-RunOnDiscreteGpu=true), or one that runs a known game runner.
+# gtk-launch resolves and runs the entry either way.
+
+if (( $# != 1 )); then
+  echo "Usage: omarchy-launch-desktop-entry <desktop-id>" >&2
+  exit 1
+fi
+
+desktop_id=$1
+file_name=$desktop_id
+[[ $file_name == *.desktop ]] || file_name+=".desktop"
+
+# The entry file in one applications directory. A desktop ID names an entry in
+# a subdirectory with its path's slashes turned into dashes
+# (games/example.desktop is games-example.desktop).
+entry_file() {
+  local apps=$1 file
+  if [[ -f $apps/$file_name ]]; then
+    printf '%s\n' "$apps/$file_name"
+    return
+  fi
+  [[ $file_name == *-* && -d $apps ]] || return 1
+  while IFS= read -r -d '' file; do
+    file=${file#"$apps/"}
+    if [[ ${file//\//-} == "$file_name" ]]; then
+      printf '%s\n' "$apps/$file"
+      return
+    fi
+  done < <(find "$apps" -mindepth 2 -name '*.desktop' -print0 2>/dev/null)
+  return 1
+}
+
+# The first entry of that ID on the XDG data path is the one gtk-launch runs.
+is_game() {
+  local dir file
+  local IFS=:
+  for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
+    file=$(entry_file "$dir/applications") || continue
+    awk '
+      /^\[/ { in_entry = ($0 == "[Desktop Entry]"); next }
+      !in_entry { next }
+      /^(PrefersNonDefaultGPU|X-KDE-RunOnDiscreteGpu)[[:space:]]*=[[:space:]]*true[[:space:]]*$/ { found = 1; exit }
+      /^Categories[[:space:]]*=/ && /[=;][[:space:]]*Game[[:space:]]*(;|$)/ { found = 1; exit }
+      /^Exec[[:space:]]*=/ {
+        line = $0
+        sub(/^Exec[[:space:]]*=[[:space:]]*/, "", line)
+        n = split(line, words, /[[:space:]]+/)
+        for (i = 1; i <= n; i++) {
+          if (words[i] == "env" || words[i] ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue
+          base = words[i]; sub(/.*\//, "", base)
+          if (base ~ /^(steam|lutris|heroic|bottles|umu-run|gamescope|wine|wine64|proton)$/) found = 1
+          break
+        }
+        if (found) exit
+      }
+      END { exit !found }
+    ' "$file"
+    return
+  done
+  return 1
+}
+
+if is_game; then
+  exec omarchy-launch-all-gpus gtk-launch "$desktop_id"
+fi
+
+exec gtk-launch "$desktop_id"
