diff --git a/migrations/1792823623.sh b/migrations/1792823623.sh
new file mode 100644
index 000000000..69e1e0d99
--- /dev/null
+++ b/migrations/1792823623.sh
@@ -0,0 +1,11 @@
+echo "Keep the NVIDIA GPU asleep while apps start on hybrids whose iGPU drives the display"
+
+# Hyprland now keeps NVIDIA's Vulkan driver and EGL vendor out of the desktop
+# there, so listing GPUs at app startup no longer wakes the dGPU. Games still
+# get them: from a shell, at login, from the app launcher as a game, or through
+# omarchy-launch-all-gpus. Hyprland applies env at startup, so a running session
+# needs a reboot.
+if [[ -z ${OMARCHY_DESKTOP_GPU_PINS:-} ]] && omarchy-hw-nvidia-gsp && omarchy-hw-igpu-render-node >/dev/null; then
+  omarchy-state set reboot-required
+  echo "Reboot to keep the NVIDIA GPU asleep while apps start; games still use it."
+fi
diff --git a/migrations/1793053364.sh b/migrations/1793053364.sh
new file mode 100644
index 000000000..264695cf9
--- /dev/null
+++ b/migrations/1793053364.sh
@@ -0,0 +1,10 @@
+echo "Let an HDMI monitor on the NVIDIA GPU of a hybrid appear when plugged in"
+
+# The desktop's GPU pins used to be set for Hyprland itself, so it could not
+# open EGL on the NVIDIA GPU and a monitor on its ports never appeared. Hyprland
+# now sets them only for what it starts. A session started with the old pins
+# keeps them until Hyprland restarts.
+if [[ -n ${OMARCHY_DESKTOP_GPU_PINS:-} ]]; then
+  omarchy-state set reboot-required
+  echo "Reboot so a monitor plugged into the NVIDIA GPU's ports appears."
+fi
