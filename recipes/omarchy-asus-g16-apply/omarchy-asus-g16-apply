# ---------------------------------------------------------------------------
# initramfs-no-nvidia (opt-in)

NVIDIA_CONF=/etc/mkinitcpio.conf.d/nvidia.conf
NVIDIA_CONF_STOCK='MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)'
# The fork's migration marker: shared, so the rebuild runs once whichever does it.
NVIDIA_REBUILD_MARKER=/var/lib/omarchy/migrations/1787683023

check_initramfs_no_nvidia() {
  local conf f others=()
  conf=$(r "$NVIDIA_CONF")
  if ! command -v limine-mkinitcpio >/dev/null; then ST=n/a DETAIL="limine-mkinitcpio is not installed"; return; fi
  if ! pci_has_nvidia_display; then ST=n/a DETAIL="no NVIDIA GPU"; return; fi
  if omarchy-hw-nvidia-only-display; then ST=n/a DETAIL="NVIDIA drives every display; it needs the early load"; return; fi
  for f in "$(r /etc/mkinitcpio.conf)" "$(r /etc/mkinitcpio.conf.d)"/*.conf; do
    [[ -f $f && $f != "$conf" ]] || continue
    grep -vE '^[[:space:]]*#' "$f" | grep -qE 'MODULES.*nvidia' && others+=("${f#"$ROOT"}")
  done
  if [[ -f $conf ]]; then
    if [[ $(<"$conf") == "$NVIDIA_CONF_STOCK" ]]; then
      ST=missing DETAIL="$NVIDIA_CONF from Omarchy's installer early-loads nvidia; resume from hibernation fails"
    else
      ST=local DETAIL="$NVIDIA_CONF has your own content; left alone"
    fi
  elif [[ -e $(r "$NVIDIA_REBUILD_MARKER") ]]; then
    ST=applied DETAIL="no $NVIDIA_CONF; rebuilt (marker $NVIDIA_REBUILD_MARKER)"
  else
    local kept
    kept=$(find "$(r /etc/mkinitcpio.conf.d)" -maxdepth 1 -name 'nvidia.conf?*' -printf '%f\n' 2>/dev/null | head -1)
    if [[ -n $kept ]]; then
      ST=local DETAIL="no $NVIDIA_CONF (your ${kept} is kept)"
    else
      ST=present DETAIL="no $NVIDIA_CONF"
    fi
  fi
  if ((${#others[@]})); then
    DETAIL+="; nvidia is still in MODULES in ${others[*]} (yours, left alone)"
  fi
}

apply_initramfs_no_nvidia() {
  local backup
  # The fork's migration 1787683023.
  echo "    This is a hybrid GPU machine; removing nvidia from the initramfs and rebuilding it"
  if ((DRY_RUN)); then
    printf '    [dry-run] back up %s, sudo rm -f %s, sudo limine-mkinitcpio (restore the file if it fails), mark %s\n' \
      "$NVIDIA_CONF" "$NVIDIA_CONF" "$NVIDIA_REBUILD_MARKER"
    return 0
  fi
  # Nothing is removed unless the backup is complete.
  backup=$(mktemp) || { warn "could not create a backup of $NVIDIA_CONF; nothing changed"; return 1; }
  if ! cp "$NVIDIA_CONF" "$backup" || ! cmp -s "$NVIDIA_CONF" "$backup"; then
    rm -f "$backup"
    warn "could not back up $NVIDIA_CONF; nothing changed"
    return 1
  fi
  # No rebuild (and no marker) unless the file is gone.
  if ! sudo rm -f "$NVIDIA_CONF" || [[ -e $NVIDIA_CONF ]]; then
    rm -f "$backup"
    warn "could not remove $NVIDIA_CONF; nothing changed"
    return 1
  fi
  if ! sudo limine-mkinitcpio; then
    sudo install -m644 "$backup" "$NVIDIA_CONF"
    rm -f "$backup"
    echo "Rebuilding the initramfs failed; restored $NVIDIA_CONF" >&2
    return 1
  fi
  rm -f "$backup"
  sudo install -Dm644 /dev/null "$NVIDIA_REBUILD_MARKER"
  info "takes effect at the next boot; keep a fallback kernel entry until it has booted and resumed once"
}

