# rtkit

check_rtkit() {
  if pacman -Q rtkit >/dev/null 2>&1; then
    ST=present DETAIL="rtkit $(pacman -Q rtkit | cut -d' ' -f2) installed"
  elif omarchy_has_migration 1789747667; then
    ST=missing DETAIL="not installed yet; the patched omarchy's migration 1789747667 installs it at the next 'omarchy update'"
  else
    ST=missing DETAIL="nothing pulls rtkit in on x86_64; PipeWire runs without realtime threads"
  fi
}

apply_rtkit() {
  local had=0
  pacman -Q rtkit >/dev/null 2>&1 && had=1
  # The fork's migration 1792162892.
  if command -v omarchy-pkg-add >/dev/null; then
    run omarchy-pkg-add rtkit || return 1
  else
    as_root pacman -S --needed --noconfirm rtkit || return 1
  fi
  # Upstream omacom/omarchy#12428 (head dac602f5) restarts the portal, then
  # PipeWire, after the install; the fork's migration doesn't. The portal reads
  # rtkit's realtime budget once, and PipeWire clients that reconnect to a
  # stale one take a hard RLIMIT_RTTIME of 0 (omacom/omarchy#12443). Only when
  # this run installed rtkit.
  ((had)) && return 0
  ((DRY_RUN)) || pacman -Q rtkit >/dev/null 2>&1 || return 0
  run_quiet systemctl --user try-restart xdg-desktop-portal.service
  run_quiet systemctl --user try-restart pipewire.service pipewire-pulse.service wireplumber.service
}

