# audio-master

SOFT_MIXER_CONF=$HOME/.config/wireplumber/wireplumber.conf.d/alsa-soft-mixer.conf

alc285_card() {
  aplay -l 2>/dev/null | grep -i "ALC285" | head -1 | sed 's/card \([0-9]*\).*/\1/'
}

check_audio_master() {
  local card level
  if ! is_asus_rog; then ST=n/a DETAIL="not an ASUS ROG laptop"; return; fi
  if [[ ! -f $SOFT_MIXER_CONF ]]; then ST=n/a DETAIL="no soft mixer: PipeWire drives Master itself"; return; fi
  card=$(alc285_card)
  if [[ -z $card ]]; then ST=n/a DETAIL="no ALC285 card (aplay -l)"; return; fi
  level=$(amixer -c "$card" sget Master 2>/dev/null | grep -o '\[[0-9]*%\]' | head -1 | tr -d '[]%')
  case $level in
    100) ST=present DETAIL="Master at 100 % on card $card" ;;
    80)
      ST=missing DETAIL="Master at 80 % (Omarchy's install value): the slider's 100 % is 12.75 dB below full scale"
      if omarchy_has_migration 1792162887; then
        DETAIL+="; the patched omarchy's migration only tells you (it never raises the level during an update): run this command to raise it"
      fi
      ;;
    '') ST=n/a DETAIL="card $card has no Master control" ;;
    *) ST=local DETAIL="Master at $level % on card $card (your setting); left alone" ;;
  esac
}

apply_audio_master() {
  local card
  card=$(alc285_card)
  [[ -n $card ]] || return 1
  warn "the speakers get louder at the same volume slider setting"
  # The fork's install/user/hardware/asus/fix-audio-mixer.sh.
  run amixer -c "$card" set Master 100% unmute
}

