  fi
  if owner=$(power_owner); then
    ST=local DETAIL="power profiles are owned by $owner; left alone"
  elif [[ -e $(r /usr/bin/omarchy-powerprofiles-asus-quiet-fans) || -e $(r /etc/sudoers.d/omarchy-asus-quiet-fans) ]]; then
    ST=present DETAIL="the omarchy fork's omarchy-powerprofiles-set does this"
  elif [[ -L $(r "/etc/systemd/system/multi-user.target.wants/$QUIET_FANS_UNIT") ]]; then
    ST=applied DETAIL="$QUIET_FANS_UNIT enabled"
  else
    ST=missing DETAIL="balanced keeps the fans at 2,000-3,800 rpm at idle on battery"
  fi
}

apply_quiet_fans() {
  as_root systemctl enable --now "$QUIET_FANS_UNIT"
}

# ---------------------------------------------------------------------------
# Report-only rows: fixes that come from packages, and fixes no package or
# command can deliver without changing Omarchy.

pkg_version() { pacman -Q "$1" 2>/dev/null | cut -d' ' -f2; }

info_rows() {
  local v f owner
  v=$(pkg_version linux-omarchy)
  if [[ $v =~ -[0-9]+\.[0-9]+$ ]]; then row linux-omarchy present "$v (omarchy-asus build: hid-asus Win-lock)"
  elif [[ -n $v ]]; then row linux-omarchy missing "$v is the stock build; the omarchy-asus build adds the hid-asus Win-lock pass-through"
  else row linux-omarchy n/a "not installed"; fi

  v=$(pkg_version nvidia-open-dkms)
  if [[ $v =~ -[0-9]+\.[0-9]+$ ]]; then row nvidia-open-dkms present "$v (omarchy-asus build: #1299 NVPCF defer, #1412 hibernate power-off)"
  elif [[ -n $v ]]; then row nvidia-open-dkms missing "$v is the stock build; the omarchy-asus build adds #1299 and #1412"
  else row nvidia-open-dkms n/a "not installed"; fi

  v=$(pkg_version hyprland)
  if [[ $v =~ -[0-9]+\.[0-9]+$ ]]; then row hyprland present "$v (omarchy-asus build: render offset after HDMI replug)"
  elif [[ -n $v ]]; then row hyprland missing "$v is the stock build; the omarchy-asus build fixes the render offset after an HDMI replug"
  else row hyprland n/a "not installed"; fi

  v=$(pkg_version aquamarine)
  if [[ -n $v ]] && (($(vercmp "$v" 0.15.1) >= 0)); then row aquamarine present "$v (0.15.1 or later: the RTX sleeps again after an HDMI unplug)"
  elif [[ -n $v ]]; then row aquamarine missing "$v: needs 0.15.1 or later ('omarchy update')"
  else row aquamarine n/a "not installed"; fi

  if [[ -f $(r /usr/lib/udev/rules.d/99-omarchy-asus-g16-touchpad-wake.rules) ]]; then row touchpad-wake present "omarchy-asus-g16"
  elif f=$(grep -lE 'ASUF1209' "$(r /etc/udev/rules.d)"/*.rules 2>/dev/null | head -1) && [[ -n $f ]]; then row touchpad-wake local "${f#"$ROOT"}"
  else row touchpad-wake missing "install omarchy-asus-g16"; fi

  if [[ -f $(r /usr/lib/systemd/sleep.conf.d/omarchy-asus-g16-hibernate-mode.conf) ]]; then row hibernate-mode present "omarchy-asus-g16"
  elif f=$(grep -lE '^[[:space:]]*HibernateMode=shutdown' "$(r /etc/systemd/sleep.conf)" "$(r /etc/systemd/sleep.conf.d)"/*.conf 2>/dev/null | head -1) && [[ -n $f ]]; then
    row hibernate-mode local "${f#"$ROOT"}"
  else row hibernate-mode missing "install omarchy-asus-g16"; fi

  if [[ -f $(r /usr/lib/systemd/system/nvidia-powerd.service.d/20-omarchy-asus.conf) ]]; then row nvidia-powerd present "omarchy-asus-g16"
  elif f=$(grep -lE '^[[:space:]]*StartLimitIntervalSec=' "$(r /etc/systemd/system/nvidia-powerd.service.d)"/*.conf "$(r /usr/lib/systemd/system/nvidia-powerd.service.d)"/*.conf 2>/dev/null | head -1) && [[ -n $f ]]; then
    row nvidia-powerd local "${f#"$ROOT"}"
  else row nvidia-powerd missing "install omarchy-asus-g16"; fi

  if owner=$(power_owner); then
    row usbc-power local "power profiles are owned by $owner"
    row external-owner local "power profiles are owned by $owner"
  else
    row usbc-power upstream "changes Omarchy's omarchy-powerprofiles-set: omacom/omarchy#15668"
    row external-owner upstream "changes Omarchy's omarchy-powerprofiles-set: omacom/omarchy#15669"
  fi
}

label() {
  case $1 in
    local) echo "present (local)" ;;
    repair) echo "needs repair" ;;
    upstream) echo "upstream PR only" ;;
    *) echo "$1" ;;
  esac
}

row() {
  local color=''
  case $2 in
    applied | present | local) color=$G ;;
    missing | repair) color=$Y ;;
  esac
  printf '  %-22s %s%-18s%s %s\n' "$1" "$color" "$(label "$2")" "$N" "$3"
}

# Runs one fix's check; sets ST and DETAIL.
check_fix() { ST='' DETAIL=''; "check_${1//-/_}"; }

# ---------------------------------------------------------------------------

((EUID != 0)) || die "run this as your normal user, not root; it calls sudo where needed"
if [[ -n $ROOT ]] && ((!DRY_RUN && !CHECK)); then
  die "OMARCHY_ASUS_G16_ROOT is set: only --check and --dry-run can run against a test prefix"
fi
((DRY_RUN)) && printf '%s(dry run: nothing is changed)%s\n' "$Y" "$N"

if ! is_ga605km; then
  if ((CHECK || DRY_RUN || FORCE)); then
    warn "this machine does not report GA605KM in its DMI data; these fixes are for the G16 GA605KM"
  else
    die "this is not an ASUS ROG Zephyrus G16 GA605KM (DMI). Use --force only if you know why it should run here."
  fi
fi

if ((CHECK)); then
  step "Packages ('omarchy update' with the omarchy-asus repo; report only)"
  info_rows
  step "Fixes this command applies"
  missing_default=0 any_redundant=0
  for fix in "${DEFAULT_FIXES[@]}" "${OPTIN_FIXES[@]}"; do
    check_fix "$fix"
    status=$ST
    if [[ $ST == missing ]] && is_optin "$fix"; then
      printf '  %-22s %s%-18s%s %s\n' "$fix" "$Y" "missing (opt-in)" "$N" "$DETAIL"
      continue
    fi
    row "$fix" "$status" "$DETAIL"
    [[ $status == missing || $status == repair ]] && missing_default=1
    [[ $DETAIL == *redundant* ]] && any_redundant=1
  done
  if patched_omarchy; then
    step "Patched omarchy installed"
    info "its migrations apply hybrid-video, hdmi-cursor, rtkit and the asusd drop-in on 'omarchy update';"
    info "no login service is needed. hybrid-video is present once its mpv and Chromium pins are in place"
    info "(the migration's marker alone isn't enough), and this command hands its older pins over to Omarchy."
    info "audio-master is only notified"
    info "by its migration: run this command to raise it."
    if ((any_redundant)); then info "Lines this command added earlier show as redundant above: delete them."; fi
  fi
  ((DRY_RUN)) || exit $((missing_default ? 10 : 0))
fi

((${#SELECTED[@]})) || SELECTED=("${DEFAULT_FIXES[@]}")

TODO=()
((CHECK)) || step "Checking"
for fix in "${SELECTED[@]}"; do
  check_fix "$fix"
  ((CHECK)) || row "$fix" "$ST" "$DETAIL"
  [[ $ST == missing || $ST == repair ]] && TODO+=("$fix")
done

if ((${#TODO[@]} == 0)); then
  step "Nothing to apply"
  exit 0
fi

if ((DRY_RUN)); then step "Would apply: ${TODO[*]}"; else step "Applying: ${TODO[*]}"; fi
if ((!DRY_RUN && !YES)); then
  [[ -r /dev/tty ]] || die "no terminal to ask on; pass --yes"
  read -r -p "    Apply these fixes? [y/N] " answer </dev/tty
  [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || die "cancelled"
fi

failed=0
for fix in "${TODO[@]}"; do
  step "$fix: ${DESC[$fix]}"
  "apply_${fix//-/_}" || { warn "$fix failed"; failed=1; }
done
exit "$failed"
