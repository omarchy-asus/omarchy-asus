# asusd-power-profiles

ASUSD_DROPIN=/etc/systemd/system/asusd.service.d/20-omarchy-asus-power-profiles.conf
ASUSD_PROPS=(ChangePlatformProfileOnAc ChangePlatformProfileOnBattery PlatformProfileLinkedEpp)
asusd_platform=(xyz.ljones.Asusd /xyz/ljones xyz.ljones.Platform)

check_asusd_power_profiles() {
  local owner f dir prop value off=0
  if ! is_asus_rog; then ST=n/a DETAIL="not an ASUS ROG laptop"; return; fi
  if [[ ! -e $(r /usr/lib/systemd/system/asusd.service) ]]; then ST=n/a DETAIL="asusctl is not installed"; return; fi
  if owner=$(power_owner); then
    ST=local DETAIL="power profiles are owned by $owner; left alone"
    return
  fi
  if [[ -f $(r "$ASUSD_DROPIN") ]]; then
    if cmp -s "$(r "$ASUSD_DROPIN")" "$SHARE/system/asusd-power-profiles.conf"; then
      if [[ -f $(r /etc/systemd/system/asusd.service.d/10-omarchy-power-profiles.conf) ]]; then
        ST=present DETAIL="omarchy-settings ships /etc/systemd/system/asusd.service.d/10-omarchy-power-profiles.conf; this command's $ASUSD_DROPIN is now redundant (sudo rm it, then sudo systemctl daemon-reload)"
      else
        ST=applied DETAIL="$ASUSD_DROPIN"
      fi
    else
      ST=local DETAIL="$ASUSD_DROPIN differs from the packaged copy; left alone"
    fi
    return
  fi
  for dir in /etc/systemd/system/asusd.service.d /run/systemd/system/asusd.service.d /usr/lib/systemd/system/asusd.service.d; do
    for f in "$(r "$dir")"/*.conf; do
      [[ -f $f ]] || continue
      grep -q 'ChangePlatformProfileOn' "$f" || continue
      if [[ ${f##*/} == 10-omarchy-power-profiles.conf ]]; then
        ST=present DETAIL="the omarchy fork's drop-in ${f#"$ROOT"}"
      else
        ST=local DETAIL="${f#"$ROOT"} sets asusd's profile switching; left alone"
      fi
      return
    done
  done
  for prop in "${ASUSD_PROPS[@]}"; do
    value=$(busctl --system get-property "${asusd_platform[@]}" "$prop" 2>/dev/null || true)
    [[ $value == "b false" ]] && ((off++))
  done
  ST=missing
  if ((off == ${#ASUSD_PROPS[@]})); then
    DETAIL="asusd's switching is off for now (asusd.ron); the drop-in keeps it off at every start"
  else
    DETAIL="asusd and Omarchy both switch the profile on every plug, and asusd rewrites the EPP"
  fi
}

apply_asusd_power_profiles() {
  local prop value
  # The fork's etc/systemd/system/asusd.service.d/10-omarchy-power-profiles.conf,
  # under a basename no Omarchy package uses.
  as_root install -Dm644 "$SHARE/system/asusd-power-profiles.conf" "$ASUSD_DROPIN" || return 1
  as_root systemctl daemon-reload
  # The fork's migration 1792122579: the running asusd too. asusd's D-Bus policy
  # lets wheel members set these without root.
  if ((DRY_RUN)); then
    printf '    [dry-run] busctl --system set-property %s %s b false (each of: %s, if asusd is running and it is true)\n' \
      "${asusd_platform[*]}" '<property>' "${ASUSD_PROPS[*]}"
    return 0
  fi
  systemctl is-active --quiet asusd.service || return 0
  for prop in "${ASUSD_PROPS[@]}"; do
    value=$(busctl --system get-property "${asusd_platform[@]}" "$prop" 2>/dev/null || true)
    if [[ $value == "b true" ]]; then
      busctl --system set-property "${asusd_platform[@]}" "$prop" b false ||
        echo "    Could not turn off asusd $prop now; it is turned off when asusd next starts"
    fi
  done
}

# ---------------------------------------------------------------------------
# winlock

winlock_nodes_accessible() {
  local dev ok=0 found=0
  for dev in "$(r /sys/class/hidraw)"/hidraw*; do
    grep -qi 'HID_ID=0003:00000B05:000019B6' "$dev/device/uevent" 2>/dev/null || continue
    found=1
    [[ -r $(r "/dev/${dev##*/}") && -w $(r "/dev/${dev##*/}") ]] && ok=1
  done
  ((found && ok))
}

check_winlock() {
  local unit=$HOME/.config/systemd/user/g16-winlock.service
  if [[ ! -x $(r /usr/bin/g16-winlock) || ! -f $(r /usr/lib/systemd/user/g16-winlock.service) ]]; then
    ST=n/a DETAIL="asus-rog-nkey-winlock is not installed"
    return
  fi
  if [[ -L $unit && $(readlink "$unit") == /dev/null ]]; then
    ST=local DETAIL="g16-winlock.service is masked by you; left alone"
    return
  elif [[ -e $unit ]]; then
    ST=local DETAIL="your own unit $(tilde "$unit") (shadows the packaged one); left alone"
    return
  fi
  # The package enables it for every user under graphical-session.target;
  # older builds and a manual enable may have used default.target.
  local t dir
  for t in graphical-session default; do
    for dir in "$HOME/.config/systemd/user" "$(r /etc/systemd/user)" "$(r /usr/lib/systemd/user)"; do
      if [[ -L $dir/$t.target.wants/g16-winlock.service ]]; then
        ST=applied DETAIL="g16-winlock.service enabled ($t.target)"
        return
      fi
    done
  done
  ST=missing DETAIL="g16-winlock.service is installed but not enabled"
}

apply_winlock() {
  run systemctl --user enable --now g16-winlock.service || return 1
  if ! winlock_nodes_accessible; then
    warn "you can't open the ROG N-Key keyboard's hidraw node yet. Reboot, or run"
    warn "'sudo udevadm trigger --subsystem-match=hidraw', so the packaged rule applies."
  fi
  info "the Win-lock toast needs linux-omarchy from this repo (7.2.8-9.1 or later)"
}

