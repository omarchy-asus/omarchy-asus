#!/bin/bash
# omarchy-asus-g16-apply: apply the ASUS ROG Zephyrus G16 GA605KM fixes that no
# package can ship, because they live in your own config or in /etc. EXPERIMENTAL.
#
#   omarchy-asus-g16-apply --check          report every known G16 fix (read-only)
#   omarchy-asus-g16-apply --dry-run [FIX]  show what applying would change
#   omarchy-asus-g16-apply [FIX...]         apply the default fixes, or the named ones
#   omarchy-asus-g16-apply --list           list the fixes this command applies
#
#   --yes    don't ask before applying     --force  skip the GA605KM model check
#
# Each fix does what the omarchy-asus fork's install leaf or migration does, with
# the same files, contents and commands. Nothing of Omarchy's is edited. A fix you
# already have in your own form (any setting of your own for the same thing) is
# reported as "present (local)" and left alone; nothing is overwritten. Run it as
# your normal user; it calls sudo for the system steps.
#
# With the patched omarchy and omarchy-settings from the omarchy-asus repo
# (4.0.5-1.1 or later), their migrations and default files apply hybrid-video,
# hdmi-cursor, rtkit and the asusd drop-in during 'omarchy update', and --check
# reports them as present once they have (hybrid-video: once its pins are in
# place, not on its migration's marker alone; this command's older pins are
# handed over to Omarchy). This command is then for stock Omarchy, for
# audio-master (the migration only tells you about it) and for the opt-ins.
# check_<fix> and apply_<fix> run by name (check_fix, the apply loop).
# shellcheck disable=SC2329
set -uo pipefail

SHARE=${OMARCHY_ASUS_G16_APPLY_SHARE:-/usr/share/omarchy-asus-g16-apply}
LIB=${OMARCHY_ASUS_G16_APPLY_LIB:-/usr/lib/omarchy-asus-g16-apply}
# Test prefix for /sys, /etc, /usr, /var and /dev. Empty on a real system; a run
# with a prefix can only check or dry-run.
ROOT=${OMARCHY_ASUS_G16_ROOT:-}
# The Lua lines added to hyprland.lua always name the installed files.
INSTALLED_SHARE=/usr/share/omarchy-asus-g16-apply

DEFAULT_FIXES=(hybrid-video hdmi-cursor audio-master rtkit asusd-power-profiles winlock)
OPTIN_FIXES=(initramfs-no-nvidia quiet-fans g16-widget)

declare -A DESC=(
  [hybrid-video]="VA-API, mpv and Chromium video decode on the iGPU instead of the RTX (fork asus/hybrid-video-decode)"
  [hdmi-cursor]="software cursor while a monitor on the RTX is connected (fork asus/hdmi-cursor)"
  [audio-master]="ALC285 hardware Master at 100 % under the soft mixer (fork asus/audio)"
  [rtkit]="rtkit, so PipeWire gets realtime scheduling (fork asus/rtkit)"
  [asusd-power-profiles]="asusd stops switching the power profile and EPP itself (fork asus/asusd-power-profiles)"
  [winlock]="enable the g16-winlock user service (asus-rog-nkey-winlock)"
  [initramfs-no-nvidia]="opt-in: drop NVIDIA early load from the initramfs and rebuild it (fork carry/initramfs-8263)"
  [quiet-fans]="opt-in, EXPERIMENTAL: fans off at idle on battery (fork asus/ga605km-quiet-fans helper)"
  [g16-widget]="opt-in: link and enable the G16 Control bar widget (asus-zephyrus-g16-control)"
)

DRY_RUN=0 CHECK=0 YES=0 FORCE=0
SELECTED=()

usage() { sed -n '2,24s/^# \{0,1\}//p' "$0"; }

is_fix() {
  local f
  for f in "${DEFAULT_FIXES[@]}" "${OPTIN_FIXES[@]}"; do [[ $f == "$1" ]] && return 0; done
  return 1
}

is_optin() {
  local f
  for f in "${OPTIN_FIXES[@]}"; do [[ $f == "$1" ]] && return 0; done
  return 1
}

for arg in "$@"; do
  case $arg in
    --check) CHECK=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --yes | -y) YES=1 ;;
    --force) FORCE=1 ;;
    --list)
      for f in "${DEFAULT_FIXES[@]}" "${OPTIN_FIXES[@]}"; do printf '%-22s %s\n' "$f" "${DESC[$f]}"; done
      exit 0
      ;;
    -h | --help) usage; exit 0 ;;
    -*) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
    *)
      is_fix "$arg" || { echo "Unknown fix: $arg (see --list)" >&2; exit 2; }
      SELECTED+=("$arg")
      ;;
  esac
done

if [[ -t 1 ]]; then B=$'\e[1m' R=$'\e[31m' Y=$'\e[33m' G=$'\e[32m' N=$'\e[0m'; else B='' R='' Y='' G='' N=''; fi
step() { printf '\n%s==> %s%s\n' "$B" "$*" "$N"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '    %swarning:%s %s\n' "$Y" "$N" "$*" >&2; }
die() { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# Path under the test prefix.
r() { printf '%s%s' "$ROOT" "$1"; }
# ~ for $HOME in messages.
tilde() { printf '%s' "${1/#"$HOME"/\~}"; }

# Under --dry-run these print what they would do instead of doing it.
run() {
  if ((DRY_RUN)); then printf '    [dry-run] %s\n' "$*"; else "$@"; fi
}
# run, with errors ignored (the migration's "2>/dev/null || true").
run_quiet() {
  if ((DRY_RUN)); then printf '    [dry-run] %s\n' "$*"; else "$@" 2>/dev/null || true; fi
}
as_root() {
  if ((DRY_RUN)); then printf '    [dry-run] sudo %s\n' "$*"; else sudo "$@"; fi
}

# The fork's tools, shipped unchanged, find each other by name.
PATH=$LIB/bin:$PATH
if [[ -n $ROOT ]]; then
  export OMARCHY_PCI_DEVICES_PATH=${OMARCHY_PCI_DEVICES_PATH:-$ROOT/sys/bus/pci/devices}
  export OMARCHY_DRI_BY_PATH=${OMARCHY_DRI_BY_PATH:-$ROOT/dev/dri/by-path}
fi
# hybrid_video_pin_mpv, hybrid_video_pin_chromium, hybrid_video_mpv_sets and
# HYBRID_VIDEO_* from the fork's install/helpers/hybrid-video-decode.sh.
# shellcheck source=/dev/null
source "$SHARE/fork/hybrid-video-decode.sh" || die "missing $SHARE/fork/hybrid-video-decode.sh"
HYBRID_VIDEO_MPV_COMMENT="# Decode video on the integrated GPU that drives the display, so the NVIDIA GPU can stay asleep."

HYPR_CONF=$HOME/.config/hypr/hyprland.lua

# ---------------------------------------------------------------------------
# Hardware and ownership checks (cached sysfs and config files only).

dmi() { local v=""; read -r v <"$(r "/sys/class/dmi/id/$1")" 2>/dev/null; printf '%s' "$v"; }
# omarchy-hw-asus-rog
is_asus_rog() { [[ $(dmi sys_vendor) == "ASUSTeK COMPUTER INC." && $(dmi product_family) == *ROG* ]]; }
# omarchy-hw-match GA605KM
is_ga605km() {
  local p f
  p=$(dmi product_name) f=$(dmi product_family)
  [[ ${p,,} == *ga605km* || ${f,,} == *ga605km* ]]
}

# Another tool owns the power profile: the fork's external-owner toggle, or a
# local power manager. Prints what it found.
power_owner() {
  local toggle=$HOME/.local/state/omarchy/toggles/powerprofiles-autoswitch-off unit
  if [[ -f $toggle ]]; then
    echo "toggle $(tilde "$toggle")"
    return 0
  fi
  for unit in "$HOME/.config/systemd/user/rog-power.service" "$(r /etc/systemd/user/rog-power.service)" \
    "$(r /etc/systemd/system/rog-power.service)"; do
    if [[ -e $unit ]]; then
      echo "rog-power ($(tilde "$unit"))"
      return 0
    fi
  done
  return 1
}

# The omarchy-asus patched omarchy and omarchy-settings (4.0.5-1.1 or later):
# their migrations ship to /usr/share/omarchy/migrations/<id>.sh and their
# default files to /usr/share/omarchy/default/.
PATCHED_OMARCHY_MIGRATIONS=/usr/share/omarchy/migrations
PATCHED_HYBRID_CURSOR=/usr/share/omarchy/default/hypr/hybrid-cursor.lua
omarchy_has_migration() { [[ -f $(r "$PATCHED_OMARCHY_MIGRATIONS/$1.sh") ]]; }
patched_omarchy() { omarchy_has_migration 1792123636 || [[ -f $(r "$PATCHED_HYBRID_CURSOR") ]]; }
# A shipped migration hasn't necessarily run: pacman installs it, and the next
# 'omarchy update' (omarchy-migrate) runs it and records it per user under
# OMARCHY_STATE_MIGRATIONS/<id>.sh (a skipped one under skipped/<id>.sh).
OMARCHY_STATE_MIGRATIONS=$HOME/.local/state/omarchy/migrations
omarchy_ran_migration() { [[ -e $OMARCHY_STATE_MIGRATIONS/$1.sh ]]; }

# Non-comment lines of the user's Hyprland config matching an ERE, not counting
# the lines this command adds. Prints the first file. Follows symlinks: dotfile
# managers often link hyprland.lua, or the whole hypr directory, from elsewhere.
hypr_sets() {
  local f
  [[ -d $HOME/.config/hypr ]] || return 1
  while IFS= read -r f; do
    if grep -vE '^[[:space:]]*(--|#)' "$f" | grep -vF "$INSTALLED_SHARE" | grep -qE "$1"; then
      printf '%s\n' "$f"
      return 0
    fi
  done < <(find -L "$HOME/.config/hypr" -maxdepth 3 -type f \( -name '*.lua' -o -name '*.conf' \) 2>/dev/null | sort)
  return 1
}

# A LIBVA_DRIVER_NAME of the user's own: Hyprland config, uwsm or environment.d.
libva_set_by_user() {
  local f
  if f=$(hypr_sets 'LIBVA_DRIVER_NAME'); then
    printf '%s\n' "$f"
    return 0
  fi
  for f in "$HOME/.config/uwsm/env" "$HOME/.config/uwsm/env-hyprland" "$HOME"/.config/environment.d/*.conf; do
    [[ -f $f ]] && grep -qE '^[[:space:]]*(export[[:space:]]+)?LIBVA_DRIVER_NAME=' "$f" && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# The two lines a Hyprland fix adds to hyprland.lua.
lua_comment() { printf -- '-- omarchy-asus-g16-apply %s: %s (delete this line and the next to undo)' "$1" "$2"; }
lua_line() {
  printf 'do local f = "%s/hypr/%s"; local h = io.open(f, "r"); if h then h:close(); dofile(f) end end' "$INSTALLED_SHARE" "$1"
}
hypr_has_line() { [[ -f $HYPR_CONF ]] && grep -qxF "$(lua_line "$1")" "$HYPR_CONF"; }

hypr_append() {
  local fix=$1 file=$2 summary=$3
  if ((DRY_RUN)); then
    printf '    [dry-run] append to %s:\n        %s\n        %s\n' "$(tilde "$HYPR_CONF")" "$(lua_comment "$fix" "$summary")" "$(lua_line "$file")"
    return 0
  fi
  [[ -f $HYPR_CONF ]] || { warn "$(tilde "$HYPR_CONF") not found"; return 1; }
  # Append in place, which keeps a symlinked config pointing where it did.
  [[ -s $HYPR_CONF && -n $(tail -c1 "$HYPR_CONF") ]] && echo >>"$HYPR_CONF"
  printf '\n%s\n%s\n' "$(lua_comment "$fix" "$summary")" "$(lua_line "$file")" >>"$HYPR_CONF"
  info "added to $(tilde "$HYPR_CONF")"
}

# drm cards: an NVIDIA one next to one from another vendor (hybrid-cursor.lua's test).
drm_hybrid() {
  local v nvidia=0 other=0 card
  for card in "$(r /sys/class/drm)"/card[0-9] "$(r /sys/class/drm)"/card[0-9][0-9]; do
    [[ -r $card/device/vendor ]] || continue
    v=$(<"$card/device/vendor")
    if [[ $v == 0x10de ]]; then nvidia=1; else other=1; fi
  done
  ((nvidia && other))
}

pci_has_nvidia_display() {
  local d
  for d in "${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"/*; do
    [[ -r $d/class && -r $d/vendor ]] || continue
    [[ $(<"$d/class") == 0x03* && $(<"$d/vendor") == 0x10de ]] && return 0
  done
  return 1
}

# Each check sets ST (applied, present, local, missing, repair or n/a) and
# DETAIL. applied: the change this command makes is in place. present: the fix
# is in place from somewhere else. local: you have your own setting for it,
# which is left alone. missing: applying would add it. repair: a change this
# command made is out of date, and applying updates or removes it. n/a: not
# this hardware, or a prerequisite package is not installed.
ST='' DETAIL=''

# ---------------------------------------------------------------------------
# hybrid-video

# The marker line written above each Chromium-family pin this command adds. Only
# pins under it, and the vaapi-device line in the block under the fork's mpv
# comment, are ever changed again; a pin you wrote yourself is never touched.
HYBRID_VIDEO_PIN_MARKER="# omarchy-asus-g16-apply hybrid-video: decode on the iGPU (kept up to date by the command; delete this line and the next to undo)"
# The patched omarchy's marker: it repins or removes only the pin on the line
# right under it, above --render-node-override in the Chromium-family flags
# files and above vaapi-device in mpv.conf. A pin under it is Omarchy's, never
# this command's. Keep in step with recipes/omarchy 0020, default/hypr/nvidia.lua
# and install/helpers/hybrid-video-decode.sh.
OMARCHY_HYBRID_VIDEO_PIN_MARKER="# Omarchy repins the next line if the iGPU moves. Delete this comment to keep the line as your own."

# The render node pins this command wrote, one "FILE<TAB>LINE<TAB>NODE" each.
hybrid_video_managed_pins() {
  local f
  for f in "${HYBRID_VIDEO_CHROMIUM_FLAGS_FILES[@]}"; do
    [[ -f $f ]] || continue
    awk -v m="$HYBRID_VIDEO_PIN_MARKER" -v f="$f" '
      prev == m && /^--render-node-override=[^[:space:]]+$/ { print f "\t" NR "\t" substr($0, 24) }
      { prev = $0 }' "$f"
  done
  [[ -f $HYBRID_VIDEO_MPV_CONF ]] || return 0
  # The fork's hybrid_video_pin_mpv writes its comment, then the options, then a
  # blank line ahead of what was there before. The patched omarchy writes the
  # same comment, with its marker above the vaapi-device line: that pin is
  # Omarchy's (its start-time check and omarchy-refresh-hybrid-video keep it).
  awk -v m="$HYBRID_VIDEO_MPV_COMMENT" -v om="$OMARCHY_HYBRID_VIDEO_PIN_MARKER" -v f="$HYBRID_VIDEO_MPV_CONF" '
    $0 == m { block = 1; prev = $0; next }
    block && (/^[[:space:]]*$/ || /^[[:space:]]*\[/) { exit }
    block && prev != om && /^vaapi-device=[^[:space:]]+$/ { print f "\t" NR "\t" substr($0, 14) }
    { prev = $0 }' "$HYBRID_VIDEO_MPV_CONF"
}

# Managed pins that don't name NODE (any of them when NODE is empty), as
# "~/file:line" words.
hybrid_video_stale_pins() {
  local node=$1 file line pin
  while IFS=$'\t' read -r file line pin; do
    [[ -n $node && $pin == "$node" ]] || printf '%s:%s\n' "$(tilde "$file")" "$line"
  done < <(hybrid_video_managed_pins)
}

# Repoints the stale managed pins at NODE, or removes them (and a Chromium pin's
# marker) when NODE is empty. Rewrites in place, which keeps a symlinked config
# pointing where it did.
hybrid_video_repair_pins() {
  local node=$1 file line pin out
  local -A lines=()
  while IFS=$'\t' read -r file line pin; do
    [[ -n $node && $pin == "$node" ]] || lines[$file]+="$line "
  done < <(hybrid_video_managed_pins)
  for file in "${!lines[@]}"; do
    if ((DRY_RUN)); then
      if [[ -n $node ]]; then
        printf '    [dry-run] repin to %s in %s (line %s)\n' "$node" "$(tilde "$file")" "${lines[$file]% }"
      else
        printf '    [dry-run] remove the pin from %s (line %s)\n' "$(tilde "$file")" "${lines[$file]% }"
      fi
      continue
    fi
    if [[ -z $node && $file == "$HYBRID_VIDEO_MPV_CONF" ]]; then
      hybrid_video_mpv_drop_block
      info "removed the pin from $(tilde "$file")"
      continue
    fi
    out=$(awk -v lines="${lines[$file]}" -v node="$node" -v m="$HYBRID_VIDEO_PIN_MARKER" '
      BEGIN { n = split(lines, a, " "); for (i = 1; i <= n; i++) fix[a[i]] = 1 }
      { buf[NR] = $0 }
      END {
        for (i = 1; i <= NR; i++) {
          if (node == "" && fix[i + 1] && buf[i] == m) continue
          if (fix[i]) {
            if (node == "") continue
            sub(/=.*/, "=" node, buf[i])
          }
          print buf[i]
        }
      }' "$file"; echo x)
    printf '%s' "${out%x}" >"$file"
    if [[ -n $node ]]; then info "repinned $(tilde "$file") to $node"; else info "removed the pin from $(tilde "$file")"; fi
  done
}

# With the patched omarchy installed, hands this command's pins over to it, so
# each pin has one owner. The stale ones are repinned to NODE first, or removed
# when NODE is empty, as hybrid_video_repair_pins does. Then each remaining pin
# is rewritten in Omarchy's form: in a Chromium-family flags file this
# command's marker becomes Omarchy's, and in mpv.conf Omarchy's marker goes
# right above the vaapi-device line. From then on Omarchy's start-time check
# and omarchy-refresh-hybrid-video keep them up to date, and this command no
# longer lists them. Rewrites in place, which keeps a symlinked config pointing
# where it did.
hybrid_video_hand_over_pins() {
  local node=$1 file line out mpv
  local -A lines=()
  hybrid_video_repair_pins "$node"
  [[ -n $node ]] || return 0
  # Repinning keeps the line numbers, so a dry run lists the same lines.
  while IFS=$'\t' read -r file line _; do
    lines[$file]+="$line "
  done < <(hybrid_video_managed_pins)
  for file in "${!lines[@]}"; do
    if ((DRY_RUN)); then
      printf '    [dry-run] hand over the pin in %s (line %s) to the patched omarchy\n' "$(tilde "$file")" "${lines[$file]% }"
      continue
    fi
    mpv=0
    [[ $file == "$HYBRID_VIDEO_MPV_CONF" ]] && mpv=1
    out=$(awk -v lines="${lines[$file]}" -v mpv="$mpv" -v m="$HYBRID_VIDEO_PIN_MARKER" \
      -v om="$OMARCHY_HYBRID_VIDEO_PIN_MARKER" '
      BEGIN { n = split(lines, a, " "); for (i = 1; i <= n; i++) fix[a[i]] = 1 }
      { buf[NR] = $0 }
      END {
        for (i = 1; i <= NR; i++) {
          if (!mpv && fix[i + 1] && buf[i] == m) { print om; continue }
          if (mpv && fix[i]) print om
          print buf[i]
        }
      }' "$file"; echo x)
    printf '%s' "${out%x}" >"$file"
    info "handed the pin in $(tilde "$file") over to the patched omarchy (omarchy-refresh-hybrid-video keeps it up to date)"
  done
}

# Removes the fork's mpv comment and the lines of its block this command
# manages (hwdec=vaapi, vaapi-device=...), and the blank line after the block
# when nothing else is left in it. Other lines in the block stay.
hybrid_video_mpv_drop_block() {
  local out
  out=$(awk -v m="$HYBRID_VIDEO_MPV_COMMENT" '
    !done && $0 == m { block = 1; kept = 0; next }
    block && /^(hwdec=vaapi|vaapi-device=[^[:space:]]+)$/ { next }
    block && (/^[[:space:]]*$/ || /^[[:space:]]*\[/) {
      block = 0; done = 1
      if (!kept && /^[[:space:]]*$/) next
    }
    block { kept = 1 }
    { print }' "$HYBRID_VIDEO_MPV_CONF"; echo x)
  printf '%s' "${out%x}" >"$HYBRID_VIDEO_MPV_CONF"
}

# Pins mpv to NODE. Without the fork's comment that is the fork's
# hybrid_video_pin_mpv. With the comment already there (a block emptied by an
# older cleanup), the options go inside its block, right under the comment, so
# the pin is recognized as this command's later.
# With MARKER (Omarchy's), the marker line goes right above vaapi-device, which
# is the patched omarchy's form: '<comment>', 'hwdec=vaapi', '<marker>',
# 'vaapi-device=NODE', then a blank line ahead of what was there before. The
# fork's hybrid_video_pin_mpv writes no marker, so it isn't used for that form.
hybrid_video_pin_mpv_in_block() {
  local node=$1 marker=${2:-} out opts="" existing=""
  hybrid_video_mpv_sets hwdec || opts+="hwdec=vaapi"$'\n'
  if ! hybrid_video_mpv_sets vaapi-device; then
    [[ -z $marker ]] || opts+="$marker"$'\n'
    opts+="vaapi-device=$node"$'\n'
  fi
  if ! { [[ -f $HYBRID_VIDEO_MPV_CONF ]] && grep -qxF "$HYBRID_VIDEO_MPV_COMMENT" "$HYBRID_VIDEO_MPV_CONF"; }; then
    if [[ -z $marker ]]; then
      hybrid_video_pin_mpv
      return
    fi
    [[ -n $opts ]] || return 0
    mkdir -p "$(dirname "$HYBRID_VIDEO_MPV_CONF")"
    [[ -f $HYBRID_VIDEO_MPV_CONF ]] && existing=$(<"$HYBRID_VIDEO_MPV_CONF")
    # Rewrite in place, which keeps a symlinked config pointing where it did.
    {
      printf '%s\n%s' "$HYBRID_VIDEO_MPV_COMMENT" "$opts"
      [[ -z $existing ]] || printf '\n%s\n' "$existing"
    } >"$HYBRID_VIDEO_MPV_CONF"
    return 0
  fi
  [[ -n $opts ]] || return 0
  out=$(awk -v m="$HYBRID_VIDEO_MPV_COMMENT" -v opts="${opts%$'\n'}" '
    { print }
    !done && $0 == m { print opts; done = 1 }' "$HYBRID_VIDEO_MPV_CONF"; echo x)
  printf '%s' "${out%x}" >"$HYBRID_VIDEO_MPV_CONF"
}

# The fork's hybrid_video_pin_chromium, with a marker line above the pin: this
# command's, or MARKER (Omarchy's, for the patched omarchy's form).
hybrid_video_pin_chromium_marked() {
  local node=$1 marker=${2:-$HYBRID_VIDEO_PIN_MARKER} conf
  for conf in "${HYBRID_VIDEO_CHROMIUM_FLAGS_FILES[@]}"; do
    [[ -f $conf ]] || continue
    grep -q -- '^[[:space:]]*--render-node-override=' "$conf" && continue
    [[ -s $conf && -n $(tail -c1 "$conf") ]] && echo >>"$conf"
    printf '%s\n--render-node-override=%s\n' "$marker" "$node" >>"$conf"
  done
}

# The patched omarchy installed, with no pins of this command's left: checks the
# files as they are, whether its migration 1792123636 has run, not run yet
# (pacman upgraded it, and 'omarchy update' hasn't run since) or been skipped.
# Sets ST and DETAIL for check_hybrid_video, which rewords DETAIL when the
# migration is recorded as run.
hybrid_video_check_pending() {
  local node=$1 f mpv_pinned=0 chromium_pinned=1 local_parts=() joined
  if [[ -f $HYBRID_VIDEO_MPV_CONF ]] && awk -v om="$OMARCHY_HYBRID_VIDEO_PIN_MARKER" '
    prev == om && /^vaapi-device=[^[:space:]]+$/ { found = 1; exit }
    { prev = $0 }
    END { exit !found }' "$HYBRID_VIDEO_MPV_CONF"; then
    mpv_pinned=1
  fi
  if f=$(libva_set_by_user); then local_parts+=("LIBVA_DRIVER_NAME set in $(tilde "$f")"); fi
  if ((!mpv_pinned)) && { hybrid_video_mpv_sets hwdec || hybrid_video_mpv_sets vaapi-device; }; then
    local_parts+=("hwdec/vaapi-device set in $(tilde "$HYBRID_VIDEO_MPV_CONF")")
  fi
  for f in "${HYBRID_VIDEO_CHROMIUM_FLAGS_FILES[@]}"; do
    [[ -f $f ]] || continue
    if ! grep -q -- '^[[:space:]]*--render-node-override=' "$f"; then
      chromium_pinned=0
    elif ! grep -qxF -- "$OMARCHY_HYBRID_VIDEO_PIN_MARKER" "$f"; then
      local_parts+=("--render-node-override set in $(tilde "$f")")
    fi
  done
  if ((mpv_pinned && chromium_pinned)); then
    ST=present DETAIL="decode is pinned in Omarchy's form (under its marker); the patched omarchy's migration 1792123636 leaves it, and omarchy-refresh-hybrid-video keeps it up to date"
  elif ((${#local_parts[@]})); then
    printf -v joined '%s; ' "${local_parts[@]}"
    ST=local DETAIL="${joined}left alone"
  elif [[ -e $OMARCHY_STATE_MIGRATIONS/skipped/1792123636.sh ]]; then
    ST=missing DETAIL="not applied; the patched omarchy's migration 1792123636 was skipped (applying pins decode to $node now, in Omarchy's form)"
  else
    ST=missing DETAIL="not applied yet; the patched omarchy's migration 1792123636 pins decode to $node at the next 'omarchy update' (applying pins it now, in Omarchy's form)"
  fi
}

# Pins mpv and the Chromium-family flags files to NODE in the patched omarchy's
# form (under its marker), so its migration leaves them and its start-time
# check and omarchy-refresh-hybrid-video keep them up to date. LIBVA is left to
# the patched omarchy's default files: nothing is added to hyprland.lua.
hybrid_video_pin_omarchy_form() {
  local node=$1 f
  if ((DRY_RUN)); then
    local opts=()
    hybrid_video_mpv_sets hwdec || opts+=("hwdec=vaapi")
    hybrid_video_mpv_sets vaapi-device || opts+=("vaapi-device=$node")
    ((${#opts[@]})) &&
      printf '    [dry-run] prepend to %s: %s (vaapi-device under Omarchy'\''s marker comment)\n' "$(tilde "$HYBRID_VIDEO_MPV_CONF")" "${opts[*]}"
    for f in "${HYBRID_VIDEO_CHROMIUM_FLAGS_FILES[@]}"; do
      [[ -f $f ]] && ! grep -q -- '^[[:space:]]*--render-node-override=' "$f" &&
        printf '    [dry-run] append to %s, under Omarchy'\''s marker comment: --render-node-override=%s\n' "$(tilde "$f")" "$node"
    done
    return 0
  fi
  echo "    Detected a hybrid GPU with the display on the iGPU. Decoding video on $node, in the patched omarchy's form."
  hybrid_video_pin_mpv_in_block "$node" "$OMARCHY_HYBRID_VIDEO_PIN_MARKER"
  hybrid_video_pin_chromium_marked "$node" "$OMARCHY_HYBRID_VIDEO_PIN_MARKER"
  info "restart mpv and the browser for the pins; omarchy-refresh-hybrid-video keeps them up to date"
}

check_hybrid_video() {
  local node="" f local_parts=() env_ours=0 mpv_ours=0 unpinned=() stale=()
  if [[ ! -f $HYPR_CONF ]]; then ST=n/a DETAIL="no $(tilde "$HYPR_CONF")"; return; fi
  node=$(omarchy-hw-igpu-render-node 2>/dev/null) || node=""
  mapfile -t stale < <(hybrid_video_stale_pins "$node")
  if [[ -z $node ]]; then
    if ((${#stale[@]})); then
      ST=repair DETAIL="no iGPU-driven display now (MUX or firmware change), but this command's pins remain (${stale[*]}); applying removes them"
    else
      ST=n/a DETAIL="no iGPU-driven display next to an NVIDIA GPU (omarchy-hw-igpu-render-node)"
    fi
    return
  fi
  # The patched omarchy owns the pins: this command's older ones are handed
  # over to it, and hybrid-video is present once the pins are actually in place.
  # The migration's marker alone proves nothing: pacman alone only installs the
  # migration, and the patched omarchy seeds every marker into /etc/skel, so a
  # user created after install has it although nothing pinned their configs.
  if omarchy_has_migration 1792123636; then
    local file line managed=() redundant=""
    if hypr_has_line hybrid-video-env.lua; then
      redundant="; this command's hybrid-video lines in $(tilde "$HYPR_CONF") are now redundant: delete them"
    fi
    while IFS=$'\t' read -r file line _; do
      managed+=("$(tilde "$file"):$line")
    done < <(hybrid_video_managed_pins)
    if ((${#managed[@]})); then
      ST=repair DETAIL="this command's older pins remain (${managed[*]})"
      if ((${#stale[@]})); then
        DETAIL+=", some naming an old render node (${stale[*]}); applying repins them to $node and hands them over"
      else
        DETAIL+="; applying hands them over"
      fi
      DETAIL+=" to the patched omarchy (rewritten under its marker), so omarchy-refresh-hybrid-video keeps them up to date$redundant"
    else
      hybrid_video_check_pending "$node"
      if omarchy_ran_migration 1792123636; then
        case $ST in
          present) DETAIL="the patched omarchy's migration 1792123636 and omarchy-refresh-hybrid-video pin decode to $node" ;;
          missing) DETAIL="the patched omarchy's migration 1792123636 is recorded as run, but decode isn't pinned (as for a user created after install, whose marker comes from /etc/skel); applying pins it to $node now, in Omarchy's form" ;;
        esac
      fi
      DETAIL+=$redundant
    fi
    return
  fi
  if ((${#stale[@]})); then
    ST=repair DETAIL="this command's pins name an old render node (${stale[*]}); applying repins them to $node"
    return
  fi
  hypr_has_line hybrid-video-env.lua && env_ours=1
  if f=$(libva_set_by_user); then local_parts+=("LIBVA_DRIVER_NAME set in $(tilde "$f")"); fi
  if [[ -f $HYBRID_VIDEO_MPV_CONF ]] && grep -qxF "$HYBRID_VIDEO_MPV_COMMENT" "$HYBRID_VIDEO_MPV_CONF"; then
    # The comment alone proves nothing: the block must still hold this
    # command's vaapi-device pin (which, past the stale check, names $node).
    if [[ -n $(hybrid_video_managed_pins | awk -F '\t' -v f="$HYBRID_VIDEO_MPV_CONF" '$1 == f') ]]; then
      mpv_ours=1
    elif hybrid_video_mpv_sets vaapi-device; then
      local_parts+=("vaapi-device set in $(tilde "$HYBRID_VIDEO_MPV_CONF")")
    fi
  elif hybrid_video_mpv_sets hwdec || hybrid_video_mpv_sets vaapi-device; then
    local_parts+=("hwdec/vaapi-device set in $(tilde "$HYBRID_VIDEO_MPV_CONF")")
  fi
  for f in "${HYBRID_VIDEO_CHROMIUM_FLAGS_FILES[@]}"; do
    [[ -f $f ]] || continue
    if grep -qxF -- "$HYBRID_VIDEO_PIN_MARKER" "$f"; then
      :
    elif grep -q -- '^[[:space:]]*--render-node-override=' "$f"; then
      ((env_ours || mpv_ours)) || local_parts+=("--render-node-override set in $(tilde "$f")")
    else
      unpinned+=("$(tilde "$f")")
    fi
  done
  if ((${#local_parts[@]})); then
    local joined
    printf -v joined '%s; ' "${local_parts[@]}"
    ST=local DETAIL="${joined}left alone"
  elif ((env_ours && mpv_ours)) && ((${#unpinned[@]} == 0)); then
    ST=applied DETAIL="decode pinned to $node"
  else
    ST=missing DETAIL="stock sets LIBVA_DRIVER_NAME=nvidia; would pin mpv and Chromium flags to $node"
  fi
}

apply_hybrid_video() {
  local node="" f
  node=$(omarchy-hw-igpu-render-node 2>/dev/null) || node=""
  # The patched omarchy pins mpv and Chromium itself and stops forcing VA-API.
  # This command's older pins are handed over to it (repinned or removed first
  # when stale), so each pin has one owner. A pin that is missing (the
  # migration hasn't run yet, was skipped, or is recorded as run only through
  # the marker /etc/skel gives a new user) is written in Omarchy's form, which
  # the migration leaves and omarchy-refresh-hybrid-video keeps up to date.
  if omarchy_has_migration 1792123636; then
    local handed=0
    [[ -z $(hybrid_video_managed_pins) ]] || handed=1
    hybrid_video_hand_over_pins "$node"
    [[ -n $node ]] || return 0
    # A dry run hasn't handed anything over, so the check would still see
    # those pins: after a hand-over, only the hand-over is shown.
    if ((DRY_RUN)); then
      ((handed == 0)) || return 0
    fi
    check_fix hybrid-video
    [[ $ST == missing ]] || return 0
    hybrid_video_pin_omarchy_form "$node"
    return
  fi
  # Stale pins of this command's first: repinned to the current iGPU node, or
  # removed when there is none (the fork's hybrid_video_unpin_stale, limited to
  # the pins this command wrote).
  local stale=()
  mapfile -t stale < <(hybrid_video_stale_pins "$node")
  hybrid_video_repair_pins "$node"
  [[ -n $node ]] || return 0
  # Then the rest of the fix, unless it is in place or a setting of yours is.
  if ((DRY_RUN)); then
    ((${#stale[@]} == 0)) || return 0
  else
    check_fix hybrid-video
    [[ $ST == missing ]] || return 0
  fi
  hypr_has_line hybrid-video-env.lua ||
    hypr_append hybrid-video hybrid-video-env.lua "VA-API on the iGPU instead of the RTX" || return 1
  # The fork's leaf (install/user/hardware/hybrid-video-decode.sh).
  if ((DRY_RUN)); then
    local opts=()
    hybrid_video_mpv_sets hwdec || opts+=("hwdec=vaapi")
    hybrid_video_mpv_sets vaapi-device || opts+=("vaapi-device=$node")
    ((${#opts[@]})) && printf '    [dry-run] prepend to %s: %s\n' "$(tilde "$HYBRID_VIDEO_MPV_CONF")" "${opts[*]}"
    for f in "${HYBRID_VIDEO_CHROMIUM_FLAGS_FILES[@]}"; do
      [[ -f $f ]] && ! grep -q -- '^[[:space:]]*--render-node-override=' "$f" &&
        printf '    [dry-run] append to %s, under a marker comment: --render-node-override=%s\n' "$(tilde "$f")" "$node"
    done
    return 0
  fi
  echo "    Detected a hybrid GPU with the display on the iGPU. Decoding video on $node."
  hybrid_video_pin_mpv_in_block "$node"
  hybrid_video_pin_chromium_marked "$node"
  info "log out and back in for LIBVA_DRIVER_NAME; restart mpv and the browser for the pins"
  info "'omarchy refresh chromium' rewrites chromium-flags.conf; run this again after it"
}

