#!/bin/bash
# Plan a PR build: which recipes to build and which follow-up checks to run.
#   ci/changed-recipes BASE HEAD    recipes the PR changes (diff from the merge base of BASE and HEAD)
#   ci/changed-recipes --list "a b" an explicit list (workflow_dispatch)
# Rules:
#   - recipes/<r>/ changes when any file under it changes; only directories
#     with a PKGBUILD in the checked-out tree are buildable (deleted or
#     reference-only recipes are skipped)
#     (exception: *.md files and the g16-test/ and tests/ directories under
#     recipes/linux-omarchy don't trigger the kernel; the PKGBUILD reads none of them)
#   - a change to the shared build inputs (build/pacman.conf, build/pacman-rc.conf, bin/build-pkg)
#     rebuilds every recipe except the kernel, which builds only when
#     recipes/linux-omarchy itself changes (or is listed explicitly)
#   - a PR that changes build tooling (ci/, build/, bin/build-pkg, .github/workflows/)
#     and would otherwise build nothing (no recipe, no kernel) builds one small recipe,
#     TOOLING_CANARY, fresh (never reused from an earlier run), so the build path it
#     changes is run at least once
# Prints GITHUB_OUTPUT lines:
#   recipes=<JSON list of non-kernel recipes>   kernel=true|false
#   fresh=<JSON list>: recipes to build even when an earlier run built the same tree
#   nvidia_built=true|false (nvidia-open-dkms is in recipes)
#   nvidia_compat=true|false (kernel or nvidia-open-dkms builds: compile NVIDIA against the headers)
set -euo pipefail
cd "$(dirname "$0")/.."
KERNEL=linux-omarchy NVIDIA=nvidia-open-dkms
SHARED_INPUTS=(build/pacman.conf build/pacman-rc.conf bin/build-pkg)
TOOLING_RE='^(ci/|build/|bin/build-pkg$|\.github/workflows/)'
TOOLING_CANARY=omarchy-asus-keyring

buildable() { [[ -f recipes/$1/PKGBUILD ]]; }
all_small() { for d in recipes/*/PKGBUILD; do d=${d%/PKGBUILD}; d=${d#recipes/}; [[ $d == "$KERNEL" ]] || echo "$d"; done; }

if [[ ${1:-} == --list ]]; then
    names=()
    for n in ${2:-}; do
        n=${n#recipes/}; n=${n%/}
        buildable "$n" || { echo "::error::no such recipe: $n" >&2; exit 1; }
        names+=("$n")
    done
    echo "==> requested: ${names[*]:-(none)}" >&2
else
    base=${1:?usage: ci/changed-recipes BASE HEAD | --list "names"} head=${2:?}
    files=$(git diff --name-only "$base...$head")
    echo "==> files changed by the PR:" >&2
    sed 's/^/    /' <<<"$files" >&2
    # Docs (NOTES.md), the G16 test kit (g16-test/) and tests (tests/) in the
    # kernel recipe don't cost a multi-hour kernel build; every other recipe
    # builds on any change.
    mapfile -t names < <(awk -F/ -v k="$KERNEL" '$1=="recipes" && NF>2 &&
        !($2==k && ($NF ~ /\.md$/ || (NF>3 && ($3=="g16-test" || $3=="tests")))) {print $2}' <<<"$files" | sort -u)
    for f in "${SHARED_INPUTS[@]}"; do
        if grep -qxF "$f" <<<"$files"; then
            echo "==> $f changed: rebuilding every recipe except $KERNEL" >&2
            mapfile -t -O "${#names[@]}" names < <(all_small)
            break
        fi
    done
    tooling=$(grep -E "$TOOLING_RE" <<<"$files" || true)
fi

kernel=false nvidia_built=false small=()
for n in $(printf '%s\n' "${names[@]}" | sort -u); do
    if ! buildable "$n"; then echo "==> skipping recipes/$n (no PKGBUILD)" >&2; continue; fi
    case $n in
        "$KERNEL") kernel=true ;;
        "$NVIDIA") nvidia_built=true; small+=("$n") ;;
        *) small+=("$n") ;;
    esac
done
fresh=()
if [[ -n ${tooling:-} && $kernel == false && ${#small[@]} -eq 0 ]] && buildable "$TOOLING_CANARY"; then
    echo "==> build tooling changed and nothing else builds: building $TOOLING_CANARY fresh" >&2
    small=("$TOOLING_CANARY") fresh=("$TOOLING_CANARY")
fi
nvidia_compat=false
[[ $kernel == true || $nvidia_built == true ]] && nvidia_compat=true

to_json() { printf '%s\n' "$@" | python3 -c 'import json,sys; print(json.dumps([l for l in sys.stdin.read().split() if l]))'; }
json=$(to_json "${small[@]}")
echo "==> plan: recipes=$json kernel=$kernel nvidia_compat=$nvidia_compat" >&2
echo "recipes=$json"
echo "fresh=$(to_json "${fresh[@]}")"
echo "kernel=$kernel"
echo "nvidia_built=$nvidia_built"
echo "nvidia_compat=$nvidia_compat"
