#!/bin/bash
# Check every recipes/*/PKGBUILD without building it (run as root inside
# ghcr.io/archlinux/archlinux:base-devel; the repo may be mounted read-only):
#   bash -n and `makepkg --printsrcinfo` must succeed (fatal)
#   namcap findings are reported as warnings (not fatal), except the known
#   false positives in NAMCAP_IGNORE, which are printed but not annotated
#   with --channel, pkgrel must be in that release channel's range (ci/check-pkgrel,
#   fatal): the RC channel builds .101 and up, Quattro .1 to .99
# Usage: ci/check-recipes [--channel quattro|rc]   (the target branch's: ci/channel <branch>)
set -uo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
channel=
if [[ ${1:-} == --channel ]]; then channel=${2:?--channel needs quattro or rc}; fi

# Known namcap false positives: "<recipe>|<message>", where <message> is the
# exact text namcap prints after "W: " or "E: ". Exact, so a changed finding
# (another package added to the list, say) warns again. Say why for each one.
NAMCAP_IGNORE=(
    # splitpkgmakedeps wants every split package's depends in the global
    # makedepends. cpio is in hyprpm's depends only because hyprpm itself runs
    # `make installheaders` (Makefile: find src ... | cpio -0dump) when it
    # builds plugins, and checks for cpio first (hyprpm/src/core/PluginManager.cpp).
    # Our build never runs cpio: build() is `make release` (cmake) and
    # package_*() is `make install` (cmake --install). Arch's PKGBUILD, which
    # ours overlays (recipes/hyprland/DELTA), is the same, so a makedepends
    # entry would only be one more delta to carry for nothing.
    "hyprland|Split PKGBUILD needs additional makedepends ['cpio'] to work properly"
)
ignored() {
    local recipe=$1 msg=${2#* [WE]: } entry
    for entry in "${NAMCAP_IGNORE[@]}"; do
        [[ $entry == "$recipe|$msg" ]] && return 0
    done
    return 1
}

pacman -Syu --noconfirm --needed --noprogressbar namcap >/dev/null || exit 1
id builder >/dev/null 2>&1 || useradd -m builder
fail=0
for pkgbuild in "$repo"/recipes/*/PKGBUILD; do
    dir=$(dirname "$pkgbuild"); rel=recipes/$(basename "$dir")
    work=$(mktemp -d); cp -a "$dir"/. "$work"/; chown -R builder: "$work"
    echo "::group::$rel"
    if ! bash -n "$work/PKGBUILD"; then
        echo "::error file=$rel/PKGBUILD::bash -n failed"; fail=1
    elif ! runuser -u builder -- env -C "$work" makepkg --printsrcinfo >"$work/.SRCINFO"; then
        echo "::error file=$rel/PKGBUILD::makepkg --printsrcinfo failed"; fail=1
    else
        grep -E '^(pkgbase|	pkgver|	pkgrel|pkgname) = ' "$work/.SRCINFO"
        pkgrel=$(awk '$1 == "pkgrel" {print $3; exit}' "$work/.SRCINFO")
        if [[ -n $channel ]] && ! why=$("$repo/ci/check-pkgrel" "$channel" "$pkgrel"); then
            echo "::error file=$rel/PKGBUILD,title=pkgrel::$channel channel: $why"; fail=1
        fi
    fi
    out=$(runuser -u builder -- env -C "$work" namcap PKGBUILD 2>&1)
    if [[ -n $out ]]; then
        echo "$out"
        while IFS= read -r line; do
            if ignored "${rel#recipes/}" "$line"; then
                echo "(known false positive, see NAMCAP_IGNORE in ci/check-recipes: $line)"
                continue
            fi
            echo "::warning file=$rel/PKGBUILD,title=namcap::$line"
        done <<<"$out"
    else
        echo "namcap: no findings"
    fi
    echo "::endgroup::"
    rm -rf "$work"
done
exit $fail
