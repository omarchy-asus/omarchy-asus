#!/bin/bash
# The tooling runs from main on both channels: the publishing pipeline is one installed
# copy of main's scripts (bin/install-auto-update), and CI on the RC branch should check
# its PRs with the same ci/ and workflows. So every tooling file on next/omarchy-4.5 must
# be main's, byte for byte; only recipes differ between the channels.
#   ci/tooling-sync check <main-ref>   exit 1 (with a CI error naming each file and the fix)
#                                      when this checkout's tooling differs from <main-ref>'s
#   ci/tooling-sync apply <main-ref>   make this checkout's tooling <main-ref>'s (stages it)
#   ci/tooling-sync list               print the tooling paths and the exceptions
# Tooling: bin/ ci/ build/ .github/ systemd/ tests/ docs/distcc.md docs/kernel-runner.md.
# Exception: tests/test_g16_resume_probe.py tests the G16 kit inside the kernel recipe
# (recipes/linux-omarchy/g16-test/), which is per channel like the rest of the recipe.
set -euo pipefail
cd "$(dirname "$0")/.."
PATHS=(bin ci build .github systemd tests docs/distcc.md docs/kernel-runner.md)
EXCEPT=(tests/test_g16_resume_probe.py)

# pathspec: the tooling paths minus the exceptions
spec=("${PATHS[@]}")
for e in "${EXCEPT[@]}"; do spec+=(":(exclude)$e"); done

case ${1:-} in
    list) printf 'tooling: %s\n' "${PATHS[@]}"; printf 'except:  %s\n' "${EXCEPT[@]}" ;;
    check)
        rev=${2:?usage: ci/tooling-sync check <main-ref>}
        # <rev> against the work tree: content, file mode, files added or removed
        mapfile -t bad < <(git diff --no-renames --name-status "$rev" -- "${spec[@]}" |
            awk -F'\t' '{print $2 ($1 == "A" ? " (not on main)" : $1 == "D" ? " (missing here)" : "")}')
        ((${#bad[@]} == 0)) && { echo "==> tooling matches $rev"; exit 0; }
        printf '    %s\n' "${bad[@]}"
        # One annotation, so the failure reads the same in the log and on the PR.
        msg="${#bad[@]} tooling file(s) differ from main ($(git rev-parse --short "$rev")): ${bad[*]}."
        msg+=" Tooling runs from main on both channels, so it changes only on main."
        msg+=" If this PR changes tooling, move that change to a PR against main and take it out of this one."
        msg+=" If main moved since this branch was synced, run 'ci/tooling-sync apply origin/main' here,"
        msg+=" commit the result as 'Tooling from main <sha>' and push; the check then passes."
        echo "::error title=Tooling differs from main::$msg"
        exit 1
        ;;
    apply)
        rev=${2:?usage: ci/tooling-sync apply <main-ref>}
        # only the paths either side has: git restore refuses a pathspec matching nothing
        here=()
        for p in "${PATHS[@]}"; do
            if git cat-file -e "$rev:$p" 2>/dev/null || [[ -n $(git ls-files -- "$p") ]]; then here+=("$p"); fi
        done
        for e in "${EXCEPT[@]}"; do here+=(":(exclude)$e"); done
        git restore --source="$rev" --staged --worktree -- "${here[@]}"
        echo "==> tooling is now $(git rev-parse --short "$rev")'s; review with git diff --cached --stat"
        ;;
    *) echo "usage: ci/tooling-sync check|apply <main-ref> | list" >&2; exit 2 ;;
esac
