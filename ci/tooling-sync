#!/bin/bash
# The tooling runs from main on both channels: the publishing pipeline is one installed
# copy of main's scripts, and CI on the RC branch should check
# its PRs with the same ci/ and workflows. So every tooling file on next/omarchy-4.5 must
# be main's, byte for byte; only recipes differ between the channels.
#   ci/tooling-sync check <main-ref> [--base <ref>]
#                                      exit 1 (with a CI error naming each file and the fix)
#                                      when this checkout's tooling differs from <main-ref>'s.
#                                      With --base (a PR's base), only the files the PR itself
#                                      changed count: the rest is the branch lagging behind
#                                      main, a warning (a 'Tooling from main' PR syncs it)
#   ci/tooling-sync apply <main-ref>   make this checkout's tooling <main-ref>'s (stages it)
#   ci/tooling-sync list               print the tooling paths and the exceptions
# Tooling: bin/ ci/ build/ .github/ tests/ docs/distcc.md docs/kernel-runner.md.
# Exceptions, per channel like the recipes they go with:
#   tests/channel/ holds offline tests of a channel's own recipe content (a patch, a drop-in
#   only that branch's recipe has); Lint runs tests/channel/*.sh beside tests/ci/*.sh;
#   tests/test_g16_resume_probe.py tests the G16 kit inside the kernel recipe
#   (recipes/linux-omarchy/g16-test/);
#   bin/g16-check checks a laptop against its channel's packages (the RC branch's
#   expects asus-rog-nkey-winlock 0.1.0-13's g16-winlockd, Quattro's 0.1.0-12).
set -euo pipefail
cd "$(dirname "$0")/.."
PATHS=(bin ci build .github tests docs/distcc.md docs/kernel-runner.md)
EXCEPT=(tests/channel tests/test_g16_resume_probe.py bin/g16-check)

# pathspec: the tooling paths minus the exceptions
spec=("${PATHS[@]}")
for e in "${EXCEPT[@]}"; do spec+=(":(exclude)$e"); done

case ${1:-} in
    list) printf 'tooling: %s\n' "${PATHS[@]}"; printf 'except:  %s\n' "${EXCEPT[@]}" ;;
    check)
        rev=${2:?usage: ci/tooling-sync check <main-ref> [--base <ref>]} base=
        [[ ${3:-} == --base ]] && base=${4:?--base needs a ref}
        # <rev> against the work tree: content, file mode, files added or removed
        mapfile -t bad < <(git diff --no-renames --name-status "$rev" -- "${spec[@]}" |
            awk -F'\t' '{print $2 ($1 == "A" ? " (not on main)" : $1 == "D" ? " (missing here)" : "")}')
        ((${#bad[@]} == 0)) && { echo "==> tooling matches $rev"; exit 0; }
        mine=() behind=()
        if [[ -n $base ]]; then
            # files this PR changed: its base against the work tree
            mapfile -t changed < <(git diff --no-renames --name-only "$base" -- "${spec[@]}")
            for b in "${bad[@]}"; do
                if printf '%s\n' "${changed[@]}" | grep -qxF -- "${b%% (*}"; then mine+=("$b"); else behind+=("$b"); fi
            done
        else
            mine=("${bad[@]}")
        fi
        short=$(git rev-parse --short "$rev")
        if ((${#behind[@]})); then
            printf '    behind main: %s\n' "${behind[@]}"
            msg="This branch's tooling is behind main ($short) in ${#behind[@]} file(s) this PR doesn't touch: ${behind[*]}."
            msg+=" Not this PR's to fix: a 'Tooling from main' PR brings it to this branch"
            msg+=" ('ci/tooling-sync apply origin/main' on a branch of its own, then open that PR)."
            echo "::warning title=Tooling behind main::$msg"
        fi
        ((${#mine[@]} == 0)) && { echo "==> this PR changes no tooling away from $rev"; exit 0; }
        printf '    changed here: %s\n' "${mine[@]}"
        # One annotation, so the failure reads the same in the log and on the PR.
        msg="This PR makes ${#mine[@]} tooling file(s) differ from main ($short): ${mine[*]}."
        msg+=" Tooling runs from main on both channels, so it changes only on main."
        msg+=" Move the change to a PR against main and take it out of this one; once main has it,"
        msg+=" a 'Tooling from main' PR brings it to this branch."
        msg+=" (A PR that syncs this branch with main passes: run 'ci/tooling-sync apply origin/main', commit, push.)"
        echo "::error title=Tooling differs from main::$msg"
        exit 1
        ;;
    apply)
        rev=${2:?usage: ci/tooling-sync apply <main-ref>}
        # only the paths either side has: git restore refuses a pathspec matching nothing
        here=()
        for p in "${PATHS[@]}"; do
            if git cat-file -e "$rev:$p" 2>/dev/null || [[ -n $(git ls-files -- "$p") ]]; then here+=("$p"); fi
        done
        for e in "${EXCEPT[@]}"; do here+=(":(exclude)$e"); done
        git restore --source="$rev" --staged --worktree -- "${here[@]}"
        echo "==> tooling is now $(git rev-parse --short "$rev")'s; review with git diff --cached --stat"
        ;;
    *) echo "usage: ci/tooling-sync check|apply <main-ref> | list" >&2; exit 2 ;;
esac
