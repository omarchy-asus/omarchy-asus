#!/bin/bash
# Print the release channel a branch builds for, and the chroot pacman.conf of that channel
# (README.md "Release channels", bin/env.sh): main is the RC channel's trunk, built against
# Omarchy's rc repos (build/pacman-rc.conf), and every branch is on main's line (#309), so
# every branch, and every PR stacked on another PR's branch, is rc. Quattro (build/pacman.conf)
# is frozen until the Omarchy 4.5 stable switch: no branch builds it.
# CI passes it to ci/find-build and ci/build-recipe, so a PR builds against the package sources
# of the channel it will be published to.
# Usage: ci/channel <branch>          prints rc
#        ci/channel --conf <channel>  prints the channel's pacman.conf path (repo-relative)
#        ci/channel --tag <channel>   prints the channel's release tag (x86_64, rc-x86_64)
set -euo pipefail
case ${1:?usage: ci/channel <branch> | --conf <channel> | --tag <channel>} in
    --conf)
        case ${2:?usage: ci/channel --conf <channel>} in
            quattro) echo build/pacman.conf ;;
            rc) echo build/pacman-rc.conf ;;
            *) echo "ci/channel: unknown channel '$2' (quattro, rc)" >&2; exit 1 ;;
        esac
        ;;
    --tag)
        case ${2:?usage: ci/channel --tag <channel>} in
            quattro) echo x86_64 ;;
            rc) echo rc-x86_64 ;;
            *) echo "ci/channel: unknown channel '$2' (quattro, rc)" >&2; exit 1 ;;
        esac
        ;;
    -*) echo "usage: ci/channel <branch> | --conf <channel> | --tag <channel>" >&2; exit 2 ;;
    *) echo rc ;;
esac
