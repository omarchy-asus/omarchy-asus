#!/bin/bash
# Build one recipe the way bin/build-pkg does, but in a throwaway container
# instead of a devtools chroot (run as root inside the Arch container):
#   ci/setup-arch, then `makepkg -s` as the unprivileged builder user with the
#   recipe's keys/pgp (if any) as that user's only PGP keys, so validpgpkeys
#   sources are verified against exactly the keys checked into the recipe.
# Output: the unsigned packages land in $OUT (default /out). The build tree
# is $WORK/<recipe> (default /build), so it can live on a big disk.
# Usage: ci/build-recipe [--channel quattro|rc] [--release] <recipe>
#   --channel: the release channel the PR targets (ci/channel); the container gets
#   that channel's package sources (ci/setup-arch). Default quattro.
#   --release: a release build (.github/workflows/release.yml): the packages carry the
#   release chroot's packager ($PACKAGER_LINE in bin/env.sh), not the PR check's
#   "omarchy-asus CI (unsigned)".
#
# Why no bin/recipe-sandbox here (#79, #89): on the build host, recipe code
# runs under bin/recipe-sandbox because that host holds the signing key and
# the publish credentials. Here `makepkg -s` runs recipe code without it,
# which is safe because this step holds no secrets:
#   - The script runs only inside the `docker run --rm` started by
#     .github/workflows/build-pr.yml, a `pull_request` workflow (never
#     pull_request_target), so fork PRs get no secrets; its other trigger,
#     `workflow_dispatch`, is started by a maintainer and gets the same
#     read-only token and no secrets either. .github/workflows/release.yml
#     (workflow_dispatch from main only) runs it the same way: its build job
#     holds a read-only token and no secret, and only its attest job, which
#     runs no recipe code, may request an OIDC token.
#   - The job token is read-only (`permissions: contents: read`,
#     `actions: read`) and is only in the env of the separate "Look for an
#     earlier build" step (ci/find-build), never in the build step.
#   - docker run is given no -e/--env/--env-file, so the runner's environment
#     (GITHUB_TOKEN, the ACTIONS_* tokens) does not reach the container; the
#     guard below refuses to run if it ever does.
#   - actions/checkout runs with persist-credentials: false, so /repo
#     (mounted :ro) holds no git credentials.
#   - The docker socket is not mounted.
#   - No signing key exists on the runner: signing and publishing happen only
#     on the build host (bin/build-pkg in the chroot, then bin/publish).
# A sandbox is not possible here anyway: bwrap needs unprivileged user
# namespaces, which the stock docker container lacks under the default
# seccomp profile (enabling them needs --privileged or
# --security-opt seccomp=unconfined, which weakens isolation), and
# `makepkg -s` needs sudo pacman to install the build deps, which cannot run
# inside bwrap --unshare-all.
# tests/ci/build-recipe-no-secrets.sh enforces all of this.
set -euo pipefail
for v in GITHUB_TOKEN GH_TOKEN ACTIONS_RUNTIME_TOKEN ACTIONS_ID_TOKEN_REQUEST_TOKEN; do
    if [[ -n ${!v:-} ]]; then
        echo "::error::ci/build-recipe: credentials in the environment ($v); recipe code must not run with them" >&2
        exit 1
    fi
done
repo=$(cd "$(dirname "$0")/.." && pwd)
usage="usage: ci/build-recipe [--channel quattro|rc] [--release] <recipe>"
channel=quattro release=0
while [[ ${1:-} == --* ]]; do
    case $1 in
        --channel) channel=${2:?$usage}; shift 2 ;;
        --release) release=1; shift ;;
        *) echo "::error::$usage" >&2; exit 2 ;;
    esac
done
name=${1:?$usage}
src=$repo/recipes/$name
[[ -f $src/PKGBUILD ]] || { echo "::error::recipes/$name/PKGBUILD not found" >&2; exit 1; }
OUT=${OUT:-/out} WORK=${WORK:-/build}

"$repo/ci/setup-arch" --channel "$channel"

# A release build's packager is the release chroot's (bin/mkchroot writes the same line).
if ((release)); then
    packager=$(sed -n "s/^PACKAGER_LINE='\(PACKAGER=.*\)'$/\1/p" "$repo/bin/env.sh")
    [[ -n $packager ]] || { echo "::error::no PACKAGER_LINE in bin/env.sh" >&2; exit 1; }
    echo "$packager" >/etc/makepkg.conf.d/zz-packager.conf
    echo "==> release build: $packager"
fi

# distcc (the build host's kernel runner only; docs/kernel-runner.md): when the
# workflow mounts the runner's compile-only key dir at /mnt/distcc (id_ed25519,
# known_hosts, and hosts: one DISTCC_HOSTS entry per line, e.g.
# <account>@<helper>/<jobs>), compiles go there over ssh through this repo's
# build/distcc-ssh, the wrapper the release builds use, so the helper's
# build/distccd-gate refuses it on another gcc or binutils and distcc compiles
# here instead. The key is copied for the builder user (makepkg runs as it) to
# /distcc, where the wrapper looks. Hosted runners mount nothing.
# A recipe with a NO_DISTCC file (its first line is the reason; hyprland's
# precompiled headers) compiles here, as bin/build-pkg does it.
no_distcc=0
if [[ -f $src/NO_DISTCC && -e /mnt/distcc ]]; then
    no_distcc=1
    echo "==> distcc: off for $name (recipes/$name/NO_DISTCC)"
fi
if [[ -f /mnt/distcc/id_ed25519 && -f /mnt/distcc/known_hosts && -s /mnt/distcc/hosts && ${no_distcc:-0} == 0 ]]; then
    pacman -S --needed --noconfirm --noprogressbar distcc openssh
    install -d -o builder -g builder -m 700 /distcc
    install -o builder -g builder -m 600 /mnt/distcc/id_ed25519 /mnt/distcc/known_hosts /distcc/
    install -m 755 "$repo/build/distcc-ssh" /distcc/ssh
    mapfile -t helpers < <(grep -v -E '^[[:space:]]*(#|$)' /mnt/distcc/hosts)
    slots=0
    for h in "${helpers[@]}"; do [[ $h =~ /([0-9]+) ]] && slots=$((slots + BASH_REMATCH[1])); done
    # After zz-ci.conf: localhost first keeps $(nproc) jobs here, the helpers take
    # the rest, so -j has to cover both (docs/distcc.md).
    cat >/etc/makepkg.conf.d/zz-distcc.conf <<EOF
BUILDENV=(distcc color !ccache check !sign)
DISTCC_HOSTS="localhost/$(nproc) ${helpers[*]}"
MAKEFLAGS="-j$(( $(nproc) + slots ))"
export DISTCC_SSH=/distcc/ssh
EOF
    echo "==> distcc: ${#helpers[@]} helper(s), $slots slots on top of $(nproc) here"
fi

# ccache (the build host's kernel runner only): when the workflow mounts the
# runner's own cache dir at /mnt/ccache, compiles go through ccache, and on a
# miss through distcc if that is on (makepkg sets CCACHE_PREFIX=distcc). A kernel
# PR that changes a few patches then rebuilds a few objects, not all ~25,000.
# The cache is the runner's, shared only by its CI builds; the release builds
# keep their own. Its files are the container builder's, so the dir must be
# writable by it (mode 1777 on the host). zz-zccache.conf loads after
# zz-distcc.conf and keeps its distcc setting.
#
# PATH is Arch's default, as in the release chroot. The builder image puts
# /usr/sbin before /usr/bin, so ccache finds gcc as /usr/sbin/gcc and hands
# distcc that path; the helper's distccd (no --enable-tcp-insecure) refuses
# every compiler path it doesn't know ("compiler name </usr/sbin/gcc> cannot
# be an absolute path"), and the build compiles locally while distcc backs
# the helper off. /usr/sbin is a link to /usr/bin on Arch, so nothing is lost.
#
# The hash settings are the release builds' (docs/distcc.md, "Persistent
# ccache"), so warm CI rebuilds hit as often as theirs:
#   - CCACHE_BASEDIR=$WORK: paths under the build tree are hashed relative to
#     it, so a build tree elsewhere (another $WORK) still hits.
#   - CCACHE_NOHASHDIR=1: the compile's working dir isn't hashed into objects
#     built with -g, for the same reason.
#   - CCACHE_SLOPPINESS: every source tarball is extracted fresh, so every
#     header's ctime (and a generated one's mtime) is from this run, and without
#     include_file_mtime and include_file_ctime ccache won't cache a compile
#     that includes a header changed that recently.
#     time_macros: __DATE__/__TIME__ don't make every such file a miss (the
#     kernel pins its build timestamp anyway); locale: the builder's LANG and
#     LC_* aren't hashed.
# ccache_stats prints the cache's hits, misses and files; after makepkg the
# log gets this build's hits, misses and hit rate.
if [[ -d /mnt/ccache ]]; then
    pacman -S --needed --noconfirm --noprogressbar ccache
    distcc=!distcc
    [[ -f /etc/makepkg.conf.d/zz-distcc.conf ]] && distcc=distcc
    cat >/etc/makepkg.conf.d/zz-zccache.conf <<EOF
BUILDENV=($distcc color ccache check !sign)
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
export CCACHE_DIR=/mnt/ccache
export CCACHE_MAXSIZE=15G
export CCACHE_BASEDIR=$WORK
export CCACHE_NOHASHDIR=1
export CCACHE_SLOPPINESS=time_macros,include_file_mtime,include_file_ctime,locale
EOF
    ccache_stats() {
        runuser -u builder -- env CCACHE_DIR=/mnt/ccache ccache --print-stats 2>/dev/null |
            awk -F'\t' '$1 ~ /^(direct|preprocessed)_cache_hit$/ { h += $2 } $1 == "cache_miss" { m += $2 }
                $1 == "files_in_cache" { f = $2 } END { print h + 0, m + 0, f + 0 }'
    }
    ccache_before=$(ccache_stats) || ccache_before=
    echo "==> ccache: /mnt/ccache (${ccache_before##* } files)"
fi

work=$WORK/$name
rm -rf "$work"; mkdir -p "$work" "$OUT"
cp -a "$src"/. "$work"/
rm -rf "$work"/{src,pkg} "$work"/*.pkg.tar.zst
chown -R builder: "$work"

builder_home=$(getent passwd builder | cut -d: -f6)
as_builder() { runuser -u builder -- env -C "$work" HOME="$builder_home" "$@"; }
shopt -s nullglob
keys=("$work"/keys/pgp/*.asc)
if (( ${#keys[@]} )); then
    echo "==> importing ${#keys[@]} recipe PGP key(s) into the builder keyring"
    as_builder gpg --batch --quiet --import "${keys[@]}"
fi

echo "==> makepkg -s ($name, MAKEFLAGS from /etc/makepkg.conf.d/zz-ci.conf, $(nproc) CPUs)"
df -h "$work" | tail -1
as_builder makepkg -s --noconfirm --noprogressbar

# This build's ccache hits and misses (the counters are the cache's, so take
# the ones from before makepkg off). Only for the log: it never fails the build.
if declare -F ccache_stats >/dev/null; then
    if [[ -n $ccache_before ]] && ccache_after=$(ccache_stats); then
        printf '%s %s\n' "$ccache_before" "$ccache_after" | awk '
            { h = $4 - $1; m = $5 - $2
              printf "==> ccache: %d hits, %d misses, %.1f%% hit rate\n", h, m, h + m ? 100 * h / (h + m) : 0 }' ||
            true
    else
        echo "==> ccache: no stats"
    fi
fi

shopt -s nullglob
pkgs=("$work"/*.pkg.tar.zst)
(( ${#pkgs[@]} )) || { echo "::error::$name built no packages" >&2; exit 1; }
cp -v "${pkgs[@]}" "$OUT"/
chmod a+r "$OUT"/*
rm -rf "$work"
