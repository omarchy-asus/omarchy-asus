#!/bin/bash
# Is a recipe's pkgrel in the range of the release channel it is built for? (#201)
# pacman caches by filename and each release only refuses its own duplicates, so the two
# channels must never build the same pkgver-pkgrel: Quattro keeps the subreleases .1 to .99
# (pkgrel 1 to 99 for our own packages), the RC channel (main, #309) .101 and up (101
# and up). bin/rebase-recipe --channel rc starts there; bin/publish refuses a clash.
# The range is checked on the last number: 9.4 -> 4, 9.101 -> 101, 12 -> 12.
# Usage: ci/check-pkgrel <quattro|rc> <pkgrel>   exit 0 in range, 1 out of it (says why),
#                                                2 usage
set -euo pipefail
ch=${1:-} rel=${2:-}
[[ -n $ch && -n $rel ]] || { echo "usage: ci/check-pkgrel <quattro|rc> <pkgrel>" >&2; exit 2; }
if [[ ! $rel =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "pkgrel $rel is not integer[.integer] (makepkg)"; exit 1
fi
n=$((10#${rel##*.}))
case $ch in
    quattro)
        ((n <= 99)) && exit 0
        echo "pkgrel $rel is in the RC channel's range (.101 and up): Quattro keeps .1 to .99" \
            "(1 to 99 for our own packages)"
        ;;
    rc)
        ((n >= 101)) && exit 0
        echo "pkgrel $rel is in Quattro's range: the RC channel builds .101 and up (101 and up" \
            "for our own packages), so its files never share a name with Quattro's" \
            "(bin/rebase-recipe --channel rc)"
        ;;
    *) echo "ci/check-pkgrel: unknown channel '$ch' (quattro, rc)" >&2; exit 2 ;;
esac
exit 1
