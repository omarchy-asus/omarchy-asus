# Known upstream PII-scan hits in release assets (see bin/sync-release).
# Each rule is '<asset glob> <location glob>': it allows a hit only at that location
# inside that asset. A name hit is at its member path; a content hit is at
# '<member path>:<line>'. Any other hit in the same asset (.PKGINFO, .BUILDINFO,
# another member) still blocks the sync. Globs are bash patterns ('*' crosses '/').
#
# Kernel: upstream HID driver module names match hardware words on the denylist; the
# module list repeats them. Our own kernel patches are scanned when committed
# (.pii-allow / publish hook).
linux-omarchy-*.pkg.tar.zst          usr/lib/modules/*/kernel/drivers/hid/*
linux-omarchy-*.pkg.tar.zst          usr/lib/modules/*/modules.order:*
# Kernel headers: the unmodified upstream build tree (Kconfig, config, uapi headers,
# rust metadata) names that hardware and has version strings shaped like addresses.
linux-omarchy-headers-*.pkg.tar.zst  usr/lib/modules/*/build/*
# The files database lists every file of every package, so it repeats the two lines
# above; only those kernel paths are allowed, each package's own list otherwise scanned.
omarchy-asus.files  linux-omarchy-[0-9]*/files:usr/lib/modules/*/kernel/drivers/hid/*
omarchy-asus.files  linux-omarchy-headers-*/files:usr/lib/modules/*/build/*
# omarchy / omarchy-settings: unmodified stock Omarchy files whose text matches common
# words or the private-address patterns on the denylist (DNS, firewall and Sunshine
# scripts). The same hits, in byte-identical files, are in stock omarchy 4.0.5-1; our
# patches add none.
omarchy-[0-9]*.pkg.tar.zst           usr/share/omarchy/shell/plugins/dev-gallery/GalleryPanel.qml:*
omarchy-[0-9]*.pkg.tar.zst           usr/bin/omarchy-bluetooth-device:*
omarchy-[0-9]*.pkg.tar.zst           usr/bin/omarchy-dns:*
omarchy-[0-9]*.pkg.tar.zst           usr/bin/omarchy-install-service-sunshine:*
omarchy-[0-9]*.pkg.tar.zst           usr/bin/omarchy-remove-service-sunshine:*
omarchy-[0-9]*.pkg.tar.zst           usr/share/omarchy/install/config/firewall.sh:*
omarchy-settings-[0-9]*.pkg.tar.zst  etc/skel/.config/btop/btop.conf:*
omarchy-settings-[0-9]*.pkg.tar.zst  usr/share/omarchy/config/btop/btop.conf:*
