[Unit]
Description=omarchy-asus: verified AI review of open PRs (codex finds, a second model verifies)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# User unit: codex and claude use the user's own logins. %h/Work/omarchy-asus-repo is the
# default checkout; override ExecStart with `systemctl --user edit` if it lives elsewhere.
ExecStart=/usr/bin/flock -n %t/omarchy-asus-ai-review.lock %h/Work/omarchy-asus-repo/bin/ai-review sweep --post
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Nice=10
TimeoutStartSec=2h
SyslogIdentifier=omarchy-asus-ai-review
