# /etc/omarchy-asus/auto-update.conf (root:root 0644; read by bin/auto-update as root).
# bin/install-auto-update creates it from this example with BUILD_USER filled in.
# No secrets here: the GitHub token, if any, lives in a file owned by BUILD_USER.

# Unprivileged user that owns the signing key, the local repo and the bot clone
# (~BUILD_USER/.local/share/omarchy-asus). Everything except makechrootpkg runs as this user.
BUILD_USER=

# Bot clone source and the branch PRs target.
#GIT_URL=https://github.com/omarchy-asus/omarchy-asus.git
#BASE_BRANCH=main

# auto: merge + publish when every gate passes (build ok, fuzz 0, recipe bump only, no
#       flags, bin/ai-review reviewed the head with no blocking finding, agent approves
#       only with REQUIRE_AGENT_APPROVAL=yes)
# pr:   never merge; every rebase waits for a human (stale packages are still unpublished)
#MERGE_MODE=auto

# ai-review gate (bin/ai-review: codex finds, a second model verifies): required or off.
# required (the default) is auto-update's review gate (#77). If codex is missing or fails,
# the PR waits for a human. off drops the review gate, so PRs merge on the build and recipe
# gates alone; use it for testing with MERGE_MODE=pr.
#AI_REVIEW=required
#AI_REVIEW_TIMEOUT=1800      # seconds for the codex review of one head
#AI_REVIEW_EFFORT=medium     # codex reasoning effort
#VERIFIER=claude             # or openrouter:<model>, with OPENROUTER_API_KEY_FILE
#OPENROUTER_API_KEY_FILE=/home/<user>/.config/omarchy-asus/openrouter-key
#MAX_FIX_ROUNDS=2            # agent fix -> push -> rebuild -> re-review rounds per run
#REPLY_LIMIT=10              # fixer answers passed back to ai-review per round

# Headless fixer (Claude) for ai-review's blocking findings. Empty disables it. The review gate
# is ai-review (Codex): the fixer is the author, so its verdict gates only when
# REQUIRE_AGENT_APPROVAL=yes (then an empty REVIEW_CMD makes the PR wait for a human).
#REVIEW_CMD="claude -p --output-format json --no-session-persistence --allowedTools Read Grep Glob --disallowedTools Bash NotebookEdit WebFetch WebSearch"
#REVIEW_TIMEOUT=1200
#REQUIRE_AGENT_APPROVAL=no

# Directories with gh, codex and claude for BUILD_USER (they are often user-installed),
# e.g. EXTRA_PATH=/home/<user>/.local/bin:/home/<user>/.local/share/mise/shims
#EXTRA_PATH=

# gh keeps its token in the desktop keyring by default, which a system service cannot
# reach. Put a fine-grained token for omarchy-asus/omarchy-asus only (Contents, Pull requests, Commit statuses: read/write)
# in a file owned by BUILD_USER, mode 0600, and name it here.
#GH_TOKEN_FILE=/home/<user>/.config/omarchy-asus/gh-token

# Recipes the timer leaves alone (space separated), e.g. while testing one by hand.
#SKIP_RECIPES=
# Build and publish recipes on BASE_BRANCH that are not in the repo db yet (yes/no).
#BUILD_NOT_BUILT=yes
# Repo-db packages with no recipe are unpublished (the recipe was removed). Package names
# listed here (space separated) are kept and only reported for attention.
#KEEP_PUBLISHED=
# Unpublish after this many consecutive runs without access to the upstream recipe.
#FETCH_FAIL_UNPUBLISH_AFTER=2
# Also fail the unit (systemctl --failed) when something only needs attention.
#FAIL_ON_ATTENTION=no
