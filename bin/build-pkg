#!/bin/bash
# Build one recipe in a clean chroot copy at low priority; output lands in $STAGE_DIR.
# Usage: bin/build-pkg [--channel quattro|rc] [--] recipes/<name> [extra makechrootpkg args]
# The channel (bin/env.sh) picks the chroot and the stage dir: an RC build runs in the rc
# chroot (Omarchy's rc packages, bin/mkchroot --channel rc) and lands in the rc stage dir,
# so bin/publish for the other channel refuses it. A chroot whose pacman.conf does not
# match the channel's (build/pacman.conf, build/pacman-rc.conf) is refused before anything
# is built. The work dir ($DATA/work-<name>.XXXX) is removed however it exits;
# KEEP_WORK=1 keeps it for debugging and prints its path.
#
# Run as a normal user: makechrootpkg is started through sudo (SUDO="sudo -S"
# reads the password from stdin). Run as root:
# BUILD_USER must be set; everything except makechrootpkg runs as that user, and
# makechrootpkg gets SUDO_USER=$BUILD_USER, which is what an interactive
# `sudo makechrootpkg` sees (files owned by, and makepkg run as, the build user).
# One difference: makechrootpkg loads the host makepkg config as root with HOME
# set to SUDO_USER's home (from getent, so overriding HOME does not help), and
# makepkg's source_makepkg_config then sources ~/.config/pacman/makepkg.conf or
# ~/.makepkg.conf -- user-writable shell code running as root. It only does that
# when MAKEPKG_CONF is literally "/etc/makepkg.conf", so the root path passes
# the same root-owned file spelled /etc/./makepkg.conf: /etc/makepkg.conf and
# /etc/makepkg.conf.d/*.conf are still read, the user overrides are not.
# PACKAGER still comes from the chroot's own /etc/makepkg.conf.d.
set -euo pipefail
usage() { sed -n '2,8s/^# \{0,1\}//p' "$0"; }
# The arguments are checked before anything else runs or is created (#301): -h/--help
# prints the usage; an unknown option, no recipe or a dir without a PKGBUILD is exit 2.
while (($#)); do
    case $1 in
        -h | --help) usage; exit 0 ;;
        # --channel quattro|rc: the release channel (bin/env.sh); default quattro
        --channel)
            # checked here: an empty value would read as the default, quattro (#310)
            [[ ${2:-} == @(quattro|rc) ]] || { echo "--channel needs quattro or rc" >&2; usage >&2; exit 2; }
            export OMARCHY_ASUS_CHANNEL=$2; shift 2 ;;
        --) shift; break ;;
        -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
        *) break ;;
    esac
done
(($#)) || { echo "no recipe given" >&2; usage >&2; exit 2; }
[[ -f $1/PKGBUILD ]] || { echo "not a recipe dir (no PKGBUILD): $1" >&2; usage >&2; exit 2; }
source "$(dirname "$0")/env.sh"
lib=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)
recipe=$(realpath -- "$1"); shift
name=$(basename "$recipe")

if [[ $EUID -eq 0 ]]; then
    : "${BUILD_USER:?running as root needs BUILD_USER}"
    [[ $(id -u "$BUILD_USER") -ne 0 ]] || { echo "BUILD_USER must not be root" >&2; exit 1; }
    user_home=$(getent passwd "$BUILD_USER" | cut -d: -f6)
    as_user() { runuser -u "$BUILD_USER" -- env HOME="$user_home" USER="$BUILD_USER" LOGNAME="$BUILD_USER" \
        PATH="$PATH" GNUPGHOME="$GNUPGHOME" "$@"; }
    as_root() { env -u XDG_CONFIG_HOME SUDO_USER="$BUILD_USER" MAKEPKG_CONF=/etc/./makepkg.conf "$@"; }
    chroot_user=(-U "$BUILD_USER")
else
    as_user() { "$@"; }
    as_root() { ${SUDO:-sudo} "$@"; }
    chroot_user=()
fi

[[ -d $CHROOT/root ]] || { echo "no $CHANNEL build chroot at $CHROOT/root (run bin/mkchroot --channel $CHANNEL)" >&2; exit 1; }
channel_conf_ok "$CHROOT/root/etc/pacman.conf" || {
    echo "$CHROOT/root/etc/pacman.conf does not use the $CHANNEL channel's package sources" \
        "(${PACMAN_CONF#"$WORKSPACE"/}); run bin/mkchroot --channel $CHANNEL" >&2
    exit 1
}
echo "==> channel $CHANNEL: chroot $CHROOT, Omarchy $OMARCHY_CHANNEL, stage $STAGE_DIR"
as_user mkdir -p "$STAGE_DIR" "$LOG_DIR"
# The work dir goes however build-pkg exits (a failed verify or build, a missing package,
# Ctrl-C), or failed trees pile up in $DATA (#300). makechrootpkg runs as root in it, so
# what the build user can't remove is removed as root, after checking the path is the
# work-<name>.XXXX dir made here. KEEP_WORK=1 keeps it and prints its path.
work=
remove_work() {
    [[ -n $work && -d $work ]] || return 0
    if [[ ${KEEP_WORK:-} == 1 ]]; then echo "==> work dir kept (KEEP_WORK=1): $work" >&2; return 0; fi
    cd /
    as_user rm -rf -- "$work" 2>/dev/null || true
    [[ -e $work ]] || return 0
    if [[ -L $work || $(realpath "$(dirname "$work")") != "$data_dir" || $(basename "$work") != "work-$name".???? ]]; then
        echo "not removing $work: not a work-$name.XXXX dir in $DATA" >&2
        return 0
    fi
    as_root rm -rf -- "$work" || echo "could not remove the work dir $work" >&2
}
trap remove_work EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
data_dir=$(realpath "$DATA")
work=$(as_user mktemp -d "$data_dir/work-$name.XXXX")
log=$LOG_DIR/$name-$(date +%Y%m%d-%H%M%S).log
# Copy and verify as the user: root never reads the recipe tree itself.
# Recipes with keys/pgp (validpgpkeys): download and verify sources here, with
# a keyring holding only the recipe's keys, then let the chroot build skip
# the PGP step (checksums are still checked there). makepkg --verifysource runs
# the recipe's PKGBUILD (in an unattended rebase, an unreviewed upstream recipe), so it runs
# in bin/recipe-sandbox: network, the work dir and that keyring only -- no
# signing key, no gh logins, no home dir, no inherited environment. A sandbox
# failure (125: bwrap missing) fails the build; there is no unsandboxed fallback.
as_user bash -euo pipefail -c '
    recipe=$1 work=$2 log=$3 name=$4 data=$5 lib=$6
    cp -a "$recipe"/. "$work"/
    rm -rf "$work"/{src,pkg} "$work"/*.pkg.tar.zst
    cd "$work"
    if [[ -d keys/pgp ]]; then
        export GNUPGHOME=$data/verify-gnupg/$name
        rm -rf "$GNUPGHOME"; mkdir -p "$GNUPGHOME"; chmod 700 "$GNUPGHOME"
        gpg --batch --quiet --import keys/pgp/*.asc
        "$lib/recipe-sandbox" --net --rw "$work" --rw "$GNUPGHOME" --setenv GNUPGHOME "$GNUPGHOME" \
            --chdir "$work" -- makepkg --verifysource 2>&1 | tee "$log.verify"
    fi' _ "$recipe" "$work" "$log" "$name" "$DATA" "$lib"
makepkg_args=()
[[ -d $work/keys/pgp ]] && makepkg_args=(-- --skippgpcheck)

# Distributed compiles (optional, off unless set up; docs/distcc.md): if the
# distcc key dir holds a compile-only SSH key, mount the dir read-only at
# /distcc. The chroot's /etc/makepkg.conf.d/distcc.conf (local, not in this
# repo) points distcc at the helper; without the key or helper, distcc falls
# back to local compiles. Build code can read the key: DISTCC_KEY_DIR= (empty)
# leaves it out of this build. Without the mount the chroot's DISTCC_SSH wrapper
# is missing and every job compiles locally (#163), which is how it stays off:
#   - for a recipe with a NO_DISTCC file (its first line is the reason; e.g.
#     hyprland's precompiled headers, which distcc can't share);
#   - when the key dir's ssh wrapper is not this repo's build/distcc-ssh, which
#     sends the chroot's gcc and binutils versions for the helper's
#     build/distccd-gate to compare (an older wrapper sends none).
#   - when the chroot has no ssh for that wrapper to run (openssh not installed in
#     it): distcc would fail every connection and compile everything here (#221).
distcc_dir=${DISTCC_KEY_DIR-$DATA/distcc}
distcc_bind=()
if [[ -n $distcc_dir && -f $distcc_dir/id_ed25519 ]]; then
    distcc_dir=$(realpath "$distcc_dir")  # absolute: makechrootpkg runs after cd "$work"
    if [[ -f $work/NO_DISTCC ]]; then
        echo "==> distcc: off for $name (recipes/$name/NO_DISTCC)"
    elif ! cmp -s "$lib/../build/distcc-ssh" "$distcc_dir/ssh"; then
        echo "==> distcc: off: $distcc_dir/ssh is not build/distcc-ssh (install it: docs/distcc.md)"
    elif [[ ! -x $CHROOT/root/usr/bin/ssh ]]; then
        echo "==> distcc: off: the $CHANNEL chroot has no /usr/bin/ssh (install openssh in $CHROOT/root: docs/distcc.md)"
    else
        distcc_bind=(-D "$distcc_dir:/distcc")
        echo "==> distcc: key dir mounted read-only at /distcc"
    fi
fi
# Persistent compiler cache (optional): if the cache dir exists, mount it
# read-write at /ccache; the chroot's /etc/makepkg.conf.d/ccache.conf (local)
# sets CCACHE_DIR=/ccache and BUILDENV enables ccache. Small-patch kernel
# rebuilds then reuse almost every object. CCACHE_HOST_DIR= (empty) turns it off:
# without the mount, build/no-ccache.conf is mounted over the chroot's makepkg config
# to take ccache out of BUILDENV, or ccache would fail every compile on the missing
# /ccache (#237).
ccache_dir=${CCACHE_HOST_DIR-$DATA/ccache}
if [[ -n $ccache_dir && -d $ccache_dir ]]; then
    distcc_bind+=(-d "$(realpath "$ccache_dir"):/ccache")
    echo "==> ccache: $ccache_dir mounted at /ccache"
else
    distcc_bind+=(-D "$(realpath "$lib/../build/no-ccache.conf"):/etc/makepkg.conf.d/zz-no-ccache.conf")
    echo "==> ccache: off (no cache dir mounted)"
fi

# -c: fresh copy of the root chroot; -u: update it first.
cd "$work"
as_root nice -n 19 ionice -c 3 makechrootpkg -c -u -r "$CHROOT" "${chroot_user[@]}" "${distcc_bind[@]}" "$@" "${makepkg_args[@]}" 2>&1 |
    as_user tee "$log"
as_user bash -c 'mv -v "$1"/*.pkg.tar.zst "$2"/' _ "$work" "$STAGE_DIR"
echo "log: $log"
