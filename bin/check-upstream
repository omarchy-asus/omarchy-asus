#!/usr/bin/env python3
"""Compare every package we carry with the version upstream currently ships.

Usage: bin/check-upstream [--json] [--refresh] [--no-prs] [--recipe DIR]... [--recipe-path PATH]...

Our packages: every recipes/<dir>/PKGBUILD (via `makepkg --printsrcinfo`, run in
bin/recipe-sandbox without network or credentials; one entry per split package)
plus anything in the local repo db ($REPO_DIR).
Upstream: the repos the laptop uses, in pacman.conf order, first match wins:
[omarchy] pkgs.omarchy.org/stable, then core/extra/multilib from the Omarchy
stable mirror.

Base version = our pkgver-pkgrel with the trailing ".N" removed (".1", ".2", ...).
Text output, one line per package:  name ours upstream status
  current          upstream == base and the repo db holds the recipe's version
  rebuild-needed   upstream moved past our base (rebuild with rebased patches, or unpublish)
  upstream-older   upstream < base (check the mirror; our base may be too new)
  not-built        recipe exists but the package is not in the repo db
  repo-stale       repo db holds a different version than the recipe
  not-upstream     no upstream repo ships this name
  bad-pkgrel       our pkgrel does not end in ".N"
  local            local-only package (recipes/<dir>/LOCAL_ONLY exists: no upstream build,
                   plain pkgrel) and the repo db holds the recipe's version; for these
                   only not-built / repo-stale are reported, never bad-pkgrel
  dep-mismatch     an exact-version dependency (depends=(x=ver)) no longer matches the
                   version upstream ships, so installing ours would break the
                   update (e.g. nvidia-open-dkms vs nvidia-utils); a dependency in
                   the same release cohort (build/cohorts.conf) is compared against the
                   package's own version, since the cohort is published together at one
                   version
rebuild-needed and dep-mismatch are urgent: pacman takes the FIRST repo that has a
name regardless of version, so a lagging package here never yields to a newer stock
one; it blocks or breaks `omarchy update` until it is rebuilt or unpublished.
"ours" is the recipe version (the repo db version when there is no recipe).

Patch status: each recipes/<dir>/UPSTREAM_PRS lists "owner/repo#N" lines; the
PR state is fetched from the public GitHub API, cached 24h in $DATA/cache.
A merged PR is reported as needing action (drop the patch when rebasing).

--recipe-path PATH checks a recipe directory outside recipes/ (e.g. a rebased copy;
reported under its basename) and, like --recipe, skips the repo-db-only entries.

The JSON carries `inventory_errors`, the recipe dirs whose `makepkg --printsrcinfo`
failed (they count as needing action); while it is non-empty, bin/auto-update-state
retires a db-only package only when it is stale.

Testing: OMARCHY_ASUS_UPSTREAM_OVERRIDE="name=ver,name=ver" replaces the upstream
version of those names (simulated upstream bumps).

Upstream db freshness: each db is cached for 1h. When a download fails the
cached copy is still used, but the db is reported stale (text: a
"db <repo> stale <age>s cached (<error>)" line before the packages) and the exit
is 10. Past OMARCHY_ASUS_DB_MAX_STALE seconds (default 24h) a stale db is also
flagged expired (" EXPIRED"), so bin/auto-update-state withdraws the packages
that override it instead of trusting an old upstream version forever. A failed
download with no cached copy at all is still an error (exit 1).
--json adds, next to packages/prs/action_needed:
  upstream_dbs   [{repo, age, stale, expired, error}] per upstream db (age in
                 seconds since the cached copy was written; 0 after a download)
  degraded       true when any db is stale (action_needed is then true too)
  expired        [repo] of the stale dbs older than db_max_stale
  db_max_stale   the OMARCHY_ASUS_DB_MAX_STALE in effect, in seconds

Exit: 0 all current, 10 something needs action (including a stale db), 1 error.
"""
import argparse
import io
import json
import os
import re
import subprocess
import sys
import tarfile
import time
import urllib.request

WORKSPACE = os.environ.get("OMARCHY_ASUS_WORKSPACE") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
UPSTREAM_DBS = [  # pacman.conf order
    ("omarchy", "https://pkgs.omarchy.org/stable/x86_64/omarchy.db"),
    ("core", "https://stable-mirror.omarchy.org/core/os/x86_64/core.db"),
    ("extra", "https://stable-mirror.omarchy.org/extra/os/x86_64/extra.db"),
    ("multilib", "https://stable-mirror.omarchy.org/multilib/os/x86_64/multilib.db"),
]
DB_TTL = 3600          # upstream dbs: refetch after 1h
DB_MAX_STALE_DEFAULT = 24 * 3600  # a cached db older than this (download failing) is "expired"
PR_TTL = 24 * 3600     # GitHub PR state: refetch after 24h
UA = "omarchy-asus-check-upstream"
SANDBOX = os.path.join(os.path.dirname(os.path.realpath(__file__)), "recipe-sandbox")


def env_from_sh():
    """DATA and REPO_DIR as bin/env.sh defines them."""
    out = subprocess.run(
        ["bash", "-c", 'source "$1" >/dev/null 2>&1 || exit 1; printf "%s\\n%s\\n%s\\n" "$DATA" "$REPO_DIR" "$REPO_NAME"',
         "_", os.path.join(WORKSPACE, "bin", "env.sh")],
        capture_output=True, text=True, check=True).stdout.splitlines()
    return out[0], out[1], out[2]


def open_tar(data):
    if data[:4] == b"\x28\xb5\x2f\xfd":  # zstd magic
        try:
            from compression import zstd  # Python >= 3.14
            data = zstd.decompress(data)
        except ImportError:
            data = subprocess.run(["zstd", "-dcq"], input=data, capture_output=True, check=True).stdout
    return tarfile.open(fileobj=io.BytesIO(data), mode="r:*")


def parse_db(data):
    """{name: version} from a pacman sync db (tar of <pkg>/desc files)."""
    pkgs = {}
    with open_tar(data) as tf:
        for m in tf:
            if not m.isfile() or not m.name.endswith("/desc"):
                continue
            fields, key = {}, None
            for line in tf.extractfile(m).read().decode("utf-8", "replace").splitlines():
                if line.startswith("%") and line.endswith("%"):
                    key = line.strip("%")
                elif line and key and key not in fields:
                    fields[key] = line
            if "NAME" in fields and "VERSION" in fields:
                pkgs[fields["NAME"]] = fields["VERSION"]
    return pkgs


def db_max_stale():
    """OMARCHY_ASUS_DB_MAX_STALE in seconds (unset or empty: DB_MAX_STALE_DEFAULT)."""
    raw = os.environ.get("OMARCHY_ASUS_DB_MAX_STALE", "").strip()
    if not raw:
        return DB_MAX_STALE_DEFAULT
    try:
        val = int(raw)
    except ValueError:
        val = 0
    if val <= 0:
        raise SystemExit("error: OMARCHY_ASUS_DB_MAX_STALE must be a positive number of seconds")
    return val


def fetch(url, cache_file, ttl, refresh, max_stale=None):
    """(data, info): info = {age, stale, expired, error}.

    age: seconds since the cache file was written (0 right after a download);
    stale: the download failed and the cached copy was used;
    expired: stale and age > max_stale (never when max_stale is None);
    error: the download error text, or None.
    No cache and a failed download raises the OSError."""
    info = {"age": 0, "stale": False, "expired": False, "error": None}
    have = os.path.exists(cache_file)
    age = int(max(0, time.time() - os.path.getmtime(cache_file))) if have else 0
    if have and age < ttl and not refresh:
        with open(cache_file, "rb") as f:
            info["age"] = age
            return f.read(), info
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=60) as r:
            data = r.read()
    except OSError as e:
        if have:  # stale beats nothing, but say how stale
            expired = max_stale is not None and age > max_stale
            info.update(age=age, stale=True, expired=expired, error=str(e))
            print(f"warning: {url}: {e}; using cached copy ({age}s old{', EXPIRED' if expired else ''})",
                  file=sys.stderr)
            with open(cache_file, "rb") as f:
                return f.read(), info
        raise
    tmp = cache_file + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, cache_file)
    return data, info


def freshness_summary(upstream_dbs, max_stale):
    """The --json freshness keys for the upstream db fetch results."""
    return {"upstream_dbs": upstream_dbs,
            "degraded": any(d["stale"] for d in upstream_dbs),
            "expired": [d["repo"] for d in upstream_dbs if d["expired"]],
            "db_max_stale": max_stale}


def recipe_packages(only=None, paths=()):
    """([(recipe_dir, pkgname, version, depends)], [failed recipe_dir]) from recipes/*/PKGBUILD (or just `paths`)."""
    out, errors = [], []
    rdir = os.path.join(WORKSPACE, "recipes")
    if paths:
        dirs = [(os.path.basename(os.path.normpath(p)), p) for p in paths]
    else:
        dirs = [(d, os.path.join(rdir, d)) for d in sorted(os.listdir(rdir))]
    for d, path in dirs:
        if d.startswith(".") or not os.path.isfile(os.path.join(path, "PKGBUILD")):
            if paths:
                raise SystemExit(f"error: {path}: no PKGBUILD")
            continue
        if only and d not in only:
            continue
        real = os.path.realpath(path)
        # makepkg needs a writable BUILDDIR/PKGDEST/SRCDEST (default: the read-only recipe dir)
        r = subprocess.run([SANDBOX, "--ro", real, "--setenv", "BUILDDIR", "/tmp/makepkg",
                            "--setenv", "PKGDEST", "/tmp/makepkg", "--setenv", "SRCDEST", "/tmp/makepkg",
                            "--chdir", real, "--", "makepkg", "--printsrcinfo"],
                           capture_output=True, text=True)
        if r.returncode == 125:  # never skip a recipe silently, never run it unsandboxed
            print("error: bin/recipe-sandbox: bubblewrap (bwrap) is missing; "
                  "recipe code is never run outside the sandbox", file=sys.stderr)
            sys.exit(1)
        if r.returncode != 0:
            print(f"warning: recipes/{d}: makepkg --printsrcinfo failed: {r.stderr.strip()}", file=sys.stderr)
            errors.append(d)
            continue
        info, names = {}, []
        base_deps, deps, section = [], {}, None
        for line in r.stdout.splitlines():
            k, _, v = line.strip().partition(" = ")
            if k == "pkgname":
                names.append(v)
                section = v
            elif k in ("pkgver", "pkgrel", "epoch") and k not in info:
                info[k] = v
            elif k == "depends" or k == "depends_x86_64":
                if section is None:
                    base_deps.append(v)
                else:
                    deps.setdefault(section, []).append(v)
        ver = f"{info['pkgver']}-{info['pkgrel']}"
        if info.get("epoch"):
            ver = f"{info['epoch']}:{ver}"
        out += [(d, n, ver, deps.get(n, base_deps)) for n in names]
    return out, sorted(errors)


def vercmp(a, b):
    return int(subprocess.run(["vercmp", a, b], capture_output=True, text=True, check=True).stdout)


def base_of(ver):
    m = re.fullmatch(r"(.+-[^-]+)\.\d+", ver)
    return m.group(1) if m else None


def exact_deps(deps):
    """[(name, version)] for depends entries pinned with '=' (not >=, <=)."""
    out = []
    for d in deps:
        m = re.fullmatch(r"([^<>=]+)=([^<>=]+)", d)
        if m:
            out.append((m.group(1), m.group(2)))
    return out


def dep_satisfied(want, have):
    """depends=x=want against version have; without a pkgrel in want, compare pkgver only."""
    if "-" not in want:
        have = have.rsplit("-", 1)[0]
        if ":" in have and ":" not in want:
            have = have.split(":", 1)[1]
    return vercmp(want, have) == 0


def load_cohorts(path=None):
    """[[recipe, ...]] from build/cohorts.conf, the same format bin/release-cohort reads:
    one cohort per line, whitespace-separated recipe names, '#' comments and blank
    lines ignored. A missing file means no cohorts."""
    if path is None:
        path = os.path.join(WORKSPACE, "build", "cohorts.conf")
    cohorts = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                names = line.split("#", 1)[0].split()
                if names:
                    cohorts.append(names)
    except FileNotFoundError:
        return []
    return cohorts


def resolve_dep(name, ver, dep, cohorts, upstream, ours_repo):
    """The version of `dep` to compare name's (at version `ver`) exact dependency against.

    A cohort partner is only ever published together with `name`, at the same
    [epoch:]pkgver-pkgrel (bin/publish refuses anything else, bin/release-cohort
    check-recipes keeps the recipes in step), so it resolves to `ver` itself. That
    also holds for a rebased copy (--recipe-path) whose partner is rebased in its
    own PR: the partner on the base branch is still at the old version.
    Otherwise: the first upstream repo that has it, else our repo db."""
    if any(name in c and dep in c for c in cohorts):
        return ver
    return next((p[dep] for _, p in upstream if dep in p), None) or ours_repo.get(dep)


def pr_states(cache_dir, refresh):
    """[(recipe_dir, 'owner/repo#N', state, merged_at)] for every UPSTREAM_PRS entry."""
    res = []
    rdir = os.path.join(WORKSPACE, "recipes")
    for d in sorted(os.listdir(rdir)):
        f = os.path.join(rdir, d, "UPSTREAM_PRS")
        if d.startswith(".") or not os.path.isfile(f):
            continue
        for line in open(f):
            m = re.match(r"\s*([\w.-]+/[\w.-]+)#(\d+)", line)
            if not m:
                continue
            repo, num = m.group(1), m.group(2)
            cache = os.path.join(cache_dir, f"pr-{repo.replace('/', '_')}-{num}.json")
            try:
                pr = json.loads(fetch(f"https://api.github.com/repos/{repo}/pulls/{num}", cache, PR_TTL, refresh)[0])
                state = "merged" if pr.get("merged_at") else pr.get("state", "unknown")
                res.append((d, f"{repo}#{num}", state, pr.get("merged_at")))
            except (OSError, ValueError) as e:
                res.append((d, f"{repo}#{num}", "unknown", None))
                print(f"warning: {repo}#{num}: {e}", file=sys.stderr)
    return res


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--json", action="store_true", help="machine-readable JSON instead of text lines")
    ap.add_argument("--refresh", action="store_true", help="ignore caches (dbs 1h, PR state 24h)")
    ap.add_argument("--no-prs", action="store_true", help="skip the GitHub PR state check")
    ap.add_argument("--recipe", action="append", help="only this recipes/ directory (repeatable)")
    ap.add_argument("--recipe-path", action="append", default=[],
                    help="check this recipe directory instead of recipes/ (repeatable)")
    args = ap.parse_args()

    data_dir, repo_dir, repo_name = env_from_sh()
    cache_dir = os.path.join(data_dir, "cache")
    os.makedirs(cache_dir, exist_ok=True)

    max_stale = db_max_stale()
    upstream = []  # [(repo, {name: ver})] in priority order
    upstream_dbs = []  # [{repo, age, stale, expired, error}]
    for name, url in UPSTREAM_DBS:
        data, info = fetch(url, os.path.join(cache_dir, f"{name}.db"), DB_TTL, args.refresh, max_stale=max_stale)
        upstream.append((name, parse_db(data)))
        upstream_dbs.append({"repo": name, **info})
    freshness = freshness_summary(upstream_dbs, max_stale)
    override = {}
    for item in filter(None, os.environ.get("OMARCHY_ASUS_UPSTREAM_OVERRIDE", "").split(",")):
        n, _, v = item.strip().partition("=")
        override[n] = v
    if override:
        print(f"warning: upstream versions overridden for testing: {override}", file=sys.stderr)
        upstream.insert(0, ("override", override))

    local_db = os.path.join(repo_dir, f"{repo_name}.db")
    ours_repo = {}
    if os.path.exists(local_db):
        with open(local_db, "rb") as f:
            ours_repo = parse_db(f.read())

    cohorts = load_cohorts()
    recipes, inventory_errors = recipe_packages(args.recipe, args.recipe_path)
    rows, seen = [], set()
    extra = [] if args.recipe or args.recipe_path else [(None, n, v, []) for n, v in sorted(ours_repo.items())]
    for recipe, name, ver, deps in recipes + extra:
        if name in seen:
            continue
        seen.add(name)
        up_repo, up_ver = next(((r, p[name]) for r, p in upstream if name in p), (None, None))
        mismatches = []
        for dn, want in exact_deps(deps):
            have = resolve_dep(name, ver, dn, cohorts, upstream, ours_repo)
            if have is None or not dep_satisfied(want, have):
                mismatches.append({"dep": dn, "want": want, "upstream": have})
        repo_ver = ours_repo.get(name)
        base = base_of(ver)
        local_only = recipe is not None and os.path.isfile(os.path.join(WORKSPACE, "recipes", recipe, "LOCAL_ONLY"))
        hold = None
        if recipe is not None and os.path.isfile(os.path.join(WORKSPACE, "recipes", recipe, "HOLD")):
            with open(os.path.join(WORKSPACE, "recipes", recipe, "HOLD")) as f:
                hold = next((l.strip() for l in f if l.strip() and not l.startswith("#")), "held")
        if local_only:
            if repo_ver is None:
                status = "not-built"
            elif repo_ver != ver:
                status = "repo-stale"
            elif mismatches:
                status = "dep-mismatch"
            else:
                status = "local"
        elif base is None:
            status = "bad-pkgrel"
        elif up_ver is None:
            status = "not-upstream"
        elif (c := vercmp(up_ver, base)) > 0:
            status = "rebuild-needed"
        elif mismatches:
            status = "dep-mismatch"
        elif c < 0:
            status = "upstream-older"
        elif repo_ver is None:
            status = "not-built"
        elif repo_ver != ver:
            status = "repo-stale"
        else:
            status = "current"
        rows.append({"name": name, "ours": ver, "base": None if local_only else base, "repo": repo_ver,
                     "local_only": local_only, "hold": hold,
                     "upstream": up_ver, "upstream_repo": up_repo, "recipe": recipe, "status": status,
                     "dep_mismatch": mismatches})

    prs = [] if args.no_prs else pr_states(cache_dir, args.refresh)
    action = (any(r["status"] not in ("current", "local") for r in rows)
              or any(p[2] in ("merged", "closed") for p in prs)
              or bool(inventory_errors)
              or freshness["degraded"])

    if args.json:
        json.dump({"packages": rows,
                   "prs": [{"recipe": d, "pr": p, "state": s, "merged_at": m} for d, p, s, m in prs],
                   "inventory_errors": inventory_errors,
                   "action_needed": action, **freshness}, sys.stdout, indent=2)
        print()
    else:
        for d in upstream_dbs:
            if d["stale"]:
                print(f"db {d['repo']} stale {d['age']}s cached ({d['error']}){' EXPIRED' if d['expired'] else ''}")
        for r in rows:
            extra = "".join(f" [{m['dep']}={m['want']} vs upstream {m['upstream'] or 'none'}]" for m in r["dep_mismatch"])
            print(r["name"], r["ours"], r["upstream"] or "-", r["status"] + extra)
        for d, p, s, m in prs:
            print(f"pr {p} {s}{' ' + m if m else ''} ({d})")
        for d in inventory_errors:
            print(f"inventory-error recipes/{d}: makepkg --printsrcinfo failed")
    return 10 if action else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError, tarfile.TarError) as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
