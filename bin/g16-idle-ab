             "wake lateness p50/p95/p99 ms | completion p50/p95/p99 ms | p95 response ms | Zen 5 GHz | Zen 5c GHz | spikes >4 GHz % | note |")
    o.append("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
    trio = lambda v: "/".join(f(x, 1) for x in v)  # noqa: E731
    for i, p in enumerate(phases):
        o.append(f"| {i} | {p['round']} | {p['name']} | {f(p['bat'])} | {f(p.get('busy5'))} | {f(p.get('busy5c'))} | {f(p.get('share5c'), 1)} | "
