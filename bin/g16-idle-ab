[[ $ROOT == none || $ROOT == testd || ${HELLO#ready } == 0 ]] || die "the root helper is not root"

if ((DRY)); then note "[dry-run] would keep the screen on (stay-awake)"
elif [[ ! -e $STAY_FILE ]]; then
