# Context and one-off diagnostics, before anything changes.
ctx() { printf -- '- %s: %s\n' "$1" "${2:-?}" >>"$WORK/context"; }
pkgv() { pacman -Q "$1" 2>/dev/null | cut -d' ' -f2; }
: >"$WORK/context"
ctx machine "$(dmi product_name), BIOS $(dmi bios_version)"
ctx kernel "$(uname -r)"
ctx packages "omarchy $(pkgv omarchy), hyprland $(pkgv hyprland), nvidia-open-dkms $(pkgv nvidia-open-dkms), linux-firmware $(pkgv linux-firmware-amdgpu || pkgv linux-firmware)"
ctx "cmdline extras" "$(tr ' ' '\n' <"$PROC/cmdline" 2>/dev/null | grep -E '^(nmi_watchdog|rcu_nocbs|rcutree|workqueue|nvme_core|amdgpu|pcie_aspm|nohz)' | paste -sd' ' -)"
pp=''; for d in "$SYS"/class/platform-profile/platform-profile-*; do [[ -d $d ]] || continue; pp+="$(cat "$d/name" 2>/dev/null)=$(cat "$d/profile" 2>/dev/null) "; done
ctx "power profile" "$(powerprofilesctl get 2>/dev/null); platform ${pp% }; EPP $(cat "$SYS"/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null)"
[[ -n $BACKLIGHT ]] && ctx brightness "$(( $(cat "$BACKLIGHT/actual_brightness") * 100 / $(cat "$BACKLIGHT/max_brightness" 2>/dev/null || echo 1) ))% (${BACKLIGHT##*/})"
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  h=$(find "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n1 | cut -d' ' -f2-)
  [[ -n $h ]] && export HYPRLAND_INSTANCE_SIGNATURE=${h##*/}
fi
ctx display "$(hyprctl monitors -j 2>/dev/null | python3 -I -c 'import json,sys
try: print("; ".join("%s %sx%s@%.0fHz vrr=%s" % (m["name"], m["width"], m["height"], m["refreshRate"], m.get("vrr")) for m in json.load(sys.stdin)))
except Exception: print("?")')"
ctx "battery sensor" "$( [[ -r $BAT/power_now ]] && echo power_now || echo current_now×voltage_now); SoC: $( [[ -n $AMDGPU ]] && echo 'amdgpu gpu_metrics' || echo none)"
# The core types, by each CPU's cpuinfo_max_freq (never its number): two clusters, split
# halfway, when the fastest is more than 15% above the slowest.
python3 -I - "$SYS" >"$WORK/cpus.json" <<'PY'
import glob, json, os, sys
m = {}
for d in glob.glob(sys.argv[1] + "/devices/system/cpu/cpu[0-9]*"):
    try:
        with open(d + "/cpufreq/cpuinfo_max_freq") as f: m[os.path.basename(d)[3:]] = int(f.read())
    except (OSError, ValueError): pass
hi, lo = (max(m.values()), min(m.values())) if m else (0, 0)
json.dump({c: "zen5c" if hi > 1.15 * lo and 2 * v < hi + lo else "zen5" for c, v in sorted(m.items(), key=lambda x: int(x[0]))}, sys.stdout)
PY
if [[ $LOAD == light ]]; then
  ctx "core types" "$(python3 -I -c 'import json, sys
t = json.load(open(sys.argv[1]))
print("; ".join(n + " CPUs " + ",".join(c for c in t if t[c] == k) for k, n in (("zen5", "Zen 5"), ("zen5c", "Zen 5c")) if k in t.values()) or "?")' "$WORK/cpus.json") (by cpuinfo_max_freq)"
  ctx "clock source" "$( [[ -r $SYS/devices/system/cpu/cpu0/cpufreq/cpuinfo_avg_freq ]] && echo 'cpuinfo_avg_freq (APERF/MPERF), about 5 Hz' || echo 'none: no cpuinfo_avg_freq')"
fi
ctx "keyboard backlight" "$( ((${#KBD_LEDS[@]})) && echo "${#KBD_LEDS[@]} LED(s), forced off before every phase$( ((DRY)) && echo ' (dry run: left as it is)')" || echo 'none found')"
ctx "Bluetooth" "$(have bluetoothctl && { bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo powered || echo 'not powered'; } || echo '?'), $(have bluetoothctl && { bluetoothctl devices Connected 2>/dev/null | grep -c '^Device' || true; } || echo '?') connected"
if [[ $LOAD == light ]]; then
  say "starting the light load (bursts, browser-like timers, video decode)"
  load_start || die "the light load did not start"
  sleep 1
  load_alive || die "the light load did not start: $(tail -n3 "$LOAD_DIR/load.log" 2>/dev/null | tr '\n' ' ')"
  note "video decode: $DECODE"
  ctx "light load" "bursts at about 8 Hz with fixed work (python, seed 10); browser-like timers and 60 Hz scroll episodes (python, seed 11); video decode: $DECODE. Started once, running through every phase"
fi
ask_root_lines diag >"$WORK/diag" || true
say "20 s IPI and timer trace (before any change)"
ask_root_lines "trace 20" >"$WORK/trace" || true

# Which tweaks can run here.
RUN=() SKIP=()
# The Zen 5c-first knobs: every one present must be at its stock value, or the
# baseline isn't stock.
HFI_NOTE=''
if HD=$(hfi_dir "$SYS"); then
  for x in $HFI_STOCK; do
    [[ -e $HD/${x%%=*} ]] || continue
    v=$(hfi_get "$HD/${x%%=*}"); [[ $v == "${x#*=}" ]] || HFI_NOTE+="${HFI_NOTE:+, }${x%%=*} is $v, not ${x#*=}"
  done
fi
for t in "${SEL[@]}"; do
  case $t in
    voxtype) systemctl --user is-active -q voxtype.service 2>/dev/null && RUN+=("$t") || SKIP+=("$t: voxtype.service not running") ;;
    bt-off | usb-idle)
      if have bluetoothctl && (( $(bluetoothctl devices Connected 2>/dev/null | grep -c '^Device') > 0 )); then SKIP+=("$t: a Bluetooth device is connected")
      else RUN+=("$t"); fi ;;
    usb4)
      if [[ $ROOT == testd ]]; then SKIP+=("$t: not on g16-testd's allowlist (G16_ROOT=pkexec runs it)")
      elif [[ -z $(usb4_awake "$SYS") ]]; then SKIP+=("$t: no USB4/Thunderbolt NHI or router is awake with power/control on")
      else RUN+=("$t"); fi ;;
    cacp3 | cacp4)
      if ! PPS=$(panel_pps "$SYS"); then SKIP+=("$t: no panel_power_savings on the eDP panel")
      elif [[ $(cat "$PPS" 2>/dev/null) != 0 ]]; then SKIP+=("$t: panel_power_savings is $(cat "$PPS" 2>/dev/null), not 0")
      elif ((DPMS && DRY == 0)) && ! { have hyprctl && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; }; then SKIP+=("$t: no Hyprland session for the DPMS cycle (--no-dpms on 0810 kernels)")
      else RUN+=("$t"); fi ;;
    hfi-eff | hfi-inv | wake-all | wake-pack | zen5c-all | wake-class | wlc-track)
      miss=''; for x in $(hfi_knobs "$t"); do [[ -n $HD && -e $HD/${x%%=*} ]] || miss+="${miss:+, }${x%%=*}"; done
      if [[ -n $miss ]]; then SKIP+=("$t: no $miss under /sys/bus/platform/devices/AMDI0104:* (a kernel without the Zen 5c-first patch 9900)")
      elif [[ -n $HFI_NOTE ]]; then SKIP+=("$t: the Zen 5c-first knobs are not at their stock values ($HFI_NOTE)")
      else RUN+=("$t"); fi ;;
    *) RUN+=("$t") ;;
  esac
done
[[ -n $BOOT ]] && RUN=()
for s in "${SKIP[@]}"; do note "skipped: $s"; printf '%s\n' "$s" >>"$WORK/skipped"; done
[[ -n $BOOT ]] || ((${#RUN[@]})) || die "no tweak can run here"

# CACP: before 0810, a panel_power_savings write reaches the panel only at the next
# modeset; one DPMS off/on of the panel forces one (cacp-check, #172).
# Returns 1 when the cycle didn't happen (no hyprctl, a dispatch refused); the panel
# is always asked to come back on.
dpms_cycle() {
  local out rc=0
  ((DRY == 0 && DPMS)) || return 0
  have hyprctl && out=$(panel_pps "$SYS") || return 1
  out=${out%/amdgpu/*}; out=eDP-${out##*-eDP-}
  [[ $(hyprctl dispatch dpms off "$out" 2>&1) == ok ]] || rc=1
  sleep "${G16_AB_DPMS_WAIT:-2}"
  [[ $(hyprctl dispatch dpms on "$out" 2>&1) == ok ]] || rc=1
  sleep "${G16_AB_DPMS_WAIT:-2}"
  return $rc
}
apply_t() { # tweak -> 0 when applied
  local r
  if [[ $1 == voxtype ]]; then
    ((DRY)) && return 0
    VOX_STOPPED=1
    if ! systemctl --user stop voxtype.service 2>/dev/null || systemctl --user is-active -q voxtype.service 2>/dev/null; then
      printf 'voxtype err did not stop\n' >>"$WORK/applied"; note "${R}voxtype did not stop; phase skipped${N}"; return 1
    fi
    printf 'voxtype ok stopped\n' >>"$WORK/applied"; return 0
  fi
  if [[ $1 == nvme-apst ]]; then r=$(ask_root "apply $1 $NVME_PRIMARY_MS $NVME_SECONDARY_MS"); else r=$(ask_root "apply $1"); fi
  printf '%s %s\n' "$1" "$r" >>"$WORK/applied"
  [[ $r == ok* ]] || { note "${R}$1 not applied: $r${N}"; return 1; }
  [[ $1 == bt-off || $1 == usb-idle ]] && ((DRY == 0)) && BT_CHECK=1
  if [[ $1 == cacp* ]]; then
    CACP_TOUCHED=1
    # Before 0810 the level reaches the panel only through the modeset.
    dpms_cycle || { printf '%s err the DPMS cycle failed\n' "$1" >>"$WORK/applied"; note "${R}$1: the DPMS cycle failed; phase skipped (--no-dpms on 0810 kernels)${N}"; return 1; }
  fi
  return 0
}
revert_t() { # tweak; a revert that fails stops the run
  local r
  if [[ $1 == voxtype ]]; then
    ((VOX_STOPPED)) || return 0
    systemctl --user start voxtype.service 2>/dev/null || die "voxtype did not start again; stopping the run"
    VOX_STOPPED=0; return 0
  fi
  r=$(ask_root "revert $1")
  [[ $r == ok* ]] || die "$1 could not be put back ($r); stopping the run"
  if [[ $1 == cacp* && $r != "ok not applied" ]]; then
    dpms_cycle || die "$1: the level is back but the DPMS cycle that applies it failed; stopping the run"
    CACP_TOUCHED=0
  fi
  if [[ $1 == bt-off || $1 == usb-idle ]] && ((BT_POWERED && DRY == 0)) && have bluetoothctl; then
    sleep 2; bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' || bluetoothctl power on >/dev/null 2>&1
  fi
}
shuffle() { # seed items... -> items, shuffled reproducibly
  python3 -I -c 'import random, sys; r = random.Random(int(sys.argv[1])); x = sys.argv[2:]; r.shuffle(x); print("\n".join(x))' "$@"
}
SEED=${SEED:-$((RANDOM * 32768 + RANDOM))}
if [[ $DESIGN == pb12 ]]; then
  ((${#RUN[@]} <= 11)) || die "pb12 takes at most 11 tweaks"
  # The matrix: tweak j is column j; the columns past the last tweak are dummies.
  {
    printf 'row  %s\n' "$(for ((j = 0; j < 11; j++)); do printf '%-3s' "$((j + 1))"; done)"
    i=0; while read -r r; do i=$((i + 1)); printf '%-4s %s\n' "$i" "$(sed 's/./&  /g' <<<"$r")"; done < <(pb12 rows)
    for ((j = 0; j < 11; j++)); do printf 'column %s: %s\n' "$((j + 1))" "${RUN[j]:-dummy}"; done
  } >"$WORK/matrix"
  say "Plackett-Burman design, 12 phases a round, ${#RUN[@]} tweaks, $((11 - ${#RUN[@]})) dummy columns"
  sed 's/^/    /' "$WORK/matrix"
  printf '%s\n' "${RUN[@]}" >"$WORK/run"
  declare -A ON=()
  while read -r round row signs; do
    want_on=" "
    for ((j = 0; j < ${#RUN[@]}; j++)); do [[ ${signs:j:1} == + ]] && want_on+="${RUN[j]} "; done
    for t in "${RUN[@]}"; do [[ -n ${ON[$t]:-} && $want_on != *" $t "* ]] && { revert_t "$t"; unset "ON[$t]"; }; done
    for t in "${RUN[@]}"; do
      [[ -z ${ON[$t]:-} && $want_on == *" $t "* ]] || continue
      if apply_t "$t"; then ON[$t]=1; else revert_t "$t"; fi
    done
    on=''; for t in "${RUN[@]}"; do [[ -n ${ON[$t]:-} ]] && on+=${on:+,}$t; done
    measure "row $((row + 1))" "${on:--}" "$round" "$signs"
  done < <(pb12 plan "$ROUNDS" "$SEED")
  for t in "${RUN[@]}"; do [[ -n ${ON[$t]:-} ]] && { revert_t "$t"; unset "ON[$t]"; }; done
fi
AB_ROUNDS=$ROUNDS; [[ $DESIGN == pb12 ]] && AB_ROUNDS=0
for ((round = 1; round <= AB_ROUNDS; round++)); do
  if [[ -n $BOOT ]]; then { measure baseline - "$round" && measure baseline - "$round"; } || break; continue; fi
  mapfile -t order < <(shuffle $((SEED + round)) "${RUN[@]}")
  measure baseline - "$round" || break
  for t in "${order[@]}"; do
    if apply_t "$t"; then measure "$t" "$t" "$round" || { revert_t "$t"; break 2; }; fi
    revert_t "$t"
    measure baseline - "$round" || break 2
  done
done

# ------------------------------------------------------------------ report
say "putting everything back"
load_stop
[[ $LOAD == light ]] && cp "$LOAD_DIR/bursts.log" "$WORK/bursts" 2>/dev/null
printf '%s\n' "${PHASES[@]}" >"$WORK/phases"
printf '%s\n' "${TWEAKS[@]}" >"$WORK/tweaks"
printf '%s\n' "$PB12_PY" >"$WORK/g16pb.py"
python3 -I - "$WORK" "$REV" "$SETTLE" "$MEASURE" "$INTERVAL" "$ROUNDS" "$SEED" "$DRY" "${BOOT:--}" "$SUMMARY_ISSUE" "$DESIGN" "$ROOT" "$LOAD" >"$WORK/report.md" <<'PY' || die "the report failed"
import json, math, os, statistics as st, sys
work, rev, settle, measure, interval, rounds, seed, dry, boot, summary, design, root, mode = sys.argv[1:14]
light = mode == "light"
def load(p):
    try:
        with open(p) as f: return f.read()
    except OSError: return ""
issues, descs = {}, {}
for line in load(work + "/tweaks").splitlines():
    n, i, d = line.split("|", 2); issues[n], descs[n] = i, d
phases = [json.loads(load(p)) for p in load(work + "/phases").split()]
stopped = set(load(work + "/load-stopped").split())
for p, path in zip(phases, load(work + "/phases").split()):
    p["load_stopped"] = path in stopped
types = json.loads(load(work + "/cpus.json") or "{}")
bursts = []  # (scheduled, woke, done, CPU at start, CPU at end)
for line in load(work + "/bursts").splitlines():
    x = line.split()
    try:
        if len(x) == 5: bursts.append((float(x[0]), float(x[1]), float(x[2]), x[3], x[4]))
    except ValueError: pass
def pct(v, q):
    if not v: return None
    v = sorted(v)
    return v[min(len(v) - 1, max(0, math.ceil(q / 100 * len(v)) - 1))]
HZ = os.sysconf("SC_CLK_TCK")
def light_metrics(p):
    """The light load's columns, kept as phase keys so other tweaks (#328) reuse them:
    lat/comp [p50, p95, p99] ms, p95 (response: scheduled wake to done) ms, burst5c %,
    busy5/busy5c (CPUs busy on average), share5c %, ghz5/ghz5c, spike % (above 4.0 GHz)."""
    b = [x for x in bursts if p.get("t0", 0) <= x[0] < p.get("t1", 0)]
    p["bursts"] = len(b)
    p["lat"] = [pct([(w - s0) * 1000 for s0, w, e, c0, c1 in b], q) for q in (50, 95, 99)]
    p["comp"] = [pct([(e - w) * 1000 for s0, w, e, c0, c1 in b], q) for q in (50, 95, 99)]
    p["p95"] = pct([(e - s0) * 1000 for s0, w, e, c0, c1 in b], 95)
    on = [types.get(c) == "zen5c" for x in b for c in x[3:5]]
    p["burst5c"] = 100 * sum(on) / len(on) if on else None
    busy, dt = p.get("busy", {}), p.get("dt") or 0
    z = {k: sum(v for c, v in busy.items() if types.get(c) == k) / HZ / dt if dt else None for k in ("zen5", "zen5c")}
    p["busy5"], p["busy5c"] = z["zen5"], z["zen5c"]
    tot = (z["zen5"] or 0) + (z["zen5c"] or 0)
    p["share5c"] = 100 * z["zen5c"] / tot if tot > 0 else None
    fr = p.get("freq", {})
    def ghz(k):
        n = sum(v[0] for c, v in fr.items() if types.get(c) == k)
        return sum(v[1] for c, v in fr.items() if types.get(c) == k) / n / 1e6 if n else None
    p["ghz5"], p["ghz5c"] = ghz("zen5"), ghz("zen5c")
    n = sum(v[0] for v in fr.values())
    p["spike"] = 100 * sum(v[2] for v in fr.values()) / n if n else None
def summarize(p):
    s = p["samples"]
    def m(k):
        v = [x[k] for x in s if x.get(k) is not None]
        return st.mean(v) if v else None
    bad = []
    if any(x.get("status") not in ("Discharging", None) for x in s): bad.append("on the charger")
    if any(z.get("dgpu") not in ("suspended", "-", None) for z in p["states"]): bad.append("RTX awake")
    bls = {x.get("bl") for x in s}
    if len(bls) > 1: bad.append("brightness changed")
    if dry != "1" and any(x.get("kbd") not in (None, 0) for x in s): bad.append("keyboard LED on")
    if p.get("load_stopped"): bad.append("light load stopped")
    stt = {}
    for z in p["states"]:
        for k, v in z.items(): stt.setdefault(k, {}).setdefault(v, 0); stt[k][v] += 1
    p.update(bat=m("bat"), sock=None if m("sock") is None else m("sock") / 1000, gfx=None if m("gfx") is None else m("gfx") / 1000,
             core=None if m("core") is None else m("core") / 1000, bad=bad, valid=not bad, devstates=stt)
    if light: light_metrics(p)
    return p
for p in phases: summarize(p)
f = lambda v, n=2: "–" if v is None else f"{v:.{n}f}"
o = []
if boot != "-":
    # Boot runs: keep the numbers, report baselines only.
    rec = {"label": boot, "when": os.popen("date -Iminutes").read().strip(), "kernel": os.uname().release,
           "extra": " ".join(w for w in load("/proc/cmdline").split() if w.split("=")[0] in ("nmi_watchdog", "rcu_nocbs", "rcutree.enable_rcu_lazy", "workqueue.power_efficient", "nvme_core.default_ps_max_latency_us", "amdgpu.dcdebugmask", "amdgpu.dcfeaturemask")),
           "settle": settle, "measure": measure, "interval": interval,
           "phases": [{k: p[k] for k in ("bat", "sock", "valid")} for p in phases]}
    with open(work + "/boot.json", "w") as fh: json.dump(rec, fh)
o.append(f"## G16 {'A/B under a light load' if light else 'idle A/B'}{' (dry run, not a measurement)' if dry == '1' else ''}{' — boot run ' + boot if boot != '-' else ''}\n")
o.append(load(work + "/context").rstrip())
o.append(f"- root steps: {'the G16 test session helper (g16-testd)' if root == 'testd' else root}")
if design == "pb12":
    o.append(f"- method: Plackett-Burman screening (#276), {rounds} round{'' if rounds == '1' else 's'} of the 12-row matrix, each round in a shuffled order "
             f"(seed {seed}). Each row switches on a different half of the tweaks; from one row to the next only the tweaks "
             f"whose level differs change. Each phase settles {settle} s, then {measure} s are measured, a sample every {interval} s. "
             "Δ is a tweak's main effect, on minus off, fitted by least squares over every valid phase with a level per round "
             "(and a linear drift over the run when the phases leave room for it); ±2 SE is from the residual noise. "
             "Columns no tweak uses (dummies) are fitted on top and should read as noise. Phases with the charger in, the RTX "
             "awake or the brightness changed are left out.")
    o.append("- assumes the effects add up (no interactions): an interaction, such as kbd-usb with bt-off (they share an xHCI "
             "controller), spreads over the other columns. A tweak this screen calls a winner gets a one-at-a-time A/B "
             "(`g16-idle-ab --only T`) to confirm it.")
else:
    o.append(f"- method: {rounds} rounds; each round runs every tweak once in a shuffled order (seed {seed}), each between two baseline phases "
             f"(B T1 B T2 … B). Each phase settles {settle} s, then {measure} s are measured, a sample every {interval} s. A tweak's delta "
             "in a round is its phase minus the mean of the two baselines around it. ±2 SE is twice the standard error of the mean delta "
             "over the rounds. Phases with the charger in, the RTX awake, the brightness changed or a keyboard LED lit are left out.")
if light:
    o.append("- light load: started once and running through every phase, baseline and tweak alike. Latency comes from the bursts "
             "scheduled in a phase's measured window: wake lateness (actual minus scheduled wake), completion (the burst's fixed "
             "work), and p95 response (scheduled wake to done). Zen 5c share: the Zen 5c cores' part of all CPU busy time "
             "(/proc/stat). Spikes: the share of cpuinfo_avg_freq samples above 4.0 GHz. A tweak's Δ is its phase minus the mean "
             "of the baselines around it; noise is the sd of one baseline minus the next. **flagged**: a watt saving with p95 "
             "response more than 10% worse.")
o.append(f"- verdict: **saves** when the {'effect' if design == 'pb12' else 'mean delta'} is below −0.10 W and below −2 SE; **costs** the mirror; otherwise **no effect beyond noise**.\n")
skipped = load(work + "/skipped").strip()
if skipped: o.append("Skipped: " + "; ".join(skipped.splitlines()) + "\n")
rows, per = [], {}
for i, p in enumerate(phases):
    if design == "pb12" or p["tweak"] == "-": continue
    before = next((q for q in reversed(phases[:i]) if q["tweak"] == "-"), None)
    after = next((q for q in phases[i + 1:] if q["tweak"] == "-"), None)
    # Both baselines around it must be valid, or drift doesn't cancel.
    bases = [q for q in (before, after) if q and q["valid"] and q["bat"] is not None]
    if not p["valid"] or p["bat"] is None or len(bases) < 2: per.setdefault(p["tweak"], []).append(None); continue
    bb = st.mean(q["bat"] for q in bases)
    bs = [q["sock"] for q in bases if q["sock"] is not None]
    per.setdefault(p["tweak"], []).append((p["bat"] - bb, (p["sock"] - st.mean(bs)) if bs and p["sock"] is not None else None, p, bases))
base = [p for p in phases if p["tweak"] == "-" and p["valid"] and p["bat"] is not None]
noise = None
if len(base) > 2:
    diffs = [b["bat"] - a["bat"] for a, b in zip(base, base[1:])]
    noise = st.pstdev(diffs) if len(diffs) > 1 else None
verdicts = {}
def verdict(mean, se2):
    if mean is None: return "no valid rounds" if design != "pb12" else "not estimable"
    if se2 is not None and mean < -0.10 and mean < -se2: return "saves"
    if se2 is not None and mean > 0.10 and mean > se2: return "costs"
    return "no effect beyond noise" if se2 is not None else "no noise estimate"
if design == "pb12":
    sys.path.insert(0, work)
    import g16pb
    run = load(work + "/run").split()
    pts = [{"on": [] if p["tweak"] == "-" else p["tweak"].split(","), "round": p["round"], "seq": i,
            "design": [1 if c == "+" else -1 for c in p.get("design", "")],
            "bat": p["bat"] if p["valid"] else None, "sock": p["sock"] if p["valid"] else None} for i, p in enumerate(phases)]
    fb = g16pb.fit(pts, run, "bat", list(range(len(run), 11)))
    fs = g16pb.fit(pts, run, "sock")
    pm = lambda e: "–" if e is None else f"{e[0]:+.2f}"  # noqa: E731
    pe = lambda e: "–" if e is None or e[1] is None else f"{e[1]:.2f}"  # noqa: E731
    o.append("| tweak | issue | phases on / off | Δ battery W | ±2 SE | Δ SoC W | ±2 SE | verdict |")
    o.append("|---|---|---|---|---|---|---|---|")
    valid = [q for q in pts if q["bat"] is not None]
    for t in run:
        e = fb["effects"].get(t)
        v = verdict(e and e[0], e and e[1])
        verdicts[t] = (v, e and e[0], e and e[1])
        non = sum(t in q["on"] for q in valid)
        o.append(f"| {t} | #{issues.get(t, '?')} | {non} / {len(valid) - non} | {pm(e)} | {pe(e)} | {pm(fs['effects'].get(t))} | {pe(fs['effects'].get(t))} | **{v}** |")
    for j, e in enumerate(fb["dummies"]):
        o.append(f"| (dummy, column {len(run) + j + 1}) | – | – | {pm(e)} | {pe(e)} | – | – | noise check |")
    o.append(f"\nFit: {fb['n']} valid phases, residual noise (sd of one phase) "
             + ("–" if fb["sigma"] is None else f"{fb['sigma']:.2f} W") + f" on {fb['df'] if fb['df'] is not None else 0} degrees of freedom"
             + (", with a linear drift term" if fb["trend"] else ", no drift term") + ".")
    o.append("\n<details><summary>The design matrix (+ on, − off)</summary>\n\n```\n" + load(work + "/matrix").rstrip() + "\n```\n</details>")
def bnoise(k):
    v = [b[k] for b in base if b.get(k) is not None]
    d = [y - x for x, y in zip(v, v[1:])]
    return st.pstdev(d) if len(d) > 1 else None
def dkey(d, k):
    p, bases = d[2], d[3]
    bv = [q[k] for q in bases if q.get(k) is not None]
    return None if p.get(k) is None or len(bv) < 2 else p[k] - st.mean(bv)
def mean_or_none(v):
    v = [x for x in v if x is not None]
    return st.mean(v) if v else None
sg = lambda v, n=2: "–" if v is None else f"{v:+.{n}f}"  # noqa: E731
if light and per:
    o.append("| tweak | issue | rounds | Δ battery W | ±2 SE | Δ SoC W | Δ p95 response ms | Δ p95 % | Δ Zen 5c share pp | Δ spikes >4 GHz pp | verdict |")
    o.append("|---|---|---|---|---|---|---|---|---|---|---|")
    for t, ds in per.items():
        good = [d for d in ds if d]
        dv = [d[0] for d in good]
        mean = st.mean(dv) if dv else None
        se2 = 2 * st.stdev(dv) / math.sqrt(len(dv)) if len(dv) > 1 else None
        v = verdict(mean, se2)
        if v == "no noise estimate": v = "no effect beyond noise"
        dl = mean_or_none([dkey(d, "p95") for d in good])
        bl95 = mean_or_none([q["p95"] for d in good for q in d[3] if q.get("p95") is not None])
        rel = 100 * dl / bl95 if dl is not None and bl95 else None
        flag = mean is not None and mean < 0 and rel is not None and rel > 10
        verdicts[t] = (v + (f", flagged: p95 {rel:+.0f}%" if flag else ""), mean, se2)
        o.append(f"| {t} | #{issues.get(t, '?')} | {len(dv)}/{len(ds)} | {sg(mean)} | {f(se2)} | {sg(mean_or_none([d[1] for d in good]))} | "
                 f"{sg(dl, 1)} | {sg(rel, 0)} | {sg(mean_or_none([dkey(d, 'share5c') for d in good]), 1)} | "
                 f"{sg(mean_or_none([dkey(d, 'spike') for d in good]), 1)} | **{v}**{f' · **flagged**: p95 {rel:+.0f}%' if flag else ''} |")
    nz = {k: bnoise(k) for k in ("bat", "sock", "p95", "share5c", "spike")}
    o.append(f"| baseline noise (sd, B to B) | – | {len(base)} | {f(nz['bat'])} | – | {f(nz['sock'])} | {f(nz['p95'], 1)} | – | "
             f"{f(nz['share5c'], 1)} | {f(nz['spike'], 1)} | – |")
elif per:
    o.append("| tweak | issue | rounds | Δ battery W (mean) | ±2 SE | per round | Δ SoC W | verdict |")
    o.append("|---|---|---|---|---|---|---|---|")
    for t, ds in per.items():
        good = [d for d in ds if d]
        dv = [d[0] for d in good]
        ds_ = [d[1] for d in good if d[1] is not None]
        mean = st.mean(dv) if dv else None
        se2 = 2 * st.stdev(dv) / math.sqrt(len(dv)) if len(dv) > 1 else None
        v = verdict(mean, se2)
        if v == "no noise estimate": v = "no effect beyond noise"
        verdicts[t] = (v, mean, se2)
        pr = ", ".join("left out" if d is None else f"{d[0]:+.2f}" for d in ds)
        o.append(f"| {t} | #{issues.get(t, '?')} | {len(dv)}/{len(ds)} | {f(mean, 2) if mean is None else f'{mean:+.2f}'} | {f(se2)} | {pr} | "
                 f"{'–' if not ds_ else f'{st.mean(ds_):+.2f}'} | **{v}** |")
if base:
    o.append(f"\nBaseline{' (the phases with every tweak off)' if design == 'pb12' else ''} over the run: battery {st.mean(b['bat'] for b in base):.2f} W (min phase {min(b['bat'] for b in base):.2f}, "
             f"max {max(b['bat'] for b in base):.2f}), SoC {f(st.mean([b['sock'] for b in base if b['sock'] is not None]) if any(b['sock'] is not None for b in base) else None)} W"
             + (f", baseline-to-baseline noise (sd) {noise:.2f} W" if noise is not None else "") + ".")
    gf = [b["gfx"] for b in base if b["gfx"] is not None]; cf = [b["core"] for b in base if b["core"] is not None]
    if gf and cf: o.append(f"SoC split at baseline: GFX {st.mean(gf):.2f} W, all CPU cores {st.mean(cf):.2f} W, the rest of the SoC (fabric, memory, display, I/O) {st.mean(b['sock'] for b in base if b['sock'] is not None) - st.mean(gf) - st.mean(cf):.2f} W.")
# Per-tweak detail: the device state each one aimed at, and the interrupt rates.
o.append("\n<details><summary>Per phase: watts, device states, interrupt rates</summary>\n")
o.append("| # | round | phase | battery W | SoC W | GFX W | cores W | states | irq/s (CAL, LOC, amdgpu, nvme, Wi-Fi, xhci) | note |")
o.append("|---|---|---|---|---|---|---|---|---|---|")
def irq(p, key):
    return sum(v for k, v in p["irq"].items() if key in k)
for i, p in enumerate(phases):
    stt = "; ".join(f"{k} " + "/".join(f"{v}" for v in sorted(c)) for k, c in sorted(p["devstates"].items()))
    o.append(f"| {i} | {p['round']} | {p['name'] + (' (' + p['tweak'] + ')' if design == 'pb12' else '')} | {f(p['bat'])} | {f(p['sock'])} | {f(p['gfx'])} | {f(p['core'])} | {stt} | "
             f"{irq(p, 'CAL'):.0f}, {irq(p, 'LOC'):.0f}, {irq(p, 'amdgpu'):.0f}, {irq(p, 'nvme'):.1f}, {irq(p, 'mt7925'):.0f}, {irq(p, 'xhci'):.1f} | {', '.join(p['bad'])} |")
o.append("\n</details>\n")
if light:
    o.append("<details><summary>Per phase under the light load: CPU time by core type, burst placement, latency, clocks</summary>\n")
