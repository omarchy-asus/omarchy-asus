    txt.append(f"\nVerdict: **{v}** ({'?' if mean is None else f'{mean:+.2f}'} W, ±2 SE {'?' if se2 is None else f'{se2:.2f}'} W). "
               f"The full report, with every phase, the device states and the interrupt rates, is on #{summary}.")
