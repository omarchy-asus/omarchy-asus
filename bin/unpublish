#!/bin/bash
# Drop packages from the repo db so the stock build flows through again.
# Usage: bin/unpublish [--channel quattro|rc] pkgname ...
# Same locked, verified transaction as bin/publish (bin/publish-lib.sh; exit 75 when
# $DATA/publish.lock stays busy): any failure leaves the live repo as it was.
# Release cohort partners (build/cohorts.conf, e.g. omarchy + omarchy-settings) that the db
# holds are withdrawn with them (bin/release-cohort members).
set -euo pipefail
# --channel quattro|rc, first: the release channel (bin/env.sh); default quattro
if [[ ${1:-} == --channel ]]; then export OMARCHY_ASUS_CHANNEL=${2:?--channel needs quattro or rc}; shift 2; fi
source "$(dirname "$0")/env.sh"
quattro_frozen unpublish
# shellcheck source=bin/publish-lib.sh
source "$(dirname "$0")/publish-lib.sh"
: "${SIGN_KEY:?no signing key fingerprint in $DATA/fingerprint}"
pub_lock
# Cohort partners are resolved under the lock, against the live db. Names the db no
# longer holds are skipped: withdrawing one member already withdrew its partners.
listed=$("$(dirname "$0")/release-cohort" members --present --db "$REPO_DIR/$REPO_NAME.db.tar.gz" "$@") || {
    echo "unpublish: bin/release-cohort members failed; nothing removed" >&2
    exit 1
}
if [[ -z $listed ]]; then
    echo "unpublish: none of $* is in the repo db; nothing to withdraw" >&2
    exit 0
fi
names=()
mapfile -t names <<<"$listed"
extra=()
for n in "${names[@]}"; do
    found=0
    for a in "$@"; do
        [[ "$n" == "$a" ]] && { found=1; break; }
    done
    (( found )) || extra+=("$n")
done
if (( ${#extra[@]} )); then
    echo "unpublish: also withdrawing release-cohort partner(s): ${extra[*]}" >&2
fi
pub_mark_pending "unpublish ${names[*]}"
pub_stage
committed=0
trap 'if ((committed == 0)); then pub_abort; fi' EXIT
repo-remove --sign --key "$SIGN_KEY" --verify "$PUB_STAGE/$REPO_NAME.db.tar.gz" "${names[@]}"
for p in "${names[@]}"; do
    # deleting the staging hardlink leaves the live file alone
    find "$PUB_STAGE" -maxdepth 1 -regextype posix-extended \
        -regex ".*/$p-[^-]+-[^-]+-[^-]+\.pkg\.tar\.zst(\.sig)?" -print -delete
done
# repo-remove's exit status does not cover a failed signature: check the result
pub_verify_repo "$PUB_STAGE"
pub_commit
# shellcheck disable=SC2034  # read by the EXIT trap above
committed=1
