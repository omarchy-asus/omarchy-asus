#!/bin/bash
# omarchy-asus-setup: switch a stock Omarchy install on an ASUS ROG Zephyrus G16
# GA605 to the EXPERIMENTAL omarchy-asus pacman repo (or back, with --uninstall).
#
# Run it as your normal user; it calls sudo for the privileged steps. It does
# the same thing as the manual steps in LAPTOP-SETUP.md, with the same file
# contents, and is safe to run again.
#
#   omarchy-asus-setup               set up the repo, then offer the upgrade and the G16 fixes
#   omarchy-asus-setup --uninstall   undo it and go back to the stock builds
#   omarchy-asus-setup --dry-run     print every privileged command instead of running it
#   omarchy-asus-setup --force       skip the GA605 model check
set -euo pipefail

REPO=omarchy-asus
FPR=0B44FF7CCDD929F61BE4A2E436FE6B28AB24EC88
GH_REPO=omarchy-asus/omarchy-asus
GH_BRANCH=main
KEY_URL=https://raw.githubusercontent.com/$GH_REPO/$GH_BRANCH/keys/omarchy-asus.asc
DB_URL=https://github.com/$GH_REPO/releases/download/x86_64/$REPO.db
KEYRING_PKG=omarchy-asus-keyring
# Offered as the optional last step on a fresh install.
G16_PKGS=(omarchy-asus-g16 asus-rog-nkey-winlock omarchy-asus-g16-apply)
# Packages only the repo ships (no stock build): left behind by --uninstall unless removed.
REPO_ONLY_PKGS=(omarchy-asus-g16 omarchy-asus-g16-apply asus-rog-nkey-winlock asus-zephyrus-g16-control hyprpm)

# The overrides exist for the offline test (tests/ci/setup-uninstall.sh).
CONF=${OMARCHY_ASUS_PACMAN_CONF:-/etc/pacman.conf}
SNIPPET=${OMARCHY_ASUS_CUSTOM_REPOS:-/etc/pacman.d/custom-repos.conf}
MARKER="Include = $SNIPPET"
HOOK_DIR=$HOME/.config/omarchy/hooks/pre-refresh-pacman.d
HOOK=$HOOK_DIR/add-omarchy-asus-repo

# The repo section of /etc/pacman.d/custom-repos.conf (LAPTOP-SETUP.md section 2).
# shellcheck disable=SC2016 # $arch is expanded by pacman, not by this script
REPO_BLOCK='[omarchy-asus]
SigLevel = Required
Server = https://github.com/omarchy-asus/omarchy-asus/releases/download/$arch'

# The pre-refresh hook (LAPTOP-SETUP.md section 3).
# shellcheck disable=SC2016 # written out verbatim
HOOK_CONTENT='#!/bin/bash
# Put the omarchy-asus repo ahead of every other repo so its patched builds win
# over the stock ones. See LAPTOP-SETUP.md in
# https://github.com/omarchy-asus/omarchy-asus.
CONF=/etc/pacman.conf
SNIPPET=/etc/pacman.d/custom-repos.conf
MARKER="Include = $SNIPPET"

[[ -r $SNIPPET ]] || exit 0
grep -qxF "$MARKER" "$CONF" && exit 0

sudo sed -i -E "0,/^\[(omarchy|core)\]$/s||$MARKER\n\n&|" "$CONF"'

DRY_RUN=0
FORCE=0
MODE=install

# Test hooks, set only by tests/ci/omarchy-asus-setup-etc-takeover.sh: ROOT prefixes the
# /etc paths the takeover checks and moves (pacman always gets the real path), TTY stands
# in for the terminal.
ROOT=${OMARCHY_ASUS_SETUP_ROOT:-}
TTY=${OMARCHY_ASUS_SETUP_TTY:-/dev/tty}

# Under `curl ... | bash`, $0 is "bash", not this file: fall back to the URL.
if [[ -f $0 ]]; then
  SELF=$0
else
  SELF="curl -fsSL https://raw.githubusercontent.com/$GH_REPO/$GH_BRANCH/bin/omarchy-asus-setup | bash -s --"
fi

usage() {
  if [[ -f $0 ]]; then
    sed -n '2,14s/^# \{0,1\}//p' "$0"
  else
    echo "usage: omarchy-asus-setup [--uninstall] [--dry-run] [--force]"
  fi
}

for arg in "$@"; do
  case $arg in
    --uninstall) MODE=uninstall ;;
    --dry-run) DRY_RUN=1 ;;
    --force) FORCE=1 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -t 1 ]]; then B=$'\e[1m' R=$'\e[31m' Y=$'\e[33m' G=$'\e[32m' N=$'\e[0m'; else B='' R='' Y='' G='' N=''; fi
step() { printf '\n%s==> %s%s\n' "$B" "$*" "$N"; }
info() { printf '    %s\n' "$*"; }
ok() { printf '    %sok:%s %s\n' "$G" "$N" "$*"; }
warn() { printf '    %swarning:%s %s\n' "$Y" "$N" "$*" >&2; }
die() { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# Privileged command: run through sudo, or print it under --dry-run.
as_root() {
  if ((DRY_RUN)); then
    local arg q="'\\''" line='    [dry-run] sudo'
    for arg in "$@"; do
      if [[ $arg =~ ^[A-Za-z0-9_./=:@%+-]+$ ]]; then line+=" $arg"; else line+=" '${arg//\'/$q}'"; fi
    done
    printf '%s\n' "$line"
  else
    sudo "$@"
  fi
}

# Write CONTENT to a root-owned FILE (mode 644), or show it under --dry-run.
write_root() {
  local file=$1 content=$2
  if ((DRY_RUN)); then
    printf '    [dry-run] sudo tee %s <<EOF\n%s\nEOF\n' "$file" "$content"
  else
    printf '%s\n' "$content" | sudo tee "$file" >/dev/null
    sudo chmod 644 "$file"
  fi
}

# Ask a yes/no question on the terminal (works under `curl | bash` too).
confirm() {
  if ((DRY_RUN)); then
    printf '    %s [y/N] [dry-run: assuming yes]\n' "$1"
    return 0
  fi
  local answer
  [[ -r $TTY ]] || die "no terminal to ask for confirmation on"
  read -r -p "    $1 [y/N] " answer <"$TTY"
  [[ $answer == [yY] || $answer == [yY][eE][sS] ]]
}

# The unpacked files database (empty: not available), the unowned /etc files the upgrade
# takes over, and the ones run_upgrade has moved aside while it runs.
FILES_DB=''
TAKEOVER=()
MOVED=()

TMP=$(mktemp -d)
# restore_moved puts back any /etc file still moved aside when the script stops early.
trap 'restore_moved || true; rm -rf "$TMP"' EXIT

# custom-repos.conf without our section (other repos the user keeps there stay).
snippet_without_repo() {
  [[ -f $SNIPPET ]] || return 0
  awk -v sec="[$REPO]" '$0 == sec { skip = 1; next } /^\[/ { skip = 0 } !skip' "$SNIPPET"
}

# Line numbers of the Include line and of the first [omarchy]/[core] header (0 = absent).
include_line() { grep -nxF "$MARKER" "$CONF" | head -n1 | cut -d: -f1 || true; }
first_repo_line() { grep -nE '^\[(omarchy|core)\]$' "$CONF" | head -n1 | cut -d: -f1 || true; }

banner() {
  cat <<EOF

${R}${B}EXPERIMENTAL. Built for and only meant for the ASUS ROG Zephyrus G16 GA605 (GA605KM).${N}
Nobody has installed these packages yet. The kernel carries untested patches, including an
experimental scheduler series that is compiled in but switched off.
Don't add this repo to any other machine. On a G16, use it only if you can recover from a
kernel or driver that won't boot (this repo replaces linux-omarchy, so keep a second kernel
such as Arch's linux installed as a boot fallback).
EOF
}

check_user() {
  ((EUID != 0)) || die "run this as your normal user, not root; it calls sudo where needed"
  local cmd
  for cmd in pacman pacman-key gpg curl awk bsdtar vercmp cmp diff; do
    command -v "$cmd" >/dev/null || die "missing command: $cmd"
  done
  [[ -f $CONF ]] || die "$CONF not found"
  grep -qE '^\[(omarchy|core)\]$' "$CONF" || die "$CONF has neither an [omarchy] nor a [core] section"
  grep -qx '\[omarchy\]' "$CONF" || warn "$CONF has no [omarchy] section; this doesn't look like an Omarchy install"
}

check_model() {
  local product board
  product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
  board=$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)
  step "Checking the machine model"
  if [[ $product == *GA605* || $board == *GA605* ]]; then
    ok "ASUS ROG Zephyrus G16 GA605 ($product / $board)"
  elif ((FORCE)); then
    warn "not a GA605 (product_name='$product', board_name='$board'); continuing because of --force"
  else
    die "this is not an ASUS ROG Zephyrus G16 GA605 (product_name='$product', board_name='$board').
       omarchy-asus is only for that model. Use --force only if you know why it should run here."
  fi
}

# Download the repo key over HTTPS and check that it is exactly the key whose
# fingerprint is hardcoded above.
fetch_key() {
  step "Downloading and checking the repo signing key"
  curl -fsSL --proto '=https' --tlsv1.2 -o "$TMP/key.asc" "$KEY_URL" || die "could not download $KEY_URL"
  mkdir -m 700 "$TMP/gnupg"
  local fprs
  fprs=$(GNUPGHOME=$TMP/gnupg gpg --batch --with-colons --show-keys "$TMP/key.asc" 2>/dev/null |
    awk -F: '$1 == "pub" { want = 1; next } $1 == "fpr" && want { print $10; want = 0 }')
  [[ $fprs == "$FPR" ]] || die "the downloaded key is not the expected one.
       expected: $FPR
       got:      ${fprs:-<no key>}"
  GNUPGHOME=$TMP/gnupg gpg --batch --quiet --dearmor -o "$TMP/key.gpg" "$TMP/key.asc"
  ok "key fingerprint $FPR"
  info "This check only proves the key matches the fingerprint in this script, which comes from"
  info "the same GitHub account. Compare the fingerprint with one you got another way (for example"
  info "the README on github.com/$GH_REPO, or from the maintainer) before you trust it."
}

# Show which installed packages the repo would replace, from its signed database
# (read-only: nothing on the system changes).
preview_repo() {
  step "Packages in the $REPO repo (signed database, read-only check)"
  if ! curl -fsSL --proto '=https' -o "$TMP/repo.db" "$DB_URL" ||
    ! curl -fsSL --proto '=https' -o "$TMP/repo.db.sig" "$DB_URL.sig"; then
    warn "could not download the repo database; skipping the preview"
    return 0
  fi
  if ! gpgv --keyring "$TMP/key.gpg" "$TMP/repo.db.sig" "$TMP/repo.db" 2>/dev/null; then
    die "the repo database signature does not verify with key $FPR"
  fi
  # The files database lists every file of every package; check_unowned_etc reads it.
  local files_url=${DB_URL%.db}.files
  if curl -fsSL --proto '=https' -o "$TMP/repo.files" "$files_url" &&
    curl -fsSL --proto '=https' -o "$TMP/repo.files.sig" "$files_url.sig"; then
    if ! gpgv --keyring "$TMP/key.gpg" "$TMP/repo.files.sig" "$TMP/repo.files" 2>/dev/null; then
      die "the repo files database signature does not verify with key $FPR"
    fi
    if mkdir "$TMP/files.d" && bsdtar -xf "$TMP/repo.files" -C "$TMP/files.d"; then
      FILES_DB=$TMP/files.d
    else
      warn "could not unpack the repo files database"
    fi
  else
    warn "could not download the repo files database"
  fi
  local name version installed
  while read -r name version; do
    if installed=$(pacman -Q "$name" 2>/dev/null); then
      installed=${installed#* }
      case $(vercmp "$version" "$installed") in
        1) info "$name  $installed -> $version" ;;
        0) info "$name  $version (already installed)" ;;
        *) info "$name  $installed installed is newer than the repo's $version (stays)" ;;
      esac
    else
      info "$name  $version (not installed, not pulled in)"
    fi
  done < <(bsdtar -xOf "$TMP/repo.db" '*/desc' |
    awk '/^%NAME%$/ { getline n } /^%VERSION%$/ { getline v; print n, v }' | sort)
}

preflight_warnings() {
  local k fallback=''
  for k in linux linux-lts linux-zen linux-hardened; do
    pacman -Q "$k" >/dev/null 2>&1 && fallback+=" $k"
  done
  if [[ -n $fallback ]]; then
    ok "fallback kernel installed:$fallback"
  else
    warn "no fallback kernel (linux, linux-lts, ...) is installed. This repo replaces linux-omarchy"
    warn "with a build whose patches have not been booted on hardware yet."
    # From the databases the system already has (no -y), so this is not a partial upgrade.
    # linux-headers too, so DKMS builds the NVIDIA module for the fallback as well. Only on a
    # system that is current with its databases (an earlier run may have synced them):
    # otherwise the install would upgrade just the packages it pulls in.
    if [[ -n $(pacman -Qu 2>/dev/null) ]]; then
      warn "the system has pending upgrades, so installing a kernel now would be a partial upgrade."
      warn "Run 'omarchy update' first, then 'sudo pacman -S linux linux-headers', before you reboot."
    elif confirm "Install Arch's 'linux' kernel (and its headers) now as a boot fallback (recommended)?"; then
      as_root pacman -S --needed --noconfirm linux linux-headers ||
        warn "could not install linux; install a fallback kernel before you reboot"
    else
      warn "no fallback kernel: install one (sudo pacman -S linux) before you reboot into the new kernel."
    fi
  fi
  if grep -nE '^[[:space:]]*IgnorePkg' "$CONF" | grep -qE 'nvidia|hyprland|hyprpm|aquamarine|linux-omarchy'; then
    warn "$CONF has IgnorePkg lines for packages this repo ships; remove them, or the repo builds won't install:"
    grep -nE '^[[:space:]]*IgnorePkg' "$CONF" | sed 's/^/        /' >&2
  fi
  # An out-of-tree hid-asus DKMS source: Arch's DKMS hook adds every /usr/src/<name>-<version>
  # with a dkms.conf again on each kernel transaction, so 'dkms remove' alone doesn't stick (#87).
  local d base owner
  for d in /usr/src/*; do
    [[ -f $d/dkms.conf ]] || continue
    base=${d##*/}
    [[ ${base,,} == *hid[-_]asus* ]] || grep -qiE 'hid[-_]asus' "$d/dkms.conf" || continue
    if owner=$(pacman -Qqo "$d" 2>/dev/null) && [[ -n $owner ]]; then
      owner=${owner%%$'\n'*}
      warn "$d (package $owner) is an out-of-tree hid-asus DKMS source; the patched kernel has the fix"
      warn "built in: remove the package (sudo pacman -Rns $owner)."
    else
      warn "$d is an out-of-tree hid-asus DKMS source that no package owns. DKMS adds it again on every"
      warn "kernel update, even after dkms remove. Run 'sudo dkms remove ${base%-*}/${base##*-} --all', then move it"
      warn "out of /usr/src: 'sudo mkdir -p /usr/local/src/dkms-disabled && sudo mv $d /usr/local/src/dkms-disabled/'."
    fi
  done
}

install_key() {
  step "Trusting the repo key in pacman's keyring"
  as_root pacman-key --add "$TMP/key.asc"
  as_root pacman-key --lsign-key "$FPR"
}

install_snippet() {
  step "Writing $SNIPPET"
  local rest new
  rest=$(snippet_without_repo)
  if [[ -n ${rest//[[:space:]]/} ]]; then
    info "keeping the other repos already in $SNIPPET"
    new=$rest$'\n\n'$REPO_BLOCK
  else
    new=$REPO_BLOCK
  fi
  if [[ -f $SNIPPET && $(<"$SNIPPET") == "$new" ]]; then
    ok "already up to date"
  else
    write_root "$SNIPPET" "$new"
  fi
}

install_hook() {
  step "Installing the Omarchy pre-refresh hook"
  if [[ -f $HOOK && $(<"$HOOK") == "$HOOK_CONTENT" && -x $HOOK ]]; then
    ok "$HOOK already up to date"
  elif ((DRY_RUN)); then
    printf '    [dry-run] write %s (mode 755):\n%s\n' "$HOOK" "$HOOK_CONTENT"
  else
    mkdir -p "$HOOK_DIR"
    printf '%s\n' "$HOOK_CONTENT" >"$HOOK"
    chmod 755 "$HOOK"
    ok "wrote $HOOK"
  fi
  local other
  for other in "$HOOK_DIR"/*; do
    [[ -f $other && $other != "$HOOK" && $other != *.sample ]] || continue
    if grep -qF "$SNIPPET" "$other"; then
      warn "$other also inserts the $SNIPPET Include line. Hooks run in name order, so if it puts"
      warn "the line below [omarchy], the omarchy-asus builds lose to the stock ones. Remove it, or make"
      warn "it insert above whichever of [omarchy]/[core] comes first, like $HOOK does."
    fi
  done
}

# Apply the hook now. Deliberately not `omarchy refresh pacman`: that ends in
# `pacman -Syyuu --noconfirm`, which would upgrade before you saw the list.
# The result in /etc/pacman.conf is the same, and later refreshes run the hook.
apply_hook() {
  step "Adding the Include line to $CONF"
  local inc first
  inc=$(include_line)
  first=$(first_repo_line)
  if [[ -n $inc && $inc -lt $first ]]; then
    ok "already above the first of [omarchy]/[core] (line $inc)"
    return 0
  fi
  if [[ -n $inc ]]; then
    warn "the Include line is at line $inc, below [omarchy]/[core]; moving it up"
    # shellcheck disable=SC2016 # sed program, same as LAPTOP-SETUP.md section 5
    as_root sed -i '\|^Include = /etc/pacman.d/custom-repos.conf$|{$d;N;/\n$/d;D}' "$CONF"
  fi
  if ((DRY_RUN)); then
    as_root sed -i -E "0,/^\[(omarchy|core)\]$/s||$MARKER\n\n&|" "$CONF"
    return 0
  fi
  bash "$HOOK"
  inc=$(include_line)
  first=$(first_repo_line)
  [[ -n $inc && $inc -lt $first ]] || die "the Include line did not land above [omarchy]/[core]; check $CONF"
  ok "Include line at line $inc, above the first of [omarchy]/[core] (line $first)"
}

install_keyring() {
  step "Installing $KEYRING_PKG"
  info "This syncs the package databases (pacman -Sy) and installs only the keyring, the same way"
  info "Arch updates archlinux-keyring before a system upgrade."
  as_root pacman -Sy --needed --noconfirm "$KEYRING_PKG"
}

# One field (%NAME%, %VERSION%, %FILENAME%) of a package's desc file in the files database.
desc_field() { awk -v key="%$2%" '$0 == key { getline v; print v; exit }' "$1/desc"; }

# True when the /etc file at PATH is a regular file with the same bytes as PKG's copy.
same_as_packaged() {
  local pkg=$1 path=$2
  [[ -f $ROOT$path && ! -L $ROOT$path ]] || return 1
  if [[ -r $ROOT$path ]]; then
    bsdtar -xOf "$pkg" "${path#/}" | cmp -s - "$ROOT$path"
  elif ((!DRY_RUN)); then
    cmp -s <(bsdtar -xOf "$pkg" "${path#/}") <(sudo cat "$ROOT$path")
  else
    return 1
  fi
}

# Show how the /etc file at PATH differs from PKG's copy (at most 40 lines of diff).
show_difference() {
  local pkg=$1 path=$2 name=$3 line
  if [[ -L $ROOT$path ]]; then
    info "  a symlink (to $(readlink "$ROOT$path")), not a regular file"
  elif [[ ! -f $ROOT$path ]]; then
    info "  not a regular file"
  elif [[ ! -r $ROOT$path ]] && ((DRY_RUN)); then
    info "  not readable without sudo, so not compared under --dry-run"
  else
    # diff exits 1 on a difference, and head may close the pipe early.
    diff -u --label "$name's copy" --label "$path" <(bsdtar -xOf "$pkg" "${path#/}") \
      <(if [[ -r $ROOT$path ]]; then cat "$ROOT$path"; else sudo cat "$ROOT$path"; fi) 2>&1 |
      head -n 40 | while IFS= read -r line; do info "  $line"; done || true
  fi
}

# pacman refuses to install a file that already exists and no package owns, and it checks
# that before any scriptlet runs. `omarchy update` passes --overwrite only for
# /usr/share/omarchy/*, so an /etc file copied in by hand before a package shipped it (the
# asusd drop-in from LAPTOP-SETUP.md, for one) stops the whole upgrade. This finds those
# files for every installed package the repo upgrades, from the signed files database (so
# it also works under --dry-run, before pacman has the repo). A file identical to the
# signed package's copy goes into TAKEOVER, which run_upgrade hands over to the package;
# any other one stops the script here, before anything is overwritten.
check_unowned_etc() {
  step "Checking /etc for unowned files the upgrade would install"
  if [[ -z $FILES_DB ]]; then
    warn "could not check /etc files against the repo; if the upgrade stops on a file conflict, see LAPTOP-SETUP.md"
    return 0
  fi
  local dir name version installed path url pkg found=0
  local -a unowned different=()
  for dir in "$FILES_DB"/*/; do
    dir=${dir%/}
    [[ -f $dir/desc && -f $dir/files ]] || continue
    name=$(desc_field "$dir" NAME)
    version=$(desc_field "$dir" VERSION)
    [[ -n $name && -n $version ]] || continue
    installed=$(pacman -Q "$name" 2>/dev/null) || continue
    installed=${installed#* }
    [[ $(vercmp "$version" "$installed") == 1 ]] || continue
    unowned=()
    while IFS= read -r path; do
      path=/$path
      [[ -e $ROOT$path || -L $ROOT$path ]] || continue
      pacman -Qo "$path" >/dev/null 2>&1 && continue
      unowned+=("$path")
    done < <(awk '$0 == "%FILES%" { on = 1; next } /^%.*%$/ { on = 0 } on && /^etc\// && !/\/$/' "$dir/files")
    ((${#unowned[@]})) || continue
    found=1
    # -dd: only this package's URL, not its dependencies'. A cached package prints a
    # file:// URL, and under --dry-run pacman has no sync database for the repo yet: both
    # use the release URL instead.
    url=$(pacman -Sddp --print-format '%l' "$REPO/$name" 2>/dev/null) || url=''
    url=${url##*$'\n'}
    if [[ $url != https://* ]]; then
      url=$(desc_field "$dir" FILENAME)
      [[ -n $url ]] || die "the files database has no file name for $name"
      url=https://github.com/$GH_REPO/releases/download/x86_64/$url
    fi
    pkg=$TMP/${url##*/}
    if ! curl -fsSL --proto '=https' -o "$pkg" "$url" ||
      ! curl -fsSL --proto '=https' -o "$pkg.sig" "$url.sig"; then
      die "could not download $url to compare its /etc files; nothing was changed"
    fi
    if ! gpgv --keyring "$TMP/key.gpg" "$pkg.sig" "$pkg" 2>/dev/null; then
      die "the signature of ${url##*/} does not verify with key $FPR"
    fi
    for path in "${unowned[@]}"; do
      if same_as_packaged "$pkg" "$path"; then
        TAKEOVER+=("$path")
        info "$path: not owned by any package and identical to $name's copy; the upgrade takes it over"
      else
        different+=("$path")
        info "$path: not owned by any package and different from $name's copy:"
        show_difference "$pkg" "$path" "$name"
      fi
    done
  done
  if ((${#different[@]})); then
    die "these files are not owned by any package, differ from the packaged copies and would stop the upgrade:
$(printf '         %s\n' "${different[@]}")
       Nothing was changed in /etc and the system is not upgraded (the package databases are
       synced, so don't install anything else first). Move or delete each file (or make it
       match the packaged copy), then run this script again."
  fi
  ((found)) || ok "no unowned /etc files in the way of the upgrade"
}

# Where run_upgrade keeps the files it moves aside. Outside the live directory, as in
# Omarchy's omarchy-update-system-pkgs-when-conflicted: systemd reads a copy left beside it.
REPLACED=/var/lib/omarchy-asus/replaced

# Settle the files run_upgrade moved aside: where the upgrade installed the package's copy,
# the saved one goes; where the path is still missing, the saved copy goes back. Runs after
# the upgrade, and from the traps when the script stops during it.
restore_moved() {
  local p saved
  for p in "${MOVED[@]}"; do
    saved=$ROOT$REPLACED$p
    if [[ -e $ROOT$p || -L $ROOT$p ]]; then
      as_root rm -f "$saved" || warn "could not remove the saved copy $saved"
      ok "took over $p (identical to the packaged copy)"
    elif as_root mv -T "$saved" "$ROOT$p"; then
      warn "put back $p (the upgrade didn't install it)"
    else
      warn "could not put back $p; the saved copy is $saved"
    fi
  done
  MOVED=()
}

# The upgrade goes through `omarchy update`, not a bare `pacman -Su`: since
# Omarchy 4.0.5 a pacman hook (omarchy-update-pacman-guard) aborts direct system
# upgrades, and `omarchy update` also takes the snapshot, updates the keyrings
# and runs the migrations. It asks for its own confirmation. Without Omarchy's
# updater, fall back to pacman with the guard's documented override.
# The files in TAKEOVER (see check_unowned_etc) go to the package: pacman gets an
# --overwrite for each, and since `omarchy update` takes no pacman arguments, they are
# moved aside for it instead and put back if the upgrade doesn't install them.
run_upgrade() {
  local p rc=0
  if command -v omarchy-update >/dev/null; then
    if ((DRY_RUN)); then
      for p in "${TAKEOVER[@]}"; do
        as_root mkdir -p "$ROOT$REPLACED${p%/*}"
        as_root mv -T "$ROOT$p" "$ROOT$REPLACED$p"
      done
      info "[dry-run] omarchy update"
      return 0
    fi
    trap 'restore_moved; exit 130' INT TERM
    for p in "${TAKEOVER[@]}"; do
      info "moving $p aside to $REPLACED$p for the upgrade"
      as_root mkdir -p "$ROOT$REPLACED${p%/*}"
      as_root mv -T "$ROOT$p" "$ROOT$REPLACED$p"
      MOVED+=("$p")
    done
    omarchy update <"$TTY" || rc=$?
    restore_moved
    trap - INT TERM
    return "$rc"
  else
    local overwrite=()
    for p in "${TAKEOVER[@]}"; do overwrite+=(--overwrite "$p"); done
    as_root env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Su "${overwrite[@]}"
  fi
}

# A power manager of your own (rog-power) and the packaged profile switching would both act
# on every plug and unplug. The patched omarchy-powerprofiles-set stands back when Omarchy's
# powerprofiles-autoswitch-off toggle is set; set it before the upgrade runs the migrations.
POWER_TOGGLE=$HOME/.local/state/omarchy/toggles/powerprofiles-autoswitch-off
own_power_manager() {
  local unit
  for unit in "$HOME/.config/systemd/user/rog-power.service" /etc/systemd/user/rog-power.service \
    /etc/systemd/system/rog-power.service; do
    [[ -f $unit ]] && { echo "$unit"; return 0; }
  done
  return 1
}

prepare_power_owner() {
  local unit
  unit=$(own_power_manager) || return 0
  step "Your own power manager"
  if [[ -e $POWER_TOGGLE ]]; then
    ok "${unit/#$HOME/\~} found and Omarchy's powerprofiles-autoswitch-off toggle is already set"
    return 0
  fi
  info "${unit/#$HOME/\~} manages your power profile. The patched Omarchy also switches it on"
  info "every charger change; with both, they would fight. Setting Omarchy's"
  info "powerprofiles-autoswitch-off toggle keeps yours in charge (delete the file to hand over)."
  if confirm "Keep your power manager in charge (set the toggle)?"; then
    if ((DRY_RUN)); then
      info "[dry-run] would run: mkdir -p ${POWER_TOGGLE%/*} && touch $POWER_TOGGLE"
    else
      mkdir -p "${POWER_TOGGLE%/*}" && touch "$POWER_TOGGLE" && ok "set ${POWER_TOGGLE/#$HOME/\~}"
    fi
  else
    warn "not set: stop ${unit##*/} yourself, or both will switch profiles on plug and unplug."
  fi
}

# A hand-made Win-lock setup has up to four local pieces next to what asus-rog-nkey-winlock
# installs: a unit in ~/.config/systemd/user that shadows the packaged one in
# /usr/lib/systemd/user, its drop-in dir (which still applies to the packaged unit), the
# <target>.wants link that enabled it (dangling once the unit moves), and a udev rule in
# /etc/udev/rules.d next to the packaged 70-g16-winlock-hidraw.rules. Once the package is
# installed, offer to move them aside. Nothing is deleted except a dangling link.
WINLOCK_LOCAL=$HOME/.config/systemd/user/g16-winlock.service
WINLOCK_DROPIN=$WINLOCK_LOCAL.d
WINLOCK_UDEV_DIR=/etc/udev/rules.d
WINLOCK_LOCAL_BIN=$HOME/.local/bin/g16-winlock

# The backup name for a path: <path>.before-omarchy-asus, or the first free
# <path>.before-omarchy-asus.N after it, so an earlier backup is never overwritten.
aside_path() {
  local base=$1.before-omarchy-asus n=1
  if [[ ! -e $base && ! -L $base ]]; then
    echo "$base"
    return 0
  fi
  while [[ -e $base.$n || -L $base.$n ]]; do n=$((n + 1)); done
  echo "$base.$n"
}

retire_local_winlock() {
  pacman -Q asus-rog-nkey-winlock >/dev/null 2>&1 || ((DRY_RUN)) || return 0
  local unit='' dropin='' links=() rules=() files=() undo=() l f p a line moved_rule=0
  local comment='^[[:space:]]*([#;]|$)'
  if [[ -f $WINLOCK_LOCAL && ! -L $WINLOCK_LOCAL ]]; then unit=$WINLOCK_LOCAL; fi
  # Links that enabled the local unit: dangling ones, or ones that resolve to it. A link to
  # the packaged unit is the package's own enablement and stays.
  for l in "$HOME"/.config/systemd/user/*.wants/g16-winlock.service; do
    [[ -L $l ]] || continue
    if [[ ! -e $l ]] || [[ -n $unit && $l -ef $unit ]]; then links+=("$l"); fi
  done
  # The drop-in only belongs to a hand-made setup when one is still here, or when an older
  # version of this script moved the unit aside but not the drop-in. The G16 Control widget
  # writes the same mode.conf for the packaged unit; that one stays.
  if [[ -d $WINLOCK_DROPIN ]]; then
    if [[ -n $unit ]] || ((${#links[@]})) ||
      { compgen -G "$WINLOCK_LOCAL.before-omarchy-asus*" >/dev/null &&
        ! compgen -G "$WINLOCK_DROPIN.before-omarchy-asus*" >/dev/null; }; then
      dropin=$WINLOCK_DROPIN
    fi
  fi
  for f in "$WINLOCK_UDEV_DIR"/*g16-winlock*.rules; do
    if [[ -f $f && ! -L $f ]]; then rules+=("$f"); fi
  done
  [[ -n $unit$dropin ]] || ((${#links[@]} + ${#rules[@]})) || return 0

  step "Your local Win-lock setup"
  info "These shadow or duplicate what asus-rog-nkey-winlock now installs:"
  if [[ -n $unit ]]; then
    info "  ${unit/#$HOME/\~}: your own unit, used instead of the packaged one"
  fi
  if [[ -n $dropin ]]; then
    info "  ${dropin/#$HOME/\~}/: your drop-in, which still applies to the packaged unit:"
    for f in "$dropin"/*.conf; do
      [[ -f $f ]] || continue
      info "    ${f##*/}:"
      while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ $comment ]] && continue
        info "      $line"
      done <"$f"
    done
  fi
  for l in "${links[@]}"; do
    info "  ${l/#$HOME/\~}: the link that enabled your unit"
  done
  for f in "${rules[@]}"; do
    info "  $f: your udev rule, next to the packaged 70-g16-winlock-hidraw.rules"
  done
  if [[ -f $WINLOCK_LOCAL_BIN && -x $WINLOCK_LOCAL_BIN ]]; then
    warn "${WINLOCK_LOCAL_BIN/#$HOME/\~} shadows /usr/bin/g16-winlock on your PATH when you run"
    warn "g16-winlock by hand. It is left in place; remove it to use the packaged one."
  fi

  if [[ -n $unit$dropin ]] || ((${#links[@]})); then
    if confirm "Move your local Win-lock unit, its drop-in and links aside so the packaged unit is used?"; then
      if [[ -n $unit ]]; then
        files+=("$unit")
        # Before the move, so systemd removes the links it made for the local unit itself.
        if ((DRY_RUN)); then
          info "[dry-run] would run: systemctl --user disable g16-winlock.service"
        else
          systemctl --user disable g16-winlock.service 2>/dev/null || true
        fi
      fi
      if [[ -n $dropin ]]; then files+=("$dropin"); fi
      for p in "${files[@]}"; do
        a=$(aside_path "$p")
        if ((DRY_RUN)); then
          info "[dry-run] would run: mv ${p/#$HOME/\~} ${a/#$HOME/\~}"
        elif ! mv "$p" "$a"; then
          warn "could not move ${p/#$HOME/\~}; it stays in place"
          continue
        fi
        undo+=("${p/#$HOME/\~} -> ${a##*/}; undo: mv ${a/#$HOME/\~} ${p/#$HOME/\~}")
      done
      for l in "${links[@]}"; do
        if ((DRY_RUN)); then
          info "[dry-run] would run: rm ${l/#$HOME/\~}"
        elif [[ -L $l && ! -e $l ]]; then
          rm -f "$l" || { warn "could not remove ${l/#$HOME/\~}"; continue; }
        elif [[ -L $l ]]; then
          continue # still resolves: the unit it points at did not move
        fi
        undo+=("${l/#$HOME/\~} removed; undo: systemctl --user enable g16-winlock.service (after moving the unit back)")
      done
      if ((DRY_RUN)); then
        info "[dry-run] would run: systemctl --user daemon-reload, try-restart g16-winlock.service"
      else
        systemctl --user daemon-reload 2>/dev/null || true
        # A running local instance keeps its old ExecStart and drop-in until it restarts.
        systemctl --user try-restart g16-winlock.service 2>/dev/null || true
      fi
    else
      warn "kept: your local unit stays in charge of Win-lock."
    fi
  fi

  # A separate question: this one needs sudo. udev reads only *.rules, so the
  # .before-omarchy-asus suffix is enough to stop it.
  if ((${#rules[@]})); then
    if confirm "Move ${rules[*]} aside (needs sudo)? The packaged 70-g16-winlock-hidraw.rules does the same."; then
      for f in "${rules[@]}"; do
        a=$(aside_path "$f")
        if as_root mv "$f" "$a"; then
          moved_rule=1
          undo+=("$f -> ${a##*/}; undo: sudo mv $a $f && sudo udevadm control --reload")
        else
          warn "could not move $f; it stays in place"
        fi
      done
      if ((moved_rule)); then
        as_root udevadm control --reload || warn "udevadm control --reload failed; the old rule applies until a reboot"
        as_root udevadm trigger --subsystem-match=hidraw --action=add || warn "udevadm trigger failed"
      fi
    else
      warn "kept: ${rules[*]} still applies next to the packaged rule."
    fi
  fi

  if ((${#undo[@]})); then
    if ((DRY_RUN)); then info "[dry-run] would move aside:"; else ok "moved aside:"; fi
    for line in "${undo[@]}"; do info "  $line"; done
  fi
  return 0
}

offer_upgrade() {
  step "What the system upgrade would change"
  if ((DRY_RUN)); then
    info "[dry-run] would list: pacman -Qu, with the packages coming from [$REPO] marked"
    confirm "Upgrade now?"
    run_upgrade
    return 0
  fi
  local repo_pkgs updates name
  repo_pkgs=" $(pacman -Slq "$REPO" 2>/dev/null | tr '\n' ' ') "
  updates=$(pacman -Qu 2>/dev/null || true)
  if [[ -z $updates ]]; then
    ok "nothing to upgrade"
    return 0
  fi
  while read -r name _; do
    if [[ $repo_pkgs == *" $name "* ]]; then
      printf '    %s[%s]%s %s\n' "$B" "$REPO" "$N" "$(grep -m1 "^$name " <<<"$updates")"
    else
      printf '                   %s\n' "$(grep -m1 "^$name " <<<"$updates")"
    fi
  done <<<"$updates"
  if confirm "Upgrade now with 'omarchy update'? (it asks once more before it starts)"; then
    run_upgrade
  else
    warn "not upgraded. The package databases are synced but the system is not upgraded:"
    warn "run 'omarchy update' before you install anything else."
  fi
}

# Optional last step: the G16 fix packages, then the fixes that live in your own
# config or in /etc (omarchy-asus-g16-apply). Nothing happens unless you say yes,
# and omarchy-asus-g16-apply leaves alone any fix you already have in your own form.
offer_g16_fixes() {
  step "Optional: G16 fixes for a fresh install"
  # omarchy-asus-g16-apply runs only on a GA605KM (its own DMI check, the same
  # as omarchy-hw-match GA605KM) unless it gets --force.
  local product family apply_opts=()
  product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
  family=$(cat /sys/class/dmi/id/product_family 2>/dev/null || true)
  if [[ ${product,,} != *ga605km* && ${family,,} != *ga605km* ]]; then
    if ((FORCE)); then
      warn "not a GA605KM; passing --force to omarchy-asus-g16-apply because of --force"
      apply_opts=(--force)
    else
      info "skipped: these fixes are for the GA605KM ('$product')"
      return 0
    fi
  fi
  info "Packages: ${G16_PKGS[*]}. omarchy-asus-g16-apply then lists the fixes that"
  info "live in your config or /etc (video decode on the iGPU, HDMI cursor, speaker level, rtkit,"
  info "asusd, Win-lock service) and applies the missing ones. Settings you already have are kept."
  if ((DRY_RUN)); then
    confirm "Install them and review the fixes?"
    as_root pacman -S --needed "${G16_PKGS[@]}"
    retire_local_winlock
    info "[dry-run] would run: omarchy-asus-g16-apply ${apply_opts[*]} --check, ask, then omarchy-asus-g16-apply ${apply_opts[*]} --yes"
    return 0
  fi
  if [[ -n $(pacman -Qu 2>/dev/null) ]]; then
    warn "the system isn't fully upgraded, and installing packages now would be a partial upgrade."
    warn "Later: 'omarchy update', then 'sudo pacman -S ${G16_PKGS[*]}' and 'omarchy-asus-g16-apply'."
    return 0
  fi
  local available=() pkg rc=0
  for pkg in "${G16_PKGS[@]}"; do
    if pacman -Si "$REPO/$pkg" >/dev/null 2>&1; then
      available+=("$pkg")
    else
      warn "$pkg is not in the $REPO repo yet; skipping it"
    fi
  done
  ((${#available[@]})) || return 0
  if ! confirm "Install ${available[*]} and review the fixes?"; then
    info "skipped. Later: 'sudo pacman -S ${G16_PKGS[*]}', then 'omarchy-asus-g16-apply'."
    return 0
  fi
  as_root pacman -S --needed "${available[@]}" || { warn "install failed; skipping the fixes"; return 0; }
  retire_local_winlock
  command -v omarchy-asus-g16-apply >/dev/null || return 0
  omarchy-asus-g16-apply "${apply_opts[@]}" --check || rc=$?
  if ((rc == 10)); then
    if confirm "Apply the missing default fixes listed above?"; then
      omarchy-asus-g16-apply "${apply_opts[@]}" --yes || warn "some fixes failed; run 'omarchy-asus-g16-apply' again to retry"
    else
      info "skipped. Run 'omarchy-asus-g16-apply' whenever you like ('--check' changes nothing)."
    fi
  elif ((rc == 0)); then
    ok "every default fix is in place"
  fi
}

do_install() {
  banner
  check_user
  check_model
  preflight_warnings
  confirm "Switch this machine to the EXPERIMENTAL omarchy-asus repo?" || die "cancelled"
  fetch_key
  preview_repo
  install_key
  install_snippet
  install_hook
  apply_hook
  install_keyring
  prepare_power_owner
  check_unowned_etc
  offer_upgrade
  offer_g16_fixes
  step "Done"
  info "Later 'omarchy refresh pacman' runs keep the repo in place through the hook."
  info "Undo with: $SELF --uninstall"
}

# Installed packages that come from the repo, without the keyring (removed on its own):
# the repo's package list against the installed ones, plus any installed REPO_ONLY_PKGS
# in case the repo database isn't synced.
repo_installed() {
  local pkg
  {
    comm -12 <(pacman -Slq "$REPO" 2>/dev/null | sort -u) <(pacman -Qq 2>/dev/null | sort -u) || true
    for pkg in "${REPO_ONLY_PKGS[@]}"; do
      if pacman -Q "$pkg" >/dev/null 2>&1; then echo "$pkg"; fi
    done
  } | sort -u | grep -vxF "$KEYRING_PKG" || true
}

# After going back: the packages from the repo that no other repo has. Once the repo is
# gone they never update. Removing them is offered, defaulting to no.
offer_leftover_removal() {
  local snapshot=("$@") leftovers=() elsewhere sl pkg
  step "Packages only the $REPO repo had"
  # Without a full listing, stock replacements (linux-omarchy) would look repo-only.
  if ! sl=$(pacman -Sl 2>/dev/null) || [[ -z $sl ]]; then
    warn "could not list the configured repos (pacman -Sl); skipping the leftover check."
    return 0
  fi
  elsewhere=" $(awk -v repo="$REPO" '$1 != repo { print $2 }' <<<"$sl" | tr '\n' ' ') "
  for pkg in "${snapshot[@]}"; do
    [[ $elsewhere == *" $pkg "* ]] && continue
    pacman -Q "$pkg" >/dev/null 2>&1 || continue
    leftovers+=("$pkg")
  done
  if ((${#leftovers[@]} == 0)); then
    ok "none installed"
    return 0
  fi
  info "These came from the $REPO repo, have no stock build, and no longer get updates:"
  for pkg in "${leftovers[@]}"; do
    info "  $pkg"
  done
  if [[ " ${leftovers[*]} " == *" omarchy-asus-g16 "* ]]; then
    info "omarchy-asus-g16 sets HibernateMode=shutdown; removing it restores the stock hibernate mode."
  fi
  if confirm "Remove them with 'pacman -Rns'?"; then
    as_root env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Rns "${leftovers[@]}" ||
      warn "could not remove them. Run 'sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Rns ${leftovers[*]}' to retry."
  else
    info "kept. Remove them later with 'sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Rns ${leftovers[*]}'."
  fi
}

do_uninstall() {
  check_user
  local snapshot=()
  mapfile -t snapshot < <(repo_installed)
  step "Removing the omarchy-asus repo"
  info "This removes the hook, the repo section, the keyring package and the key, then runs"
  info "pacman -Syuu so the omarchy-asus builds go back to the stock ones. Before that it warns"
  info "about the stock NVIDIA driver's hibernate hang; afterwards it lists the packages only"
  info "the repo had and offers to remove them (default no)."
  confirm "Continue?" || die "cancelled"

  step "Removing the pre-refresh hook"
  if [[ -e $HOOK ]]; then
    if ((DRY_RUN)); then info "[dry-run] rm $HOOK"; else rm -f "$HOOK" && ok "removed $HOOK"; fi
  else
    ok "not present"
  fi

  step "Removing the repo from $SNIPPET and $CONF"
  local rest
  rest=$(snippet_without_repo)
  if [[ -n ${rest//[[:space:]]/} ]]; then
    info "other repos remain in $SNIPPET; keeping the file and its Include line"
    [[ $(<"$SNIPPET") == "$rest" ]] || write_root "$SNIPPET" "$rest"
  else
    if grep -qxF "$MARKER" "$CONF"; then
      # shellcheck disable=SC2016 # sed program, same as LAPTOP-SETUP.md section 5
      as_root sed -i '\|^Include = /etc/pacman.d/custom-repos.conf$|{$d;N;/\n$/d;D}' "$CONF"
    fi
    if [[ -e $SNIPPET ]]; then as_root rm -f "$SNIPPET"; else ok "$SNIPPET not present"; fi
  fi

  step "Removing $KEYRING_PKG and the repo key"
  if pacman -Q "$KEYRING_PKG" >/dev/null 2>&1; then
    as_root pacman -R --noconfirm "$KEYRING_PKG"
  fi
  as_root pacman-key --delete "$FPR" || warn "key $FPR was not in pacman's keyring"

  # `omarchy update` runs pacman -Syu, which never downgrades, so this one
  # transaction bypasses Omarchy's update guard with its documented override.
  step "Going back to the stock builds"
  if ((DRY_RUN)) || [[ " ${snapshot[*]} " == *" nvidia-open-dkms "* ]] || pacman -Q nvidia-open-dkms >/dev/null 2>&1; then
    warn "the stock nvidia-open-dkms lacks the NVIDIA/open-gpu-kernel-modules#1412 fix. On a GA605KM the"
    warn "machine can hang at power-off after writing the hibernate image (omarchy-asus #11)."
    warn "Suspend-then-hibernate is the default lid action, so the battery can drain overnight."
    warn "To avoid it, keep a locally patched driver (for example, add nvidia-open-dkms to IgnorePkg"
    warn "in $CONF before going back), or disable hibernation until #1412 lands."
  fi
  if confirm "Run 'pacman -Syuu' now? (-uu downgrades the omarchy-asus builds to stock)"; then
    as_root env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syuu
  else
    warn "skipped. Run 'sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syuu' to go back to the stock builds."
  fi

  offer_leftover_removal "${snapshot[@]}"
}

# Tests source this file to call its functions; they stop here, before anything runs.
[[ ${OMARCHY_ASUS_SETUP_SOURCE_ONLY:-0} == 1 ]] && return 0

((DRY_RUN)) && printf '%s(dry run: privileged commands and file writes are printed, not run)%s\n' "$Y" "$N"
case $MODE in
  install) do_install ;;
  uninstall) do_uninstall ;;
esac
