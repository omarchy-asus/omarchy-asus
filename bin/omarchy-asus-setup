#!/bin/bash
# omarchy-asus-setup: switch a stock Omarchy install on an ASUS ROG Zephyrus G16
# GA605 to the EXPERIMENTAL omarchy-asus pacman repo (or back, with --uninstall).
#
# Run it as your normal user; it calls sudo for the privileged steps. It does
# the same thing as the manual steps in LAPTOP-SETUP.md, with the same file
# contents, and is safe to run again.
#
#   omarchy-asus-setup               set up the repo, then offer the upgrade and the G16 fixes
#   omarchy-asus-setup --uninstall   undo it and go back to the stock builds
#   omarchy-asus-setup --dry-run     print every privileged command instead of running it
#   omarchy-asus-setup --force       skip the GA605 model check, and upgrade even when no snapshot could be taken
#
# Our channels are pinned to Omarchy's: quattro (the x86_64 release) goes with Omarchy stable,
# rc (the rc-x86_64 release) with Omarchy rc. A first setup picks the one that matches the
# machine's Omarchy channel. To switch later, run Omarchy's own 'omarchy-channel-set rc' or
# 'omarchy-channel-set stable': the pre-refresh hook this script installs moves
# [omarchy-asus] with it.
set -euo pipefail

REPO=omarchy-asus
FPR=0B44FF7CCDD929F61BE4A2E436FE6B28AB24EC88
GH_REPO=omarchy-asus/omarchy-asus
GH_BRANCH=main
KEY_URL=https://raw.githubusercontent.com/$GH_REPO/$GH_BRANCH/keys/omarchy-asus.asc
KEYRING_PKG=omarchy-asus-keyring
# Offered as the optional last step on a fresh install.
G16_PKGS=(omarchy-asus-g16 asus-rog-nkey-winlock omarchy-asus-g16-apply)
# Packages only the repo ships (no stock build): left behind by --uninstall unless removed.
# Not hyprpm: recipes/hyprland builds it as a split package of stock hyprland, which has one
# too (repo_installed still finds it through the repo's package list).
REPO_ONLY_PKGS=(omarchy-asus-g16 omarchy-asus-g16-apply asus-rog-nkey-winlock asus-zephyrus-g16-control)

# The overrides exist for the offline test (tests/ci/setup-uninstall.sh).
CONF=${OMARCHY_ASUS_PACMAN_CONF:-/etc/pacman.conf}
SNIPPET=${OMARCHY_ASUS_CUSTOM_REPOS:-/etc/pacman.d/custom-repos.conf}
MARKER="Include = $SNIPPET"
HOOK_DIR=$HOME/.config/omarchy/hooks/pre-refresh-pacman.d
HOOK=$HOOK_DIR/add-omarchy-asus-repo

# Release channels (README "Release channels"): each of ours rides one of Omarchy's.
channel_tag() { case $1 in quattro) echo x86_64 ;; rc) echo rc-x86_64 ;; *) return 1 ;; esac; }
channel_omarchy() { case $1 in quattro) echo stable ;; rc) echo rc ;; *) return 1 ;; esac; }

# The repo section of /etc/pacman.d/custom-repos.conf for a channel (LAPTOP-SETUP.md section 2).
repo_block() {
  local prefix=''
  [[ $1 == quattro ]] || prefix=$1-
  # shellcheck disable=SC2016 # $arch is expanded by pacman, not by this script
  printf '[%s]\nSigLevel = Required\nServer = https://github.com/%s/releases/download/%s$arch' \
    "$REPO" "$GH_REPO" "$prefix"
}

# The pre-refresh hook (LAPTOP-SETUP.md section 3). Omarchy runs it after every rewrite of
# pacman.conf (omarchy refresh pacman, omarchy-channel-set) and before the
# pacman -Syyuu, so a channel switch is Omarchy's omarchy-channel-set alone (#201).
HOOK_CONTENT=$(
  cat <<'HOOK'
#!/bin/bash
# Put the omarchy-asus repo ahead of every other repo so its patched builds win
# over the stock ones, on the channel that matches Omarchy's: Omarchy stable gets
# the x86_64 release, Omarchy rc the rc-x86_64 one. See LAPTOP-SETUP.md in
# https://github.com/omarchy-asus/omarchy-asus.
CONF=/etc/pacman.conf
SNIPPET=/etc/pacman.d/custom-repos.conf
MARKER="Include = $SNIPPET"
RELEASES=https://github.com/omarchy-asus/omarchy-asus/releases/download/

[[ -r $SNIPPET ]] || exit 0

# pacman allows blanks around section names, keys and "=": the first Server of section $1 in $2.
server() {
  sed -n "/^[[:space:]]*\[$1\][[:space:]]*\$/,/^[[:space:]]*\[/s/^[[:space:]]*Server[[:space:]]*=[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*\$/\1/p" "$2" | head -n1
}

# Omarchy's hook runner reports a failed hook and goes on to pacman -Syyuu, which without
# our repo (or on the wrong channel) replaces our builds with stock ones. So a failure
# stops the omarchy-refresh-pacman this hook runs under, before that upgrade.
stop() {
  echo "omarchy-asus: $1" >&2
  local pid=$PPID args
  while [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)); do
    args=$(ps -o args= -p "$pid" 2>/dev/null) || break
    if [[ $args == *omarchy-refresh-pacman* ]]; then
      echo "omarchy-asus: stopping the refresh before its pacman -Syyuu; fix this and run the same command again" >&2
      kill -TERM "$pid"
      break
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
  done
  exit 1
}

case $(server omarchy "$CONF") in
  */stable/*) want=${RELEASES}\$arch ;;
  */rc/*) want=${RELEASES}rc-\$arch ;;
  *) want='' ;;
esac
have=$(server omarchy-asus "$SNIPPET")
new_server=''
if [[ $have == "$RELEASES"* ]]; then
  if [[ -z $want ]]; then
    echo "omarchy-asus: [omarchy] is on neither Omarchy stable nor rc; [omarchy-asus] stays on $have" >&2
  elif [[ $have != "$want" ]]; then
    new_server=$want
  fi
fi
new_include=''
grep -qxF "$MARKER" "$CONF" || new_include=$MARKER
[[ -n $new_server || -n $new_include ]] || exit 0

# One sudo for both: Omarchy 4.5 runs hooks with sudo -N, which asks every time.
sudo bash -c '
  if [[ -n $3 ]]; then
    sed -i "/^[[:space:]]*\[omarchy-asus\][[:space:]]*\$/,/^[[:space:]]*\[/s|^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://github.com/omarchy-asus/omarchy-asus/releases/download/.*|Server = $3|" "$2" || exit 1
  fi
  if [[ -n $4 ]]; then
    sed -i -E "0,/^[[:space:]]*\[(omarchy|core)\][[:space:]]*\$/s||$4\n\n&|" "$1" || exit 1
  fi' _ "$CONF" "$SNIPPET" "$new_server" "$new_include" || stop "could not update $SNIPPET and $CONF"
[[ -z $new_server || $(server omarchy-asus "$SNIPPET") == "$new_server" ]] ||
  stop "[omarchy-asus] in $SNIPPET is not on $new_server"
grep -qxF "$MARKER" "$CONF" || stop "the line '$MARKER' is missing from $CONF"
HOOK
)

DRY_RUN=0
FORCE=0
MODE=install
CHANNEL_ARG=''

# Test hooks, set only by tests/ci/omarchy-asus-setup-etc-takeover.sh: ROOT prefixes the
# /etc paths the takeover checks and moves (pacman always gets the real path), TTY stands
# in for the terminal.
ROOT=${OMARCHY_ASUS_SETUP_ROOT:-}
TTY=${OMARCHY_ASUS_SETUP_TTY:-/dev/tty}
# Also test hooks, for tests/ci/setup-way-back.sh: the boot menu the fallback kernel check
# reads, and the snapper config take_snapshot needs. And for
# tests/ci/setup-retire-dkms-source.sh: where DKMS sources live, and where an unowned
# hid-asus source is moved aside to.
LIMINE_CONF=${OMARCHY_ASUS_LIMINE_CONF:-$ROOT/boot/limine.conf}
SNAPPER_CONFIG=${OMARCHY_ASUS_SNAPPER_CONFIG:-$ROOT/etc/snapper/configs/root}
DKMS_SRC_ROOT=${OMARCHY_ASUS_DKMS_SRC_ROOT:-$ROOT/usr/src}
DKMS_DISABLED_DIR=${OMARCHY_ASUS_DKMS_DISABLED_DIR:-$ROOT/usr/local/src/dkms-disabled}

# Under `curl ... | bash`, $0 is "bash", not this file: fall back to the URL.
if [[ -f $0 ]]; then
  SELF=$0
else
  SELF="curl -fsSL https://raw.githubusercontent.com/$GH_REPO/$GH_BRANCH/bin/omarchy-asus-setup | bash -s --"
fi

usage() {
  if [[ -f $0 ]]; then
    sed -n '2,19s/^# \{0,1\}//p' "$0"
  else
    echo "usage: omarchy-asus-setup [--uninstall] [--dry-run] [--force]"
  fi
}

while (($#)); do
  case $1 in
    --uninstall) MODE=uninstall ;;
    --dry-run) DRY_RUN=1 ;;
    --force) FORCE=1 ;;
    --channel)
      MODE=channel CHANNEL_ARG=${2:-}
      [[ $CHANNEL_ARG == -* ]] && CHANNEL_ARG=''
      [[ -n $CHANNEL_ARG ]] && shift
      ;;
    -h | --help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

# Prefixed names: tests source this file, and one-letter globals would clobber theirs.
if [[ -t 1 ]]; then
  CLR_BOLD=$'\e[1m' CLR_RED=$'\e[31m' CLR_YELLOW=$'\e[33m' CLR_GREEN=$'\e[32m' CLR_OFF=$'\e[0m'
else
  CLR_BOLD='' CLR_RED='' CLR_YELLOW='' CLR_GREEN='' CLR_OFF=''
fi
step() { printf '\n%s==> %s%s\n' "$CLR_BOLD" "$*" "$CLR_OFF"; }
info() { printf '    %s\n' "$*"; }
ok() { printf '    %sok:%s %s\n' "$CLR_GREEN" "$CLR_OFF" "$*"; }
warn() { printf '    %swarning:%s %s\n' "$CLR_YELLOW" "$CLR_OFF" "$*" >&2; }
die() { printf '%serror:%s %s\n' "$CLR_RED" "$CLR_OFF" "$*" >&2; exit 1; }

# Privileged command: run through sudo, or print it under --dry-run.
as_root() {
  if ((DRY_RUN)); then
    local arg q="'\\''" line='    [dry-run] sudo'
    for arg in "$@"; do
      if [[ $arg =~ ^[A-Za-z0-9_./=:@%+-]+$ ]]; then line+=" $arg"; else line+=" '${arg//\'/$q}'"; fi
    done
    printf '%s\n' "$line"
  else
    sudo "$@"
  fi
}

# Write CONTENT to a root-owned FILE (mode 644), or show it under --dry-run.
write_root() {
  local file=$1 content=$2
  if ((DRY_RUN)); then
    printf '    [dry-run] sudo tee %s <<EOF\n%s\nEOF\n' "$file" "$content"
  else
    printf '%s\n' "$content" | sudo tee "$file" >/dev/null
    sudo chmod 644 "$file"
  fi
}

# Ask a yes/no question on the terminal (works under `curl | bash` too).
confirm() {
  if ((DRY_RUN)); then
    printf '    %s [y/N] [dry-run: assuming yes]\n' "$1"
    return 0
  fi
  local answer
  [[ -r $TTY ]] || die "no terminal to ask for confirmation on"
  read -r -p "    $1 [y/N] " answer <"$TTY"
  [[ $answer == [yY] || $answer == [yY][eE][sS] ]]
}

# The unpacked files database (empty: not available), the unowned /etc files the upgrade
# takes over, and the ones run_upgrade has moved aside while it runs.
FILES_DB=''
TAKEOVER=()
MOVED=()

TMP=$(mktemp -d)
# restore_moved puts back any /etc file still moved aside when the script stops early.
trap 'restore_moved || true; rm -rf "$TMP"' EXIT

# custom-repos.conf without our section (other repos the user keeps there stay).
snippet_without_repo() {
  [[ -f $SNIPPET ]] || return 0
  awk -v sec="[$REPO]" '$0 == sec { skip = 1; next } /^\[/ { skip = 0 } !skip' "$SNIPPET"
}

# Omarchy's channel, from the [omarchy] server in pacman.conf (as omarchy-version-channel
# reads it): stable, rc, edge or unknown.
omarchy_channel() {
  local server
  server=$(awk '/^\[/ { sec = $0; next } sec == "[omarchy]" && /^[[:space:]]*Server[[:space:]]*=/ { print; exit }' "$CONF")
  case $server in
    *pkgs.omarchy.org/stable/*) echo stable ;;
    *pkgs.omarchy.org/rc/*) echo rc ;;
    *pkgs.omarchy.org/edge/*) echo edge ;;
    *) echo unknown ;;
  esac
}

# Our channel, from the [omarchy-asus] server in custom-repos.conf: quattro, rc, other or none.
asus_channel() {
  [[ -f $SNIPPET ]] || { echo none; return 0; }
  local server
  server=$(awk -v sec="[$REPO]" '/^\[/ { on = ($0 == sec); seen = seen || on; next }
    on && /^[[:space:]]*Server[[:space:]]*=/ { print; exit } END { if (!seen) print "none" }' "$SNIPPET")
  case $server in
    none) echo none ;;
    */releases/download/rc-\$arch) echo rc ;;
    */releases/download/\$arch) echo quattro ;;
    *) echo other ;;
  esac
}

# use_channel NAME: the release, database URL and repo section of our channel NAME.
use_channel() {
  CHANNEL=$1
  GH_TAG=$(channel_tag "$CHANNEL")
  DB_URL=https://github.com/$GH_REPO/releases/download/$GH_TAG/$REPO.db
  REPO_BLOCK=$(repo_block "$CHANNEL")
}
use_channel quattro

# The channel this run sets up: the one that matches Omarchy's.
set_channel() {
  case $(omarchy_channel) in
    rc) use_channel rc ;;
    stable) use_channel quattro ;;
    *)
      use_channel quattro
      warn "[omarchy] is on neither Omarchy's stable nor its rc channel; using our quattro channel (Omarchy stable)"
      ;;
  esac
}

# Line numbers of the Include line and of the first [omarchy]/[core] header (0 = absent).
include_line() { grep -nxF "$MARKER" "$CONF" | head -n1 | cut -d: -f1 || true; }
first_repo_line() { grep -nE '^\[(omarchy|core)\]$' "$CONF" | head -n1 | cut -d: -f1 || true; }

banner() {
  cat <<EOF

${CLR_RED}${CLR_BOLD}EXPERIMENTAL. Built for and only meant for the ASUS ROG Zephyrus G16 GA605 (GA605KM).${CLR_OFF}
Nobody has installed these packages yet. The kernel carries untested patches, including an
experimental scheduler series that is compiled in but switched off.
Don't add this repo to any other machine. On a G16, use it only if you can recover from a
kernel or driver that won't boot (this repo replaces linux-omarchy, so keep a second kernel
such as Arch's linux installed as a boot fallback).
EOF
}

check_user() {
  ((EUID != 0)) || die "run this as your normal user, not root; it calls sudo where needed"
  local cmd
  for cmd in pacman pacman-key gpg curl awk bsdtar vercmp cmp diff; do
    command -v "$cmd" >/dev/null || die "missing command: $cmd"
  done
  [[ -f $CONF ]] || die "$CONF not found"
  grep -qE '^\[(omarchy|core)\]$' "$CONF" || die "$CONF has neither an [omarchy] nor a [core] section"
  grep -qx '\[omarchy\]' "$CONF" || warn "$CONF has no [omarchy] section; this doesn't look like an Omarchy install"
}

check_model() {
  local product board
  product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
  board=$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)
  step "Checking the machine model"
  if [[ $product == *GA605* || $board == *GA605* ]]; then
    ok "ASUS ROG Zephyrus G16 GA605 ($product / $board)"
  elif ((FORCE)); then
    warn "not a GA605 (product_name='$product', board_name='$board'); continuing because of --force"
  else
    die "this is not an ASUS ROG Zephyrus G16 GA605 (product_name='$product', board_name='$board').
       omarchy-asus is only for that model. Use --force only if you know why it should run here."
  fi
}

# Download the repo key over HTTPS and check that it is exactly the key whose
# fingerprint is hardcoded above.
fetch_key() {
  step "Downloading and checking the repo signing key"
  curl -fsSL --proto '=https' --tlsv1.2 -o "$TMP/key.asc" "$KEY_URL" || die "could not download $KEY_URL"
  mkdir -m 700 "$TMP/gnupg"
  local fprs
  fprs=$(GNUPGHOME=$TMP/gnupg gpg --batch --with-colons --show-keys "$TMP/key.asc" 2>/dev/null |
    awk -F: '$1 == "pub" { want = 1; next } $1 == "fpr" && want { print $10; want = 0 }')
  [[ $fprs == "$FPR" ]] || die "the downloaded key is not the expected one.
       expected: $FPR
       got:      ${fprs:-<no key>}"
  GNUPGHOME=$TMP/gnupg gpg --batch --quiet --dearmor -o "$TMP/key.gpg" "$TMP/key.asc"
  ok "key fingerprint $FPR"
  info "This check only proves the key matches the fingerprint in this script, which comes from"
  info "the same GitHub account. Compare the fingerprint with one you got another way (for example"
  info "the README on github.com/$GH_REPO, or from the maintainer) before you trust it."
}

# Show which installed packages the repo would replace, from its signed database
# (read-only: nothing on the system changes).
# With 'required' (a channel switch), a database that can't be downloaded stops the script.
preview_repo() {
  step "Packages in the $REPO repo, $CHANNEL channel (signed database, read-only check)"
  if ! curl -fsSL --proto '=https' -o "$TMP/repo.db" "$DB_URL" ||
    ! curl -fsSL --proto '=https' -o "$TMP/repo.db.sig" "$DB_URL.sig"; then
    [[ ${1:-} == required ]] &&
      die "could not download the $CHANNEL channel's database ($DB_URL); nothing was changed"
    warn "could not download the repo database; skipping the preview"
    return 0
  fi
  if ! gpgv --keyring "$TMP/key.gpg" "$TMP/repo.db.sig" "$TMP/repo.db" 2>/dev/null; then
    die "the repo database signature does not verify with key $FPR"
  fi
  # The files database lists every file of every package; check_unowned_etc reads it.
  local files_url=${DB_URL%.db}.files
  if curl -fsSL --proto '=https' -o "$TMP/repo.files" "$files_url" &&
    curl -fsSL --proto '=https' -o "$TMP/repo.files.sig" "$files_url.sig"; then
    if ! gpgv --keyring "$TMP/key.gpg" "$TMP/repo.files.sig" "$TMP/repo.files" 2>/dev/null; then
      die "the repo files database signature does not verify with key $FPR"
    fi
    if mkdir "$TMP/files.d" && bsdtar -xf "$TMP/repo.files" -C "$TMP/files.d"; then
      FILES_DB=$TMP/files.d
    else
      warn "could not unpack the repo files database"
    fi
  else
    warn "could not download the repo files database"
  fi
  local name version installed
  while read -r name version; do
    if installed=$(pacman -Q "$name" 2>/dev/null); then
      installed=${installed#* }
      case $(vercmp "$version" "$installed") in
        1) info "$name  $installed -> $version" ;;
        0) info "$name  $version (already installed)" ;;
        *) info "$name  $installed installed is newer than the repo's $version (stays)" ;;
      esac
    else
      info "$name  $version (not installed, not pulled in)"
    fi
  done < <(bsdtar -xOf "$TMP/repo.db" '*/desc' |
    awk '/^%NAME%$/ { getline n } /^%VERSION%$/ { getline v; print n, v }' | sort)
}

# Whether the fallback kernel K is really a way back (#85): headers for DKMS, an NVIDIA DKMS
# build for its release, a Limine boot entry, and an earlier boot. Warns only, never stops,
# and asks for no password (the boot menu is read with sudo -n or not at all).
check_fallback_kernel() {
  local k=$1 files='' krel='' status='' conf='' boots='' bad=0
  if ! pacman -Q "$k-headers" >/dev/null 2>&1; then
    warn "$k-headers is not installed, so DKMS can't build the NVIDIA module for $k: sudo pacman -S $k-headers"
    bad=1
  fi
  # The release from the package's own file list (no root needed): /usr/lib/modules/<release>/vmlinuz.
  files=$(pacman -Qlq "$k" 2>/dev/null) || files=''
  krel=$(awk -F/ '/^\/usr\/lib\/modules\/[^\/]+\/vmlinuz$/ { print $5; exit }' <<<"$files")
  if [[ -z $krel ]]; then
    warn "could not find the kernel release of $k (no /usr/lib/modules/<release>/vmlinuz in pacman -Ql $k);"
    warn "skipping its NVIDIA DKMS and boot history checks."
    bad=1
  fi

  # A fallback without the NVIDIA module boots to a console at best on the G16.
  if [[ -n $krel ]] && pacman -Q nvidia-open-dkms >/dev/null 2>&1; then
    if ! command -v dkms >/dev/null; then
      warn "dkms is not installed, so nvidia-open-dkms has no module for $k ($krel)"
      bad=1
    else
      status=$(dkms status 2>/dev/null) || status=''
      # A line like "nvidia/615.78.08, 7.2.8-arch1-1, x86_64: installed" (fixed strings: the
      # release has dots).
      if ! K=$krel awk 'index($0, "nvidia") &&
          (index($0, ", " ENVIRON["K"] ", ") || index($0, ", " ENVIRON["K"] ":")) &&
          /: installed( \(.*\))?$/ { found = 1 }
          END { exit !found }' <<<"$status"; then
        warn "no DKMS nvidia build is installed for $k ($krel): the fallback boots without the NVIDIA driver."
        warn "Once $k-headers is installed: sudo dkms autoinstall -k $krel"
        bad=1
      fi
    fi
  fi

  local limine_read=1
  if [[ -r $LIMINE_CONF ]]; then
    conf=$(<"$LIMINE_CONF")
  elif conf=$(sudo -n cat "$LIMINE_CONF" 2>/dev/null); then
    :
  else
    warn "could not read $LIMINE_CONF without a password; check that the boot menu lists $k"
    bad=1
    limine_read=0
    conf=''
  fi
  # vmlinuz-linux must not count for linux-lts, nor vmlinuz-linux-lts for linux.
  # An empty but readable config has no entry either.
  if ((limine_read)) && ! grep -qE "vmlinuz-${k}([^-A-Za-z0-9_]|$)" <<<"$conf"; then
    warn "Limine has no entry for $k ($LIMINE_CONF): run 'sudo limine-update', then check the boot menu"
    bad=1
  fi

  # A heuristic: the reboot records name the kernel release that booted.
  if [[ -n $krel ]]; then
    local history=1
    if command -v last >/dev/null; then
      # -w: the release column is cut at 16 characters without it.
      boots=$(last -w -x reboot 2>/dev/null) || true
    elif command -v wtmpdb >/dev/null; then
      boots=$(wtmpdb last reboot 2>/dev/null) || true
    else
      warn "neither last nor wtmpdb is installed, so the boot history of $k can't be checked"
      bad=1
      history=0
    fi
    if ((history)) && ! K=$krel awk '{ for (i = 1; i <= NF; i++) if ($i == ENVIRON["K"]) found = 1 }
        END { exit !found }' <<<"$boots"; then
      warn "$k ($krel) has never booted on this machine (no boot in the login records; they can be"
      warn "rotated). Boot it once from the Limine menu before the switch."
      bad=1
    fi
  fi

  if ((!bad)); then
    ok "$k $krel: headers, NVIDIA DKMS build, boot entry and an earlier boot found"
  fi
  return 0
}

# True when the running kernel carries patch 0568 (hid-asus Win-lock pass-through): an
# omarchy-asus build, whose release ends in -<pkgrel with .N>-omarchy (e.g. 7.2.8-9.1-omarchy),
# the same rule as bin/g16-check. Every linux-omarchy build from this repo carries 0568
# (recipes/linux-omarchy/DELTA); a stock ...-9-omarchy or ...-arch1-1 does not.
kernel_carries_0568() {
  local krel
  krel=$(uname -r 2>/dev/null) || return 1
  [[ $krel =~ -[0-9]+\.[0-9]+-omarchy$ ]]
}

# The manual steps for retiring an unowned hid-asus DKMS source at DIR (module NAME/VER).
dkms_source_manual_steps() {
  local d=$1 name=$2 ver=$3
  warn "Run 'sudo dkms remove $name/$ver --all', then move it out of /usr/src:"
  warn "'sudo mkdir -p /usr/local/src/dkms-disabled && sudo mv $d /usr/local/src/dkms-disabled/'."
}

# Offer to retire the unowned out-of-tree hid-asus DKMS source DIR on a kernel that already
# has the fix: 'dkms remove' its module (only when DKMS has it registered), then move the
# source out of the DKMS source root so the DKMS hook stops adding it back (#134, #87).
# Nothing is deleted. Always returns 0: preflight_warnings must never stop setup.
retire_dkms_source() {
  local d=$1 base name='' ver='' line key val dest status='' krel sq="'" dq='"'
  base=${d##*/}
  krel=$(uname -r 2>/dev/null) || krel=unknown
  # PACKAGE_NAME and PACKAGE_VERSION, read as text: dkms.conf is never sourced.
  if [[ -r $d/dkms.conf ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line =~ ^[[:space:]]*(PACKAGE_NAME|PACKAGE_VERSION)=(.*)$ ]] || continue
      key=${BASH_REMATCH[1]}
      val=${BASH_REMATCH[2]}
      val=${val%"${val##*[![:space:]]}"}
      if ((${#val} >= 2)) && [[ ($val == "$dq"*"$dq") || ($val == "$sq"*"$sq") ]]; then
        val=${val:1:${#val}-2}
      fi
      if [[ $key == PACKAGE_NAME ]]; then name=$val; else ver=$val; fi
    done <"$d/dkms.conf"
  fi
  [[ -n $name ]] || name=${base%-*}
  [[ -n $ver ]] || ver=${base##*-}

  warn "$d is an out-of-tree hid-asus DKMS source that no package owns. The running kernel $krel"
  warn "already has the fix (0568), and DKMS adds the source back on every kernel update, even after dkms remove."
  dest=$DKMS_DISABLED_DIR/$base
  if [[ -e $dest || -L $dest ]]; then dest=$(aside_path "$dest"); fi
  if ! confirm "Retire it: dkms remove $name/$ver --all and move it to $dest (needs sudo)?"; then
    warn "kept: $d stays, and DKMS keeps adding it back."
    dkms_source_manual_steps "$d" "$name" "$ver"
    return 0
  fi

  # Never move the source while its module is still registered: a built module left in
  # /usr/lib/modules would override the in-tree hid_asus.
  if command -v dkms >/dev/null; then
    status=$(dkms status "$name/$ver" 2>/dev/null) || status=''
    if [[ -n ${status//[[:space:]]/} ]] && ! as_root dkms remove "$name/$ver" --all; then
      warn "could not remove $name/$ver from DKMS; $d stays in place."
      dkms_source_manual_steps "$d" "$name" "$ver"
      return 0
    fi
  fi
  if ! as_root mkdir -p "$DKMS_DISABLED_DIR" || ! as_root mv "$d" "$dest"; then
    warn "could not move $d; it stays in place"
    return 0
  fi
  if ((DRY_RUN)); then
    info "[dry-run] would move aside: $d -> $dest"
  else
    ok "moved $d -> $dest"
  fi
  info "undo: sudo mv $dest $d (DKMS adds it again at the next kernel update; 'sudo dkms install $name/$ver' builds it now)"
  return 0
}

preflight_warnings() {
  local k fallback=''
  for k in linux linux-lts linux-zen linux-hardened; do
    pacman -Q "$k" >/dev/null 2>&1 && fallback+=" $k"
  done
  if [[ -n $fallback ]]; then
    ok "fallback kernel installed:$fallback"
    for k in $fallback; do
      check_fallback_kernel "$k"
    done
  else
    warn "no fallback kernel (linux, linux-lts, ...) is installed. This repo replaces linux-omarchy"
    warn "with a build whose patches have not been booted on hardware yet."
    # From the databases the system already has (no -y), so this is not a partial upgrade.
    # linux-headers too, so DKMS builds the NVIDIA module for the fallback as well. Only on a
    # system that is current with its databases (an earlier run may have synced them):
    # otherwise the install would upgrade just the packages it pulls in.
    if [[ -n $(pacman -Qu 2>/dev/null) ]]; then
      warn "the system has pending upgrades, so installing a kernel now would be a partial upgrade."
      warn "Run 'omarchy update' first, then 'sudo pacman -S linux linux-headers', before you reboot."
    elif confirm "Install Arch's 'linux' kernel (and its headers) now as a boot fallback (recommended)?"; then
      if as_root pacman -S --needed --noconfirm linux linux-headers; then
        ((DRY_RUN)) || check_fallback_kernel linux
      else
        warn "could not install linux; install a fallback kernel before you reboot"
      fi
    else
      warn "no fallback kernel: install one (sudo pacman -S linux) before you reboot into the new kernel."
    fi
  fi
  if grep -nE '^[[:space:]]*IgnorePkg' "$CONF" | grep -qE 'nvidia|hyprland|hyprpm|aquamarine|linux-omarchy'; then
    warn "$CONF has IgnorePkg lines for packages this repo ships; remove them, or the repo builds won't install:"
    grep -nE '^[[:space:]]*IgnorePkg' "$CONF" | sed 's/^/        /' >&2
  fi
  # An out-of-tree hid-asus DKMS source: Arch's DKMS hook adds every /usr/src/<name>-<version>
  # with a dkms.conf again on each kernel transaction, so 'dkms remove' alone doesn't stick (#87).
  # An unowned one on a kernel that carries 0568 is offered for retirement (#134).
  local d base owner
  for d in "$DKMS_SRC_ROOT"/*; do
    [[ -f $d/dkms.conf ]] || continue
    base=${d##*/}
    [[ ${base,,} == *hid[-_]asus* ]] || grep -qiE 'hid[-_]asus' "$d/dkms.conf" || continue
    if owner=$(pacman -Qqo "$d" 2>/dev/null) && [[ -n $owner ]]; then
      owner=${owner%%$'\n'*}
      warn "$d (package $owner) is an out-of-tree hid-asus DKMS source; the patched kernel has the fix"
      warn "built in: remove the package (sudo pacman -Rns $owner)."
    elif kernel_carries_0568; then
      retire_dkms_source "$d"
    else
      warn "$d is an out-of-tree hid-asus DKMS source that no package owns. DKMS adds it again on every"
      warn "kernel update, even after dkms remove. Run 'sudo dkms remove ${base%-*}/${base##*-} --all', then move it"
      warn "out of /usr/src: 'sudo mkdir -p /usr/local/src/dkms-disabled && sudo mv $d /usr/local/src/dkms-disabled/'."
    fi
  done
}

install_key() {
  step "Trusting the repo key in pacman's keyring"
  as_root pacman-key --add "$TMP/key.asc"
  as_root pacman-key --lsign-key "$FPR"
}

install_snippet() {
  step "Writing $SNIPPET"
  local rest new
  rest=$(snippet_without_repo)
  if [[ -n ${rest//[[:space:]]/} ]]; then
    info "keeping the other repos already in $SNIPPET"
    new=$rest$'\n\n'$REPO_BLOCK
  else
    new=$REPO_BLOCK
  fi
  if [[ -f $SNIPPET && $(<"$SNIPPET") == "$new" ]]; then
    ok "already up to date"
  else
    write_root "$SNIPPET" "$new"
  fi
}

install_hook() {
  step "Installing the Omarchy pre-refresh hook"
  if [[ -f $HOOK && $(<"$HOOK") == "$HOOK_CONTENT" && -x $HOOK ]]; then
    ok "$HOOK already up to date"
  elif ((DRY_RUN)); then
    printf '    [dry-run] write %s (mode 755):\n%s\n' "$HOOK" "$HOOK_CONTENT"
  else
    mkdir -p "$HOOK_DIR"
    printf '%s\n' "$HOOK_CONTENT" >"$HOOK"
    chmod 755 "$HOOK"
    ok "wrote $HOOK"
  fi
  local other
  for other in "$HOOK_DIR"/*; do
    [[ -f $other && $other != "$HOOK" && $other != *.sample ]] || continue
    if grep -qF "$SNIPPET" "$other"; then
      warn "$other also inserts the $SNIPPET Include line. Hooks run in name order, so if it puts"
      warn "the line below [omarchy], the omarchy-asus builds lose to the stock ones. Remove it, or make"
      warn "it insert above whichever of [omarchy]/[core] comes first, like $HOOK does."
    fi
  done
}

# Apply the hook now. Deliberately not `omarchy refresh pacman`: that ends in
# `pacman -Syyuu --noconfirm`, which would upgrade before you saw the list.
# The result in /etc/pacman.conf is the same, and later refreshes run the hook.
apply_hook() {
  step "Adding the Include line to $CONF"
  local inc first
  inc=$(include_line)
  first=$(first_repo_line)
  if [[ -n $inc && $inc -lt $first ]]; then
    ok "already above the first of [omarchy]/[core] (line $inc)"
    return 0
  fi
  if [[ -n $inc ]]; then
    warn "the Include line is at line $inc, below [omarchy]/[core]; moving it up"
    # shellcheck disable=SC2016 # sed program, same as LAPTOP-SETUP.md section 5
    as_root sed -i '\|^Include = /etc/pacman.d/custom-repos.conf$|{$d;N;/\n$/d;D}' "$CONF"
  fi
  if ((DRY_RUN)); then
    as_root sed -i -E "0,/^\[(omarchy|core)\]$/s||$MARKER\n\n&|" "$CONF"
    return 0
  fi
  bash "$HOOK"
  inc=$(include_line)
  first=$(first_repo_line)
  [[ -n $inc && $inc -lt $first ]] || die "the Include line did not land above [omarchy]/[core]; check $CONF"
  ok "Include line at line $inc, above the first of [omarchy]/[core] (line $first)"
}

install_keyring() {
  step "Installing $KEYRING_PKG"
  info "This syncs the package databases (pacman -Sy) and installs only the keyring, the same way"
  info "Arch updates archlinux-keyring before a system upgrade."
  as_root pacman -Sy --needed --noconfirm "$KEYRING_PKG"
}

# One field (%NAME%, %VERSION%, %FILENAME%) of a package's desc file in the files database.
desc_field() { awk -v key="%$2%" '$0 == key { getline v; print v; exit }' "$1/desc"; }

# Every line of a multi-line section (%DEPENDS%, %PROVIDES%) of a package's desc file in the
# files database, up to the blank line that ends it.
desc_list() { awk -v key="%$2%" '$0 == key { on = 1; next } on && $0 == "" { exit } on { print }' "$1/desc"; }

# True when the /etc file at PATH is a regular file with the same bytes as PKG's copy.
same_as_packaged() {
  local pkg=$1 path=$2
  [[ -f $ROOT$path && ! -L $ROOT$path ]] || return 1
  if [[ -r $ROOT$path ]]; then
    bsdtar -xOf "$pkg" "${path#/}" | cmp -s - "$ROOT$path"
  elif ((!DRY_RUN)); then
    cmp -s <(bsdtar -xOf "$pkg" "${path#/}") <(sudo cat "$ROOT$path")
  else
    return 1
  fi
}

# Show how the /etc file at PATH differs from PKG's copy (at most 40 lines of diff).
show_difference() {
  local pkg=$1 path=$2 name=$3 line
  if [[ -L $ROOT$path ]]; then
    info "  a symlink (to $(readlink "$ROOT$path")), not a regular file"
  elif [[ ! -f $ROOT$path ]]; then
    info "  not a regular file"
  elif [[ ! -r $ROOT$path ]] && ((DRY_RUN)); then
    info "  not readable without sudo, so not compared under --dry-run"
  else
    # diff exits 1 on a difference, and head may close the pipe early.
    diff -u --label "$name's copy" --label "$path" <(bsdtar -xOf "$pkg" "${path#/}") \
      <(if [[ -r $ROOT$path ]]; then cat "$ROOT$path"; else sudo cat "$ROOT$path"; fi) 2>&1 |
      head -n 40 | while IFS= read -r line; do info "  $line"; done || true
  fi
}

# pacman refuses to install a file that already exists and no package owns, and it checks
# that before any scriptlet runs. `omarchy update` passes --overwrite only for
# /usr/share/omarchy/*, so an /etc file copied in by hand before a package shipped it (the
# asusd drop-in from LAPTOP-SETUP.md, for one) stops the whole upgrade. This finds those
# files for every installed package the repo upgrades, from the signed files database (so
# it also works under --dry-run, before pacman has the repo). A file identical to the
# signed package's copy goes into TAKEOVER, which run_upgrade hands over to the package;
# any other one stops the script here, before anything is overwritten.
#
# unowned_etc_of DIR NAME USE: the unowned /etc files of the files-database entry DIR
# (package NAME), compared with the signed package. Identical ones are appended to the
# caller's `identical` array (USE says what then happens to them), the others to the
# caller's `different` array, each with its difference shown. Returns 1 when there are
# none, and 2 when the package can't be downloaded or verified (the reason in UNOWNED_ERR).
UNOWNED_ERR=''
unowned_etc_of() {
  local dir=$1 name=$2 use=$3 path url pkg
  local -a unowned=()
  while IFS= read -r path; do
    path=/$path
    [[ -e $ROOT$path || -L $ROOT$path ]] || continue
    pacman -Qo "$path" >/dev/null 2>&1 && continue
    unowned+=("$path")
  done < <(awk '$0 == "%FILES%" { on = 1; next } /^%.*%$/ { on = 0 } on && /^etc\// && !/\/$/' "$dir/files")
  ((${#unowned[@]})) || return 1
  # -dd: only this package's URL, not its dependencies'. A cached package prints a
  # file:// URL, and under --dry-run pacman has no sync database for the repo yet: both
  # use the release URL instead.
  url=$(pacman -Sddp --print-format '%l' "$REPO/$name" 2>/dev/null) || url=''
  url=${url##*$'\n'}
  if [[ $url != https://* ]]; then
    url=$(desc_field "$dir" FILENAME)
    if [[ -z $url ]]; then
      UNOWNED_ERR="the files database has no file name for $name"
      return 2
    fi
    url=https://github.com/$GH_REPO/releases/download/$GH_TAG/$url
  fi
  pkg=$TMP/${url##*/}
  if ! curl -fsSL --proto '=https' -o "$pkg" "$url" ||
    ! curl -fsSL --proto '=https' -o "$pkg.sig" "$url.sig"; then
    UNOWNED_ERR="could not download $url to compare its /etc files; nothing was changed"
    return 2
  fi
  if ! gpgv --keyring "$TMP/key.gpg" "$pkg.sig" "$pkg" 2>/dev/null; then
    UNOWNED_ERR="the signature of ${url##*/} does not verify with key $FPR"
    return 2
  fi
  for path in "${unowned[@]}"; do
    if same_as_packaged "$pkg" "$path"; then
      identical+=("$path")
      info "$path: not owned by any package and identical to $name's copy; $use"
    else
      different+=("$path")
      info "$path: not owned by any package and different from $name's copy:"
      show_difference "$pkg" "$path" "$name"
    fi
  done
  return 0
}

check_unowned_etc() {
  step "Checking /etc for unowned files the upgrade would install"
  if [[ -z $FILES_DB ]]; then
    warn "could not check /etc files against the repo; if the upgrade stops on a file conflict, see LAPTOP-SETUP.md"
    return 0
  fi
  local dir name version installed rc found=0
  local -a identical=() different=()
  for dir in "$FILES_DB"/*/; do
    dir=${dir%/}
    [[ -f $dir/desc && -f $dir/files ]] || continue
    name=$(desc_field "$dir" NAME)
    version=$(desc_field "$dir" VERSION)
    [[ -n $name && -n $version ]] || continue
    installed=$(pacman -Q "$name" 2>/dev/null) || continue
    installed=${installed#* }
    [[ $(vercmp "$version" "$installed") == 1 ]] || continue
    rc=0
    unowned_etc_of "$dir" "$name" "the upgrade takes it over" || rc=$?
    if ((rc == 2)); then die "$UNOWNED_ERR"; fi
    if ((rc == 0)); then found=1; fi
  done
  TAKEOVER+=("${identical[@]}")
  if ((${#different[@]})); then
    die "these files are not owned by any package, differ from the packaged copies and would stop the upgrade:
$(printf '         %s\n' "${different[@]}")
       Nothing was changed in /etc and the system is not upgraded (the package databases are
       synced, so don't install anything else first). Move or delete each file (or make it
       match the packaged copy), then run this script again."
  fi
  ((found)) || ok "no unowned /etc files in the way of the upgrade"
}

# The packages pacman -S installs for the names given: each one that isn't installed, and
# the packages of this repo it depends on that aren't installed either, recursively. A
# dependency is found in the files database by %NAME%, or else by %PROVIDES%, with any
# version constraint (name>=1.2, name=1, name<2) stripped. Prints "NAME DIR" per package,
# NAME its real %NAME%. Dependencies from other repos are left out: the check covers only
# this repo's signed packages.
install_closure() {
  local dir name want entry
  local -A by_name=() by_provides=() seen=()
  local -a queue=("$@")
  for dir in "$FILES_DB"/*/; do
    dir=${dir%/}
    [[ -f $dir/desc && -f $dir/files ]] || continue
    name=$(desc_field "$dir" NAME)
    [[ -n $name ]] || continue
    by_name[$name]=$dir
    while IFS= read -r entry; do
      entry=${entry%%[<>=]*}
      if [[ -n $entry && -z ${by_provides[$entry]:-} ]]; then by_provides[$entry]=$name; fi
    done < <(desc_list "$dir" PROVIDES)
  done
  while ((${#queue[@]})); do
    want=${queue[0]}
    queue=("${queue[@]:1}")
    [[ -n $want ]] || continue
    # Installed already (pacman -Q also matches what an installed package provides).
    pacman -Q "$want" >/dev/null 2>&1 && continue
    name=$want
    [[ -n ${by_name[$name]:-} ]] || name=${by_provides[$want]:-}
    [[ -n $name && -z ${seen[$name]:-} ]] || continue
    # The visited set: a dependency cycle ends here.
    seen[$name]=1
    pacman -Q "$name" >/dev/null 2>&1 && continue
    dir=${by_name[$name]}
    printf '%s %s\n' "$name" "$dir"
    while IFS= read -r entry; do
      queue+=("${entry%%[<>=]*}")
    done < <(desc_list "$dir" DEPENDS)
  done
}

# The same check for the packages offer_g16_fixes installs that aren't installed yet: pacman
# refuses an unowned /etc file there too. A file identical to the signed package's copy goes
# into INSTALL_OVERWRITE, which offer_g16_fixes passes to pacman as one --overwrite each.
# Any other file, or a package that can't be checked, returns 1 before anything changes.
# The packages pacman -S pulls in as dependencies are checked too (install_closure): they
# go in the same transaction, so their identical files join the same --overwrite list.
INSTALL_OVERWRITE=()
check_unowned_etc_install() {
  step "Checking /etc for unowned files the G16 packages would install"
  INSTALL_OVERWRITE=()
  if [[ -z $FILES_DB ]]; then
    warn "could not check /etc files against the repo; if the install stops on a file conflict, see LAPTOP-SETUP.md"
    return 0
  fi
  local entry name dir rc found=0
  local -a identical=() different=() pkgs=()
  mapfile -t pkgs < <(install_closure "$@")
  for entry in "${pkgs[@]}"; do
    name=${entry%% *} dir=${entry#* }
    rc=0
    unowned_etc_of "$dir" "$name" "the install overwrites it" || rc=$?
    if ((rc == 2)); then
      warn "$UNOWNED_ERR"
      return 1
    fi
    if ((rc == 0)); then found=1; fi
  done
  if ((${#different[@]})); then
    warn "these files are not owned by any package, differ from the packaged copies and would stop the install:
$(printf '         %s\n' "${different[@]}")
       Nothing was changed. Move or delete each file (or make it match the packaged copy),
       then run this script again."
    return 1
  fi
  INSTALL_OVERWRITE=("${identical[@]}")
  ((found)) || ok "no unowned /etc files in the way of the install"
}

# Where run_upgrade keeps the files it moves aside. Outside the live directory, as in
# Omarchy's omarchy-update-system-pkgs-when-conflicted: systemd reads a copy left beside it.
REPLACED=/var/lib/omarchy-asus/replaced

# Settle the files run_upgrade moved aside: where the upgrade installed the package's copy,
# the saved one goes; where the path is still missing, the saved copy goes back. Runs after
# the upgrade, and from the traps when the script stops during it.
restore_moved() {
  local p saved
  for p in "${MOVED[@]}"; do
    saved=$ROOT$REPLACED$p
    if [[ -e $ROOT$p || -L $ROOT$p ]]; then
      as_root rm -f "$saved" || warn "could not remove the saved copy $saved"
      ok "took over $p (identical to the packaged copy)"
    elif as_root mv -T "$saved" "$ROOT$p"; then
      warn "put back $p (the upgrade didn't install it)"
    else
      warn "could not put back $p; the saved copy is $saved"
    fi
  done
  MOVED=()
}

# The upgrade goes through `omarchy update`, not a bare `pacman -Su`: since
# Omarchy 4.0.5 a pacman hook (omarchy-update-pacman-guard) aborts direct system
# upgrades, and `omarchy update` also takes the snapshot, updates the keyrings
# and runs the migrations. It asks for its own confirmation. Without Omarchy's
# updater, fall back to pacman with the guard's documented override.
# The files in TAKEOVER (see check_unowned_etc) go to the package: pacman gets an
# --overwrite for each, and since `omarchy update` takes no pacman arguments, they are
# moved aside for it instead and put back if the upgrade doesn't install them.
run_upgrade() {
  local p rc=0
  if command -v omarchy-update >/dev/null; then
    if ((DRY_RUN)); then
      for p in "${TAKEOVER[@]}"; do
        as_root mkdir -p "$ROOT$REPLACED${p%/*}"
        as_root mv -T "$ROOT$p" "$ROOT$REPLACED$p"
      done
      info "[dry-run] omarchy update"
      return 0
    fi
    trap 'restore_moved; exit 130' INT TERM
    for p in "${TAKEOVER[@]}"; do
      info "moving $p aside to $REPLACED$p for the upgrade"
      as_root mkdir -p "$ROOT$REPLACED${p%/*}"
      as_root mv -T "$ROOT$p" "$ROOT$REPLACED$p"
      MOVED+=("$p")
    done
    omarchy update <"$TTY" || rc=$?
    restore_moved
    trap - INT TERM
    return "$rc"
  else
    local overwrite=()
    for p in "${TAKEOVER[@]}"; do overwrite+=(--overwrite "$p"); done
    as_root env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Su "${overwrite[@]}"
  fi
}

# A power manager of your own (rog-power) and the packaged profile switching would both act
# on every plug and unplug. The patched omarchy-powerprofiles-set stands back when Omarchy's
# powerprofiles-autoswitch-off toggle is set; set it before the upgrade runs the migrations.
POWER_TOGGLE=$HOME/.local/state/omarchy/toggles/powerprofiles-autoswitch-off
# The user unit dir follows XDG_CONFIG_HOME (~/.config by default), like systemd and the G16 Control widget.
USER_UNIT_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
# The /etc unit dirs, the source monitor Omarchy's charger switching needs and the sudoers
# dir: variables so the offline tests (tests/ci/setup-power-handover.sh) can point them at
# temp dirs instead of the host's.
POWER_ETC_USER_DIR=/etc/systemd/user
POWER_ETC_SYSTEM_DIR=/etc/systemd/system
POWER_MONITOR_UNIT=/usr/lib/systemd/user/omarchy-powerprofiles-source-monitor.service
POWER_SUDOERS_DIR=/etc/sudoers.d
own_power_manager() {
  local unit
  for unit in "$USER_UNIT_DIR/rog-power.service" "$POWER_ETC_USER_DIR/rog-power.service" \
    "$POWER_ETC_SYSTEM_DIR/rog-power.service"; do
    [[ -f $unit ]] && { echo "$unit"; return 0; }
  done
  return 1
}

# Ask which owner of the power profile to keep (works under `curl | bash` too). Prints one
# word on stdout: keep, omarchy, or nothing for neither. The prompt goes to stderr.
power_owner_choice() {
  local answer question="Which one should own the power profile? [1/2/Enter]"
  {
    info "1) keep yours in charge (sets Omarchy's powerprofiles-autoswitch-off toggle)"
    info "2) hand over to Omarchy (disables and moves aside your unit)"
    info "Enter: neither"
  } >&2
  if ((DRY_RUN)); then
    printf '    %s [dry-run: assuming keep]\n' "$question" >&2
    echo keep
    return 0
  fi
  [[ -r $TTY ]] || die "no terminal to ask for confirmation on"
  read -r -p "    $question " answer <"$TTY" || answer=''
  case $answer in
    1) echo keep ;;
    2) echo omarchy ;;
  esac
  return 0
}

# Hand the power profile from the local rog-power UNIT over to Omarchy: disable it, move the
# unit (and the toggle, if set) aside, check the source monitor, and list the root helpers
# and sudoers rules that came with it. Nothing is deleted; the undo commands are printed.
handover_power_owner() {
  local unit=$1 scope=user sudo='' a t src line cmd f enable_cmd unreadable=0
  local undo=() helpers=() sudoers=() link
  # A unit in the /etc user dir is a user unit, enabled there for every user (--global).
  if [[ $unit == "$POWER_ETC_SYSTEM_DIR"/* ]]; then
    scope=system
  elif [[ $unit == "$POWER_ETC_USER_DIR"/* ]]; then
    scope=global
  fi
  if [[ $unit != "$USER_UNIT_DIR"/* ]]; then sudo='sudo '; fi

  # Before the move, so systemd removes the links it made for the unit.
  if [[ $scope == system ]]; then
    as_root systemctl disable --now rog-power.service ||
      warn "could not disable rog-power.service; stop it yourself"
  elif [[ $scope == global ]]; then
    # Only root removes the links `systemctl --global enable` made in the /etc user dir
    # (#142); the running instance is this user's.
    as_root systemctl --global disable rog-power.service ||
      warn "could not disable rog-power.service for all users"
    for link in "$POWER_ETC_USER_DIR"/*.wants/rog-power.service; do
      [[ -L $link ]] || continue
      as_root rm -f "$link" || warn "could not remove $link; remove it yourself"
    done
    if ((DRY_RUN)); then
      info "[dry-run] would run: systemctl --user stop rog-power.service"
    else
      systemctl --user stop rog-power.service 2>/dev/null || true
    fi
  elif ((DRY_RUN)); then
    info "[dry-run] would run: systemctl --user disable --now rog-power.service"
  else
    systemctl --user disable --now rog-power.service 2>/dev/null || true
  fi

  a=$(aside_path "$unit")
  if [[ -n $sudo ]]; then
    if ! as_root mv "$unit" "$a"; then
      warn "could not move $unit; it stays in place, disabled, and the toggle is untouched"
      return 0
    fi
  elif ((DRY_RUN)); then
    info "[dry-run] would run: mv ${unit/#$HOME/\~} ${a/#$HOME/\~}"
  elif ! mv "$unit" "$a"; then
    warn "could not move ${unit/#$HOME/\~}; it stays in place, disabled, and the toggle is untouched"
    return 0
  fi
  # A unit in the /etc user dir moves back with sudo and is enabled for every user again.
  if [[ $scope == system ]]; then
    enable_cmd='sudo systemctl enable --now rog-power.service'
  elif [[ $scope == global ]]; then
    enable_cmd='sudo systemctl --global enable rog-power.service && systemctl --user start rog-power.service'
  else
    enable_cmd='systemctl --user enable --now rog-power.service'
  fi
  undo+=("${unit/#$HOME/\~} -> ${a##*/}; undo: ${sudo}mv ${a/#$HOME/\~} ${unit/#$HOME/\~} && $enable_cmd")

  if [[ $scope == system ]]; then
    as_root systemctl daemon-reload || true
  elif ((DRY_RUN)); then
    info "[dry-run] would run: systemctl --user daemon-reload"
  else
    systemctl --user daemon-reload 2>/dev/null || true
  fi

  # Only a toggle that is set moves aside; this path never creates or deletes it.
  if [[ -e $POWER_TOGGLE ]]; then
    t=$(aside_path "$POWER_TOGGLE")
    if ((DRY_RUN)); then
      info "[dry-run] would run: mv ${POWER_TOGGLE/#$HOME/\~} ${t/#$HOME/\~}"
      undo+=("${POWER_TOGGLE/#$HOME/\~} -> ${t##*/}; undo: mv ${t/#$HOME/\~} ${POWER_TOGGLE/#$HOME/\~}")
    elif mv "$POWER_TOGGLE" "$t"; then
      undo+=("${POWER_TOGGLE/#$HOME/\~} -> ${t##*/}; undo: mv ${t/#$HOME/\~} ${POWER_TOGGLE/#$HOME/\~}")
    else
      warn "could not move ${POWER_TOGGLE/#$HOME/\~}; while it is set, Omarchy leaves the profile alone"
    fi
  fi

  # Verify only: the source monitor is Omarchy's to enable (read-only, so under --dry-run too).
  if [[ -e $POWER_MONITOR_UNIT ]]; then
    if systemctl --user is-enabled omarchy-powerprofiles-source-monitor.service >/dev/null 2>&1; then
      ok "omarchy-powerprofiles-source-monitor is enabled"
    else
      warn "omarchy-powerprofiles-source-monitor is not enabled, so Omarchy won't follow the charger; run:"
      warn "  systemctl --user enable --now omarchy-powerprofiles-source-monitor.service"
    fi
  else
    info "omarchy-powerprofiles-source-monitor isn't installed yet: the upgrade below installs it"
    info "with omarchy-settings, and Omarchy's migration enables it."
  fi

  # Root helpers the unit runs, and sudoers rules that mention it: listed, never touched.
  src=$a
  if ((DRY_RUN)) || [[ ! -r $src ]]; then src=$unit; fi
  if [[ -r $src ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line =~ ^[[:space:]]*(ExecStart[A-Za-z]*|ExecStop[A-Za-z]*|ExecReload)[[:space:]]*=[[:space:]]*(.*)$ ]] ||
        continue
      cmd=${BASH_REMATCH[2]}
      while [[ $cmd == [-@:+!]* ]]; do cmd=${cmd:1}; done
      cmd=${cmd%%[[:space:]]*}
      [[ $cmd == /* ]] || continue
      case $cmd in /usr/bin/* | /usr/lib/*) continue ;; esac
      [[ " ${helpers[*]} " == *" $cmd "* ]] && continue
      helpers+=("$cmd")
    done <"$src"
  fi
  # /etc/sudoers.d and its files are root-only on Arch: then read it with sudo -n (read-only and
  # never a password prompt; install_keyring has just used sudo), or say to look by hand.
  if [[ -d $POWER_SUDOERS_DIR ]]; then
    if [[ -r $POWER_SUDOERS_DIR && -x $POWER_SUDOERS_DIR ]]; then
      for f in "$POWER_SUDOERS_DIR"/*; do
        [[ -f $f ]] || continue
        if [[ ! -r $f ]]; then
          unreadable=1
        elif grep -qF rog-power -- "$f" 2>/dev/null; then
          sudoers+=("$f")
        fi
      done
    else
      unreadable=1
    fi
    if ((unreadable)); then
      sudoers=()
      if sudo -n true 2>/dev/null; then
        mapfile -t sudoers < <(sudo -n grep -rlF rog-power -- "$POWER_SUDOERS_DIR" 2>/dev/null)
      else
        info "could not read $POWER_SUDOERS_DIR without a password; look there for rules that mention rog-power."
      fi
    fi
  fi
  for f in "${helpers[@]}" "${sudoers[@]}"; do
    info "  ${f/#$HOME/\~}: left in place"
  done
  info "Helpers and sudoers rules stay; remove them yourself once you no longer need them."
  info "Nothing is deleted."

  if ((DRY_RUN)); then info "[dry-run] would hand over:"; else ok "handed over to Omarchy:"; fi
  for line in "${undo[@]}"; do info "  $line"; done
  return 0
}

prepare_power_owner() {
  local unit choice toggle_set=0
  unit=$(own_power_manager) || return 0
  step "Your own power manager"
  info "${unit/#$HOME/\~} manages your power profile. The patched Omarchy also switches it on"
  info "every charger change; with both, they would fight. Setting Omarchy's"
  info "powerprofiles-autoswitch-off toggle keeps yours in charge."
  if [[ -e $POWER_TOGGLE ]]; then
    toggle_set=1
    ok "Omarchy's powerprofiles-autoswitch-off toggle is already set"
  fi
  # A failed question (no terminal) stops the script, as confirm's die does.
  choice=$(power_owner_choice) || exit 1
  case $choice in
    keep)
      if ((toggle_set)); then
        ok "nothing changes: yours stays in charge"
      elif ((DRY_RUN)); then
        info "[dry-run] would run: mkdir -p ${POWER_TOGGLE%/*} && touch $POWER_TOGGLE"
      else
        mkdir -p "${POWER_TOGGLE%/*}" && touch "$POWER_TOGGLE" && ok "set ${POWER_TOGGLE/#$HOME/\~}"
      fi
      ;;
    omarchy)
      handover_power_owner "$unit"
      ;;
    *)
      if ((toggle_set)); then
        ok "nothing changes: the toggle stays set, so yours stays in charge"
      else
        warn "not set: hand over, or stop ${unit##*/} yourself, or both will switch profiles on plug and unplug."
      fi
      ;;
  esac
  return 0
}

# A hand-made Win-lock setup has up to four local pieces next to what asus-rog-nkey-winlock
# installs: a unit in the user unit dir that shadows the packaged one in
# /usr/lib/systemd/user, its drop-in dir (which still applies to the packaged unit), the
# <target>.wants link that enabled it (dangling once the unit moves), and a udev rule in
# /etc/udev/rules.d next to the packaged 70-g16-winlock-hidraw.rules. Once the package is
# installed, offer to move them aside. Nothing is deleted except a dangling link.
WINLOCK_USER_DIR=$USER_UNIT_DIR
WINLOCK_LOCAL=$WINLOCK_USER_DIR/g16-winlock.service
WINLOCK_DROPIN=$WINLOCK_LOCAL.d
WINLOCK_UDEV_DIR=/etc/udev/rules.d
WINLOCK_LOCAL_BIN=$HOME/.local/bin/g16-winlock
# Local copies of the fixes omarchy-asus-g16 ships (#136). ROOT is the test hook.
G16_UDEV_DIR=$ROOT/etc/udev/rules.d
G16_SLEEP_CONF=$ROOT/etc/systemd/sleep.conf
G16_SLEEP_DROPIN_DIR=$ROOT/etc/systemd/sleep.conf.d

# The backup name for a path: <path>.before-omarchy-asus, or the first free
# <path>.before-omarchy-asus.N after it, so an earlier backup is never overwritten.
aside_path() {
  local base=$1.before-omarchy-asus n=1
  if [[ ! -e $base && ! -L $base ]]; then
    echo "$base"
    return 0
  fi
  while [[ -e $base.$n || -L $base.$n ]]; do n=$((n + 1)); done
  echo "$base.$n"
}

# True when FILE is a mode.conf exactly as the G16 Control widget writes it for the packaged
# unit (its bridge now, `g16ctl winlock-mode` before).
written_by_g16ctl() {
  local f=$1
  [[ -f $f && ! -L $f ]] || return 1
  [[ $(<"$f") == $'[Service]\nEnvironment=G16_WINLOCK_MODE=toast' ||
    $(<"$f") == $'[Service]\nEnvironment=G16_WINLOCK_MODE=unlock' ]]
}

# True when drop-in DIR holds a *.conf file that g16ctl did not write (a hand-made one).
dropin_has_own_conf() {
  local f
  for f in "$1"/*.conf; do
    [[ -e $f || -L $f ]] || continue
    written_by_g16ctl "$f" || return 0
  done
  return 1
}

# True when nothing in drop-in DIR changed after the newest unit backup was made. Moving
# the unit aside updated the backup's ctime, so a drop-in written later (for the packaged
# unit) has a newer mtime and is not a leftover of the hand-made setup.
dropin_predates_unit_backup() {
  local dir=$1 f t moved=0 newest
  for f in "$WINLOCK_LOCAL".before-omarchy-asus*; do
    [[ -e $f || -L $f ]] || continue
    t=$(stat -c %Z -- "$f") || return 1
    if ((t > moved)); then moved=$t; fi
  done
  newest=$(stat -c %Y -- "$dir") || return 1
  for f in "$dir"/* "$dir"/.*; do
    [[ -f $f && ! -L $f ]] || continue
    t=$(stat -c %Y -- "$f") || return 1
    if ((t > newest)); then newest=$t; fi
  done
  ((newest <= moved))
}

retire_local_winlock() {
  pacman -Q asus-rog-nkey-winlock >/dev/null 2>&1 || ((DRY_RUN)) || return 0
  local unit='' dropin='' links=() rules=() files=() undo=() l f p a line moved_rule=0
  local keep_mode=0 shadow_bin=0 how
  local comment='^[[:space:]]*([#;]|$)'
  if [[ -f $WINLOCK_LOCAL && ! -L $WINLOCK_LOCAL ]]; then unit=$WINLOCK_LOCAL; fi
  # Links that enabled the local unit: dangling ones, or ones that resolve to it. A link to
  # the packaged unit is the package's own enablement and stays.
  for l in "$WINLOCK_USER_DIR"/*.wants/g16-winlock.service; do
    [[ -L $l ]] || continue
    if [[ ! -e $l ]] || [[ -n $unit && $l -ef $unit ]]; then links+=("$l"); fi
  done
  # The drop-in only belongs to a hand-made setup when it holds a file g16ctl did not write
  # (G16 Control writes mode.conf for the packaged unit; a drop-in of only that always
  # stays), and either the hand-made unit or its links are still here, or an older version
  # of this script moved the unit aside but not the drop-in and nothing in the drop-in
  # changed since. A g16ctl mode.conf inside a retired drop-in is put back after the move.
  if [[ -d $WINLOCK_DROPIN ]] && dropin_has_own_conf "$WINLOCK_DROPIN"; then
    if [[ -n $unit ]] || ((${#links[@]})); then
      dropin=$WINLOCK_DROPIN
    elif compgen -G "$WINLOCK_LOCAL.before-omarchy-asus*" >/dev/null &&
      ! compgen -G "$WINLOCK_DROPIN.before-omarchy-asus*" >/dev/null &&
      dropin_predates_unit_backup "$WINLOCK_DROPIN"; then
      dropin=$WINLOCK_DROPIN
    fi
    if [[ -n $dropin ]] && written_by_g16ctl "$dropin/mode.conf"; then keep_mode=1; fi
  fi
  for f in "$WINLOCK_UDEV_DIR"/*g16-winlock*.rules; do
    if [[ -f $f && ! -L $f ]]; then rules+=("$f"); fi
  done
  if [[ -f $WINLOCK_LOCAL_BIN && -x $WINLOCK_LOCAL_BIN ]]; then shadow_bin=1; fi
  [[ -n $unit$dropin ]] || ((${#links[@]} + ${#rules[@]} + shadow_bin)) || return 0

  step "Your local Win-lock setup"
  if [[ -n $unit$dropin ]] || ((${#links[@]} + ${#rules[@]})); then
    info "These shadow or duplicate what asus-rog-nkey-winlock now installs:"
  fi
  if [[ -n $unit ]]; then
    info "  ${unit/#$HOME/\~}: your own unit, used instead of the packaged one"
  fi
  if [[ -n $dropin ]]; then
    info "  ${dropin/#$HOME/\~}/: your drop-in, which still applies to the packaged unit:"
    for f in "$dropin"/*.conf; do
      [[ -f $f ]] || continue
      info "    ${f##*/}:"
      while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ $comment ]] && continue
        info "      $line"
      done <"$f"
    done
  fi
  for l in "${links[@]}"; do
    info "  ${l/#$HOME/\~}: the link that enabled your unit"
  done
  for f in "${rules[@]}"; do
    info "  $f: your udev rule, next to the packaged 70-g16-winlock-hidraw.rules"
  done
  if ((shadow_bin)); then
    warn "${WINLOCK_LOCAL_BIN/#$HOME/\~} shadows /usr/bin/g16-winlock on your PATH when you run"
    warn "g16-winlock by hand. It is left in place; remove it to use the packaged one."
  fi

  if [[ -n $unit$dropin ]] || ((${#links[@]})); then
    if confirm "Move your local Win-lock unit, its drop-in and links aside so the packaged unit is used?"; then
      if [[ -n $unit ]]; then
        files+=("$unit")
        # Before the move, so systemd removes the links it made for the local unit itself.
        if ((DRY_RUN)); then
          info "[dry-run] would run: systemctl --user disable g16-winlock.service"
        else
          systemctl --user disable g16-winlock.service 2>/dev/null || true
        fi
      fi
      if [[ -n $dropin ]]; then files+=("$dropin"); fi
      for p in "${files[@]}"; do
        a=$(aside_path "$p")
        if ((DRY_RUN)); then
          info "[dry-run] would run: mv ${p/#$HOME/\~} ${a/#$HOME/\~}"
        elif ! mv "$p" "$a"; then
          warn "could not move ${p/#$HOME/\~}; it stays in place"
          continue
        fi
        how="mv ${a/#$HOME/\~} ${p/#$HOME/\~}"
        # The mode chosen in G16 Control applies to the packaged unit too: put it back.
        if [[ $p == "$dropin" ]] && ((keep_mode)); then
          if ((DRY_RUN)); then
            info "[dry-run] would run: mkdir -p ${p/#$HOME/\~} && cp -p ${a/#$HOME/\~}/mode.conf ${p/#$HOME/\~}/mode.conf"
          elif mkdir -p "$p" && cp -p "$a/mode.conf" "$p/mode.conf"; then
            info "kept the Win-lock mode set in the omarchy-asus plugin (${p/#$HOME/\~}/mode.conf)"
          else
            warn "could not put back ${p/#$HOME/\~}/mode.conf; set the Win-lock mode in the omarchy-asus plugin again"
          fi
          how="rm -r ${p/#$HOME/\~} && $how"
        fi
        undo+=("${p/#$HOME/\~} -> ${a##*/}; undo: $how")
      done
      for l in "${links[@]}"; do
        if ((DRY_RUN)); then
          info "[dry-run] would run: rm ${l/#$HOME/\~}"
        elif [[ -L $l && ! -e $l ]]; then
          rm -f "$l" || { warn "could not remove ${l/#$HOME/\~}"; continue; }
        elif [[ -L $l ]]; then
          continue # still resolves: the unit it points at did not move
        fi
        undo+=("${l/#$HOME/\~} removed; undo: systemctl --user enable g16-winlock.service (after moving the unit back)")
      done
      if ((DRY_RUN)); then
        info "[dry-run] would run: systemctl --user daemon-reload, try-restart g16-winlock.service"
      else
        systemctl --user daemon-reload 2>/dev/null || true
        # A running local instance keeps its old ExecStart and drop-in until it restarts.
        systemctl --user try-restart g16-winlock.service 2>/dev/null || true
      fi
    else
      warn "kept: your local unit stays in charge of Win-lock."
    fi
  fi

  # A separate question: this one needs sudo. udev reads only *.rules, so the
  # .before-omarchy-asus suffix is enough to stop it.
  if ((${#rules[@]})); then
    if confirm "Move ${rules[*]} aside (needs sudo)? The packaged 70-g16-winlock-hidraw.rules does the same."; then
      for f in "${rules[@]}"; do
        a=$(aside_path "$f")
        if as_root mv "$f" "$a"; then
          moved_rule=1
          undo+=("$f -> ${a##*/}; undo: sudo mv $a $f && sudo udevadm control --reload")
        else
          warn "could not move $f; it stays in place"
        fi
      done
      if ((moved_rule)); then
        as_root udevadm control --reload || warn "udevadm control --reload failed; the old rule applies until a reboot"
        as_root udevadm trigger --subsystem-match=hidraw --action=add || warn "udevadm trigger failed"
      fi
    else
      warn "kept: ${rules[*]} still applies next to the packaged rule."
    fi
  fi

  if ((${#undo[@]})); then
    if ((DRY_RUN)); then info "[dry-run] would move aside:"; else ok "moved aside:"; fi
    for line in "${undo[@]}"; do info "  $line"; done
  fi
  return 0
}

# Hand-made copies in /etc of the two fixes omarchy-asus-g16 ships (#136), once the package
# is installed: a udev rule in /etc/udev/rules.d that disarms the ASUF1209 touchpad wake
# (the package has 99-omarchy-asus-g16-touchpad-wake.rules), offered to move aside with
# sudo; and HibernateMode= lines in /etc/systemd/sleep.conf or sleep.conf.d/*.conf (the
# package has omarchy-asus-g16-hibernate-mode.conf), only reported, because those files
# may hold other settings. A rule some package owns is not yours and stays.
retire_local_g16_fixes() {
  pacman -Q omarchy-asus-g16 >/dev/null 2>&1 || ((DRY_RUN)) || return 0
  local rules=() sleeps=() others=() undo=() f a n body hit line moved=0
  local comment='^[[:space:]]*#'
  local mode='^[[:space:]]*HibernateMode[[:space:]]*='
  local shutdown='^[[:space:]]*HibernateMode[[:space:]]*=[[:space:]]*shutdown[[:space:]]*$'
  for f in "$G16_UDEV_DIR"/*.rules; do
    [[ -f $f && ! -L $f ]] || continue
    body=$(grep -vE "$comment" "$f" || true)
    [[ $body == *ASUF1209* && $body == *power/wakeup* ]] || continue
    # pacman gets the real path (ROOT is only the test hook), as in unowned_etc_of.
    pacman -Qqo "${f#"$ROOT"}" >/dev/null 2>&1 && continue
    rules+=("$f")
  done
  for f in "$G16_SLEEP_CONF" "$G16_SLEEP_DROPIN_DIR"/*.conf; do
    [[ -f $f && -r $f ]] || continue
    while IFS= read -r hit; do
      n=${hit%%:*}
      line=${hit#*:}
      sleeps+=("$f:$n: $line")
      [[ $line =~ $shutdown ]] || others+=("$f:$n")
    done < <(grep -nE "$mode" "$f" || true)
  done
  ((${#rules[@]} + ${#sleeps[@]})) || return 0

  step "Local copies of the omarchy-asus-g16 fixes"
  # udev reads only *.rules, so the .before-omarchy-asus suffix is enough to stop it, and
  # a re-run does not find the moved rule again.
  if ((${#rules[@]})); then
    for f in "${rules[@]}"; do
      info "  $f: your udev rule that disarms the ASUF1209 touchpad wake"
    done
    if confirm "Move ${rules[*]} aside (needs sudo)? omarchy-asus-g16 ships the same fix in /usr/lib/udev/rules.d/99-omarchy-asus-g16-touchpad-wake.rules."; then
      for f in "${rules[@]}"; do
        a=$(aside_path "$f")
        if as_root mv "$f" "$a"; then
          moved=1
          undo+=("$f -> ${a##*/}; undo: sudo mv $a $f && sudo udevadm control --reload")
        else
          warn "could not move $f; it stays in place"
        fi
      done
      if ((moved)); then
        as_root udevadm control --reload || warn "udevadm control --reload failed; the old rule applies until a reboot"
        as_root udevadm trigger --action=add --subsystem-match=i2c '--sysname-match=i2c-ASUF1209:*' || warn "udevadm trigger failed"
      fi
    else
      warn "kept: ${rules[*]} still applies next to the packaged rule."
    fi
  fi

  # Report only: these files may hold other sleep settings, so they are never written.
  if ((${#sleeps[@]})); then
    info "These set HibernateMode next to omarchy-asus-g16's /usr/lib/systemd/sleep.conf.d/omarchy-asus-g16-hibernate-mode.conf (HibernateMode=shutdown):"
    for line in "${sleeps[@]}"; do info "  $line"; done
    info "The files may hold other settings, so they are left alone: delete the HibernateMode= line once you no longer need it."
    for line in "${others[@]}"; do
      warn "$line sets a HibernateMode other than shutdown and can override the packaged one"
    done
  fi

  if ((${#undo[@]})); then
    if ((DRY_RUN)); then info "[dry-run] would move aside:"; else ok "moved aside:"; fi
    for line in "${undo[@]}"; do info "  $line"; done
  fi
  return 0
}

# The way back from a bad driver or migration: a snapper snapshot taken (and seen in the
# list) right before the upgrade. 'omarchy update' tries one too, but carries on without it
# (#85). Returns 0 only when the snapshot it just took exists.
take_snapshot() {
  step "Taking a snapshot before the upgrade"
  if ! command -v snapper >/dev/null || [[ ! -f $SNAPPER_CONFIG ]]; then
    warn "snapper has no root config, so no snapshot can be taken"
    return 1
  fi
  if ((DRY_RUN)); then
    as_root snapper -c root create -c number -d 'before omarchy-asus' --print-number
    info "[dry-run] would check that the new snapshot appears in snapper -c root list"
    return 0
  fi
  local num list
  if ! num=$(sudo snapper -c root create -c number -d 'before omarchy-asus' --print-number); then
    warn "snapper could not create a snapshot"
    return 1
  fi
  num=${num//[[:space:]]/}
  if [[ ! $num =~ ^[0-9]+$ ]]; then
    warn "snapper did not print a snapshot number"
    return 1
  fi
  # CSV, one number per line: the table output draws its columns with Unicode box
  # characters in a UTF-8 locale, so splitting it on '|' would never find the number.
  list=$(sudo snapper --csvout -c root list --columns number 2>/dev/null) || list=''
  if ! N=$num awk '{ f = $0; gsub(/[[:space:]"]/, "", f); if (f == ENVIRON["N"]) found = 1 }
      END { exit !found }' <<<"$list"; then
    warn "snapshot $num does not appear in snapper list"
    return 1
  fi
  ok "snapshot $num taken (before omarchy-asus)"
  info "Limine lists it as a boot entry once limine-snapper-sync picks it up."
}

# Take the snapshot; without one, stop short of the upgrade unless --force. Returns 0 to go on.
snapshot_gate() {
  take_snapshot && return 0
  if ((FORCE)); then
    warn "no snapshot: upgrading anyway because of --force. A bad driver or migration then has no way back."
    return 0
  fi
  warn "not upgraded: without a snapshot, a bad driver or omarchy migration has no way back ('omarchy update' carries on without one)."
  warn "Fix snapper (sudo snapper -c root create -d test), or run again with --force. The package databases are synced but the system is not upgraded: run 'omarchy update' before you install anything else."
  return 1
}

offer_upgrade() {
  step "What the system upgrade would change"
  if ((DRY_RUN)); then
    info "[dry-run] would list: pacman -Qu, with the packages coming from [$REPO] marked"
    snapshot_gate || return 0
    confirm "Upgrade now?"
    run_upgrade
    return 0
  fi
  local repo_pkgs updates name
  repo_pkgs=" $(pacman -Slq "$REPO" 2>/dev/null | tr '\n' ' ') "
  updates=$(pacman -Qu 2>/dev/null || true)
  if [[ -z $updates ]]; then
    ok "nothing to upgrade"
    return 0
  fi
  while read -r name _; do
    if [[ $repo_pkgs == *" $name "* ]]; then
      printf '    %s[%s]%s %s\n' "$CLR_BOLD" "$REPO" "$CLR_OFF" "$(grep -m1 "^$name " <<<"$updates")"
    else
      printf '                   %s\n' "$(grep -m1 "^$name " <<<"$updates")"
    fi
  done <<<"$updates"
  snapshot_gate || return 0
  if confirm "Upgrade now with 'omarchy update'? (it asks once more before it starts)"; then
    run_upgrade
  else
    warn "not upgraded. The package databases are synced but the system is not upgraded:"
    warn "run 'omarchy update' before you install anything else."
  fi
}

# Optional last step: the G16 fix packages, then the fixes that live in your own
# config or in /etc (omarchy-asus-g16-apply). Nothing happens unless you say yes,
# and omarchy-asus-g16-apply leaves alone any fix you already have in your own form.
offer_g16_fixes() {
  step "Optional: G16 fixes for a fresh install"
  # omarchy-asus-g16-apply runs only on a GA605KM (its own DMI check, the same
  # as omarchy-hw-match GA605KM) unless it gets --force.
  local product family apply_opts=()
  product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
  family=$(cat /sys/class/dmi/id/product_family 2>/dev/null || true)
  if [[ ${product,,} != *ga605km* && ${family,,} != *ga605km* ]]; then
    if ((FORCE)); then
      warn "not a GA605KM; passing --force to omarchy-asus-g16-apply because of --force"
      apply_opts=(--force)
    else
      info "skipped: these fixes are for the GA605KM ('$product')"
      return 0
    fi
  fi
  info "Packages: ${G16_PKGS[*]}. omarchy-asus-g16-apply then lists the fixes that"
  info "live in your config or /etc (video decode on the iGPU, HDMI cursor, speaker level, rtkit,"
  info "asusd, Win-lock service) and applies the missing ones. Settings you already have are kept."
  local overwrite=() p
  if ((DRY_RUN)); then
    confirm "Install them and review the fixes?"
    if ! check_unowned_etc_install "${G16_PKGS[@]}"; then
      warn "the G16 packages were not installed."
      return 0
    fi
    for p in "${INSTALL_OVERWRITE[@]}"; do overwrite+=(--overwrite "$p"); done
    as_root pacman -S --needed "${overwrite[@]}" "${G16_PKGS[@]}"
    retire_local_winlock
    retire_local_g16_fixes
    info "[dry-run] would run: omarchy-asus-g16-apply ${apply_opts[*]} --check, ask, then omarchy-asus-g16-apply ${apply_opts[*]} --yes"
    return 0
  fi
  if [[ -n $(pacman -Qu 2>/dev/null) ]]; then
    warn "the system isn't fully upgraded, and installing packages now would be a partial upgrade."
    warn "Later: 'omarchy update', then 'sudo pacman -S ${G16_PKGS[*]}' and 'omarchy-asus-g16-apply'."
    return 0
  fi
  local available=() pkg rc=0
  for pkg in "${G16_PKGS[@]}"; do
    if pacman -Si "$REPO/$pkg" >/dev/null 2>&1; then
      available+=("$pkg")
    else
      warn "$pkg is not in the $REPO repo yet; skipping it"
    fi
  done
  ((${#available[@]})) || return 0
  if ! confirm "Install ${available[*]} and review the fixes?"; then
    info "skipped. Later: 'sudo pacman -S ${G16_PKGS[*]}', then 'omarchy-asus-g16-apply'."
    return 0
  fi
  # Identical means overwrite, different means stop, as for the upgrade (check_unowned_etc).
  if ! check_unowned_etc_install "${available[@]}"; then
    warn "the G16 packages were not installed. Later: 'sudo pacman -S ${available[*]}', then 'omarchy-asus-g16-apply'."
    return 0
  fi
  for p in "${INSTALL_OVERWRITE[@]}"; do overwrite+=(--overwrite "$p"); done
  as_root pacman -S --needed "${overwrite[@]}" "${available[@]}" || { warn "install failed; skipping the fixes"; return 0; }
  retire_local_winlock
  retire_local_g16_fixes
  command -v omarchy-asus-g16-apply >/dev/null || return 0
  omarchy-asus-g16-apply "${apply_opts[@]}" --check || rc=$?
  if ((rc == 10)); then
    if confirm "Apply the missing default fixes listed above?"; then
      omarchy-asus-g16-apply "${apply_opts[@]}" --yes || warn "some fixes failed; run 'omarchy-asus-g16-apply' again to retry"
    else
      info "skipped. Run 'omarchy-asus-g16-apply' whenever you like ('--check' changes nothing)."
    fi
  elif ((rc == 0)); then
    ok "every default fix is in place"
  fi
}

do_install() {
  banner
  check_user
  check_model
  set_channel
  step "Channel"
  info "[omarchy] is on Omarchy's $(omarchy_channel) channel: setting up our $CHANNEL channel (the $GH_TAG release)."
  info "Switch both together later with Omarchy's 'omarchy-channel-set stable|rc': the hook moves [$REPO] with it."
  preflight_warnings
  confirm "Switch this machine to the EXPERIMENTAL omarchy-asus repo?" || die "cancelled"
  fetch_key
  # The RC release may not exist yet: stop before anything changes rather than at the keyring.
  if [[ $CHANNEL == rc ]]; then preview_repo required; else preview_repo; fi
  install_key
  install_snippet
  install_hook
  apply_hook
  install_keyring
  prepare_power_owner
  check_unowned_etc
  offer_upgrade
  offer_g16_fixes
  step "Done"
  info "Later 'omarchy refresh pacman' runs keep the repo in place through the hook."
  info "Undo with: $SELF --uninstall"
}

# Installed packages that come from the repo, without the keyring (removed on its own):
# the repo's package list against the installed ones, plus any installed REPO_ONLY_PKGS
# in case the repo database isn't synced.
repo_installed() {
  local pkg
  {
    comm -12 <(pacman -Slq "$REPO" 2>/dev/null | sort -u) <(pacman -Qq 2>/dev/null | sort -u) || true
    for pkg in "${REPO_ONLY_PKGS[@]}"; do
      if pacman -Q "$pkg" >/dev/null 2>&1; then echo "$pkg"; fi
    done
  } | sort -u | grep -vxF "$KEYRING_PKG" || true
}

# After going back: the packages from the repo that no other repo has. Once the repo is
# gone they never update. Removing them is offered, defaulting to no.
offer_leftover_removal() {
  local snapshot=("$@") leftovers=() elsewhere sl pkg
  step "Packages only the $REPO repo had"
  # Without a full listing, stock replacements (linux-omarchy) would look repo-only.
  if ! sl=$(pacman -Sl 2>/dev/null) || [[ -z $sl ]]; then
    warn "could not list the configured repos (pacman -Sl); skipping the leftover check."
    return 0
  fi
  elsewhere=" $(awk -v repo="$REPO" '$1 != repo { print $2 }' <<<"$sl" | tr '\n' ' ') "
  for pkg in "${snapshot[@]}"; do
    [[ $elsewhere == *" $pkg "* ]] && continue
    pacman -Q "$pkg" >/dev/null 2>&1 || continue
    leftovers+=("$pkg")
  done
  if ((${#leftovers[@]} == 0)); then
    ok "none installed"
    return 0
  fi
  info "These came from the $REPO repo, have no stock build, and no longer get updates:"
  for pkg in "${leftovers[@]}"; do
    info "  $pkg"
  done
  if [[ " ${leftovers[*]} " == *" omarchy-asus-g16 "* ]]; then
    info "omarchy-asus-g16 sets HibernateMode=shutdown; removing it restores the stock hibernate mode."
  fi
  if confirm "Remove them with 'pacman -Rns'?"; then
    as_root env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Rns "${leftovers[@]}" ||
      warn "could not remove them. Run 'sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Rns ${leftovers[*]}' to retry."
  else
    info "kept. Remove them later with 'sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Rns ${leftovers[*]}'."
  fi
}

do_uninstall() {
  check_user
  local snapshot=()
  mapfile -t snapshot < <(repo_installed)
  step "Removing the omarchy-asus repo"
  info "This removes the hook, the repo section, the keyring package and the key, then runs"
  info "pacman -Syuu so the omarchy-asus builds go back to the stock ones. Before that it warns"
  info "about the stock NVIDIA driver's hibernate hang; afterwards it lists the packages only"
  info "the repo had and offers to remove them (default no)."
  confirm "Continue?" || die "cancelled"

  step "Removing the pre-refresh hook"
  if [[ -e $HOOK ]]; then
    if ((DRY_RUN)); then info "[dry-run] rm $HOOK"; else rm -f "$HOOK" && ok "removed $HOOK"; fi
  else
    ok "not present"
  fi

  step "Removing the repo from $SNIPPET and $CONF"
  local rest
  rest=$(snippet_without_repo)
  if [[ -n ${rest//[[:space:]]/} ]]; then
    info "other repos remain in $SNIPPET; keeping the file and its Include line"
    [[ $(<"$SNIPPET") == "$rest" ]] || write_root "$SNIPPET" "$rest"
  else
    if grep -qxF "$MARKER" "$CONF"; then
      # shellcheck disable=SC2016 # sed program, same as LAPTOP-SETUP.md section 5
      as_root sed -i '\|^Include = /etc/pacman.d/custom-repos.conf$|{$d;N;/\n$/d;D}' "$CONF"
    fi
    if [[ -e $SNIPPET ]]; then as_root rm -f "$SNIPPET"; else ok "$SNIPPET not present"; fi
  fi

  step "Removing $KEYRING_PKG and the repo key"
  if pacman -Q "$KEYRING_PKG" >/dev/null 2>&1; then
    as_root pacman -R --noconfirm "$KEYRING_PKG"
  fi
  as_root pacman-key --delete "$FPR" || warn "key $FPR was not in pacman's keyring"

  # `omarchy update` runs pacman -Syu, which never downgrades, so this one
  # transaction bypasses Omarchy's update guard with its documented override.
  step "Going back to the stock builds"
  if ((DRY_RUN)) || [[ " ${snapshot[*]} " == *" nvidia-open-dkms "* ]] || pacman -Q nvidia-open-dkms >/dev/null 2>&1; then
    warn "the stock nvidia-open-dkms lacks the NVIDIA/open-gpu-kernel-modules#1412 fix. On a GA605KM the"
    warn "machine can hang at power-off after writing the hibernate image (omarchy-asus #11)."
    warn "Suspend-then-hibernate is the default lid action, so the battery can drain overnight."
    warn "To avoid it, keep a locally patched driver (for example, add nvidia-open-dkms to IgnorePkg"
    warn "in $CONF before going back), or disable hibernation until #1412 lands."
  fi
  if confirm "Run 'pacman -Syuu' now? (-uu downgrades the omarchy-asus builds to stock)"; then
    as_root env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syuu
  else
    warn "skipped. Run 'sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syuu' to go back to the stock builds."
  fi

  offer_leftover_removal "${snapshot[@]}"
}

# --channel is retired (#201): switching is Omarchy's omarchy-channel-set alone, and the
# pre-refresh hook moves [omarchy-asus] to the matching channel. An older hook doesn't, so
# say whether this machine's needs a rerun first.
do_channel() {
  local want
  want=$(channel_omarchy "$CHANNEL_ARG" 2>/dev/null) || want='stable|rc'
  [[ $CHANNEL_ARG == stable ]] && want=stable
  warn "--channel is retired: switch channels with Omarchy's own 'omarchy-channel-set $want'."
  info "The pre-refresh hook moves [$REPO] with it: Omarchy stable takes our x86_64 release, Omarchy rc rc-x86_64."
  if [[ -f $HOOK && $(<"$HOOK") != "$HOOK_CONTENT" ]]; then
    warn "$HOOK is an older copy that doesn't move [$REPO]: run $SELF once first to update it."
  elif [[ ! -f $HOOK ]]; then
    warn "the $REPO repo is not set up on this machine (no $HOOK); run $SELF first."
  fi
  exit 2
}

# Tests source this file to call its functions; they stop here, before anything runs.
[[ ${OMARCHY_ASUS_SETUP_SOURCE_ONLY:-0} == 1 ]] && return 0

((DRY_RUN)) && printf '%s(dry run: privileged commands and file writes are printed, not run)%s\n' "$CLR_YELLOW" "$CLR_OFF"
case $MODE in
  install) do_install ;;
  uninstall) do_uninstall ;;
  channel) do_channel ;;
esac
