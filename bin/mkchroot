#!/bin/bash
# Create (or update) the clean build chroot of a release channel. Needs sudo (or root).
# Usage: bin/mkchroot [--channel quattro|rc]
# quattro: $CHROOT from build/pacman.conf (Omarchy stable); rc: its own chroot from
# build/pacman-rc.conf (Omarchy rc). An update rewrites the chroot's pacman.conf from the
# channel's, so the two never share package sources. Both get the same packager
# ($PACKAGER_LINE, bin/env.sh).
set -euo pipefail
# --channel quattro|rc, first: the release channel (bin/env.sh); default quattro
if [[ ${1:-} == --channel ]]; then export OMARCHY_ASUS_CHANNEL=${2:?--channel needs quattro or rc}; shift 2; fi
source "$(dirname "$0")/env.sh"
MAKEPKG_CONF=/usr/share/devtools/makepkg.conf.d/x86_64.conf
as_root=(sudo); [[ $EUID -ne 0 ]] || as_root=()
if [[ -d $CHROOT/root ]]; then
    "${as_root[@]}" arch-nspawn -C "$PACMAN_CONF" "$CHROOT/root" pacman -Syu --noconfirm
else
    "${as_root[@]}" mkdir -p "$CHROOT"
    "${as_root[@]}" mkarchroot -C "$PACMAN_CONF" -M "$MAKEPKG_CONF" "$CHROOT/root" base-devel
fi
if ! chroot_packager_ok "$CHROOT/root"; then
    "${as_root[@]}" mkdir -p "$CHROOT/root/${PACKAGER_FILE%/*}"
    printf '%s\n' "$PACKAGER_LINE" | "${as_root[@]}" tee "$CHROOT/root/$PACKAGER_FILE" >/dev/null
    "${as_root[@]}" chmod 644 "$CHROOT/root/$PACKAGER_FILE"
fi
