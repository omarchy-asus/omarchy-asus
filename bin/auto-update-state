#!/usr/bin/env python3
"""State and planning helpers for bin/auto-update (runs as the build user).

  plan CHECK_JSON STATUS_JSON        print the run plan, one TSV line per recipe:
                                     recipe action target repo_names all_names note
  record STATUS_JSON RUN_ID RECIPE RESULT ACTION [key=value...]
                                     update the recipe's entry (RESULT: ok, failed,
                                     attention, skipped) and append it to its history
  forget STATUS_JSON RECIPE          drop the recipe's entry (e.g. "(upstream dbs)" once the
                                     dbs recover), so it no longer shows as an earlier run
  get STATUS_JSON RECIPE KEY        print one field of a recipe's last entry
  summary STATUS_JSON RUN_ID OUT_MD  write the human summary, print it, exit 1 if a
                                     recipe failed this run (2 if only attention items)
  review VERDICT_JSON                parse a headless review's JSON output: prints
                                     "approve" or "reject" on line 1, the notes after
  replies VERDICT_JSON               the review's thread replies, "id<TAB>reply" per line
  revdep-withdraw REVDEPS_CONF WITHDRAWN_CSV REPO_NAMES_CSV
                                     "headers<TAB>dkms" for each build/revdeps.conf pair whose
                                     headers package is withdrawn while its DKMS package stays
                                     in the repo (CSVs may be empty or "-"); nothing for a
                                     missing conf, exit 1 for an unreadable one
  counterpart-key ITEM...            one key (sha256) for a revdep check's counterparts: each
                                     ITEM is a package file (basename + content hash) or
                                     "stock:NAME=VERSION"; "none" with no items

Plan actions:
  rebase     upstream moved past our base: rebase the recipe onto TARGET (= upstream)
  build      recipe on the base branch is not in the repo db, or the db holds another
             version (not-built / repo-stale): build and publish it as is
  unpublish  stale and nothing to rebuild from (dep-mismatch), or a db entry with no
             recipe whatever its status (the recipe was removed): drop it so the stock
             build flows through
  attention  needs a human (upstream merged/closed one of our PRs, upstream older than
             our base, bad pkgrel, not in any upstream repo); no automatic change
An upstream db that check-upstream could not fetch past its grace period ("expired" in its
JSON) withdraws every overriding package (unpublish; attention when not in the repo), so the
stock build flows through instead of a pin planned on stale data; local-only recipes are not
affected. A db that is merely stale ("degraded") only adds a note to non-current lines.
Config via env: SKIP_RECIPES (space separated), BUILD_NOT_BUILT (yes/no),
KEEP_PUBLISHED (space separated package names kept despite having no recipe).
While check-upstream reports inventory_errors (or the check JSON has no inventory_errors
key), a db entry with no recipe is unpublished only when it is stale (rebuild-needed,
dep-mismatch, upstream-older), as before #82.
A recipe with a HOLD file (first non-comment line: the reason) is never built or published;
a stale published copy of it is unpublished.
"""
import hashlib
import json
import os
import re
import sys
import time

HISTORY = 30


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"recipes": {}}


def save(path, data):
    data["updated"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, path)


def plan(check_path, status_path):
    check = json.load(open(check_path))
    # The inventory is complete only when check-upstream says so with an empty list; a missing
    # key (an old or hand-made JSON) counts as incomplete, so nothing is unpublished for it.
    inv_errors = check.get("inventory_errors")
    skip = set(os.environ.get("SKIP_RECIPES", "").split())
    keep = set(os.environ.get("KEEP_PUBLISHED", "").split())
    build_not_built = os.environ.get("BUILD_NOT_BUILT", "yes") == "yes"
    by_recipe = {}
    for row in check["packages"]:
        key = row["recipe"] or f"(db) {row['name']}"
        by_recipe.setdefault(key, []).append(row)
    prs = {}
    for p in check.get("prs", []):
        prs.setdefault(p["recipe"], []).append(p)
    # Upstream db freshness (bin/check-upstream --json; all keys optional for older output).
    dbs = [d for d in check.get("upstream_dbs") or [] if isinstance(d, dict)]
    expired = list(check.get("expired") or [])
    expired_note = degraded_note = None
    if expired:
        age = db_age_text([d for d in dbs if d.get("repo") in expired])
        expired_note = (f"upstream db(s) {', '.join(map(str, expired))} unreachable past the "
                        f"{db_hours(check.get('db_max_stale'))} grace" + (f" ({age})" if age else ""))
    elif check.get("degraded"):
        stale = [d for d in dbs if d.get("stale") or d.get("expired")] or [d for d in dbs if d.get("error")]
        names = ", ".join(str(d.get("repo")) for d in stale) or "?"
        age = db_age_text(stale)
        degraded_note = f"upstream db(s) {names} stale (fetch failed" + (f", {age})" if age else ")")
    out = []
    for recipe, rows in sorted(by_recipe.items(), key=lambda kv: (kv[0] in HEAVY, kv[0])):
        statuses = {r["status"] for r in rows}
        names = [r["name"] for r in rows]
        in_repo = [r["name"] for r in rows if r["repo"]]
        notes = []
        for p in prs.get(recipe, []):
            if p["state"] in ("merged", "closed"):
                notes.append(f"upstream PR {p['pr']} is {p['state']}: re-check the patch carrying it (not dropped automatically)")
        for r in rows:
            for m in r.get("dep_mismatch") or []:
                notes.append(f"{r['name']} needs {m['dep']}={m['want']}, upstream has {m['upstream'] or 'none'}")
        target = max((r["upstream"] for r in rows if r["upstream"]), default="", key=VerKey)
        hold = next((r.get("hold") for r in rows if r.get("hold")), None)
        if recipe in skip:
            action, notes = "attention", notes + [f"skipped by SKIP_RECIPES ({', '.join(sorted(statuses))})"]
        elif (expired and not all(r.get("local_only") for r in rows) and any(r["upstream"] for r in rows)
              and not (not rows[0]["recipe"] and any(n in keep for n in names))):
            # Planned on a db copy past its grace: withdraw the override rather than keep or build it
            # (not a package with no stock build to fall back to, nor one KEEP_PUBLISHED retains).
            if in_repo:
                action = "unpublish"
                notes.append(f"{expired_note}: withdrawn so the stock build flows through")
            else:
                action = "attention"
                notes.append(f"{expired_note}: not built or rebased on stale data")
        elif hold and in_repo and (statuses & {"rebuild-needed", "dep-mismatch"} or any(
                r["repo"] and r["upstream"] and VerKey(re.sub(r"\.\d+$", "", r["repo"])) < VerKey(r["upstream"])
                for r in rows)):
            # Held recipes never get (re)published; a copy behind upstream still goes, so stock flows.
            action = "unpublish"
            notes.append(f"held ({hold}); stale copy unpublished instead of rebased")
        elif hold:
            action = "attention"
            notes.append(f"held, not built or published: {hold} ({', '.join(sorted(statuses))})")
        elif not rows[0]["recipe"]:
            # The recipe was removed: withdraw what is still published, whatever its status,
            # unless KEEP_PUBLISHED names it or the recipe inventory may be missing recipes.
            if any(n in keep for n in names):
                action = "attention"
                notes.append("in the repo db without a recipe; kept by KEEP_PUBLISHED")
            elif inv_errors != [] and statuses & {"rebuild-needed", "dep-mismatch", "upstream-older"}:
                # Stale whatever the inventory says: a lagging pin blocks stock updates.
                action = "unpublish"
                notes.append("in the repo db without a recipe and no longer current")
            elif inv_errors != []:
                action = "attention"
                why = ", ".join(map(str, inv_errors)) if inv_errors else "no inventory_errors in check"
                notes.append(f"in the repo db without a recipe, but the recipe inventory is incomplete ({why}): not unpublished")
            else:
                action = "unpublish"
                notes.append(f"in the repo db without a recipe: withdrawn (status: {', '.join(sorted(statuses))})")
        elif "rebuild-needed" in statuses:
            action = "rebase"
        elif "dep-mismatch" in statuses:
            action = "unpublish" if in_repo else "attention"
        elif statuses & {"bad-pkgrel", "not-upstream", "upstream-older"}:
            action = "attention"
            notes.append("status: " + ", ".join(sorted(statuses)))
        elif statuses & {"not-built", "repo-stale"}:
            action = "build" if build_not_built else "attention"
            notes.append("status: " + ", ".join(sorted(statuses)))
        elif notes:
            action = "attention"
        else:
            action = "current"
        if degraded_note and action != "current":
            notes.append(degraded_note)
        out.append("\t".join([recipe, action, target, ",".join(in_repo) or "-", ",".join(names),
                              "; ".join(notes) or "-"]))
    print("\n".join(out))


HEAVY = {"linux-omarchy"}  # built last: an hour of chroot time


def db_hours(seconds):
    """'24h' for a number of seconds; '?' when unknown."""
    try:
        return f"{int(seconds) // 3600}h"
    except (TypeError, ValueError):
        return "?"


def db_age_text(entries):
    """'cached copy 73h old' for the oldest known age among upstream_dbs entries, else ''."""
    ages = []
    for d in entries:
        try:
            ages.append(int(d.get("age")))
        except (TypeError, ValueError):
            pass
    return f"cached copy {max(ages) // 3600}h old" if ages else ""


def csv_set(text):
    return {x for x in (text or "").split(",") if x and x != "-"}


def revdep_withdraw(conf, withdrawn_csv, repo_csv):
    """Pairs of build/revdeps.conf (parsed like bin/auto-update's revdep_lines) whose headers
    package is withdrawn while the DKMS package stays published: "headers<TAB>dkms"."""
    withdrawn, repo = csv_set(withdrawn_csv), csv_set(repo_csv)
    if not os.path.exists(conf):
        return 0
    # Present but unreadable (a directory, no permission): fail, so the caller withdraws
    # nothing rather than skip the retained DKMS package's check.
    try:
        with open(conf) as f:
            lines = f.read().splitlines()
    except OSError as e:
        print(f"revdep-withdraw: cannot read {conf}: {e.strerror or e}", file=sys.stderr)
        return 1
    for line in lines:
        parts = line.split(None, 2)
        if not parts or parts[0].startswith("#") or len(parts) < 2 or not parts[1].startswith("dkms:"):
            continue
        src, dkms = parts[0], parts[1][len("dkms:"):]
        opt = parts[2].strip() if len(parts) > 2 else ""
        hdr = opt[len("headers="):] if opt.startswith("headers=") else f"{src}-headers"
        if hdr in withdrawn and dkms not in withdrawn and dkms in repo:
            print(f"{hdr}\t{dkms}")
    return 0


def counterpart_key(items):
    """sha256 over '<basename> <sha256>' per file and the 'stock:NAME=VERSION' items as given."""
    if not items:
        print("none")
        return 0
    parts = []
    for item in items:
        if item.startswith("stock:"):
            parts.append(item)
            continue
        try:
            with open(item, "rb") as f:
                digest = hashlib.sha256(f.read()).hexdigest()
        except OSError as e:
            print(f"counterpart-key: cannot read {item}: {e}", file=sys.stderr)
            return 1
        parts.append(f"{os.path.basename(item)} {digest}")
    print(hashlib.sha256("\n".join(parts).encode()).hexdigest())
    return 0


class VerKey:
    """Sort key using vercmp semantics (pyalpm-free)."""
    def __init__(self, v):
        self.v = v

    def __lt__(self, other):
        import subprocess
        return int(subprocess.run(["vercmp", self.v, other.v], capture_output=True, text=True).stdout) < 0


def record(status_path, run_id, recipe, result, action, kv):
    data = load(status_path)
    entry = {"run": run_id, "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "result": result, "action": action}
    for item in kv:
        k, _, v = item.partition("=")
        entry[k] = v
    rec = data["recipes"].setdefault(recipe, {"history": []})
    prev = rec.get("last", {})
    if entry.get("class") == "fetch":
        entry["consecutive_fetch_failures"] = str(int(prev.get("consecutive_fetch_failures", "0")) + 1)
    rec["last"] = entry
    rec["history"] = (rec.get("history", []) + [entry])[-HISTORY:]
    save(status_path, data)


def forget(status_path, recipe):
    """Drop a recipe's entry (a pseudo-recipe like "(upstream dbs)" once its cause is gone)."""
    data = load(status_path)
    data["recipes"].pop(recipe, None)
    save(status_path, data)
    return 0


def get(status_path, recipe, key):
    print(load(status_path)["recipes"].get(recipe, {}).get("last", {}).get(key, ""))


def summary(status_path, run_id, out_md):
    data = load(status_path)
    lines = ["# omarchy-asus auto-update status", "",
             f"Last run: `{run_id}` (updated {data.get('updated', '?')}). Machine-readable: `status.json`.", "",
             "| recipe | result | action | version | details |", "|---|---|---|---|---|"]
    worst = 0
    for recipe, rec in sorted(data["recipes"].items()):
        last = rec.get("last", {})
        this_run = last.get("run") == run_id
        res = last.get("result", "?")
        if this_run and res == "failed":
            worst = 1
        elif this_run and res == "attention" and worst == 0:
            worst = 2
        details = "; ".join(x for x in (last.get("class") and f"[{last['class']}]", last.get("message"),
                                        last.get("pr")) if x)
        lines.append(f"| {recipe} | {res}{'' if this_run else ' (earlier run)'} | {last.get('action', '')} | "
                     f"{last.get('version', '')} | {details.replace('|', '/')} |")
    text = "\n".join(lines) + "\n"
    tmp = out_md + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, out_md)
    print(text)
    return worst


def verdict_object(path):
    raw = open(path, errors="replace").read()
    text = raw
    try:
        obj = json.loads(raw)
        if isinstance(obj, dict) and "result" in obj:
            text = obj["result"] or ""
    except ValueError:
        pass
    for start in [i for i, ch in enumerate(text) if ch == "{"][::-1]:
        try:
            obj, _ = json.JSONDecoder().raw_decode(text[start:])
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("verdict") in ("approve", "reject"):
            return obj
    return None


def replies(path):
    obj = verdict_object(path) or {}
    for r in obj.get("replies") or []:
        if isinstance(r, dict) and str(r.get("id", "")).isdigit() and r.get("reply"):
            body = str(r["reply"]).replace("\t", " ").replace("\r", "").replace("\n", " / ")
            print(f"{r['id']}\t{body[:3000]} (auto-update agent)")


def review(path):
    """Accept `claude -p --output-format json` output ({"result": "..."}) or plain text."""
    raw = open(path, errors="replace").read()
    text = raw
    try:
        obj = json.loads(raw)
        if isinstance(obj, dict) and "result" in obj:
            text = obj["result"] or ""
            if obj.get("is_error"):
                print("reject")
                print(f"review run reported an error: {text[:2000]}")
                return
    except ValueError:
        pass
    verdict, notes = None, text.strip()
    # the prompt asks for a final JSON object {"verdict": ..., "notes": ...}
    for start in [i for i, ch in enumerate(text) if ch == "{"][::-1]:
        try:
            obj, _ = json.JSONDecoder().raw_decode(text[start:])
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("verdict") in ("approve", "reject"):
            verdict, notes = obj["verdict"], str(obj.get("notes", "")).strip()
            break
    print(verdict or "reject")
    print(notes if verdict else f"could not find a verdict in the review output:\n{notes[:2000]}")


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 1
    cmd, a = argv[1], argv[2:]
    if cmd == "plan" and len(a) == 2:
        plan(*a)
    elif cmd == "record" and len(a) >= 5:
        record(a[0], a[1], a[2], a[3], a[4], a[5:])
    elif cmd == "forget" and len(a) == 2:
        return forget(*a)
    elif cmd == "get" and len(a) == 3:
        get(*a)
    elif cmd == "summary" and len(a) == 3:
        return summary(*a)
    elif cmd == "review" and len(a) == 1:
        review(a[0])
    elif cmd == "replies" and len(a) == 1:
        replies(a[0])
    elif cmd == "revdep-withdraw" and len(a) == 3:
        return revdep_withdraw(*a)
    elif cmd == "counterpart-key":
        return counterpart_key(a)
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
