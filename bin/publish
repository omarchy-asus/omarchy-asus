#!/bin/bash
# Sign staged packages and add them to the repo db (signed). Removes superseded files.
# One locked, verified transaction (bin/publish-lib.sh): it waits for $DATA/publish.lock
# (PUBLISH_LOCK_WAIT seconds, then exit 75), journals the change in $DATA/sync-pending,
# builds it in a staging copy of the repo, checks every signature there and only then
# swaps it in. Any failure exits non-zero and leaves the live repo as it was.
# Usage: bin/publish [--channel quattro|rc] $STAGE_DIR/foo-1-1.1-x86_64.pkg.tar.zst ...
# The channel (bin/env.sh, default quattro) picks the local repo ($REPO_DIR) and its
# journal; a package from another channel's stage dir is refused, so an RC build never
# reaches the x86_64 repo and a Quattro build never reaches the RC one.
# Release cohort members (build/cohorts.conf, e.g. omarchy + omarchy-settings) are published
# in one call, or next to a partner already in the db at the same version; otherwise this
# refuses before anything is copied or signed (bin/release-cohort check-publish). The check
# reads each archive's .PKGINFO (a file name that disagrees with it is refused) and refuses
# a missing $WORKSPACE/build/cohorts.conf.
# A filename names one file on every channel: pacman caches by filename, and each release
# only refuses its own duplicates. A package whose name the other channel's local repo or
# release already has with other bytes, or with a digest that can't be compared, is
# refused: bump the recipe's pkgrel (the RC channel's range starts at .101, 101 for our own
# packages; bin/rebase-recipe --channel rc). The other release is read live (one gh call:
# a superseded package stays on it until pruned) and nothing stands in for it: if gh
# can't read it, the publish is refused. A release not made yet has no assets.
set -euo pipefail
# --channel quattro|rc, first: the release channel (bin/env.sh); default quattro
if [[ ${1:-} == --channel ]]; then export OMARCHY_ASUS_CHANNEL=${2:?--channel needs quattro or rc}; shift 2; fi
source "$(dirname "$0")/env.sh"
# shellcheck source=bin/publish-lib.sh
source "$(dirname "$0")/publish-lib.sh"
: "${SIGN_KEY:?no signing key fingerprint in $DATA/fingerprint}"
names=()
for f in "$@"; do
    names+=("$(basename "$f")")
    real=$(realpath -m -- "$f")
    for c in "${CHANNELS[@]}"; do
        [[ $c != "$CHANNEL" ]] || continue
        other=$(realpath -m -- "$(channel_stage_dir "$c")")
        if [[ $real == "$other"/* ]]; then
            echo "publish: refusing $(basename "$f"): it was built for the $c channel ($other)," \
                "not $CHANNEL; publish it with --channel $c" >&2
            exit 1
        fi
    done
done
pub_lock
# The other channels' releases, read once: "name<TAB>size<TAB>digest" lines per channel
declare -A other_assets
for c in "${CHANNELS[@]}"; do
    [[ $c != "$CHANNEL" ]] || continue
    tag=$(channel_gh_tag "$c")
    rc=0; other_assets[$c]=$(pub_release_assets "$tag") || rc=$?
    if ((rc == 2)); then other_assets[$c]=''
    elif ((rc != 0)); then
        echo "publish: refusing: cannot read the $tag release, so a file it serves under one of" \
            "these names could differ; retry when GitHub answers" >&2
        exit 1
    fi
done
# cross_channel_clash <file> <channel>: print why the other <channel> already has another
# file by this name; nothing (exit 1) when it has none or the same bytes
cross_channel_clash() {
    local f=$1 c=$2 b sum repo d tag
    b=$(basename "$f")
    sum=$(sha256sum "$f" | cut -d' ' -f1) || { echo "cannot read $f"; return 0; }
    repo=$(channel_repo_dir "$c")
    [[ -e $repo || ! -e $repo.prev ]] || repo=$repo.prev   # a swap a killed run left half done
    if [[ -e $repo/$b && $(sha256sum "$repo/$b" | cut -d' ' -f1) != "$sum" ]]; then
        echo "the $c channel's local repo ($repo) has a different $b"; return 0
    fi
    tag=$(channel_gh_tag "$c")
    d=$(awk -F'\t' -v n="$b" '$1 == n {print $3; f = 1; exit} END {exit !f}' <<<"${other_assets[$c]}") ||
        return 1
    if [[ $d != sha256:?* ]]; then
        echo "the $c channel's release ($tag) serves a $b whose digest is unknown"; return 0
    fi
    if [[ ${d#sha256:} != "$sum" ]]; then
        echo "the $c channel's release ($tag) serves a different $b"; return 0
    fi
    return 1
}
for f in "$@"; do
    for c in "${CHANNELS[@]}"; do
        [[ $c != "$CHANNEL" ]] || continue
        if why=$(cross_channel_clash "$f" "$c"); then
            base=$(bsdtar -xOf "$f" .PKGINFO 2>/dev/null | awk '$1 == "pkgbase" {print $3; exit}') || true
            echo "publish: refusing $(basename "$f"): $why. A filename must name one file on every" \
                "channel (pacman caches by filename): bump pkgrel in recipes/${base:-<its recipe>}" \
                "(on the RC channel .101 and up, 101 for our own packages) and rebuild" >&2
            exit 1
        fi
    done
done
# checked under the lock, against the live db, before anything is journaled or staged
db_args=()
if [[ -f "$REPO_DIR/$REPO_NAME.db.tar.gz" ]]; then
    db_args=(--db "$REPO_DIR/$REPO_NAME.db.tar.gz")
fi
"$(dirname "$0")/release-cohort" --workspace "$WORKSPACE" check-publish "${db_args[@]}" "$@" || {
    echo "publish: refusing: a release cohort member would ship without its partner (build/cohorts.conf)" >&2
    exit 1
}
pub_mark_pending "publish ${names[*]}"
pub_stage
committed=0
trap 'if ((committed == 0)); then pub_abort; fi' EXIT
added=()
for f in "$@"; do
    b=$(basename "$f")
    # may be hardlinks into the live repo: replace, never write through them
    rm -f "$PUB_STAGE/$b" "$PUB_STAGE/$b.sig"
    cp -v "$f" "$PUB_STAGE/$b"
    gpg --batch --yes --local-user "$SIGN_KEY" --detach-sign --no-armor "$PUB_STAGE/$b"
    pub_verify_sig "$PUB_STAGE/$b"
    added+=("$PUB_STAGE/$b")
done
repo-add --sign --key "$SIGN_KEY" --verify --remove "$PUB_STAGE/$REPO_NAME.db.tar.gz" "${added[@]}"
# repo-add can exit 0 after a GPG failure and leave the previous .sig beside the new
# db: its exit status is not trusted, the staged repo is checked instead.
pub_verify_repo "$PUB_STAGE"
pub_commit
# shellcheck disable=SC2034  # read by the EXIT trap above
committed=1
