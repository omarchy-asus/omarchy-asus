#!/bin/bash
# Mirror $REPO_DIR to the GitHub release that pacman pulls from:
#   Server = https://github.com/$GH_REPO/releases/download/$GH_TAG
# Usage: bin/sync-release [--dry-run]
#        bin/sync-release --pii-scan FILE...   (only run the PII scan below on these files)
#        bin/sync-release --pii-scan-text FILE...   (the same scan, each file read as plain text)
#
# One transaction, under the publication lock ($DATA/publish.lock, shared with
# bin/publish and bin/unpublish; PUBLISH_LOCK_WAIT seconds, then exit 75) for the
# whole run: snapshot, uploads, verification and pruning (--dry-run too).
# - The snapshot's db and files must carry a good signature by $SIGN_KEY, and so
#   must every package (+ .sig) about to go up; otherwise nothing is uploaded.
# - One publisher: $DATA/release-db.sha256 records the db this host last put on the
#   release (plus any it uploaded since without verifying: each is appended before its
#   upload). If the release's db is none of those nor the local one, someone else
#   published: refuse (checked again right before the db upload) unless
#   SYNC_ADOPT_REMOTE=1. Without a record this host adopts the release as it is.
# - Incremental, to keep GitHub traffic (and the window where an asset 404s) small:
#   one API call reads the release's assets (name, size, sha256 digest); a package
#   already uploaded with the same bytes is skipped; a package filename that is
#   already uploaded with DIFFERENT bytes is refused (a rebuild must bump pkgrel:
#   pacman and caches treat a filename as immutable); new packages and signatures go
#   up first, the db/files (+ .sig) last and only when they changed.
# - Journal: after the uploads the release is read again and every db file, package
#   and signature the db names must match the local bytes. Only then is the db sum
#   recorded and $DATA/sync-pending cleared; any mismatch keeps it, for a retry.
# - Grace period: an asset the db no longer names is not deleted at once (a client
#   may hold the previous db). It is listed in $DATA/prune-candidates with the time
#   it was first seen unreferenced, and deleted by a later verified sync once it is
#   PRUNE_GRACE_HOURS (default 72; 0 deletes at once) old.
# Release assets can't be symlinks, so the db/files links are uploaded as real
# files under the names pacman requests.
#
# PII guard: before anything is uploaded, the new packages and the db are scanned
# (strings of every file in them, plus file names) against the denylist
# ($PII_DENYLIST, default ~/.config/agent-pii/denylist), whole-word and
# case-insensitive. A hit aborts the sync unless build/pii-allow-packages has a rule
# '<asset glob> <location glob>' for that asset AND every hit in it lies at an
# allowed location: a hit in a file name is at that member path, a hit in contents
# at '<member path>:<line>' (the strings line holding it). One hit anywhere else
# (.PKGINFO, .BUILDINFO, another member) still blocks. Only denylist line numbers are
# printed, never the entries, the matched text or its location. A missing denylist,
# an invalid regex in it, a malformed allow rule, a hit the located pass cannot place,
# an archive that cannot be listed or read to the end (truncated, not an archive) or
# any other failed scan step aborts too, never reads as clean (PII_SCAN=off skips the
# scan, for a machine without one).
# --pii-scan-text scans files as plain text, never as archives (bin/auto-update scans
# its PR comments and replies with it; build/pii-allow-packages does not apply).
set -euo pipefail
source "$(dirname "$0")/env.sh"
dry=0 scan_only=0 as_text=0
case ${1:-} in
    --dry-run) dry=1 ;;
    --pii-scan) scan_only=1; shift ;;
    --pii-scan-text) scan_only=1 as_text=1; shift ;;
esac
run() { if ((dry)); then echo "would run: $*"; else "$@"; fi; }

up=$(mktemp -d); trap 'rm -rf "$up"' EXIT
# --- PII scan (used below on what is about to become public) ---
pii_scan() {  # pii_scan <file>...: prints a line per file with hits, returns 1 if any is not allowed
    [[ ${PII_SCAN:-on} == off ]] && { echo "PII scan skipped (PII_SCAN=off)"; return 0; }
    local list=${PII_DENYLIST:-$HOME/.config/agent-pii/denylist}
    [[ -r $list ]] || { echo "PII denylist $list is missing; refusing to upload (PII_SCAN=off to skip)" >&2; return 1; }
    local allow=$WORKSPACE/build/pii-allow-packages g ag pg extra n=0
    local -a aglobs=() pglobs=()
    if [[ -r $allow ]]; then
        while IFS= read -r g; do
            n=$((n + 1)); g=${g%%#*}; ag='' pg='' extra=''
            read -r ag pg extra <<<"$g" || true
            [[ -z $ag ]] && continue
            if [[ -z $pg || -n $extra ]]; then  # a bare asset glob would allow the whole file
                echo "build/pii-allow-packages line $n: want '<asset glob> <location glob>'; refusing to upload" >&2
                return 1
            fi
            aglobs+=("$ag"); pglobs+=("$pg")
        done <"$allow"
    fi
    # Whole-word regex per denylist line (same rules as the publish guard's wrap()).
    local -a res=() nums=()
    local e pre post i=0 lineno=0
    while IFS= read -r e; do
        lineno=$((lineno + 1))
        [[ $e =~ ^[[:space:]]*(#|$) ]] && continue
        local alts=("$e")
        [[ $e == *'|'* && $e =~ ^[[:alnum:]|._@-]+$ ]] && IFS='|' read -ra alts <<<"$e"
        for a in "${alts[@]}"; do
            pre=''; post=''
            [[ $a =~ ^[[:alnum:]] ]] && pre='(^|[^[:alnum:]])'
            [[ $a =~ [[:alnum:]]$ ]] && post='([^[:alnum:]]|$)'
            res+=("$pre($a)$post"); nums+=("$lineno")
        done
    done <"$list"
    ((${#res[@]})) || return 0
    local pattern; pattern=$(IFS='|'; echo "${res[*]}")
    # Fail closed: an invalid entry makes grep exit 2 without scanning, which must not
    # read as "no hits". Check the combined pattern once; name bad lines, not entries.
    local st=0 bad=()
    grep -iE -- "$pattern" </dev/null >/dev/null 2>&1 || st=$?
    if ((st > 1)); then
        for i in "${!res[@]}"; do
            st=0; grep -iE -- "${res[$i]}" </dev/null >/dev/null 2>&1 || st=$?
            ((st > 1)) && bad+=("${nums[$i]}")
        done
        echo "PII denylist $list has an invalid regex (line(s) $(printf '%s\n' "${bad[@]:-?}" | sort -nu | paste -sd, -));" \
            "refusing to upload" >&2
        return 1
    fi
    local f rc=0 m hit
    for f in "$@"; do
        declare -A seen=()
        st=0
        if ((as_text)); then   # a PR comment or reply; an unreadable file is grep exit 2
            grep -aoiE -- "$pattern" "$f" >"$up/.hits" || st=$?
        else                   # a package or db: its file names and the strings of its contents
            # Every step is checked: an archive that cannot be listed or read to the end
            # (truncated, not an archive) must abort, not read as "no hits".
            local why='' ps=()
            : >"$up/.hits"
            if ! bsdtar -tf "$f" >"$up/.list" 2>/dev/null; then
                why="could not list it"
            else
                grep -oiE -- "$pattern" "$up/.list" >"$up/.hits" || st=$?
                if ((st > 1)); then
                    why="grep exit $st"
                else
                    st=0; ps=(0 0 0)
                    bsdtar -xOf "$f" 2>/dev/null | strings -n 4 | grep -oiE -- "$pattern" >>"$up/.hits" ||
                        ps=("${PIPESTATUS[@]}")
                    if ((ps[0] != 0)); then why="could not read it"
                    elif ((ps[1] != 0)); then why="strings exit ${ps[1]}"
                    elif ((ps[2] > 1)); then why="grep exit ${ps[2]}"
                    fi
                fi
            fi
            rm -f "$up/.list"
            if [[ -n $why ]]; then
                echo "PII scan of $(basename "$f") failed ($why); refusing to upload" >&2
                rm -f "$up/.hits"; return 1
            fi
        fi
        if ((st > 1)); then  # 1 is "no match"; anything else is a scan error
            echo "PII scan of $(basename "$f") failed (grep exit $st); refusing to upload" >&2
            rm -f "$up/.hits"; return 1
        fi
        [[ -s $up/.hits ]] || { unset seen; continue; }
        while IFS= read -r m; do
            for i in "${!res[@]}"; do
                shopt -s nocasematch
                [[ $m =~ ${res[$i]} ]] && seen[${nums[$i]}]=1
                shopt -u nocasematch
            done
        done < <(sort -u "$up/.hits")
        hit="$(basename "$f"): denylist line(s) $(printf '%s\n' "${!seen[@]}" | sort -n | paste -sd, -)"
        local ok=0 why=''
        if ((!as_text)); then  # the allow list names packages, never a comment
            # shellcheck disable=SC2053  # the rules are globs
            for i in "${!aglobs[@]}"; do [[ $(basename "$f") == ${aglobs[$i]} ]] && ok=1; done
            ((ok)) && { pii_located "$f" || { ok=0; why=$pii_why; }; }
        fi
        rm -f "$up/.hits"
        if ((ok)); then echo "PII scan: allowed by build/pii-allow-packages: $hit"
        else echo "PII scan: BLOCKED $hit${why:+ ($why)}" >&2; rc=1; fi
        unset seen
    done
    return $rc
}
pii_place() {  # pii_place <location> <file of hit lines> [line]: append '<location>\t<match>' to
    # $up/.loc per match; with 'line', the location is '<location>:<that line>'
    local l m s
    while IFS= read -r l; do
        s=0; grep -oiE -- "$pattern" <<<"$l" >"$up/.m" || s=$?
        ((s > 1)) && return 1
        while IFS= read -r m; do printf '%s\t%s\n' "${1//$'\t'/ }${3:+:${l//$'\t'/ }}" "$m"; done <"$up/.m"
    done <"$2" >>"$up/.loc"
}
# pii_located <asset>: second pass, only for an asset that has allow rules. Unpacks it
# and places every hit (the member path for a name hit, '<member>:<line>' for a
# content hit); returns 0 only if every hit lies at a location a rule for this asset
# allows AND the placed hits cover every distinct hit of the first pass ($up/.hits).
# Otherwise sets pii_why (a count, never a location or the text) and returns 1.
pii_located() {
    local f=$1 base x m loc i allowed nbad=0 d=$up/.x
    base=$(basename "$f"); pii_why=''
    rm -rf "$d"; mkdir -p "$d"
    if ! bsdtar -xf "$f" -C "$d" 2>/dev/null; then
        pii_why="could not unpack it to place the hits"; chmod -R u+rwX "$d"; rm -rf "$d"; return 1
    fi
    chmod -R u+rwX "$d"  # read every member, and let rm remove read-only dirs
    # Every step is checked: a failed read must refuse the asset, not drop its hits.
    local st=0 err=''
    : >"$up/.loc"
    # name hits: the member path itself (no leading ./ or trailing /)
    bsdtar -tf "$f" >"$up/.names" 2>/dev/null || err="could not list it"
    # The unpacked tree must be a 1:1 image of the archive, or a member the first pass
    # streamed could go unread here (overwritten by a repeat or an alias like ././x, or
    # a hardlink that duplicates data). So: canonical paths only, none repeated, no
    # hardlinks, and as many regular files on disk as regular entries in the archive.
    if [[ -z $err ]]; then
        local canon nreg nfiles
        if ! { bsdtar -tvf "$f" >"$up/.long" 2>/dev/null &&
               canon=$(sed -e 's,^\./,,' -e 's,/$,,' "$up/.names" | grep -v '^\.\?$' | sort) &&
               nreg=$(awk '/^-/ {n++} END {print n + 0}' "$up/.long") &&
               nfiles=$(find "$d" -type f | wc -l); }; then
            err="could not list it"
        elif (($(wc -l <"$up/.long") != $(wc -l <"$up/.names"))); then err="its listing is ambiguous"
        elif grep -qE '^/|//|(^|/)\.\.?(/|$)' <<<"$canon"; then err="it has a non-canonical member path"
        elif [[ -n $(uniq -d <<<"$canon") ]]; then err="it repeats a member path"
        elif grep -q ' link to ' "$up/.long"; then err="it has a hardlink"
        elif ((nreg != nfiles)); then err="it did not unpack 1:1"
        fi
        rm -f "$up/.long"
    fi
    if [[ -z $err ]]; then
        grep -iE -- "$pattern" "$up/.names" >"$up/.l" || st=$?
        ((st > 1)) && err="name scan failed"
    fi
    if [[ -z $err ]]; then
        while IFS= read -r x; do
            x=${x#./}; x=${x%/}; printf '%s\n' "$x" >"$up/.one"
            pii_place "$x" "$up/.one" || { err="name scan failed"; break; }
        done <"$up/.l"
    fi
    # content hits, at '<member>:<line>'. Every regular member is read the way the first
    # pass reads it (strings, then the same grep): a raw-byte prefilter would not match
    # anchored entries the same way. A few seconds per thousand members.
    if [[ -z $err ]]; then
        find "$d" -type f -print0 >"$up/.files" || err="content scan failed"
    fi
    if [[ -z $err ]]; then
        while IFS= read -r -d '' x; do
            strings -n 4 "$x" >"$up/.s" || { err="content scan failed"; break; }
            st=0; grep -iE -- "$pattern" "$up/.s" >"$up/.l" || st=$?
            ((st > 1)) && { err="content scan failed"; break; }
            pii_place "${x#"$d"/}" "$up/.l" line || { err="content scan failed"; break; }
        done <"$up/.files"
    fi
    rm -rf "$d"; rm -f "$up/.names" "$up/.l" "$up/.one" "$up/.files" "$up/.s" "$up/.m"
    if [[ -n $err ]]; then pii_why="$err; refusing"; rm -f "$up/.loc"; return 1; fi
    # Fail closed: a first-pass hit this pass did not place (say, a string that spans
    # two members) is not covered by any rule. Intermediate files, not process
    # substitutions, so a failed sort or comm is seen (pipefail is on).
    local uncovered
    if ! { tr '[:upper:]' '[:lower:]' <"$up/.hits" | sort -u >"$up/.h1" &&
           cut -f2- "$up/.loc" | tr '[:upper:]' '[:lower:]' | sort -u >"$up/.h2" &&
           uncovered=$(comm -23 "$up/.h1" "$up/.h2"); }; then
        pii_why="coverage check failed; refusing"; rm -f "$up/.loc" "$up/.h1" "$up/.h2"; return 1
    fi
    rm -f "$up/.h1" "$up/.h2"
    if [[ -n $uncovered ]]; then
        pii_why="a hit could not be placed"; rm -f "$up/.loc"; return 1
    fi
    while IFS=$'\t' read -r loc m; do   # read the file itself: no hidden exit status
        allowed=0
        for i in "${!aglobs[@]}"; do
            # shellcheck disable=SC2053  # the rules are globs
            [[ $base == ${aglobs[$i]} && $loc == ${pglobs[$i]} ]] && { allowed=1; break; }
        done
        ((allowed)) || nbad=$((nbad + 1))
    done <"$up/.loc"
    rm -f "$up/.loc"
    ((nbad == 0)) || { pii_why="$nbad hit(s) outside its allowed locations"; return 1; }
}
if ((scan_only)); then pii_scan "$@"; exit; fi

# shellcheck source=bin/publish-lib.sh
source "$(dirname "$0")/publish-lib.sh"
: "${SIGN_KEY:?no signing key fingerprint in $DATA/fingerprint}"
grace_h=${PRUNE_GRACE_HOURS:-72}
[[ $grace_h =~ ^[0-9]+$ ]] || { echo "PRUNE_GRACE_HOURS=$grace_h is not a whole number of hours" >&2; exit 1; }
# Set the EXIT trap before pub_lock, so a trap the lock sets up is not replaced.
remote_dl=$(mktemp -d); trap 'rm -rf "$up" "$remote_dl"' EXIT
pub_lock  # held until exit: snapshot, uploads, verification and pruning

for f in "$REPO_DIR"/*; do
    case $(basename "$f") in *.tar.gz|*.tar.gz.sig|*.old|*.old.sig) continue ;; esac
    cp -L "$f" "$up/$(basename "$f")"
done
dbfiles=("$REPO_NAME".db "$REPO_NAME".db.sig "$REPO_NAME".files "$REPO_NAME".files.sig)
for f in "${dbfiles[@]}"; do [[ -e $up/$f ]] || { echo "missing $REPO_DIR/$f" >&2; exit 1; }; done
# The db and files must be validly signed by our key: repo-add can keep an old .sig
# beside a new db when signing fails, and pacman (SigLevel Required) would refuse it.
for n in "$REPO_NAME".db "$REPO_NAME".files; do
    pub_verify_sig "$up/$n" "$up/$n.sig" ||
        { echo "sync aborted: the local db/files signature does not verify; nothing uploaded" >&2; exit 1; }
done
# Every package the db names must be here (with its signature), or pacman would 404.
# Intermediate files, so a db that cannot be read aborts instead of naming nothing.
bsdtar -tf "$up/$REPO_NAME.db" >"$up/.dblist" 2>/dev/null ||
    { echo "cannot list $REPO_DIR/$REPO_NAME.db; nothing uploaded" >&2; exit 1; }
: >"$up/.desc"
gs=0; grep -q '/desc$' "$up/.dblist" || gs=$?
((gs < 2)) || { echo "cannot read the listing of $REPO_DIR/$REPO_NAME.db; nothing uploaded" >&2; exit 1; }
if ((gs == 0)); then   # an empty repo has no entries to extract
    bsdtar -xOf "$up/$REPO_NAME.db" '*/desc' >"$up/.desc" 2>/dev/null ||
        { echo "cannot read $REPO_DIR/$REPO_NAME.db; nothing uploaded" >&2; exit 1; }
fi
awk 'p {print; p=0} /^%FILENAME%$/ {p=1}' "$up/.desc" >"$up/.dbnames"
mapfile -t db_pkgs <"$up/.dbnames"
rm -f "$up/.dblist" "$up/.desc" "$up/.dbnames"
for f in "${db_pkgs[@]}"; do
    [[ -e $up/$f && -e $up/$f.sig ]] || { echo "db names $f but $REPO_DIR lacks it (or its .sig)" >&2; exit 1; }
done
db_sum=$(sha256sum "$up/$REPO_NAME.db" | cut -d' ' -f1)

# --- remote state (one API call per read) ---
declare -A rsize rdigest
read_assets() {  # fill rsize/rdigest from the release; 1 if it cannot be read
    local assets n s d
    assets=$(gh release view "$GH_TAG" -R "$GH_REPO" --json assets \
        --jq '.assets[] | [.name, (.size|tostring), (.digest // "")] | @tsv' 2>/dev/null) || return 1
    rsize=(); rdigest=()
    while IFS=$'\t' read -r n s d; do
        [[ -n $n ]] || continue
        rsize[$n]=$s; rdigest[$n]=$d
    done <<<"$assets"
}
release_missing=0
if ! read_assets; then
    echo "release $GH_TAG does not exist yet"
    run gh release create "$GH_TAG" -R "$GH_REPO" --target "$GH_BRANCH" --latest=false \
        --prerelease --title "EXPERIMENTAL omarchy-asus pacman repo ($GH_TAG) - ROG Zephyrus G16 GA605 only" \
        --notes-file "$WORKSPACE/build/release-notes.md"
    rsize=(); rdigest=(); release_missing=1
fi

remote_sum() {  # remote_sum <asset name>: print the release asset's sha256 (from the API's
                # digest, else by downloading it); 1 the asset is absent, 2 the download failed
    local n=$1 d s
    [[ -n ${rsize[$n]:-} ]] || return 1
    d=${rdigest[$n]:-}
    if [[ $d == sha256:?* ]]; then echo "${d#sha256:}"; return 0; fi
    rm -f "$remote_dl/$n"
    gh release download "$GH_TAG" -R "$GH_REPO" -p "$n" -D "$remote_dl" --clobber >/dev/null 2>&1 &&
        [[ -f $remote_dl/$n ]] || { echo "cannot download release asset $n to hash it" >&2; return 2; }
    s=$(sha256sum "$remote_dl/$n" | cut -d' ' -f1) || { rm -f "$remote_dl/$n"; return 2; }
    rm -f "$remote_dl/$n"
    echo "$s"
}
# One publisher: the release's db must be the one this host last synced (or already
# the local one). Anything else was put there by someone else; don't overwrite it.
check_publisher() {  # check_publisher [first]: exits 1 on a foreign db
    local rec rs rc=0
    if [[ ${SYNC_ADOPT_REMOTE:-} == 1 ]]; then
        [[ ${1:-} == first ]] && echo "SYNC_ADOPT_REMOTE=1: taking over the release whatever db it has"
        return 0
    fi
    if [[ ! -e $DATA/release-db.sha256 ]]; then
        [[ ${1:-} == first ]] &&
            echo "note: no $DATA/release-db.sha256 yet; this host adopts the release as it is"
        return 0
    fi
    [[ -n ${rsize[$REPO_NAME.db]:-} ]] || return 0
    rec=$DATA/release-db.sha256
    rs=$(remote_sum "$REPO_NAME.db") || rc=$?
    # The record lists every db this host uploaded since its last verified sync (one per
    # line, see below): a sync killed after its db upload must not look like another publisher.
    if ((rc == 0)) && [[ -n $rs ]] && { [[ $rs == "$db_sum" ]] || grep -qxF -- "$rs" "$rec"; }; then
        return 0
    fi
    ((rc == 0)) || echo "cannot hash the release's $REPO_NAME.db" >&2
    echo "refusing: the release's db changed since this host last synced it (another publisher?);" \
        "check it, then rerun with SYNC_ADOPT_REMOTE=1" >&2
    exit 1
}
check_publisher first

same() {  # same <local file>: 0 the remote asset of that name has the same bytes, 1 it differs
          # (or is absent), 2 unknown (no digest from the API and the download failed)
    local n sum; n=$(basename "$1")
    [[ -n ${rsize[$n]:-} ]] || return 1
    [[ ${rsize[$n]} == "$(stat -c %s "$1")" ]] || return 1
    sum=$(sha256sum "$1" | cut -d' ' -f1)
    if [[ -n ${rdigest[$n]} ]]; then
        [[ ${rdigest[$n]} == "sha256:$sum" ]]; return
    fi
    # No digest (older assets, or the API left it out): an equal size proves nothing,
    # so fetch the asset and hash it. Fail closed when that is not possible.
    rm -f "$remote_dl/$n"
    gh release download "$GH_TAG" -R "$GH_REPO" -p "$n" -D "$remote_dl" --clobber >/dev/null 2>&1 &&
        [[ -f $remote_dl/$n ]] || { echo "cannot download release asset $n to compare it" >&2; return 2; }
    [[ $(sha256sum "$remote_dl/$n" | cut -d' ' -f1) == "$sum" ]]
    local rc=$?; rm -f "$remote_dl/$n"; return $rc
}

new_pkgs=() upload_pkgs=() upload_db=()
for f in "$up"/*.pkg.tar.zst; do
    [[ -e $f ]] || continue
    n=$(basename "$f")
    rc=0; same "$f" || rc=$?
    if ((rc == 0)); then :
    elif ((rc == 2)); then
        echo "refusing: cannot verify that the release's $n has the same bytes; nothing uploaded" >&2
        exit 1
    elif [[ -n ${rsize[$n]:-} ]]; then
        echo "refusing: $n is already in the release with different bytes; bump pkgrel instead" >&2
        exit 1
    else
        new_pkgs+=("$f"); upload_pkgs+=("$f")
    fi
    # A signature may differ for unchanged package bytes (re-signed); both verify.
    # Unknown (2) counts as different: re-uploading a .sig or the db is harmless.
    same "$f.sig" || upload_pkgs+=("$f.sig")
done
for n in "${dbfiles[@]}"; do same "$up/$n" || upload_db+=("$up/$n"); done
n_assets=${#rsize[@]}

# --- every package about to go up must be signed by our key ---
declare -A sig_ok=()
for f in "${upload_pkgs[@]}"; do
    p=${f%.sig}
    [[ $p == *.pkg.tar.zst && -z ${sig_ok[$p]:-} ]] || continue
    pub_verify_sig "$p" "$p.sig" ||
        { echo "sync aborted: $(basename "$p") has no good signature by $SIGN_KEY; nothing uploaded" >&2; exit 1; }
    sig_ok[$p]=1
done

# --- PII scan of what is about to become public ---
scan=("${new_pkgs[@]}")
((${#upload_db[@]})) && scan+=("$up/$REPO_NAME.db" "$up/$REPO_NAME.files")
if ((${#scan[@]})); then
    pii_scan "${scan[@]}" || { echo "sync aborted: nothing uploaded" >&2; exit 1; }
fi

# --- upload: packages first, db last ---
((${#upload_pkgs[@]})) && run gh release upload "$GH_TAG" -R "$GH_REPO" --clobber "${upload_pkgs[@]}"
if ((${#upload_db[@]})); then
    # Another publisher may have replaced the db while the packages went up: look again.
    if read_assets; then
        check_publisher
    elif ((dry && release_missing)); then
        :   # dry run against a release that would have been created: nothing to re-read
    else
        echo "refusing: cannot re-read release $GH_TAG before the db upload; db not uploaded" >&2
        exit 1
    fi
    # Record this db before it goes up: if the run dies between the upload and the
    # verification below, the next sync still knows the release's db as this host's.
    if ((!dry)); then
        # No record yet (the release was adopted as it is): record the adopted db too, so
        # an upload that fails before replacing it does not make it look foreign later.
        if [[ ! -e $DATA/release-db.sha256 && -n ${rsize[$REPO_NAME.db]:-} ]]; then
            arc=0; adopted=$(remote_sum "$REPO_NAME.db") || arc=$?
            ((arc == 0)) && [[ -n $adopted ]] ||
                { echo "refusing: cannot hash the release's $REPO_NAME.db to record it; db not uploaded" >&2; exit 1; }
            printf '%s\n' "$adopted" >>"$DATA/release-db.sha256" ||
                { echo "refusing: cannot write $DATA/release-db.sha256; db not uploaded" >&2; exit 1; }
        fi
        printf '%s\n' "$db_sum" >>"$DATA/release-db.sha256" ||
            { echo "refusing: cannot write $DATA/release-db.sha256; db not uploaded" >&2; exit 1; }
    fi
    run gh release upload "$GH_TAG" -R "$GH_REPO" --clobber "${upload_db[@]}"
fi

# --- verify the release, then record the db and clear the journal ---
verify_asset() {  # verify_asset <name>: 0 the release has exactly the bytes of $up/<name>
    local rs
    rs=$(remote_sum "$1") || return 1
    [[ $rs == "$(sha256sum "$up/$1" | cut -d' ' -f1)" ]]
}
if ((dry)); then
    echo "dry run: would verify the release against the db, record $db_sum in" \
        "$DATA/release-db.sha256 and clear $DATA/sync-pending"
else
    read_assets ||
        { echo "sync incomplete: cannot read release $GH_TAG to verify it; $DATA/sync-pending kept" >&2; exit 1; }
    want=("${dbfiles[@]}")
    for f in "${db_pkgs[@]}"; do want+=("$f" "$f.sig"); done
    for n in "${want[@]}"; do
        verify_asset "$n" ||
            { echo "sync incomplete: $n on the release does not match; $DATA/sync-pending kept" >&2; exit 1; }
    done
    printf '%s\n' "$db_sum" >"$DATA/release-db.sha256.tmp"
    mv -f "$DATA/release-db.sha256.tmp" "$DATA/release-db.sha256"
    pub_clear_pending
fi

# --- prune what the db no longer names, after a grace period ---
# $DATA/prune-candidates: '<asset>\t<epoch first seen unreferenced>' per line.
cand=$DATA/prune-candidates now=$(date +%s) grace_s=$((10#$grace_h * 3600)) deleted=0 waiting=0
declare -A first_seen=()
if [[ -e $cand ]]; then
    while IFS=$'\t' read -r n t; do
        if [[ -n $n && $t =~ ^[0-9]+$ ]]; then first_seen[$n]=$t; fi
    done <"$cand"
fi
: >"$up/.cand"
for a in "${!rsize[@]}"; do
    [[ -e $up/$a ]] && continue
    case " ${dbfiles[*]} " in *" $a "*) continue ;; esac
    t=${first_seen[$a]:-$now}
    if ((now - t >= grace_s)); then
        run gh release delete-asset "$GH_TAG" "$a" -R "$GH_REPO" --yes
        deleted=$((deleted + 1))
    else
        printf '%s\t%s\n' "$a" "$t" >>"$up/.cand"
        waiting=$((waiting + 1))
    fi
done
if ((!dry)); then
    cp "$up/.cand" "$cand.tmp"
    mv -f "$cand.tmp" "$cand"
fi
echo "sync: ${#upload_pkgs[@]} package file(s) and ${#upload_db[@]} db file(s) uploaded;" \
    "$deleted superseded asset(s) deleted, $waiting waiting out the ${grace_h}h grace period" \
    "($n_assets assets were in the release)"
