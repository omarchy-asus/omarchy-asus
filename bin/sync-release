#!/bin/bash
# Mirror $REPO_DIR to the GitHub release that pacman pulls from:
#   Server = https://github.com/$GH_REPO/releases/download/$GH_TAG
# Usage: bin/sync-release [--dry-run]
#        bin/sync-release --pii-scan FILE...   (only run the PII scan below on these files)
#        bin/sync-release --pii-scan-text FILE...   (the same scan, each file read as plain text)
#
# Incremental, to keep GitHub traffic (and the window where an asset 404s) small:
# - one API call reads the release's assets (name, size, sha256 digest);
# - a package already uploaded with the same bytes is skipped; a package filename
#   that is already uploaded with DIFFERENT bytes is refused (a rebuild must bump
#   pkgrel: pacman and caches treat a filename as immutable);
# - new packages and signatures go up first, the db/files (+ .sig) last and only
#   when they changed, and assets the db no longer names are deleted only after
#   the new db is up.
# Release assets can't be symlinks, so the db/files links are uploaded as real
# files under the names pacman requests.
#
# PII guard: before anything is uploaded, the new packages and the db are scanned
# (strings of every file in them, plus file names) against the denylist
# ($PII_DENYLIST, default ~/.config/agent-pii/denylist), whole-word and
# case-insensitive. A hit aborts the sync unless build/pii-allow-packages has a rule
# '<asset glob> <location glob>' for that asset AND every hit in it lies at an
# allowed location: a hit in a file name is at that member path, a hit in contents
# at '<member path>:<line>' (the strings line holding it). One hit anywhere else
# (.PKGINFO, .BUILDINFO, another member) still blocks. Only denylist line numbers are
# printed, never the entries, the matched text or its location. A missing denylist,
# an invalid regex in it, a malformed allow rule, a hit the located pass cannot place
# or a failed scan aborts too, never reads as clean (PII_SCAN=off skips the scan,
# for a machine without one).
# --pii-scan-text scans files as plain text, never as archives (bin/auto-update scans
# its PR comments and replies with it; build/pii-allow-packages does not apply).
set -euo pipefail
source "$(dirname "$0")/env.sh"
dry=0 scan_only=0 as_text=0
case ${1:-} in
    --dry-run) dry=1 ;;
    --pii-scan) scan_only=1; shift ;;
    --pii-scan-text) scan_only=1 as_text=1; shift ;;
esac
run() { if ((dry)); then echo "would run: $*"; else "$@"; fi; }

up=$(mktemp -d); trap 'rm -rf "$up"' EXIT
# --- PII scan (used below on what is about to become public) ---
pii_scan() {  # pii_scan <file>...: prints a line per file with hits, returns 1 if any is not allowed
    [[ ${PII_SCAN:-on} == off ]] && { echo "PII scan skipped (PII_SCAN=off)"; return 0; }
    local list=${PII_DENYLIST:-$HOME/.config/agent-pii/denylist}
    [[ -r $list ]] || { echo "PII denylist $list is missing; refusing to upload (PII_SCAN=off to skip)" >&2; return 1; }
    local allow=$WORKSPACE/build/pii-allow-packages g ag pg extra n=0
    local -a aglobs=() pglobs=()
    if [[ -r $allow ]]; then
        while IFS= read -r g; do
            n=$((n + 1)); g=${g%%#*}; ag='' pg='' extra=''
            read -r ag pg extra <<<"$g" || true
            [[ -z $ag ]] && continue
            if [[ -z $pg || -n $extra ]]; then  # a bare asset glob would allow the whole file
                echo "build/pii-allow-packages line $n: want '<asset glob> <location glob>'; refusing to upload" >&2
                return 1
            fi
            aglobs+=("$ag"); pglobs+=("$pg")
        done <"$allow"
    fi
    # Whole-word regex per denylist line (same rules as the publish guard's wrap()).
    local -a res=() nums=()
    local e pre post i=0 lineno=0
    while IFS= read -r e; do
        lineno=$((lineno + 1))
        [[ $e =~ ^[[:space:]]*(#|$) ]] && continue
        local alts=("$e")
        [[ $e == *'|'* && $e =~ ^[[:alnum:]|._@-]+$ ]] && IFS='|' read -ra alts <<<"$e"
        for a in "${alts[@]}"; do
            pre=''; post=''
            [[ $a =~ ^[[:alnum:]] ]] && pre='(^|[^[:alnum:]])'
            [[ $a =~ [[:alnum:]]$ ]] && post='([^[:alnum:]]|$)'
            res+=("$pre($a)$post"); nums+=("$lineno")
        done
    done <"$list"
    ((${#res[@]})) || return 0
    local pattern; pattern=$(IFS='|'; echo "${res[*]}")
    # Fail closed: an invalid entry makes grep exit 2 without scanning, which must not
    # read as "no hits". Check the combined pattern once; name bad lines, not entries.
    local st=0 bad=()
    grep -iE -- "$pattern" </dev/null >/dev/null 2>&1 || st=$?
    if ((st > 1)); then
        for i in "${!res[@]}"; do
            st=0; grep -iE -- "${res[$i]}" </dev/null >/dev/null 2>&1 || st=$?
            ((st > 1)) && bad+=("${nums[$i]}")
        done
        echo "PII denylist $list has an invalid regex (line(s) $(printf '%s\n' "${bad[@]:-?}" | sort -nu | paste -sd, -));" \
            "refusing to upload" >&2
        return 1
    fi
    local f rc=0 m hit
    for f in "$@"; do
        declare -A seen=()
        st=0
        if ((as_text)); then   # a PR comment or reply; an unreadable file is grep exit 2
            grep -aoiE -- "$pattern" "$f" >"$up/.hits" || st=$?
        else                   # a package or db: its file names and the strings of its contents
            { bsdtar -tf "$f" 2>/dev/null; bsdtar -xOf "$f" 2>/dev/null | strings -n 4; } |
                grep -oiE -- "$pattern" >"$up/.hits" || st=${PIPESTATUS[1]}
        fi
        if ((st > 1)); then  # 1 is "no match"; anything else is a scan error
            echo "PII scan of $(basename "$f") failed (grep exit $st); refusing to upload" >&2
            rm -f "$up/.hits"; return 1
        fi
        [[ -s $up/.hits ]] || { unset seen; continue; }
        while IFS= read -r m; do
            for i in "${!res[@]}"; do
                shopt -s nocasematch
                [[ $m =~ ${res[$i]} ]] && seen[${nums[$i]}]=1
                shopt -u nocasematch
            done
        done < <(sort -u "$up/.hits")
        hit="$(basename "$f"): denylist line(s) $(printf '%s\n' "${!seen[@]}" | sort -n | paste -sd, -)"
        local ok=0 why=''
        if ((!as_text)); then  # the allow list names packages, never a comment
            # shellcheck disable=SC2053  # the rules are globs
            for i in "${!aglobs[@]}"; do [[ $(basename "$f") == ${aglobs[$i]} ]] && ok=1; done
            ((ok)) && { pii_located "$f" || { ok=0; why=$pii_why; }; }
        fi
        rm -f "$up/.hits"
        if ((ok)); then echo "PII scan: allowed by build/pii-allow-packages: $hit"
        else echo "PII scan: BLOCKED $hit${why:+ ($why)}" >&2; rc=1; fi
        unset seen
    done
    return $rc
}
pii_place() {  # pii_place <location> <file of hit lines> [line]: append '<location>\t<match>' to
    # $up/.loc per match; with 'line', the location is '<location>:<that line>'
    local l m s
    while IFS= read -r l; do
        s=0; grep -oiE -- "$pattern" <<<"$l" >"$up/.m" || s=$?
        ((s > 1)) && return 1
        while IFS= read -r m; do printf '%s\t%s\n' "${1//$'\t'/ }${3:+:${l//$'\t'/ }}" "$m"; done <"$up/.m"
    done <"$2" >>"$up/.loc"
}
# pii_located <asset>: second pass, only for an asset that has allow rules. Unpacks it
# and places every hit (the member path for a name hit, '<member>:<line>' for a
# content hit); returns 0 only if every hit lies at a location a rule for this asset
# allows AND the placed hits cover every distinct hit of the first pass ($up/.hits).
# Otherwise sets pii_why (a count, never a location or the text) and returns 1.
pii_located() {
    local f=$1 base x m loc i allowed nbad=0 d=$up/.x
    base=$(basename "$f"); pii_why=''
    rm -rf "$d"; mkdir -p "$d"
    if ! bsdtar -xf "$f" -C "$d" 2>/dev/null; then
        pii_why="could not unpack it to place the hits"; chmod -R u+rwX "$d"; rm -rf "$d"; return 1
    fi
    chmod -R u+rwX "$d"  # read every member, and let rm remove read-only dirs
    # Every step is checked: a failed read must refuse the asset, not drop its hits.
    local st=0 err=''
    : >"$up/.loc"
    # name hits: the member path itself (no leading ./ or trailing /)
    bsdtar -tf "$f" >"$up/.names" 2>/dev/null || err="could not list it"
    # A repeated member path is overwritten on extraction, so its earlier contents would
    # go unread here (the first pass streams them all): refuse such an asset.
    if [[ -z $err ]]; then
        local dups
        if ! dups=$(sed -e 's,^\./,,' -e 's,/$,,' "$up/.names" | sort | uniq -d); then err="could not list it"
        elif [[ -n $dups ]]; then err="it repeats a member path"; fi
    fi
    if [[ -z $err ]]; then
        grep -iE -- "$pattern" "$up/.names" >"$up/.l" || st=$?
        ((st > 1)) && err="name scan failed"
    fi
    if [[ -z $err ]]; then
        while IFS= read -r x; do
            x=${x#./}; x=${x%/}; printf '%s\n' "$x" >"$up/.one"
            pii_place "$x" "$up/.one" || { err="name scan failed"; break; }
        done <"$up/.l"
    fi
    # content hits, at '<member>:<line>'. Every regular member is read the way the first
    # pass reads it (strings, then the same grep): a raw-byte prefilter would not match
    # anchored entries the same way. A few seconds per thousand members.
    if [[ -z $err ]]; then
        find "$d" -type f -print0 >"$up/.files" || err="content scan failed"
    fi
    if [[ -z $err ]]; then
        while IFS= read -r -d '' x; do
            strings -n 4 "$x" >"$up/.s" || { err="content scan failed"; break; }
            st=0; grep -iE -- "$pattern" "$up/.s" >"$up/.l" || st=$?
            ((st > 1)) && { err="content scan failed"; break; }
            pii_place "${x#"$d"/}" "$up/.l" line || { err="content scan failed"; break; }
        done <"$up/.files"
    fi
    rm -rf "$d"; rm -f "$up/.names" "$up/.l" "$up/.one" "$up/.files" "$up/.s" "$up/.m"
    if [[ -n $err ]]; then pii_why="$err; refusing"; rm -f "$up/.loc"; return 1; fi
    # Fail closed: a first-pass hit this pass did not place (say, a string that spans
    # two members) is not covered by any rule. Intermediate files, not process
    # substitutions, so a failed sort or comm is seen (pipefail is on).
    local uncovered
    if ! { tr '[:upper:]' '[:lower:]' <"$up/.hits" | sort -u >"$up/.h1" &&
           cut -f2- "$up/.loc" | tr '[:upper:]' '[:lower:]' | sort -u >"$up/.h2" &&
           uncovered=$(comm -23 "$up/.h1" "$up/.h2"); }; then
        pii_why="coverage check failed; refusing"; rm -f "$up/.loc" "$up/.h1" "$up/.h2"; return 1
    fi
    rm -f "$up/.h1" "$up/.h2"
    if [[ -n $uncovered ]]; then
        pii_why="a hit could not be placed"; rm -f "$up/.loc"; return 1
    fi
    while IFS=$'\t' read -r loc m; do   # read the file itself: no hidden exit status
        allowed=0
        for i in "${!aglobs[@]}"; do
            # shellcheck disable=SC2053  # the rules are globs
            [[ $base == ${aglobs[$i]} && $loc == ${pglobs[$i]} ]] && { allowed=1; break; }
        done
        ((allowed)) || nbad=$((nbad + 1))
    done <"$up/.loc"
    rm -f "$up/.loc"
    ((nbad == 0)) || { pii_why="$nbad hit(s) outside its allowed locations"; return 1; }
}
if ((scan_only)); then pii_scan "$@"; exit; fi

for f in "$REPO_DIR"/*; do
    case $(basename "$f") in *.tar.gz|*.tar.gz.sig|*.old|*.old.sig) continue ;; esac
    cp -L "$f" "$up/$(basename "$f")"
done
dbfiles=("$REPO_NAME".db "$REPO_NAME".db.sig "$REPO_NAME".files "$REPO_NAME".files.sig)
for f in "${dbfiles[@]}"; do [[ -e $up/$f ]] || { echo "missing $REPO_DIR/$f" >&2; exit 1; }; done
# Every package the db names must be here (with its signature), or pacman would 404.
while IFS= read -r f; do
    [[ -e $up/$f && -e $up/$f.sig ]] || { echo "db names $f but $REPO_DIR lacks it (or its .sig)" >&2; exit 1; }
done < <(bsdtar -xOf "$up/$REPO_NAME.db" '*/desc' | awk 'p {print; p=0} /^%FILENAME%$/ {p=1}')

# --- remote state (one API call) ---
declare -A rsize rdigest
if ! assets=$(gh release view "$GH_TAG" -R "$GH_REPO" --json assets \
        --jq '.assets[] | [.name, (.size|tostring), (.digest // "")] | @tsv' 2>/dev/null); then
    echo "release $GH_TAG does not exist yet"
    run gh release create "$GH_TAG" -R "$GH_REPO" --target "$GH_BRANCH" --latest=false \
        --prerelease --title "EXPERIMENTAL omarchy-asus pacman repo ($GH_TAG) - ROG Zephyrus G16 GA605 only" \
        --notes-file "$WORKSPACE/build/release-notes.md"
    assets=
fi
while IFS=$'\t' read -r n s d; do
    [[ -n $n ]] || continue
    rsize[$n]=$s; rdigest[$n]=$d
done <<<"$assets"

remote_dl=$(mktemp -d); trap 'rm -rf "$up" "$remote_dl"' EXIT
same() {  # same <local file>: 0 the remote asset of that name has the same bytes, 1 it differs
          # (or is absent), 2 unknown (no digest from the API and the download failed)
    local n sum; n=$(basename "$1")
    [[ -n ${rsize[$n]:-} ]] || return 1
    [[ ${rsize[$n]} == "$(stat -c %s "$1")" ]] || return 1
    sum=$(sha256sum "$1" | cut -d' ' -f1)
    if [[ -n ${rdigest[$n]} ]]; then
        [[ ${rdigest[$n]} == "sha256:$sum" ]]; return
    fi
    # No digest (older assets, or the API left it out): an equal size proves nothing,
    # so fetch the asset and hash it. Fail closed when that is not possible.
    rm -f "$remote_dl/$n"
    gh release download "$GH_TAG" -R "$GH_REPO" -p "$n" -D "$remote_dl" --clobber >/dev/null 2>&1 &&
        [[ -f $remote_dl/$n ]] || { echo "cannot download release asset $n to compare it" >&2; return 2; }
    [[ $(sha256sum "$remote_dl/$n" | cut -d' ' -f1) == "$sum" ]]
    local rc=$?; rm -f "$remote_dl/$n"; return $rc
}

new_pkgs=() upload_pkgs=() upload_db=()
for f in "$up"/*.pkg.tar.zst; do
    [[ -e $f ]] || continue
    n=$(basename "$f")
    rc=0; same "$f" || rc=$?
    if ((rc == 0)); then :
    elif ((rc == 2)); then
        echo "refusing: cannot verify that the release's $n has the same bytes; nothing uploaded" >&2
        exit 1
    elif [[ -n ${rsize[$n]:-} ]]; then
        echo "refusing: $n is already in the release with different bytes; bump pkgrel instead" >&2
        exit 1
    else
        new_pkgs+=("$f"); upload_pkgs+=("$f")
    fi
    # A signature may differ for unchanged package bytes (re-signed); both verify.
    # Unknown (2) counts as different: re-uploading a .sig or the db is harmless.
    same "$f.sig" || upload_pkgs+=("$f.sig")
done
for n in "${dbfiles[@]}"; do same "$up/$n" || upload_db+=("$up/$n"); done

# --- PII scan of what is about to become public ---
scan=("${new_pkgs[@]}")
((${#upload_db[@]})) && scan+=("$up/$REPO_NAME.db" "$up/$REPO_NAME.files")
if ((${#scan[@]})); then
    pii_scan "${scan[@]}" || { echo "sync aborted: nothing uploaded" >&2; exit 1; }
fi

# --- upload: packages first, db last, then prune ---
((${#upload_pkgs[@]})) && run gh release upload "$GH_TAG" -R "$GH_REPO" --clobber "${upload_pkgs[@]}"
((${#upload_db[@]})) && run gh release upload "$GH_TAG" -R "$GH_REPO" --clobber "${upload_db[@]}"
for a in "${!rsize[@]}"; do
    [[ -e $up/$a ]] || run gh release delete-asset "$GH_TAG" "$a" -R "$GH_REPO" --yes
done
echo "sync: ${#upload_pkgs[@]} package file(s) and ${#upload_db[@]} db file(s) uploaded" \
    "($(( ${#rsize[@]} )) assets were in the release)"
